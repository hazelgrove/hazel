#!/usr/bin/env bash
# Builds the test JS and runs it, forwarding any CLI arguments.
# Examples:
#   ./run_tests                        # Run all tests
#   ./run_tests test 'Statics.*' -q    # Run Statics tests, quick output
#   ./run_tests test 'Evaluator' 19    # Run only Evaluator test 19

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Build the JS and the idb stub by explicit path: `dune build test` only builds
# the @default alias, and idb_stub.js reaches _build solely as a dep of the
# @runtest/@test-quick alias rules, so it would otherwise be missing here.
dune build test/haz3ltest.bc.js test/idb_stub.js --profile dev

"$SCRIPT_DIR/test/run_node.sh" "$@"
