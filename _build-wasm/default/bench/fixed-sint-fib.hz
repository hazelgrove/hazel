# Fixed-precision workload: binder-heavy recursion over SInt.               #
# SInt is Hazel's machine-int type (OCaml int), so this touches no zarith.  #
# `use SInt in` binds literals and operators to the SInt class; without it  #
# the arithmetic elaborates to Int (Bigint) and does not reduce.            #
use SInt in
let fib : SInt -> SInt =
  fun n -> if n < 2 then n else fib(n - 1) + fib(n - 2)
in
let ack : (SInt, SInt) -> SInt =
  fun (m, n) ->
    if m == 0 then n + 1
    else if n == 0 then ack(m - 1, 1)
    else ack(m - 1, ack(m, n - 1))
in
fib(21) + ack(2, 6)
