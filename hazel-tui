#!/usr/bin/env bash
# Builds the Hazel TUI and runs it with node, forwarding any arguments.
# All paths are resolved relative to this script's location.

set -e

# Resolve the directory this script lives in
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Path to the JS target relative to the script
JS_TARGET="$SCRIPT_DIR/_build/default/src/tui/tui.bc.js"
# Preload that stubs browser globals (IndexedDB, localStorage, DOM, Worker)
# which the web library references at module load time but that the TUI
# does not actually use at runtime. Shared with the CLI.
POLYFILL="$SCRIPT_DIR/src/CLI/polyfill.js"

# Build with the release profile: the dev profile's --linkall --noinline
# js_of_ocaml flags produce a bundle too slow for interactive use.
(cd "$SCRIPT_DIR" && dune build --profile release ./src/tui/tui.bc.js)

# Execute the compiled JavaScript with node. --stack-size matches
# test/run_node.sh; core code is deeply recursive.
exec node --stack-size=8192 -r "$POLYFILL" "$JS_TARGET" "$@"
