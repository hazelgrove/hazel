#!/usr/bin/env bash
# Builds the native Hazel TUI and runs it, forwarding any arguments.
# All paths are resolved relative to this script's location.

set -e

# Resolve the directory this script lives in
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

TARGET="$SCRIPT_DIR/_build/default/src/tui/tui.exe"

(cd "$SCRIPT_DIR" && dune build --profile release ./src/tui/tui.exe)

exec "$TARGET" "$@"
