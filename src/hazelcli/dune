(include_subdirs unqualified)

(executable
 (name cli)
 (modules Cli Run Parse Print QCheck_Util)
 (libraries ppx_yojson_conv.expander haz3lcore cmdliner qcheck haz3lmenhir)
 (modes js)
 (preprocess
  (pps js_of_ocaml-ppx)))

(env
 (dev
  (js_of_ocaml
   (flags :standard --debuginfo --noinline --dynlink --linkall --sourcemap)))
 (release
  (js_of_ocaml
   (flags (:standard)))))

(rule
 (alias run)
 (action
  (run node %{exe:cli.bc.js})))
