let continue = x => x;
/*
   The expression data types in Hazel, specialised to IdTag annotations, and
   the traversals over them. The types themselves are in Grammar.re.

   Every traversal here is built on one primitive per type, generated by
   `[@deriving children]` (src/ppx_children): Grammar.map_children_<T> and
   Grammar.fold_children_<T> visit the nodes (Exp, Pat, Typ, ...) directly
   under a term, and nothing deeper. They are the only code that knows which
   constructors have children, so a new constructor needs no change here.

   - Any.children, Any.fold and Any.subterms walk a term without rebuilding it.

   - map_term rebuilds a term:

     map_term:
     (
       ~f_exp: (Exp.t => Exp.t, Exp.t) => Exp.t=?,
       ...one argument per sort...
       ~f_any: (Any.t => Any.t, Any.t) => Any.t=?,
       t
     ) =>
     t;

     Each argument specifies what should happen at each node in the data
     structure. Each function takes two arguments: a `continue` function that
     allows the map to continue on all the children nodes, and the current node
     itself. If you don't explicitly call the `continue` function, the map will
     not traverse the children nodes. If you don't provide a function for a
     specific kind of node, the map will simply continue at that node without
     any additional action.
 */

[@deriving (show({with_path: false}), sexp, yojson)]
type any_t = Grammar.any_t(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type exp_t = Grammar.exp_t(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type exp_term = Grammar.exp_term(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type pat_t = Grammar.pat_t(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type pat_term = Grammar.pat_term(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type typ_t = Grammar.typ_t(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type typ_term = Grammar.typ_term(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type tpat_t = Grammar.tpat_t(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type tpat_term = Grammar.tpat_term(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type rul_t = Grammar.rul_t(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type rul_term = Grammar.rul_term(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type mod_t = Grammar.mod_t(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type mod_term = Grammar.mod_term(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type sig_t = Grammar.sig_t(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type sig_term = Grammar.sig_term(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type mpat_t = Grammar.mpat_t(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type mpat_term = Grammar.mpat_term(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type stepper_filter_kind_t = Grammar.stepper_filter_kind_t(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type type_hole = Grammar.type_hole(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type type_provenance = Grammar.type_provenance(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type filter = Grammar.filter(IdTagged.IdTag.t);
[@deriving (show({with_path: false}), sexp, yojson)]
type deferral_position_t = Grammar.deferral_position_t;

type mapper = Grammar.children_map(IdTagged.IdTag.t);
type folder('acc) = Grammar.children_fold(IdTagged.IdTag.t, 'acc);

/* map_term's arguments, one per sort. */
type callbacks = {
  f_exp: (exp_t => exp_t, exp_t) => exp_t,
  f_pat: (pat_t => pat_t, pat_t) => pat_t,
  f_typ: (typ_t => typ_t, typ_t) => typ_t,
  f_tpat: (tpat_t => tpat_t, tpat_t) => tpat_t,
  f_rul: (rul_t => rul_t, rul_t) => rul_t,
  f_mod: (mod_t => mod_t, mod_t) => mod_t,
  f_sig: (sig_t => sig_t, sig_t) => sig_t,
  f_mpat: (mpat_t => mpat_t, mpat_t) => mpat_t,
  f_any: (any_t => any_t, any_t) => any_t,
};

/* Traversals show each of a sum's constructor names as a Var node, so that
   id renaming passes reach it: we turn a variant back into its original term
   (see MakeTerm.parse_sum_term) in order to visit it. */
let constructor_var = (c, ann: ConstructorMap.variant_ann): typ_t => {
  term: Var(c),
  annotation: IdTagged.IdTag.mk_internal(ann.ids),
};

let map_sum = (map_typ: typ_t => typ_t, variants: ConstructorMap.t(typ_t)) =>
  List.map(
    variants,
    ~f=
      fun
      | ConstructorMap.Variant(c, ann, t) =>
        switch (map_typ(constructor_var(c, ann))) {
        | {term: Var(c), annotation: {ids, _}} =>
          ConstructorMap.Variant(
            c,
            {
              ids,
              secondary: ann.secondary,
            },
            Option.map(~f=map_typ, t),
          )
        | t => BadEntry(map_typ(t))
        }
      | ConstructorMap.BadEntry(t) => ConstructorMap.BadEntry(map_typ(t)),
  );

let fold_sum =
    (
      fold_typ: (typ_t, 'acc) => 'acc,
      variants: ConstructorMap.t(typ_t),
      acc: 'acc,
    )
    : 'acc =>
  List.fold(variants, ~init=acc, ~f=(acc, variant) =>
    switch (variant) {
    | ConstructorMap.Variant(c, ann, t) =>
      Option.fold(
        t, ~init=fold_typ(constructor_var(c, ann), acc), ~f=(acc, t) =>
        fold_typ(t, acc)
      )
    | ConstructorMap.BadEntry(t) => fold_typ(t, acc)
    }
  );

/* The one type constructor whose children traversals see differently from
   the generated functions (see constructor_var). */
let as_sum = (term: typ_term): option(ConstructorMap.t(typ_t)) =>
  switch (term) {
  | Sum(variants) => Some(variants)
  | Unknown(_)
  | Atom(_)
  | DrvQuoteTy(_)
  | Var(_)
  | List(_)
  | Arrow(_)
  | Prod(_)
  | ExplicitNonlabel
  | Label(_)
  | TupLabel(_)
  | Parens(_)
  | Projector(_)
  | Rec(_)
  | Poly(_)
  | ProofOf(_)
  | ProdProjection(_)
  | ProdExtension(_)
  | Sig(_) => None
  };

let map_typ_term = (m: mapper, term: typ_term): typ_term =>
  switch (as_sum(term)) {
  | Some(variants) => Sum(map_sum(m.typ_t, variants))
  | None => Grammar.map_children_typ_term(m, term)
  };

let fold_typ_term = (f: folder('acc), term: typ_term, acc: 'acc): 'acc =>
  switch (as_sum(term)) {
  | Some(variants) => fold_sum(f.typ_t, variants, acc)
  | None => Grammar.fold_children_typ_term(f, term, acc)
  };

/* The mapper that applies each callback at its sort, continuing into the
   node's children with this same mapper. */
let deep_mapper = (cb: callbacks): mapper => {
  let rec m: mapper = {
    exp_t: x =>
      cb.f_exp(
        e =>
          {
            ...e,
            term: Grammar.map_children_exp_term(m, e.term),
          },
        x,
      ),
    pat_t: x =>
      cb.f_pat(
        p =>
          {
            ...p,
            term: Grammar.map_children_pat_term(m, p.term),
          },
        x,
      ),
    typ_t: x =>
      cb.f_typ(
        t =>
          {
            ...t,
            term: map_typ_term(m, t.term),
          },
        x,
      ),
    tpat_t: x =>
      cb.f_tpat(
        tp =>
          {
            ...tp,
            term: Grammar.map_children_tpat_term(m, tp.term),
          },
        x,
      ),
    rul_t: x =>
      cb.f_rul(
        r =>
          {
            ...r,
            term: Grammar.map_children_rul_term(m, r.term),
          },
        x,
      ),
    mod_t: x =>
      cb.f_mod(
        md =>
          {
            ...md,
            term: Grammar.map_children_mod_term(m, md.term),
          },
        x,
      ),
    sig_t: x =>
      cb.f_sig(
        s =>
          {
            ...s,
            term: Grammar.map_children_sig_term(m, s.term),
          },
        x,
      ),
    mpat_t: x =>
      cb.f_mpat(
        mp =>
          {
            ...mp,
            term: Grammar.map_children_mpat_term(m, mp.term),
          },
        x,
      ),
    any_t: x => cb.f_any(Grammar.map_children_any_t(m), x),
  };
  m;
};

/* map_term for the sort that `pick` selects from the mapper. */
let map_term_at =
    (
      pick: (mapper, 't) => 't,
      ~f_exp=continue,
      ~f_pat=continue,
      ~f_typ=continue,
      ~f_tpat=continue,
      ~f_rul=continue,
      ~f_mod=continue,
      ~f_sig=continue,
      ~f_mpat=continue,
      ~f_any=continue,
      x: 't,
    )
    : 't =>
  pick(
    deep_mapper({
      f_exp,
      f_pat,
      f_typ,
      f_tpat,
      f_rul,
      f_mod,
      f_sig,
      f_mpat,
      f_any,
    }),
    x,
  );

/* Collects a node's children in reverse; Any.children puts them in order. */
let children_folder: folder(list(any_t)) = {
  exp_t: (e, acc) => [Exp(e), ...acc],
  pat_t: (p, acc) => [Pat(p), ...acc],
  typ_t: (t, acc) => [Typ(t), ...acc],
  tpat_t: (tp, acc) => [TPat(tp), ...acc],
  rul_t: (r, acc) => [Rul(r), ...acc],
  mod_t: (m, acc) => [Mod(m), ...acc],
  sig_t: (s, acc) => [Sig(s), ...acc],
  mpat_t: (mp, acc) => [MPat(mp), ...acc],
  any_t: (a, acc) => [a, ...acc],
};

module Any = {
  [@deriving (show({with_path: false}), sexp, yojson)]
  type t = any_t;

  let map_term = map_term_at(m => m.any_t);

  /* The nodes directly under this one, in source order. Drv terms have their
     own traversal machinery in DrvTermBase, so they have no children here. */
  let children = (x: t): list(t) =>
    List.rev(
      switch (x) {
      | Exp(e) => Grammar.fold_children_exp_term(children_folder, e.term, [])
      | Pat(p) => Grammar.fold_children_pat_term(children_folder, p.term, [])
      | Typ(t) => fold_typ_term(children_folder, t.term, [])
      | TPat(tp) =>
        Grammar.fold_children_tpat_term(children_folder, tp.term, [])
      | Rul(r) => Grammar.fold_children_rul_term(children_folder, r.term, [])
      | Mod(m) => Grammar.fold_children_mod_term(children_folder, m.term, [])
      | Sig(s) => Grammar.fold_children_sig_term(children_folder, s.term, [])
      | MPat(mp) =>
        Grammar.fold_children_mpat_term(children_folder, mp.term, [])
      | Drv(_)
      | Any () => []
      },
    );

  /* Folds over x and every node under it, parents before children. */
  let rec fold = (x: t, ~init: 'acc, ~f: ('acc, t) => 'acc): 'acc =>
    List.fold(children(x), ~init=f(init, x), ~f=(acc, child) =>
      fold(child, ~init=acc, ~f)
    );

  /* x and every node under it, parents before children. */
  let subterms = (x: t): list(t) =>
    fold(x, ~init=[], ~f=(acc, y) => [y, ...acc]) |> List.rev;
};

module Exp = {
  [@deriving (show({with_path: false}), sexp, yojson)]
  type term = exp_term;
  [@deriving (show({with_path: false}), sexp, yojson)]
  type t = exp_t;
  [@deriving (show({with_path: false}), sexp, yojson)]
  type deferral_position = deferral_position_t;

  let map_term = map_term_at(m => m.exp_t);
};

module Pat = {
  [@deriving (show({with_path: false}), sexp, yojson)]
  type term = pat_term; // The second Typ.t field is only meaningful in dynamic patterns
  [@deriving (show({with_path: false}), sexp, yojson)]
  type t = pat_t;

  let map_term = map_term_at(m => m.pat_t);
};

module Typ = {
  [@deriving (show({with_path: false}), sexp, yojson)]
  type term = typ_term;
  [@deriving (show({with_path: false}), sexp, yojson)]
  type t = typ_t;

  type sum_map = ConstructorMap.t(t);

  let map_term = map_term_at(m => m.typ_t);
};

module TPat = {
  [@deriving (show({with_path: false}), sexp, yojson)]
  type term = tpat_term;
  [@deriving (show({with_path: false}), sexp, yojson)]
  type t = tpat_t;

  let map_term = map_term_at(m => m.tpat_t);

  let tyvar_of_utpat = ({term, _}: t) =>
    switch (term) {
    | Var(x) => Some(x)
    | _ => None
    };
};

module Rul = {
  [@deriving (show({with_path: false}), sexp, yojson)]
  type term = rul_term;
  [@deriving (show({with_path: false}), sexp, yojson)]
  type t = rul_t;

  let map_term = map_term_at(m => m.rul_t);
};

module Mod = {
  [@deriving (show({with_path: false}), sexp, yojson)]
  type term = mod_term;
  [@deriving (show({with_path: false}), sexp, yojson)]
  type t = mod_t;

  let map_term = map_term_at(m => m.mod_t);
};

module Sig = {
  [@deriving (show({with_path: false}), sexp, yojson)]
  type term = sig_term;
  [@deriving (show({with_path: false}), sexp, yojson)]
  type t = sig_t;

  let map_term = map_term_at(m => m.sig_t);
};

module MPat = {
  [@deriving (show({with_path: false}), sexp, yojson)]
  type term = mpat_term;
  [@deriving (show({with_path: false}), sexp, yojson)]
  type t = mpat_t;

  let map_term = map_term_at(m => m.mpat_t);
};

module StepperFilterKind = {
  [@deriving (show({with_path: false}), sexp, yojson)]
  type t = stepper_filter_kind_t;

  let map = (mapper, filter: t): t => {
    switch (filter) {
    | Filter({act, pat}) =>
      Filter({
        act,
        pat: mapper(pat),
      })
    | Residue(idx, act) => Residue(idx, act)
    };
  };

  let map_term =
    map_term_at(m => Grammar.map_children_stepper_filter_kind_t(m));
};
