(include_subdirs unqualified)

(library
 (name b2t2)
 (libraries haz3lcore)
 (js_of_ocaml)
 (instrumentation
  (backend bisect_ppx))
 (preprocess
  (pps
   ppx_yojson_conv
   js_of_ocaml-ppx
   ppx_let
   ppx_blob
   ppx_sexp_conv
   ppx_enumerate
   ppx_deriving.show
   ppx_deriving.eq))
 (preprocessor_deps
  (file Datasheet.md)))

(env
 (dev
  (js_of_ocaml
   (flags :standard --debuginfo --noinline --dynlink --linkall --sourcemap)))
 (release
  (js_of_ocaml
   (flags :standard))))

; Generate B2T2 slide .ml files from .hz source files at build time
; All .hz source files and generated .ml targets are in the b2t2 root directory.
; With (include_subdirs unqualified), dune treats them all as top-level modules.

(rule
 (targets B2T2ExampleTables.ml)
 (deps
  (:gen %{project_root}/src/hazel_codegen/hazel_codegen.bc.js)
  (:src B2T2__Example_Tables.hz))
 (action
  (run
   node
   --stack-size=65536
   %{gen}
   "B2T2 / Example Tables"
   %{src}
   %{targets})))

(rule
 (targets B2T2ErrorsMalformedTables.ml)
