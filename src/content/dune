(library
 (name content)
 (libraries haz3lcore)
 (wrapped false)
 (preprocess
  (pps ppx_sexp_conv ppx_deriving.show)))

; Generate .ml slide files from .hz source files at build time
; The codegen tool parses .hz text and emits PersistentSegment.t records

(rule
 (targets ADTs.ml)
 (deps
  (:gen %{project_root}/src/hazel_codegen/hazel_codegen.bc.js)
  (:src ADTs.hz))
 (action
  (run node --stack-size=65536 %{gen} "ADTs" %{src} %{targets})))

(rule
 (targets BasicReference.ml)
