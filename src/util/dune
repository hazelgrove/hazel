(library
 (name util)
 ; SPIKE (wasm-eval-bench): BigIntWasmStub is swapped in over BigInt.re
 ; by bench/wasm/run.sh; it must not be compiled as its own module.
 (modules :standard \ BigIntWasmStub)
 (libraries ptmap bignum uuidm unionFind csv)
 (js_of_ocaml)
 (instrumentation
  (backend bisect_ppx))
 (preprocess
  (pps
   ppx_yojson_conv
   js_of_ocaml-ppx
   ppx_let
   ppx_sexp_conv
   ppx_deriving.show
   ppx_deriving.eq)))

(env
 (dev
  (js_of_ocaml
   (flags :standard --debuginfo --noinline --dynlink --linkall --sourcemap)))
 (release
  (js_of_ocaml
   (flags :standard))))
