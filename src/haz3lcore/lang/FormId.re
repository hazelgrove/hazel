/* FormId names every syntactic form in the grammar. The type
 * declarations for atomic_form, drv_compound_form, and compound_form
 * live here (moved from Form.re) and are re-exported by Form via
 * `include FormId`, so `Form.compound_form`, bare constructors, and
 * `all_of_compound_form` keep resolving. This module is a leaf:
 * it may depend only on Sort, Token, and Util. The label/mold lookup
 * and classification tables (which need Mold) live in Form.re. */

/* B. Operands:
   Order in this type determines relative remolding
   priority for forms with overlapping regexps */

[@deriving (show({with_path: false}), sexp, yojson, eq, enumerate)]
type atomic_form =
  | Var
  | DrvVar
  | ExplicitHole
  | ImplicitHoleMarker
  | LLMHole
  | Wild
  | String
  | QuotedLabel
  | IntLit
  | FloatLit
  | BoolLit
  | LivelitName
  | ProjectorInvoke
  | UndefinedLit
  | EmptyList
  | EmptyTuple
  | EmptyModule
  | Deferral
  | ExplicitNonlabel
  | TyVar
  | TyVarP
  | Ctr
  | MPatName
  | Type
  | InfixDelimiterPrefix;

/* C. Compound Forms:
   Order in this type determines relative remolding
   priority for forms which share the same labels
   A list of all possible compound_forms is automatically
   generated by @deriving enumerate */

[@deriving (show({with_path: false}), sexp, yojson, eq, enumerate)]
type drv_compound_form =
  // Interface to normal forms
  | OfProp
  | OfCtx
  | OfJdmt
  | OfAlfaExp
  | OfAlfaTyp
  | OfAlfaPat
  | OfAlfaTPat
  // Formula (only for pretty printing)
  | Subst
  | SubstTy
  | Glb
  // Judgments
  | Val
  | Eval
  | Entail
  | UnaryEntail
  | Consistent
  | MatchedArrow
  | MatchedProd
  | MatchedSum
  // Proposition
  | Valid
  | HasType
  | Syn
  | Ana
  | And
  | Or
  | Impl
  | Not
  // Ctx
  | Cons
  | Concat
  | List
  // Exp
  | Neg
  | Plus
  | Minus
  | Times
  | Eq
  | Lt
  | Gt
  | If
  | Let
  | Fix
  | Fun
  | Dot
  | Case
  | Rule
  // Pat
  | Cast
  // Typ
  | Arrow
  | Prod
  | Sum
  | Rec
  // Shared
  | ApExpEmpty
  | ApExp
  | ApPat
  | CommaExp
  | CommaPat
  | ParenProp
  | ParenExp
  | ParenPat
  | ParenTyp;

[@deriving (show({with_path: false}), sexp, yojson, eq, enumerate)]
type compound_form =
  // INFIX OPERATORS
  | TypeArrow
  | CellJoin
  | Plus
  | Minus
  | Times
  | Power
  | FPower
  | Divide
  | Equals
  | StringConcat
  | Lt
  | Gt
  | NotEquals
  | Gte
  | Lte
  | FPlus
  | FMinus
  | FTimes
  | FDivide
  | FEquals
  | FLt
  | FGt
  | FNotEquals
  | FGte
  | FLte
  | LogicalAnd
  | LogicalOrLegacy
  | LogicalOr
  | ListConcat
  | ConsExp
  | ConsPat
  | Typeann
  | TupleLabeledExp
  | TupleLabeledPat
  | TupleLabeledTyp
  | DotExp
  | TupleExtension
  | DotTyp
  | TypeAsc
  | TypPlus
  | ProdProjection
  | ProdExtension
  // UNARY PREFIX OPERATORS
  | Not
  | TypSumSingle
  | UnaryMinus
  // N-ARY OPS (on the semantics level)
  | CommaExp
  | CommaPat
  | CommaTyp
  // PAIRED DELIMITERS:
  | ListLitExp
  | ListLitPat
  | ListTyp
  //NOTE(andrew): parens being below aps is load-bearing, unfortunately
  | ParensExp
  | ParensPat
  | ParensTyp
  | ParensTPat
  | ApExpEmpty
  | ApExp
  | ApPatEmpty
  | ApPat
  | ApTyp
  | ApExpTyp
  | Case
  | Test
  | ProofOf
  | ProofObject
  | HintedTest
  | Fun
  | Fix
  | TypFun
  | Poly
  | Forall
  | Rec
  | Rule
  | Pipeline
  // DOUBLE DELIMITERS
  | FilterHide
  | FilterEval
  | FilterPause
  | FilterDebug
  | Use
  // Drv
  | Drv(drv_compound_form)
  // TRIPLE DELIMITERS
  | Let
  | Theorem
  | TypeAlias
  | If
  // MODULE FORMS
  | ModBody
  | ModSeq
  | ModLet
  | ModType
  // MODULE KEYWORD FORMS
  | ModuleExp
  | ModuleMod
  | MPatTypeann
  // SIGNATURE FORMS
  | SigBody
  | SigSeq
  | SigLet
  | SigType;

/* A form identity: a specific registered form (compound or classified
 * atomic), or one of the two Any-fallback classes replicating
 * Form.Molds.get's behavior for labels that fail to mold:
 * - Unsorted(cf): the label IS registered (cf = first form with that
 *   label) but no registered mold matches the requested sort;
 * - Unmolded(t): the token matches no registered form at all. */
[@deriving (show({with_path: false}), sexp, yojson, eq)]
type t =
  | Form(compound_form)
  | Unsorted(compound_form)
  | Atom(atomic_form, Sort.t, Token.t)
  | Unmolded(Token.t);
