/* As a CSS url(), percent-encoding the few characters a data URI in a
   double-quoted url() cannot carry as they are. */
let css_url = (svg: string): string => {
  let b = Buffer.create(String.length(svg) + 64);
  String.iter(
    c =>
      switch (c) {
      | '%' => Buffer.add_string(b, "%25")
      | '#' => Buffer.add_string(b, "%23")
      | '<' => Buffer.add_string(b, "%3C")
      | '>' => Buffer.add_string(b, "%3E")
      | '"' => Buffer.add_string(b, "%22")
      | '\n' => Buffer.add_string(b, "%0A")
      | c => Buffer.add_char(b, c)
      },
    svg,
  );
  "url(\"data:image/svg+xml," ++ Buffer.contents(b) ++ "\")";
};

let shut = css_url(shut_svg);
let open_ = css_url(open_svg);
