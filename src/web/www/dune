(rule
 (copy ../main.bc.js hazel.js))

(rule
 (copy ../worker.bc.js worker.js))

(rule
 (targets bundled.js)
 (deps prebundle.js)
 (action
  (run
   %{project_root}/node_modules/esbuild/bin/esbuild
   prebundle.js
   --bundle
   --outfile=bundled.js)))

; Z3, which the proof checker verifies algebra steps with. The page and
; the worker fetch these at the first such step, so they are served beside
; the scripts that load them. z3.js starts Z3 through a promise, for the
; page; z3-sync.js starts it synchronously, for the worker.

(rule
 (copy %{project_root}/node_modules/hazel-z3/z3.js z3.js))

(rule
 (copy %{project_root}/node_modules/hazel-z3/z3-sync.js z3-sync.js))

(rule
 (copy %{project_root}/node_modules/hazel-z3/z3.wasm z3.wasm))
