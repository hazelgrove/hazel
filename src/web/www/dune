(rule
 (copy ../main.bc.js hazel.js))

(rule
 (copy ../worker.bc.js worker.js))

; the baked library and its source, loaded at boot (StdlibServed)

(rule
 (copy ../../stdlib/stdlib.blob stdlib.blob))

(rule
 (copy ../../stdlib/stdlib.hz stdlib.hz))

(rule
 (targets bundled.js)
 (deps prebundle.js)
 (action
  (run
   %{project_root}/node_modules/esbuild/bin/esbuild
   prebundle.js
   --bundle
   --outfile=bundled.js)))
