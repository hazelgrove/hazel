(rule
 (copy ../main.bc.js hazel.js))

(rule
 (copy ../worker.bc.js worker.js))

(rule
 (targets bundled.js)
 (deps prebundle.js)
 (action
  (run
   %{project_root}/node_modules/esbuild/bin/esbuild
   prebundle.js
   --bundle
   --outfile=bundled.js)))

(rule
 (targets worker-algebrite.js)
 (deps workerprelude.js)
 (action
  (run
   %{project_root}/node_modules/esbuild/bin/esbuild
   workerprelude.js
   --bundle
   --outfile=worker-algebrite.js)))
