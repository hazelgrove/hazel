  (pps js_of_ocaml-ppx)))

; Example-module exporter: rewrites the example exercise modules in the
; shipped persistent format (serialized zipper sexp + backup_text, decoded
; via *.of_persistent at startup — no re-parse). The string-based
; "transitionary" format remains the migration interchange format.
; Run under node; see scripts/README_migrate_tile_format.md.

(executable
 (name migrate_exercises)
 (modules Migrate_exercises)
 (libraries ppx_yojson_conv.expander web)
 (modes js)
 (preprocess
  (pps
   ppx_yojson_conv
   js_of_ocaml-ppx
   ppx_let
   ppx_sexp_conv
   ppx_deriving.show
   bonsai.ppx_bonsai)))

; Slide migrator (tile-datatype Phase 1m): decodes the OLD-format segment
; sexps embedded in the slide .ml files via LegacyBase, upgrades them
; id-preservingly to the FormId representation, and re-emits the files.
; Run under node; see scripts/README_migrate_tile_format.md.

(executable
 (name migrate_slides)
 (modules Migrate_slides LegacyBase LegacyBaseV1)
 (libraries ppx_yojson_conv.expander haz3lcore b2t2 web)
 (modes js)
 (preprocess
  (pps
   ppx_yojson_conv
   js_of_ocaml-ppx
   ppx_let
   ppx_sexp_conv
   ppx_deriving.show
   bonsai.ppx_bonsai)))

(env
 (dev
  (js_of_ocaml
   (flags :standard --debuginfo --noinline --dynlink --linkall --sourcemap)))
 (release
  (js_of_ocaml
   (flags (:standard)))))
