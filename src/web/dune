; Migration exporter: rewrites zipper-embedding example modules as
; "transitionary" (string-based) modules that survive Zipper.t datatype
; changes. Run under node; see scripts/README_migrate_tile_format.md.

(executable
 (name migrate_exercises)
 (modules Migrate_exercises)
 (libraries ppx_yojson_conv.expander web)
 (modes js)
 (preprocess
  (pps
   ppx_yojson_conv
   js_of_ocaml-ppx
   ppx_let
   ppx_sexp_conv
   ppx_deriving.show
   bonsai.ppx_bonsai)))

(env
 (dev
  (js_of_ocaml
   (flags :standard --debuginfo --noinline --dynlink --linkall --sourcemap)))
 (release
  (js_of_ocaml
   (flags (:standard)))))
