; The commit a build is from: GITHUB_SHA on GitHub's runners, so a deploy
; carries its commit, and "local" elsewhere. Hazel.build in hazel-lib.js, and
; the build in embed mode's ready message, so a page can tell whether the two
; came from one build.

(rule
 (targets BuildStamp.ml)
 (action
  (with-stdout-to
   BuildStamp.ml
   (echo "let commit = \"%{env:GITHUB_SHA=local}\"\n"))))

(library
 (name buildStamp)
 (modules BuildStamp)
 (js_of_ocaml))

; Hazel as a JS library (a draft): window.Hazel, to analyze and run programs
; from any page. Served as www/hazel-lib.js. See HazelLib.re.

(library
 (name hazelLibCore)
 (modules HazelLibCore)
 (libraries haz3lcore language buildStamp)
 (js_of_ocaml)
 (preprocess
  (pps js_of_ocaml-ppx)))

(executable
 (name hazelLib)
 (modules HazelLib)
 (libraries hazelLibCore)
 (modes js)
 (preprocess
  (pps js_of_ocaml-ppx)))

; Example-module exporter (dev tool, not shipped): regenerates the example
; exercise modules' persistent literals. Run under node; see the header of
; Migrate_exercises.re.

(executable
 (name migrate_exercises)
 (modules Migrate_exercises)
 (libraries ppx_yojson_conv.expander web)
 (modes js)
 (preprocess
  (pps
   ppx_yojson_conv
   js_of_ocaml-ppx
   ppx_let
   ppx_sexp_conv
   ppx_deriving.show
   bonsai.ppx_bonsai)))

(env
 (dev
  (js_of_ocaml
   (flags :standard --debuginfo --noinline --dynlink --linkall --sourcemap)))
 (release
  (js_of_ocaml
   (flags (:standard)))))
