let find_node_by_id : [JSON] -> String -> JSON =
fun node_list -> fun wanted_id ->
  case node_list
  | [] => Null
  | node::rest =>
    case jq1([jq_field("id")])(node)
    | String(node_id) =>
      if node_id == wanted_id
      then node
      else find_node_by_id(rest)(wanted_id)
    | _ => find_node_by_id(rest)(wanted_id)
    end
  end
in

let get_int_or : JSON -> Int -> Int =
fun json -> fun fallback ->
  case json
  | Int(n) => n
  | _ => fallback
  end
in

let sum_arc_weight : [JSON] -> String -> String -> Int =
fun arc_list -> fun source_id -> fun target_id ->
  case arc_list
  | [] => 0
  | arc::rest =>
    let arc_source =
      case jq1([jq_field("source")])(arc)
      | String(s) => s
      | _ => ""
      end
    in
    let arc_target =
      case jq1([jq_field("target")])(arc)
      | String(t) => t
      | _ => ""
      end
    in
    let arc_weight =
      get_int_or(
        jq1([jq_field("data"), jq_field("tokenWeights"), jq_field("default")])(arc)
      )(1)
    in
    if arc_source == source_id && arc_target == target_id
    then arc_weight + sum_arc_weight(rest)(source_id)(target_id)
    else sum_arc_weight(rest)(source_id)(target_id)
  end
in

let vector_ge : [Int] -> [Int] -> Bool =
fun xs -> fun ys ->
  case (xs, ys)
  | ([], []) => true
  | (x::xt, y::yt) => x >= y && vector_ge(xt)(yt)
  | _ => false
  end
in

let vector_add : [Int] -> [Int] -> [Int] =
fun xs -> fun ys ->
  case (xs, ys)
  | ([], []) => []
  | (x::xt, y::yt) => (x + y)::vector_add(xt)(yt)
  | _ => []
  end
in

let vector_sub : [Int] -> [Int] -> [Int] =
fun xs -> fun ys ->
  case (xs, ys)
  | ([], []) => []
  | (x::xt, y::yt) => (x - y)::vector_sub(xt)(yt)
  | _ => []
  end
in

let fire : [Int] -> [Int] -> [Int] -> [Int] =
fun marking -> fun pre -> fun post ->
  vector_add(vector_sub(marking)(pre))(post)
in

let has_marking : [[Int]] -> [Int] -> Bool =
fun seen -> fun marking ->
  case seen
  | [] => false
  | m::rest =>
    if m == marking
    then true
    else has_marking(rest)(marking)
  end
in

let step_transitions : [(String, [Int], [Int])] -> [Int] -> [[Int]] -> [[Int]] -> ([[Int]], [[Int]]) =
fun ts -> fun current -> fun frontier -> fun seen ->
  case ts
  | [] => (frontier, seen)
  | (_tid, pre, post)::rest_ts =>
    if vector_ge(current)(pre)
    then
      let next_marking = fire(current)(pre)(post) in
      if has_marking(seen)(next_marking)
      then step_transitions(rest_ts)(current)(frontier)(seen)
      else step_transitions(rest_ts)(current)(next_marking::frontier)(next_marking::seen)
    else step_transitions(rest_ts)(current)(frontier)(seen)
  end
in

let reachability_bfs : [(String, [Int], [Int])] -> [[Int]] -> [[Int]] -> Int -> [[Int]] =
fun ts -> fun frontier -> fun seen -> fun budget ->
  if budget <= 0
  then seen
  else
    case frontier
    | [] => seen
    | current::rest_frontier =>
      let (new_frontier, new_seen) = step_transitions(ts)(current)(rest_frontier)(seen) in
      reachability_bfs(ts)(new_frontier)(new_seen)(budget - 1)
    end
in

let successors_in_set : [(String, [Int], [Int])] -> [[Int]] -> [Int] -> [[Int]] =
fun ts -> fun reachable -> fun current ->
  flat_map(ts, fun (_tid, pre, post) ->
    if vector_ge(current)(pre)
    then
      let next_marking = fire(current)(pre)(post) in
      if has_marking(reachable)(next_marking)
      then [next_marking]
      else []
    else []
  )
in

let filter_unseen : [[Int]] -> [[Int]] -> [[Int]] =
fun candidates -> fun visited ->
  filter(candidates, fun m -> !has_marking(visited)(m))
in

let path_exists : [(String, [Int], [Int])] -> [[Int]] -> [Int] -> [Int] -> [[Int]] -> [[Int]] -> Bool =
fun ts -> fun reachable -> fun target -> fun _start -> fun frontier -> fun visited ->
  case frontier
  | [] => false
  | current::rest =>
    if current == target
    then true
    else
      let nexts = filter_unseen(successors_in_set(ts)(reachable)(current))(visited) in
      path_exists(ts)(reachable)(target)(_start)(append(rest, nexts))(append(visited, nexts))
  end
in

let is_petri_reversible : JSON -> Bool =
fun petri_json ->
  let nodes = jq([jq_field("petriNetDefinition"), jq_field("nodes"), jq_iterate])(petri_json) in
  let arcs = jq([jq_field("petriNetDefinition"), jq_field("arcs"), jq_iterate])(petri_json) in
  let place_ids =
    flat_map(nodes, fun node ->
      case jq1([jq_field("type")])(node)
      | String("place") =>
        case jq1([jq_field("id")])(node)
        | String(pid) => [pid]
        | _ => []
        end
      | _ => []
      end
    )
  in
  let transition_ids =
    flat_map(nodes, fun node ->
      case jq1([jq_field("type")])(node)
      | String("transition") =>
        case jq1([jq_field("id")])(node)
        | String(tid) => [tid]
        | _ => []
        end
      | _ => []
      end
    )
  in
  let initial_marking =
    map(place_ids, fun pid ->
      let place_node = find_node_by_id(nodes)(pid) in
      get_int_or(
        jq1([jq_field("data"), jq_field("tokenCounts"), jq_field("default")])(place_node)
      )(0)
    )
  in
  let transitions =
    map(transition_ids, fun tid ->
      (
        tid,
        map(place_ids, fun pid -> sum_arc_weight(arcs)(pid)(tid)),
        map(place_ids, fun pid -> sum_arc_weight(arcs)(tid)(pid))
      )
    )
  in
  let reachable = reachability_bfs(transitions)([initial_marking])([initial_marking])(800) in
  for_all(
    reachable,
    fun m ->
      path_exists(transitions)(reachable)(initial_marking)(m)([m])([m])
  )
in

let reversible_example =
  Assoc([
    ("petriNetDefinition", Assoc([
      ("nodes", List([
        Assoc([
          ("id", String("p")),
          ("type", String("place")),
          ("data", Assoc([
            ("tokenCounts", Assoc([
              ("default", Int(1))
            ]))
          ]))
        ]),
        Assoc([
          ("id", String("t")),
          ("type", String("transition")),
          ("data", Assoc([]))
        ])
      ])),
      ("arcs", List([
        Assoc([
          ("source", String("p")),
          ("target", String("t")),
          ("data", Assoc([
            ("tokenWeights", Assoc([
              ("default", Int(1))
            ]))
          ]))
        ]),
        Assoc([
          ("source", String("t")),
          ("target", String("p")),
          ("data", Assoc([
            ("tokenWeights", Assoc([
              ("default", Int(1))
            ]))
          ]))
        ])
      ]))
    ]))
  ])
in

let not_reversible_example =
  Assoc([
    ("petriNetDefinition", Assoc([
      ("nodes", List([
        Assoc([
          ("id", String("p")),
          ("type", String("place")),
          ("data", Assoc([
            ("tokenCounts", Assoc([]))
          ]))
        ]),
        Assoc([
          ("id", String("q")),
          ("type", String("place")),
          ("data", Assoc([
            ("tokenCounts", Assoc([]))
          ]))
        ]),
        Assoc([
          ("id", String("t")),
          ("type", String("transition")),
          ("data", Assoc([]))
        ])
      ])),
      ("arcs", List([
        Assoc([
          ("source", String("p")),
          ("target", String("t")),
          ("data", Assoc([
            ("tokenWeights", Assoc([
              ("default", Int(1))
            ]))
          ]))
        ]),
        Assoc([
          ("source", String("t")),
          ("target", String("q")),
          ("data", Assoc([
            ("tokenWeights", Assoc([
              ("default", Int(1))
            ]))
          ]))
        ])
      ]))
    ]))
  ])
in

hint "1-token self-loop is reversible"
  test is_petri_reversible(reversible_example) == true end;

hint "one-way transfer net is not reversible"
  test is_petri_reversible(not_reversible_example) == false end;

is_petri_reversible(reversible_example)
