#!/usr/bin/env bash
set -u

# Autoformat the code being committed without touching anything that isn't
# staged:
#   - Fully staged files that the formatter fixes are re-staged, so the commit
#     picks up the formatting automatically.
#   - Partially staged files can't be re-staged safely (git add would sweep
#     the unstaged hunks into the commit), so if the formatter changes one of
#     those the commit is aborted and the developer resolves it.
#   - dune fmt formats the whole tree, not just the staged files. Committed
#     code is already formatted, so if the formatter changes a file that isn't
#     staged, either its behavior changed (e.g. a different ocamlformat or
#     refmt version) or the file has unformatted WIP. Either way the commit is
#     aborted so the developer sees it.
# `git commit --no-verify` bypasses this hook.

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# GUI commits (e.g. the VS Code Source Control panel) often run git without a
# login shell, so the opam switch environment may not be on PATH. The opam
# binary itself usually is, so bootstrap the environment from it if needed.
if ! command -v dune >/dev/null 2>&1 && command -v opam >/dev/null 2>&1; then
    eval "$(opam env 2>/dev/null)" >/dev/null 2>&1 || true
fi
if ! command -v dune >/dev/null 2>&1; then
    echo "[pre-commit] dune not found on PATH; skipping autoformat" >&2
    exit 0
fi

# Files with unstaged changes; a staged file also in this list is partially staged.
unstaged=$(git diff --name-only)
untracked=$(git ls-files --others --exclude-standard)

# Record the working-tree content of every file that already differs from the
# index, so we can tell exactly which files the formatter changes (a partially
# staged file already differs from the index, so "did it change?" has to be
# answered by content, not by diff). Any other tracked file matches the index,
# so the formatter changed it iff it shows up in `git diff` afterwards.
files=()
hashes=()
recorded=""
while IFS= read -r f; do
    [ -n "$f" ] && [ -e "$f" ] || continue
    files+=("$f")
    hashes+=("$(git hash-object -- "$f")")
    recorded+="$f"$'\n'
done < <(printf '%s\n%s\n%s\n' "$staged" "$unstaged" "$untracked" | sort -u)

echo "[pre-commit] dune fmt --auto-promote"
dune fmt --auto-promote || true

changed=""
for i in "${!files[@]}"; do
    f=${files[$i]}
    [ -e "$f" ] || continue
    [ "$(git hash-object -- "$f")" = "${hashes[$i]}" ] || changed+="$f"$'\n'
done
while IFS= read -r f; do
    [ -n "$f" ] || continue
    grep -qxF -- "$f" <<<"$recorded" || changed+="$f"$'\n'
done <<<"$(git diff --name-only)"

partial=""
not_staged=""
while IFS= read -r f; do
    [ -n "$f" ] || continue
    if ! grep -qxF -- "$f" <<<"$staged"; then
        not_staged+="  $f"$'\n'
    elif grep -qxF -- "$f" <<<"$unstaged"; then
        partial+="  $f"$'\n'
    else
        git add -- "$f"
    fi
done <<<"$changed"

[ -z "$partial" ] && [ -z "$not_staged" ] && exit 0

{
    echo "[pre-commit] Commit aborted."
    if [ -n "$not_staged" ]; then
        echo "The formatter changed file(s) that aren't staged:"
        printf '%s' "$not_staged"
        echo "Committed code is already formatted, so either dune fmt now formats"
        echo "differently (e.g. a different ocamlformat or refmt version than the"
        echo "codebase was formatted with) or these files have unformatted edits"
        echo "of yours. The formatter's changes are in your working tree; check"
        echo "them with git diff before committing again."
    fi
    if [ -n "$partial" ]; then
        echo "The formatter changed partially staged file(s):"
        printf '%s' "$partial"
        echo "Re-staging them automatically would also stage your unstaged edits."
        echo "The formatting fixes are now in your working tree (unstaged). Either:"
        echo "  - fully stage the file (git add <file>) and commit again,"
        echo "  - stage just the formatting hunks (git add -p) and commit again, or"
        echo "  - git commit --no-verify if the staged portion is already formatted."
    fi
} >&2
exit 1
