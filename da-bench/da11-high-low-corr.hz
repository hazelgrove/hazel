# DA-Bench id 11: Pearson r of High Price vs Low Price + significance class, GODREJIND.csv. #
let data = ^^csv("GODREJIND.csv") in
let pairs =
  filter(zip(map(data, fun r -> r.`High Price`), map(data, fun r -> r.`Low Price`)),
    fun (a, b) -> (string_trim(a) != "") && (string_trim(b) != "")) in
let xs = map(pairs, fun (a, _b) -> float_of_string(string_trim(a))) in
let ys = map(pairs, fun (_a, b) -> float_of_string(string_trim(b))) in
let r = pearson(xs, ys) in
let p = pearson_p(r, length(pairs)) in
(correlation_coefficient = round2(r),
 relationship_type = if p <. 0.05 then (if abs_float(r) >=. 0.5 then "linear" else "nonlinear") else "none")
