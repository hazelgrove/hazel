# DA-Bench id 70: predict wage from 12 features, beauty and the labor market.csv. 70/30 #
# train_test_split(random_state=42) via the prelude RNG, multiple linear regression (olsk) on the #
# training split, RMSE on the test split #
let data = ^^csv("beauty and the labor market.csv") in
let f1 = num(map(data, fun r -> r.`exper`)) in
let f2 = num(map(data, fun r -> r.`looks`)) in
let f3 = num(map(data, fun r -> r.`union`)) in
let f4 = num(map(data, fun r -> r.`goodhlth`)) in
let f5 = num(map(data, fun r -> r.`black`)) in
let f6 = num(map(data, fun r -> r.`female`)) in
let f7 = num(map(data, fun r -> r.`married`)) in
let f8 = num(map(data, fun r -> r.`south`)) in
let f9 = num(map(data, fun r -> r.`bigcity`)) in
let f10 = num(map(data, fun r -> r.`smllcity`)) in
let f11 = num(map(data, fun r -> r.`service`)) in
let f12 = num(map(data, fun r -> r.`educ`)) in
let y = num(map(data, fun r -> r.`wage`)) in
let n = length(y) in
let perm = perm_list(n, ^^seed(42)) in
let nt = tts_n_test(0.3, n) in
let tr = drop(perm, nt) in
let te = take(perm, nt) in
let trees = map([f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12], (fun (c) -> abuildf(c, n))) in
let trcols = map(trees, (fun (t) -> gather_f(t, tr, n))) in
let tecols = map(trees, (fun (t) -> gather_f(t, te, n))) in
let yT = abuildf(y, n) in
let tr_y = gather_f(yT, tr, n) in
let te_y = gather_f(yT, te, n) in
let (b0, beta) = olsk(trcols, tr_y) in
let yhat = predict(b0, beta, tecols) in
(RMSE = round2(sqrt(mean(map(zip(te_y, yhat), (fun (yi, yh) -> (yi -. yh) *. (yi -. yh)))))))
