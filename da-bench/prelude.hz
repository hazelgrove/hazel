# DA-Bench shared prelude. Concatenated in front of each solution (run.sh), #
# so the solution expression becomes the body of these let-bindings. #
let sum = fun (xs: [Float]) -> fold_left(xs, fun (acc, x) -> acc +. x, 0.0) in
let mean = fun (xs: [Float]) -> sum(xs) /. float_of_int(length(xs)) in
let pop_std = fun (xs: [Float]) ->
  let m = mean(xs) in sqrt(mean(map(xs, fun x -> (x -. m) *. (x -. m))))
in
let sample_std = fun (xs: [Float]) ->
  let m = mean(xs) in
  let n = float_of_int(length(xs)) in
  sqrt(sum(map(xs, fun x -> (x -. m) *. (x -. m))) /. (n -. 1.0))
in
let cmp = fun (a, b) -> if a <. b then Lt else if a >. b then Gt else Eq in
let median = fun (xs: [Float]) ->
  let s = sort(cmp, xs) in
  let n = length(xs) in
  let h = n / 2 in
  if int_mod(n, 2) == 1 then nth(s, h) else (nth(s, h - 1) +. nth(s, h)) /. 2.0
in
# linear-interpolated quantile (numpy/pandas default); xs must be sorted #
let quantile = fun (xs: [Float], q: Float) ->
  let n = length(xs) in
  let pos = q *. float_of_int(n - 1) in
  let lo = int_of_float(floor(pos)) in
  let frac = pos -. floor(pos) in
  if lo + 1 < n then nth(xs, lo) +. frac *. (nth(xs, lo + 1) -. nth(xs, lo))
  else nth(xs, lo)
in
let pearson = fun (xs: [Float], ys: [Float]) ->
  let mx = mean(xs) in
  let my = mean(ys) in
  let pp = sum(map(zip(xs, ys), fun (x, y) -> (x -. mx) *. (y -. my))) in
  let sx = sum(map(xs, fun x -> (x -. mx) *. (x -. mx))) in
  let sy = sum(map(ys, fun y -> (y -. my) *. (y -. my))) in
  pp /. sqrt(sx *. sy)
in
# pandas .skew(): adjusted Fisher-Pearson standardized 3rd moment #
let skew = fun (xs: [Float]) ->
  let n = float_of_int(length(xs)) in
  let m = mean(xs) in
  let s = sample_std(xs) in
  let acc = sum(map(xs, fun x -> let c = (x -. m) /. s in c *. c *. c)) in
  n /. ((n -. 1.0) *. (n -. 2.0)) *. acc
in
# scipy.stats.kurtosis default: Fisher (excess), biased (population) g2 #
let kurtosis = fun (xs: [Float]) ->
  let n = float_of_int(length(xs)) in
  let m = mean(xs) in
  let m2 = sum(map(xs, fun x -> let d = x -. m in d *. d)) /. n in
  let m4 = sum(map(xs, fun x -> let d = x -. m in d *. d *. d *. d)) /. n in
  m4 /. (m2 *. m2) -. 3.0
in
# scipy.stats.skew default: biased (population) Fisher-Pearson g1 = m3 / m2^1.5 #
let skew_pop = fun (xs: [Float]) ->
  let m = mean(xs) in
  let m2 = mean(map(xs, fun x -> let d = x -. m in d *. d)) in
  let m3 = mean(map(xs, fun x -> let d = x -. m in d *. d *. d)) in
  m3 /. (m2 *. sqrt(m2))
in
# Pearson's second/median skewness coefficient: 3(mean - median)/std (sample) #
let pearson_skew = fun (xs: [Float]) ->
  3.0 *. (mean(xs) -. median(xs)) /. sample_std(xs)
in
let round0 = fun (x: Float) -> round(x) in
let round1 = fun (x: Float) -> round(x *. 10.0) /. 10.0 in
let round2 = fun (x: Float) -> round(x *. 100.0) /. 100.0 in
let round3 = fun (x: Float) -> round(x *. 1000.0) /. 1000.0 in
let round4 = fun (x: Float) -> round(x *. 10000.0) /. 10000.0 in
let fmax = fun (xs: [Float]) -> fold_left(tail(xs), fun (a, x) -> if x >. a then x else a, head(xs)) in
let fmin = fun (xs: [Float]) -> fold_left(tail(xs), fun (a, x) -> if x <. a then x else a, head(xs)) in
# count of values whose population z-score exceeds threshold in magnitude #
let count_z_out = fun (xs: [Float], thresh: Float) ->
  let m = mean(xs) in
  let s = pop_std(xs) in
  length(filter(xs, fun x -> abs_float((x -. m) /. s) >. thresh))
in
# count of IQR (1.5) outliers; uses linear-interpolated Q1/Q3 #
let count_iqr_out = fun (xs: [Float]) ->
  let s = sort(cmp, xs) in
  let q1 = quantile(s, 0.25) in
  let q3 = quantile(s, 0.75) in
  let iqr = q3 -. q1 in
  let lo = q1 -. 1.5 *. iqr in
  let hi = q3 +. 1.5 *. iqr in
  length(filter(xs, fun x -> (x <. lo) || (x >. hi)))
in
# distinct string values, preserving first-seen order #
let distinct = fun (xs: [String]) ->
  fold_left(xs, fun (acc, x) -> if fold_left(acc, fun (f, a) -> f || (a == x), false) then acc else acc @ [x], [])
in
# insert s into an ascending-sorted, distinct list, dropping it if already present #
let insert_sorted_uniq = fun (acc: [String], s: String) ->
  case acc
  | [] => [s]
  | (y :: rest) =>
    case string_compare(s, y)
    | Lt => s :: y :: rest
    | Eq => acc
    | Gt => y :: insert_sorted_uniq(rest, s)
    end
  end
in
# distinct strings, returned in ascending sorted order (insertion sort, no dups). #
# Accumulator only grows to the distinct count, so this is practical for the #
# low-cardinality columns where the O(n^2) `distinct` above is too slow. #
let distinct_strings = fun (xs: [String]) ->
  fold_left(xs, fun (acc, x) -> insert_sorted_uniq(acc, x), [])
in
let count_eq = fun (xs: [String], v: String) -> length(filter(xs, fun s -> s == v)) in
# Pearson r over two String columns, dropping rows where either cell is blank #
let corr_cols = fun (a: [String], b: [String]) ->
  let pairs = filter(zip(a, b), fun (x, y) -> (string_trim(x) != "") && (string_trim(y) != "")) in
  pearson(map(pairs, fun (x, _y) -> float_of_string(string_trim(x))),
          map(pairs, fun (_x, y) -> float_of_string(string_trim(y))))
in
let num = fun (col: [String]) ->
  col |> map(_, string_trim) |> filter(_, fun s -> s != "") |> map(_, float_of_string)
in
# remove thousands-separator commas from a string (e.g. "5,350,380" -> "5350380") #
let strip_commas = fun (s: String) -> fold_left(string_split(",", s), fun (a, p) -> a ++ p, "") in
# like num, but tolerant of comma thousands separators #
let num_commas = fun (col: [String]) ->
  col |> map(_, string_trim) |> filter(_, fun s -> s != "") |> map(_, fun s -> float_of_string(strip_commas(s)))
in
# value cells (as strings) from `vals` for rows where `keys` cell trims to k #
let col_where = fun (keys: [String], vals: [String], k: String) ->
  filter(zip(keys, vals), fun (a, _b) -> string_trim(a) == k) |> map(_, fun (_a, b) -> b)
in
# like num, but also drops cells that are not numeric (e.g. a stray label) #
let num_loose = fun (col: [String]) ->
  col |> map(_, string_trim) |> filter(_, fun s -> string_match("^[0-9]", s)) |> map(_, float_of_string)
in
# messy numeric cell: leading number before any bracket, commas dropped #
let clean_num1 = fun (s: String) -> float_of_string(strip_commas(string_trim(nth(string_split("[", s), 0)))) in
let num_clean = fun (col: [String]) ->
  col |> map(_, string_trim) |> filter(_, fun s -> s != "") |> map(_, clean_num1)
in
# Pearson r over two messy-numeric String columns, dropping blank-paired rows #
let corr_clean = fun (a: [String], b: [String]) ->
  let pairs = filter(zip(a, b), fun (x, y) -> (string_trim(x) != "") && (string_trim(y) != "")) in
  pearson(map(pairs, fun (x, _y) -> clean_num1(x)), map(pairs, fun (_x, y) -> clean_num1(y)))
in
# join a list of strings with a separator #
let join_with = fun (sep: String, xs: [String]) ->
  if length(xs) == 0 then ""
  else fold_left(tail(xs), fun (a, p) -> a ++ sep ++ p, head(xs))
in
# Python-style float repr: string_of_float renders integer-valued floats as "6.", #
# so append a "0" after a trailing dot to get "6.0" (matches Python's repr). #
let py_float = fun (x: Float) ->
  let s = string_of_float(x) in
  let n = string_length(s) in
  if string_sub(s, n - 1, 1) == "." then s ++ "0" else s
in
# format parallel key/value-string lists as a Python dict literal: {'k': v, ...} #
let py_dict = fun (keys: [String], vals: [String]) ->
  "{" ++ join_with(", ", map(zip(keys, vals), fun (k, v) -> "'" ++ k ++ "': " ++ v)) ++ "}"
in
# format a labeled tuple as a Python dict literal; show_val stringifies each value, #
# e.g. dict_of_tuple(string_of_int, (a=1, b=2)) = "{'a': 1, 'b': 2}". #
let dict_of_tuple = fun (show_val, t) ->
  "{"
  ++ join_with(", ", map(to_lvs(t), fun lv -> "'" ++ lv.label ++ "': " ++ show_val(lv.value)))
  ++ "}"
in
# ---- Phase 5: special functions for hypothesis-test p-values (pure numerics) ---- #
# error function (Abramowitz and Stegun 7.1.26), |err| < 1.5e-7 #
let erf = fun (x: Float) ->
  let z = abs_float(x) in
  let t = 1.0 /. (1.0 +. 0.3275911 *. z) in
  let poly = t *. (0.254829592 +. t *. ((0.0 -. 0.284496736) +. t *. (1.421413741 +. t *. ((0.0 -. 1.453152027) +. t *. 1.061405429)))) in
  let y = 1.0 -. poly *. exp(0.0 -. z *. z) in
  if x <. 0.0 then 0.0 -. y else y
in
# standard normal CDF #
let normal_cdf = fun (z: Float) -> 0.5 *. (1.0 +. erf(z /. sqrt(2.0))) in
# log-gamma via Lanczos (g=7) #
let lgamma = fun (x0: Float) ->
  let x = x0 -. 1.0 in
  let a = 0.99999999999980993
    +. 676.5203681218851 /. (x +. 1.0)
    +. (0.0 -. 1259.1392167224028) /. (x +. 2.0)
    +. 771.32342877765313 /. (x +. 3.0)
    +. (0.0 -. 176.61502916214059) /. (x +. 4.0)
    +. 12.507343278686905 /. (x +. 5.0)
    +. (0.0 -. 0.13857109526572012) /. (x +. 6.0)
    +. 0.0000099843695780195716 /. (x +. 7.0)
    +. 0.00000015056327351493116 /. (x +. 8.0) in
  let t = x +. 7.5 in
  0.5 *. log(2.0 *. 3.14159265358979323846) +. (x +. 0.5) *. log(t) -. t +. log(a)
in
# incomplete-beta continued fraction (Lentz), fixed 200 iterations #
let betacf = fun (a: Float, b: Float, x: Float) ->
  let qab = a +. b in let qap = a +. 1.0 in let qam = a -. 1.0 in
  let go = fun (m: Int, c: Float, d: Float, h: Float) ->
    if m > 200 then h
    else
      let m2 = float_of_int(2 * m) in
      let fm = float_of_int(m) in
      let aa1 = fm *. (b -. fm) *. x /. ((qam +. m2) *. (a +. m2)) in
      let d1 = 1.0 /. (1.0 +. aa1 *. d) in
      let c1 = 1.0 +. aa1 /. c in
      let h1 = h *. d1 *. c1 in
      let aa2 = (0.0 -. (a +. fm)) *. (qab +. fm) *. x /. ((a +. m2) *. (qap +. m2)) in
      let d2 = 1.0 /. (1.0 +. aa2 *. d1) in
      let c2 = 1.0 +. aa2 /. c1 in
      go(m + 1, c2, d2, h1 *. (d2 *. c2))
  in
  let d0 = 1.0 /. (1.0 -. qab *. x /. qap) in
  go(1, 1.0, d0, d0)
in
# regularized incomplete beta I_x(a, b) #
let betainc = fun (a: Float, b: Float, x: Float) ->
  if x <=. 0.0 then 0.0 else if x >=. 1.0 then 1.0
  else
    let bt = exp(lgamma(a +. b) -. lgamma(a) -. lgamma(b) +. a *. log(x) +. b *. log(1.0 -. x)) in
    if x <. (a +. 1.0) /. (a +. b +. 2.0)
    then bt *. betacf(a, b, x) /. a
    else 1.0 -. bt *. betacf(b, a, 1.0 -. x) /. b
in
# Student-t two-sided p-value for a t statistic with df degrees of freedom #
let t_sf2 = fun (t: Float, df: Float) -> betainc(df /. 2.0, 0.5, df /. (df +. t *. t)) in
# two-sided p-value for a Pearson r over n paired observations (scipy.stats.pearsonr) #
let pearson_p = fun (r: Float, n: Int) ->
  let df = float_of_int(n - 2) in
  t_sf2(r *. sqrt(df /. (1.0 -. r *. r)), df)
in
# independent two-sample t-test, pooled variance (scipy.stats.ttest_ind), two-sided p #
let ttest_ind_p = fun (xs: [Float], ys: [Float]) ->
  let n1 = float_of_int(length(xs)) in
  let n2 = float_of_int(length(ys)) in
  let m1 = mean(xs) in
  let m2 = mean(ys) in
  let v1 = sum(map(xs, fun x -> (x -. m1) *. (x -. m1))) /. (n1 -. 1.0) in
  let v2 = sum(map(ys, fun y -> (y -. m2) *. (y -. m2))) /. (n2 -. 1.0) in
  let sp2 = ((n1 -. 1.0) *. v1 +. (n2 -. 1.0) *. v2) /. (n1 +. n2 -. 2.0) in
  t_sf2((m1 -. m2) /. sqrt(sp2 *. (1.0 /. n1 +. 1.0 /. n2)), n1 +. n2 -. 2.0)
in
# Welch two-sample t-test (scipy.stats.ttest_ind with equal_var=False), two-sided p #
let ttest_welch_p = fun (xs: [Float], ys: [Float]) ->
  let n1 = float_of_int(length(xs)) in
  let n2 = float_of_int(length(ys)) in
  let m1 = mean(xs) in
  let m2 = mean(ys) in
  let v1 = sum(map(xs, fun x -> (x -. m1) *. (x -. m1))) /. (n1 -. 1.0) in
  let v2 = sum(map(ys, fun y -> (y -. m2) *. (y -. m2))) /. (n2 -. 1.0) in
  let se2 = v1 /. n1 +. v2 /. n2 in
  let df = se2 *. se2 /. ((v1 /. n1) *. (v1 /. n1) /. (n1 -. 1.0) +. (v2 /. n2) *. (v2 /. n2) /. (n2 -. 1.0)) in
  t_sf2((m1 -. m2) /. sqrt(se2), df)
in
# D'Agostino-Pearson normality test p-value (scipy.stats.normaltest); K2 ~ chi2(2), p = exp(-K2/2) #
let normaltest_p = fun (xs: [Float]) ->
  let n = float_of_int(length(xs)) in
  let m = mean(xs) in
  let m2 = sum(map(xs, fun x -> let d = x -. m in d *. d)) /. n in
  let m3 = sum(map(xs, fun x -> let d = x -. m in d *. d *. d)) /. n in
  let m4 = sum(map(xs, fun x -> let d = x -. m in d *. d *. d *. d)) /. n in
  let b1 = m3 /. (m2 *. sqrt(m2)) in
  let b2 = m4 /. (m2 *. m2) in
  let y = b1 *. sqrt((n +. 1.0) *. (n +. 3.0) /. (6.0 *. (n -. 2.0))) in
  let beta2 = 3.0 *. (n *. n +. 27.0 *. n -. 70.0) *. (n +. 1.0) *. (n +. 3.0) /. ((n -. 2.0) *. (n +. 5.0) *. (n +. 7.0) *. (n +. 9.0)) in
  let w2 = (0.0 -. 1.0) +. sqrt(2.0 *. (beta2 -. 1.0)) in
  let delta = 1.0 /. sqrt(0.5 *. log(w2)) in
  let alpha = sqrt(2.0 /. (w2 -. 1.0)) in
  let ya = y /. alpha in
  let zs = delta *. log(ya +. sqrt(ya *. ya +. 1.0)) in
  let e = 3.0 *. (n -. 1.0) /. (n +. 1.0) in
  let varb2 = 24.0 *. n *. (n -. 2.0) *. (n -. 3.0) /. ((n +. 1.0) *. (n +. 1.0) *. (n +. 3.0) *. (n +. 5.0)) in
  let xx = (b2 -. e) /. sqrt(varb2) in
  let sb1 = 6.0 *. (n *. n -. 5.0 *. n +. 2.0) /. ((n +. 7.0) *. (n +. 9.0)) *. sqrt(6.0 *. (n +. 3.0) *. (n +. 5.0) /. (n *. (n -. 2.0) *. (n -. 3.0))) in
  let aa = 6.0 +. 8.0 /. sb1 *. (2.0 /. sb1 +. sqrt(1.0 +. 4.0 /. (sb1 *. sb1))) in
  let term1 = 1.0 -. 2.0 /. (9.0 *. aa) in
  let denom = 1.0 +. xx *. sqrt(2.0 /. (aa -. 4.0)) in
  let cr = exp(log((1.0 -. 2.0 /. aa) /. abs_float(denom)) /. 3.0) in
  let term2 = if denom <. 0.0 then 0.0 -. cr else cr in
  let zk = (term1 -. term2) /. sqrt(2.0 /. (9.0 *. aa)) in
  let k2 = zs *. zs +. zk *. zk in
  exp(0.0 -. k2 /. 2.0)
in
# Gregorian days since 1970-01-01 (Howard Hinnant's days_from_civil); pure integer math #
let days_civil = fun (y0: Int, mo: Int, d: Int) ->
  let y = if mo <= 2 then y0 - 1 else y0 in
  let era = (if y >= 0 then y else y - 399) / 400 in
  let yoe = y - era * 400 in
  let mp = if mo > 2 then mo - 3 else mo + 9 in
  let doy = (153 * mp + 2) / 5 + d - 1 in
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy in
  era * 146097 + doe - 719468
in
# 3-letter English month abbreviation -> 1..12 #
let monthnum = fun (m: String) ->
  if m == "Jan" then 1 else if m == "Feb" then 2 else if m == "Mar" then 3
  else if m == "Apr" then 4 else if m == "May" then 5 else if m == "Jun" then 6
  else if m == "Jul" then 7 else if m == "Aug" then 8 else if m == "Sep" then 9
  else if m == "Oct" then 10 else if m == "Nov" then 11 else 12
in
