# DA-Bench shared prelude. Concatenated in front of each solution (run.sh), #
# so the solution expression becomes the body of these let-bindings. #
let sum = fun (xs: [Float]) -> fold_left(xs, fun (acc, x) -> acc +. x, 0.0) in
let mean = fun (xs: [Float]) -> sum(xs) /. float_of_int(length(xs)) in
let pop_std = fun (xs: [Float]) ->
  let m = mean(xs) in sqrt(mean(map(xs, fun x -> (x -. m) *. (x -. m))))
in
let sample_std = fun (xs: [Float]) ->
  let m = mean(xs) in
  let n = float_of_int(length(xs)) in
  sqrt(sum(map(xs, fun x -> (x -. m) *. (x -. m))) /. (n -. 1.0))
in
let cmp = fun (a, b) -> if a <. b then Lt else if a >. b then Gt else Eq in
let median = fun (xs: [Float]) ->
  let s = sort(cmp, xs) in
  let n = length(xs) in
  let h = n / 2 in
  if int_mod(n, 2) == 1 then nth(s, h) else (nth(s, h - 1) +. nth(s, h)) /. 2.0
in
# linear-interpolated quantile (numpy/pandas default); xs must be sorted #
let quantile = fun (xs: [Float], q: Float) ->
  let n = length(xs) in
  let pos = q *. float_of_int(n - 1) in
  let lo = int_of_float(floor(pos)) in
  let frac = pos -. floor(pos) in
  if lo + 1 < n then nth(xs, lo) +. frac *. (nth(xs, lo + 1) -. nth(xs, lo))
  else nth(xs, lo)
in
let pearson = fun (xs: [Float], ys: [Float]) ->
  let mx = mean(xs) in
  let my = mean(ys) in
  let pp = sum(map(zip(xs, ys), fun (x, y) -> (x -. mx) *. (y -. my))) in
  let sx = sum(map(xs, fun x -> (x -. mx) *. (x -. mx))) in
  let sy = sum(map(ys, fun y -> (y -. my) *. (y -. my))) in
  pp /. sqrt(sx *. sy)
in
# pandas .skew(): adjusted Fisher-Pearson standardized 3rd moment #
let skew = fun (xs: [Float]) ->
  let n = float_of_int(length(xs)) in
  let m = mean(xs) in
  let s = sample_std(xs) in
  let acc = sum(map(xs, fun x -> let c = (x -. m) /. s in c *. c *. c)) in
  n /. ((n -. 1.0) *. (n -. 2.0)) *. acc
in
# scipy.stats.kurtosis default: Fisher (excess), biased (population) g2 #
let kurtosis = fun (xs: [Float]) ->
  let n = float_of_int(length(xs)) in
  let m = mean(xs) in
  let m2 = sum(map(xs, fun x -> let d = x -. m in d *. d)) /. n in
  let m4 = sum(map(xs, fun x -> let d = x -. m in d *. d *. d *. d)) /. n in
  m4 /. (m2 *. m2) -. 3.0
in
# scipy.stats.skew default: biased (population) Fisher-Pearson g1 = m3 / m2^1.5 #
let skew_pop = fun (xs: [Float]) ->
  let m = mean(xs) in
  let m2 = mean(map(xs, fun x -> let d = x -. m in d *. d)) in
  let m3 = mean(map(xs, fun x -> let d = x -. m in d *. d *. d)) in
  m3 /. (m2 *. sqrt(m2))
in
# Pearson's second/median skewness coefficient: 3(mean - median)/std (sample) #
let pearson_skew = fun (xs: [Float]) ->
  3.0 *. (mean(xs) -. median(xs)) /. sample_std(xs)
in
let round0 = fun (x: Float) -> round(x) in
let round1 = fun (x: Float) -> round(x *. 10.0) /. 10.0 in
let round2 = fun (x: Float) -> round(x *. 100.0) /. 100.0 in
let round3 = fun (x: Float) -> round(x *. 1000.0) /. 1000.0 in
let round4 = fun (x: Float) -> round(x *. 10000.0) /. 10000.0 in
let fmax = fun (xs: [Float]) -> fold_left(tail(xs), fun (a, x) -> if x >. a then x else a, head(xs)) in
let fmin = fun (xs: [Float]) -> fold_left(tail(xs), fun (a, x) -> if x <. a then x else a, head(xs)) in
# count of values whose population z-score exceeds threshold in magnitude #
let count_z_out = fun (xs: [Float], thresh: Float) ->
  let m = mean(xs) in
  let s = pop_std(xs) in
  length(filter(xs, fun x -> abs_float((x -. m) /. s) >. thresh))
in
# count of IQR (1.5) outliers; uses linear-interpolated Q1/Q3 #
let count_iqr_out = fun (xs: [Float]) ->
  let s = sort(cmp, xs) in
  let q1 = quantile(s, 0.25) in
  let q3 = quantile(s, 0.75) in
  let iqr = q3 -. q1 in
  let lo = q1 -. 1.5 *. iqr in
  let hi = q3 +. 1.5 *. iqr in
  length(filter(xs, fun x -> (x <. lo) || (x >. hi)))
in
# distinct string values, preserving first-seen order #
let distinct = fun (xs: [String]) ->
  fold_left(xs, fun (acc, x) -> if fold_left(acc, fun (f, a) -> f || (a == x), false) then acc else acc @ [x], [])
in
# insert s into an ascending-sorted, distinct list, dropping it if already present #
let insert_sorted_uniq = fun (acc: [String], s: String) ->
  case acc
  | [] => [s]
  | (y :: rest) =>
    case string_compare(s, y)
    | Lt => s :: y :: rest
    | Eq => acc
    | Gt => y :: insert_sorted_uniq(rest, s)
    end
  end
in
# distinct strings, returned in ascending sorted order (insertion sort, no dups). #
# Accumulator only grows to the distinct count, so this is practical for the #
# low-cardinality columns where the O(n^2) `distinct` above is too slow. #
let distinct_strings = fun (xs: [String]) ->
  fold_left(xs, fun (acc, x) -> insert_sorted_uniq(acc, x), [])
in
let count_eq = fun (xs: [String], v: String) -> length(filter(xs, fun s -> s == v)) in
# Pearson r over two String columns, dropping rows where either cell is blank #
let corr_cols = fun (a: [String], b: [String]) ->
  let pairs = filter(zip(a, b), fun (x, y) -> (string_trim(x) != "") && (string_trim(y) != "")) in
  pearson(map(pairs, fun (x, _y) -> float_of_string(string_trim(x))),
          map(pairs, fun (_x, y) -> float_of_string(string_trim(y))))
in
let num = fun (col: [String]) ->
  col |> map(_, string_trim) |> filter(_, fun s -> s != "") |> map(_, float_of_string)
in
# remove thousands-separator commas from a string (e.g. "5,350,380" -> "5350380") #
let strip_commas = fun (s: String) -> fold_left(string_split(",", s), fun (a, p) -> a ++ p, "") in
# like num, but tolerant of comma thousands separators #
let num_commas = fun (col: [String]) ->
  col |> map(_, string_trim) |> filter(_, fun s -> s != "") |> map(_, fun s -> float_of_string(strip_commas(s)))
in
# value cells (as strings) from `vals` for rows where `keys` cell trims to k #
let col_where = fun (keys: [String], vals: [String], k: String) ->
  filter(zip(keys, vals), fun (a, _b) -> string_trim(a) == k) |> map(_, fun (_a, b) -> b)
in
# like num, but also drops cells that are not numeric (e.g. a stray label) #
let num_loose = fun (col: [String]) ->
  col |> map(_, string_trim) |> filter(_, fun s -> string_match("^[0-9]", s)) |> map(_, float_of_string)
in
# messy numeric cell: leading number before any bracket, commas dropped #
let clean_num1 = fun (s: String) -> float_of_string(strip_commas(string_trim(nth(string_split("[", s), 0)))) in
let num_clean = fun (col: [String]) ->
  col |> map(_, string_trim) |> filter(_, fun s -> s != "") |> map(_, clean_num1)
in
# Pearson r over two messy-numeric String columns, dropping blank-paired rows #
let corr_clean = fun (a: [String], b: [String]) ->
  let pairs = filter(zip(a, b), fun (x, y) -> (string_trim(x) != "") && (string_trim(y) != "")) in
  pearson(map(pairs, fun (x, _y) -> clean_num1(x)), map(pairs, fun (_x, y) -> clean_num1(y)))
in
# join a list of strings with a separator #
let join_with = fun (sep: String, xs: [String]) ->
  if length(xs) == 0 then ""
  else fold_left(tail(xs), fun (a, p) -> a ++ sep ++ p, head(xs))
in
# Python-style float repr: string_of_float renders integer-valued floats as "6.", #
# so append a "0" after a trailing dot to get "6.0" (matches Python's repr). #
let py_float = fun (x: Float) ->
  let s = string_of_float(x) in
  let n = string_length(s) in
  if string_sub(s, n - 1, 1) == "." then s ++ "0" else s
in
# format parallel key/value-string lists as a Python dict literal: {'k': v, ...} #
let py_dict = fun (keys: [String], vals: [String]) ->
  "{" ++ join_with(", ", map(zip(keys, vals), fun (k, v) -> "'" ++ k ++ "': " ++ v)) ++ "}"
in
# format a labeled tuple as a Python dict literal; show_val stringifies each value, #
# e.g. dict_of_tuple(string_of_int, (a=1, b=2)) = "{'a': 1, 'b': 2}". #
let dict_of_tuple = fun (show_val, t) ->
  "{"
  ++ join_with(", ", map(to_lvs(t), fun lv -> "'" ++ lv.label ++ "': " ++ show_val(lv.value)))
  ++ "}"
in
# ---- Phase 5: special functions for hypothesis-test p-values (pure numerics) ---- #
# VERIFIED against real scipy 1.18.0 / pandas 3.0.3 (not just hand-derived constants): #
# pearson_p == scipy.stats.pearsonr (408: 0.0102), ttest_welch_p == ttest_ind(equal_var=False) #
# (419: 0.8463), normaltest_p == scipy.stats.normaltest (652: 1.5e-10->0.0, 729: 0.0), and #
# erf/lgamma/betainc match known reference values to printed precision. #
# error function (Abramowitz and Stegun 7.1.26), |err| < 1.5e-7 #
let erf = fun (x: Float) ->
  let z = abs_float(x) in
  let t = 1.0 /. (1.0 +. 0.3275911 *. z) in
  let poly = t *. (0.254829592 +. t *. ((0.0 -. 0.284496736) +. t *. (1.421413741 +. t *. ((0.0 -. 1.453152027) +. t *. 1.061405429)))) in
  let y = 1.0 -. poly *. exp(0.0 -. z *. z) in
  if x <. 0.0 then 0.0 -. y else y
in
# standard normal CDF #
let normal_cdf = fun (z: Float) -> 0.5 *. (1.0 +. erf(z /. sqrt(2.0))) in
# log-gamma via Lanczos (g=7) #
let lgamma = fun (x0: Float) ->
  let x = x0 -. 1.0 in
  let a = 0.99999999999980993
    +. 676.5203681218851 /. (x +. 1.0)
    +. (0.0 -. 1259.1392167224028) /. (x +. 2.0)
    +. 771.32342877765313 /. (x +. 3.0)
    +. (0.0 -. 176.61502916214059) /. (x +. 4.0)
    +. 12.507343278686905 /. (x +. 5.0)
    +. (0.0 -. 0.13857109526572012) /. (x +. 6.0)
    +. 0.0000099843695780195716 /. (x +. 7.0)
    +. 0.00000015056327351493116 /. (x +. 8.0) in
  let t = x +. 7.5 in
  0.5 *. log(2.0 *. 3.14159265358979323846) +. (x +. 0.5) *. log(t) -. t +. log(a)
in
# incomplete-beta continued fraction (Lentz), fixed 200 iterations #
let betacf = fun (a: Float, b: Float, x: Float) ->
  let qab = a +. b in let qap = a +. 1.0 in let qam = a -. 1.0 in
  let go = fun (m: Int, c: Float, d: Float, h: Float) ->
    if m > 200 then h
    else
      let m2 = float_of_int(2 * m) in
      let fm = float_of_int(m) in
      let aa1 = fm *. (b -. fm) *. x /. ((qam +. m2) *. (a +. m2)) in
      let d1 = 1.0 /. (1.0 +. aa1 *. d) in
      let c1 = 1.0 +. aa1 /. c in
      let h1 = h *. d1 *. c1 in
      let aa2 = (0.0 -. (a +. fm)) *. (qab +. fm) *. x /. ((a +. m2) *. (qap +. m2)) in
      let d2 = 1.0 /. (1.0 +. aa2 *. d1) in
      let c2 = 1.0 +. aa2 /. c1 in
      go(m + 1, c2, d2, h1 *. (d2 *. c2))
  in
  let d0 = 1.0 /. (1.0 -. qab *. x /. qap) in
  go(1, 1.0, d0, d0)
in
# regularized incomplete beta I_x(a, b) #
let betainc = fun (a: Float, b: Float, x: Float) ->
  if x <=. 0.0 then 0.0 else if x >=. 1.0 then 1.0
  else
    let bt = exp(lgamma(a +. b) -. lgamma(a) -. lgamma(b) +. a *. log(x) +. b *. log(1.0 -. x)) in
    if x <. (a +. 1.0) /. (a +. b +. 2.0)
    then bt *. betacf(a, b, x) /. a
    else 1.0 -. bt *. betacf(b, a, 1.0 -. x) /. b
in
# Student-t two-sided p-value for a t statistic with df degrees of freedom #
let t_sf2 = fun (t: Float, df: Float) -> betainc(df /. 2.0, 0.5, df /. (df +. t *. t)) in
# two-sided p-value for a Pearson r over n paired observations (scipy.stats.pearsonr) #
let pearson_p = fun (r: Float, n: Int) ->
  let df = float_of_int(n - 2) in
  t_sf2(r *. sqrt(df /. (1.0 -. r *. r)), df)
in
# independent two-sample t-test, pooled variance (scipy.stats.ttest_ind), two-sided p #
let ttest_ind_p = fun (xs: [Float], ys: [Float]) ->
  let n1 = float_of_int(length(xs)) in
  let n2 = float_of_int(length(ys)) in
  let m1 = mean(xs) in
  let m2 = mean(ys) in
  let v1 = sum(map(xs, fun x -> (x -. m1) *. (x -. m1))) /. (n1 -. 1.0) in
  let v2 = sum(map(ys, fun y -> (y -. m2) *. (y -. m2))) /. (n2 -. 1.0) in
  let sp2 = ((n1 -. 1.0) *. v1 +. (n2 -. 1.0) *. v2) /. (n1 +. n2 -. 2.0) in
  t_sf2((m1 -. m2) /. sqrt(sp2 *. (1.0 /. n1 +. 1.0 /. n2)), n1 +. n2 -. 2.0)
in
# Welch two-sample t-test (scipy.stats.ttest_ind with equal_var=False), two-sided p #
let ttest_welch_p = fun (xs: [Float], ys: [Float]) ->
  let n1 = float_of_int(length(xs)) in
  let n2 = float_of_int(length(ys)) in
  let m1 = mean(xs) in
  let m2 = mean(ys) in
  let v1 = sum(map(xs, fun x -> (x -. m1) *. (x -. m1))) /. (n1 -. 1.0) in
  let v2 = sum(map(ys, fun y -> (y -. m2) *. (y -. m2))) /. (n2 -. 1.0) in
  let se2 = v1 /. n1 +. v2 /. n2 in
  let df = se2 *. se2 /. ((v1 /. n1) *. (v1 /. n1) /. (n1 -. 1.0) +. (v2 /. n2) *. (v2 /. n2) /. (n2 -. 1.0)) in
  t_sf2((m1 -. m2) /. sqrt(se2), df)
in
# D'Agostino-Pearson normality test p-value (scipy.stats.normaltest); K2 ~ chi2(2), p = exp(-K2/2) #
let normaltest_p = fun (xs: [Float]) ->
  let n = float_of_int(length(xs)) in
  let m = mean(xs) in
  let m2 = sum(map(xs, fun x -> let d = x -. m in d *. d)) /. n in
  let m3 = sum(map(xs, fun x -> let d = x -. m in d *. d *. d)) /. n in
  let m4 = sum(map(xs, fun x -> let d = x -. m in d *. d *. d *. d)) /. n in
  let b1 = m3 /. (m2 *. sqrt(m2)) in
  let b2 = m4 /. (m2 *. m2) in
  let y = b1 *. sqrt((n +. 1.0) *. (n +. 3.0) /. (6.0 *. (n -. 2.0))) in
  let beta2 = 3.0 *. (n *. n +. 27.0 *. n -. 70.0) *. (n +. 1.0) *. (n +. 3.0) /. ((n -. 2.0) *. (n +. 5.0) *. (n +. 7.0) *. (n +. 9.0)) in
  let w2 = (0.0 -. 1.0) +. sqrt(2.0 *. (beta2 -. 1.0)) in
  let delta = 1.0 /. sqrt(0.5 *. log(w2)) in
  let alpha = sqrt(2.0 /. (w2 -. 1.0)) in
  let ya = y /. alpha in
  let zs = delta *. log(ya +. sqrt(ya *. ya +. 1.0)) in
  let e = 3.0 *. (n -. 1.0) /. (n +. 1.0) in
  let varb2 = 24.0 *. n *. (n -. 2.0) *. (n -. 3.0) /. ((n +. 1.0) *. (n +. 1.0) *. (n +. 3.0) *. (n +. 5.0)) in
  let xx = (b2 -. e) /. sqrt(varb2) in
  let sb1 = 6.0 *. (n *. n -. 5.0 *. n +. 2.0) /. ((n +. 7.0) *. (n +. 9.0)) *. sqrt(6.0 *. (n +. 3.0) *. (n +. 5.0) /. (n *. (n -. 2.0) *. (n -. 3.0))) in
  let aa = 6.0 +. 8.0 /. sb1 *. (2.0 /. sb1 +. sqrt(1.0 +. 4.0 /. (sb1 *. sb1))) in
  let term1 = 1.0 -. 2.0 /. (9.0 *. aa) in
  let denom = 1.0 +. xx *. sqrt(2.0 /. (aa -. 4.0)) in
  let cr = exp(log((1.0 -. 2.0 /. aa) /. abs_float(denom)) /. 3.0) in
  let term2 = if denom <. 0.0 then 0.0 -. cr else cr in
  let zk = (term1 -. term2) /. sqrt(2.0 /. (9.0 *. aa)) in
  let k2 = zs *. zs +. zk *. zk in
  exp(0.0 -. k2 /. 2.0)
in
# Gregorian days since 1970-01-01 (Howard Hinnant's days_from_civil); pure integer math #
let days_civil = fun (y0: Int, mo: Int, d: Int) ->
  let y = if mo <= 2 then y0 - 1 else y0 in
  let era = (if y >= 0 then y else y - 399) / 400 in
  let yoe = y - era * 400 in
  let mp = if mo > 2 then mo - 3 else mo + 9 in
  let doy = (153 * mp + 2) / 5 + d - 1 in
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy in
  era * 146097 + doe - 719468
in
# 3-letter English month abbreviation -> 1..12 #
let monthnum = fun (m: String) ->
  if m == "Jan" then 1 else if m == "Feb" then 2 else if m == "Mar" then 3
  else if m == "Apr" then 4 else if m == "May" then 5 else if m == "Jun" then 6
  else if m == "Jul" then 7 else if m == "Aug" then 8 else if m == "Sep" then 9
  else if m == "Oct" then 10 else if m == "Nov" then 11 else 12
in
# sum of squared deviations from the mean (named helper so the inner map type-checks; #
# an inline `map(g, fun x -> ...)` inside a fold over a list-of-lists fails to infer g's #
# element type, leaving the result indeterminate). #
let ss_dev = fun (g: [Float]) ->
  let m = mean(g) in sum(map(g, fun x -> (x -. m) *. (x -. m)))
in
# one-way ANOVA p-value (scipy.stats.f_oneway): F = MSbetween/MSwithin, p via F-survival. #
# Reduce each group to a (n, mean, ss) triple via a typed map first, then fold over the #
# triples — folding over the raw list-of-lists leaves `g`'s element type un-inferred. #
let anova_p = fun (groups: [[Float]]) ->
  let st = map(groups, fun (g: [Float]) -> (float_of_int(length(g)), mean(g), ss_dev(g))) in
  let nf = fold_left(st, fun (acc, (n, _m, _s)) -> acc +. n, 0.0) in
  let total = fold_left(st, fun (acc, (n, m, _s)) -> acc +. n *. m, 0.0) in
  let grand = total /. nf in
  let ssb = fold_left(st, fun (acc, (n, m, _s)) -> acc +. n *. (m -. grand) *. (m -. grand), 0.0) in
  let ssw = fold_left(st, fun (acc, (_n, _m, s)) -> acc +. s, 0.0) in
  let k = float_of_int(length(groups)) in
  let dfb = k -. 1.0 in
  let dfw = nf -. k in
  let f = ssb /. dfb /. (ssw /. dfw) in
  betainc(dfw /. 2.0, dfb /. 2.0, dfw /. (dfw +. dfb *. f))
in
# regularized upper incomplete gamma Q(a, x) (Numerical Recipes gammq), fixed iterations #
let gammq = fun (a: Float, x: Float) ->
  let gln = lgamma(a) in
  if x <. a +. 1.0 then
    let go = fun (ap: Float, del: Float, s: Float, n: Int) ->
      if n > 300 then s
      else let ap2 = ap +. 1.0 in let del2 = del *. x /. ap2 in go(ap2, del2, s +. del2, n + 1)
    in
    let s = go(a, 1.0 /. a, 1.0 /. a, 0) in
    1.0 -. s *. exp(0.0 -. x +. a *. log(x) -. gln)
  else
    let go = fun (i: Int, b: Float, c: Float, d: Float, h: Float) ->
      if i > 300 then h
      else
        let fi = float_of_int(i) in
        let an = (0.0 -. fi) *. (fi -. a) in
        let b2 = b +. 2.0 in
        let d2 = 1.0 /. (an *. d +. b2) in
        let c2 = b2 +. an /. c in
        go(i + 1, b2, c2, d2, h *. (d2 *. c2))
    in
    let b0 = x +. 1.0 -. a in
    let d0 = 1.0 /. b0 in
    exp(0.0 -. x +. a *. log(x) -. gln) *. go(1, b0, 1000000000.0 *. 1000000000.0 *. 1000000000.0, d0, d0)
in
# chi-square survival function P(X > x) for df degrees of freedom #
let chi2_sf = fun (x: Float, df: Float) -> gammq(df /. 2.0, x /. 2.0) in
# Kolmogorov distribution survival Q(lam) = 2*sum_{k>=1} (-1)^(k-1) exp(-2 k^2 lam^2) #
let kolmogorov_sf = fun (lam: Float) ->
  let go = fun (k: Int, acc: Float) ->
    if k > 100 then acc
    else
      let kf = float_of_int(k) in
      let term = exp(0.0 -. 2.0 *. kf *. kf *. lam *. lam) in
      go(k + 1, acc +. (if int_mod(k, 2) == 1 then term else 0.0 -. term))
  in
  let s = 2.0 *. go(1, 0.0) in
  if s <. 0.0 then 0.0 else if s >. 1.0 then 1.0 else s
in
# max KS deviation between the standardized sample's ECDF and N(0,1) #
let ks_d_norm = fun (xs: [Float]) ->
  let m = mean(xs) in
  let sd = sample_std(xs) in
  let z = sort(cmp, map(xs, fun x -> (x -. m) /. sd)) in
  let nf = float_of_int(length(z)) in
  let acc =
    fold_left(z, (fun (st, zi) ->
      let (i, mx) = st in
      let phi = normal_cdf(zi) in
      let fi = float_of_int(i) in
      let d1 = fi /. nf -. phi in
      let d2 = phi -. (fi -. 1.0) /. nf in
      let mx2 = if d1 >. mx then d1 else mx in
      (i + 1, if d2 >. mx2 then d2 else mx2)), (1, 0.0)) in
  let (_i, d) = acc in d
in
# one-sample Kolmogorov-Smirnov normality p-value (scipy kstest on standardized data) #
let ks_norm_p = fun (xs: [Float]) ->
  let nf = float_of_int(length(xs)) in
  kolmogorov_sf(sqrt(nf) *. ks_d_norm(xs))
in
# two-sample Kolmogorov-Smirnov p-value (scipy.stats.ks_2samp, asymptotic) #
let ks_2samp_p = fun (a: [Float], b: [Float]) ->
  let n1 = float_of_int(length(a)) in
  let n2 = float_of_int(length(b)) in
  let d =
    fold_left(a @ b, (fun (mx, v) ->
      let f1 = float_of_int(length(filter(a, fun x -> x <=. v))) /. n1 in
      let f2 = float_of_int(length(filter(b, fun x -> x <=. v))) /. n2 in
      let g = abs_float(f1 -. f2) in
      if g >. mx then g else mx), 0.0) in
  kolmogorov_sf(sqrt(n1 *. n2 /. (n1 +. n2)) *. d)
in
# Mann-Whitney U two-sided p-value, normal approximation (U via pair counts, no ranking) #
let mannwhitney_p = fun (a: [Float], b: [Float]) ->
  let n1 = float_of_int(length(a)) in
  let n2 = float_of_int(length(b)) in
  let u1 =
    fold_left(a, (fun (acc, x) ->
      let lt = float_of_int(length(filter(b, fun y -> y <. x))) in
      let eq = float_of_int(length(filter(b, fun y -> (! (y <. x)) && (! (x <. y))))) in
      acc +. lt +. 0.5 *. eq), 0.0) in
  let mu = n1 *. n2 /. 2.0 in
  let sg = sqrt(n1 *. n2 *. (n1 +. n2 +. 1.0) /. 12.0) in
  2.0 *. normal_cdf(0.0 -. abs_float((u1 -. mu) /. sg))
in
# inverse standard-normal CDF (probit / quantile), Acklam's rational approximation #
let probit = fun (p: Float) ->
  let a1 = 0.0 -. 39.69683028665376 in let a2 = 220.9460984245205 in
  let a3 = 0.0 -. 275.9285104469687 in let a4 = 138.3577518672690 in
  let a5 = 0.0 -. 30.66479806614716 in let a6 = 2.506628277459239 in
  let b1 = 0.0 -. 54.47609879822406 in let b2 = 161.5858368580409 in
  let b3 = 0.0 -. 155.6989798598866 in let b4 = 66.80131188771972 in
  let b5 = 0.0 -. 13.28068155288572 in
  let c1 = 0.0 -. 0.007784894002430293 in let c2 = 0.0 -. 0.3223964580411365 in
  let c3 = 0.0 -. 2.400758277161838 in let c4 = 0.0 -. 2.549732539343734 in
  let c5 = 4.374664141464968 in let c6 = 2.938163982698783 in
  let d1 = 0.007784695709041462 in let d2 = 0.3224671290700398 in
  let d3 = 2.445134137142996 in let d4 = 3.754408661907416 in
  if (p >. 0.02425) && (p <. 0.97575) then
    let q = p -. 0.5 in let r = q *. q in
    let nn = (((((a1 *. r +. a2) *. r +. a3) *. r +. a4) *. r +. a5) *. r +. a6) *. q in
    let dd = (((((b1 *. r +. b2) *. r +. b3) *. r +. b4) *. r +. b5) *. r +. 1.0) in
    nn /. dd
  else if p <=. 0.02425 then
    let q = sqrt(0.0 -. 2.0 *. log(p)) in
    (((((c1 *. q +. c2) *. q +. c3) *. q +. c4) *. q +. c5) *. q +. c6)
      /. ((((d1 *. q +. d2) *. q +. d3) *. q +. d4) *. q +. 1.0)
  else
    let q = sqrt(0.0 -. 2.0 *. log(1.0 -. p)) in
    0.0 -. (((((c1 *. q +. c2) *. q +. c3) *. q +. c4) *. q +. c5) *. q +. c6)
      /. ((((d1 *. q +. d2) *. q +. d3) *. q +. d4) *. q +. 1.0)
in
# [1, 2, ..., n] #
let range1 = fun (n: Int) ->
  let go = fun (i: Int, acc: [Int]) -> if i < 1 then acc else go(i - 1, i :: acc) in
  go(n, [])
in
# Shapiro-Wilk W statistic (Royston AS R94 half-sample weights; verified vs scipy.stats.shapiro) #
let shapiro_w = fun (xs: [Float]) ->
  let s = sort(cmp, xs) in
  let n = length(xs) in
  let nf = float_of_int(n) in
  let nn2 = n / 2 in
  let ms = map(range1(nn2), fun i -> probit((float_of_int(i) -. 0.375) /. (nf +. 0.25))) in
  let summ2 = 2.0 *. sum(map(ms, fun mi -> mi *. mi)) in
  let rsn = 1.0 /. sqrt(nf) in
  let m1 = nth(ms, 0) in
  let m2 = nth(ms, 1) in
  let pc1 = (((((0.0 -. 2.706056) *. rsn +. 4.434685) *. rsn -. 2.071190) *. rsn -. 0.147981) *. rsn +. 0.221157) *. rsn in
  let pc2 = (((((0.0 -. 3.582633) *. rsn +. 5.682633) *. rsn -. 1.752461) *. rsn -. 0.293762) *. rsn +. 0.042981) *. rsn in
  let a1 = pc1 -. m1 /. sqrt(summ2) in
  let a2 = pc2 -. m2 /. sqrt(summ2) in
  let fac = sqrt((summ2 -. 2.0 *. m1 *. m1 -. 2.0 *. m2 *. m2) /. (1.0 -. 2.0 *. a1 *. a1 -. 2.0 *. a2 *. a2)) in
  # weights a[i] aligned with i; pairs (i-th smallest, i-th largest) via zip(s, reverse(s)). #
  # Built with zip/map (O(n)) rather than nth in a fold (which would be O(n^2)). #
  let weights = map(zip(range1(nn2), ms),
    (fun (i, mi) -> if i == 1 then a1 else if i == 2 then a2 else 0.0 -. mi /. fac)) in
  let pairs = take(zip(s, reverse(s)), nn2) in
  let b = sum(map(zip(weights, pairs), (fun (w, (lo, hi)) -> w *. (hi -. lo)))) in
  let mx = mean(xs) in
  b *. b /. sum(map(xs, fun x -> (x -. mx) *. (x -. mx)))
in
# Shapiro-Wilk p-value, Royston's n>=12 normalizing transform (verified vs scipy.stats.shapiro) #
let shapiro_p = fun (xs: [Float]) ->
  let w = shapiro_w(xs) in
  let g = log(float_of_int(length(xs))) in
  let mu = (((0.0038915 *. g -. 0.083751) *. g -. 0.31082) *. g -. 1.5861) in
  let ls = ((0.0030302 *. g -. 0.082676) *. g -. 0.4803) in
  1.0 -. normal_cdf((log(1.0 -. w) -. mu) /. exp(ls))
in
# Two-predictor OLS (intercept + x1 + x2) via the mean-centered normal equations: solving the #
# 2x2 centered system for the slopes (then intercept = ybar - b1*x1bar - b2*x2bar) keeps XtX #
# well-conditioned even when predictors differ in scale, and gives the same coefficients as #
# statsmodels OLS / sklearn LinearRegression. Returns (b0, b1, b2, p1, p2, r2): intercept, the two #
# slopes, their two-sided p-values (t = b/SE, SE^2 = sigma2 * inv(centered XtX), sigma2 = RSS/(n-3), #
# df = n-3, via t_sf2), and R^2 = 1 - RSS/TSS. Slope variances equal the full-model ones (Frisch-Waugh). #
let ols2 = fun (x1: [Float], x2: [Float], y: [Float]) ->
  let nf = float_of_int(length(y)) in
  let mx1 = mean(x1) in
  let mx2 = mean(x2) in
  let my = mean(y) in
  let cx1 = map(x1, fun v -> v -. mx1) in
  let cx2 = map(x2, fun v -> v -. mx2) in
  let cy = map(y, fun v -> v -. my) in
  let s11 = sum(map(cx1, fun v -> v *. v)) in
  let s22 = sum(map(cx2, fun v -> v *. v)) in
  let s12 = sum(map(zip(cx1, cx2), fun (a, b) -> a *. b)) in
  let t1 = sum(map(zip(cx1, cy), fun (a, b) -> a *. b)) in
  let t2 = sum(map(zip(cx2, cy), fun (a, b) -> a *. b)) in
  let det = s11 *. s22 -. s12 *. s12 in
  let b1 = (t1 *. s22 -. t2 *. s12) /. det in
  let b2 = (s11 *. t2 -. s12 *. t1) /. det in
  let b0 = my -. b1 *. mx1 -. b2 *. mx2 in
  let yhat = map(zip(x1, x2), fun (a, b) -> b0 +. b1 *. a +. b2 *. b) in
  let rss = sum(map(zip(y, yhat), fun (yi, yh) -> (yi -. yh) *. (yi -. yh))) in
  let tss = sum(map(cy, fun e -> e *. e)) in
  let sigma2 = rss /. (nf -. 3.0) in
  let se1 = sqrt(sigma2 *. s22 /. det) in
  let se2 = sqrt(sigma2 *. s11 /. det) in
  let p1 = t_sf2(abs_float(b1 /. se1), nf -. 3.0) in
  let p2 = t_sf2(abs_float(b2 /. se2), nf -. 3.0) in
  (b0, b1, b2, p1, p2, 1.0 -. rss /. tss)
in
# Simple (one-predictor) OLS: returns (intercept, slope), matching sklearn LinearRegression. #
let ols1 = fun (x: [Float], y: [Float]) ->
  let mx = mean(x) in
  let my = mean(y) in
  let sxx = sum(map(x, fun v -> (v -. mx) *. (v -. mx))) in
  let sxy = sum(map(zip(x, y), fun (xi, yi) -> (xi -. mx) *. (yi -. my))) in
  let b1 = sxy /. sxx in
  (my -. b1 *. mx, b1) in
# ---- helpers (tapp/mkrange/ttake/tdrop, used by olsk/gauss/abuildf below) + a pure-Hazel MT19937 ---- #
# REFERENCE: the xor32/and32/hword/init_list/twist/temper/genrand/mask_for/rk_interval + Int-tree #
# functions below are a VERIFIED pure-Hazel numpy-MT19937 (reproduces np.random.RandomState(seed) #
# bit-for-bit). They are kept as the expressiveness artifact but are NOT on the active path: perm_list #
# now delegates to the native `np_permutation` builtin (much faster). Notes preserved: MT state is a #
# list so the 624-word twist is an O(n) XOR pass; the shuffle used a recursive-ADT perfect-tree array; #
# native `++` overflows on long lists, hence the tail-recursive `tapp`/`ttake`/`tdrop`. #
let p32 = 4294967296 in
let xor32 = fun (a: Int, b: Int) ->
  let go = fun (x, y, pw, acc) ->
    if pw >= p32 then acc else go(x / 2, y / 2, pw * 2, acc + int_mod(int_mod(x, 2) + int_mod(y, 2), 2) * pw)
  in go(a, b, 1, 0) in
let and32 = fun (a: Int, b: Int) ->
  let go = fun (x, y, pw, acc) ->
    if pw >= p32 then acc else go(x / 2, y / 2, pw * 2, acc + int_mod(x, 2) * int_mod(y, 2) * pw)
  in go(a, b, 1, 0) in
let tapp = fun (xs, ys) -> fold_left(reverse(xs), (fun (acc, x) -> x :: acc), ys) in
let mkrange = fun (n: Int) -> let g = fun (i, acc) -> if i < 0 then acc else g(i - 1, i :: acc) in g(n - 1, []) in
# tail-recursive take/drop (the builtins recurse on the native stack and overflow past ~1-2k depth, #
# which `abuild` hits when splitting a several-thousand-element list). #
let tdrop = fun (xs, k) -> let go = fun (ys, i) -> if i <= 0 then ys else go(tail(ys), i - 1) in go(xs, k) in
let ttake = fun (xs, k) ->
  let go = fun (ys, i, acc) -> if i <= 0 then reverse(acc) else go(tail(ys), i - 1, head(ys) :: acc) in
  go(xs, k, []) in
let hword = fun (a: Int, b: Int) ->
  let y = (a / 2147483648) * 2147483648 + int_mod(b, 2147483648) in
  xor32(y / 2, if int_mod(y, 2) == 1 then 2567483615 else 0) in
let init_list = fun (seed: Int) ->
  let go = fun (i, prev, acc) ->
    if i >= 624 then reverse(acc)
    else let cur = int_mod(1812433253 * xor32(prev, prev / 1073741824) + i, p32) in go(i + 1, cur, cur :: acc)
  in go(1, seed, [seed]) in
let twist = fun (old) ->
  let rot1 = tapp(tail(old), [head(old)]) in
  let h = map(zip(old, rot1), (fun (a, b) -> hword(a, b))) in
  let p1 = map(zip(drop(old, 397), take(h, 227)), (fun (c, hk) -> xor32(c, hk))) in
  let chunkA = map(zip(p1, take(drop(h, 227), 227)), (fun (nj, hk) -> xor32(nj, hk))) in
  let chunkB0 = map(zip(take(chunkA, 169), take(drop(h, 454), 169)), (fun (nj, hk) -> xor32(nj, hk))) in
  # last element kk=623: numpy's y uses the ALREADY-updated key[0] (=new[0]=head(p1)) for its LOWER #
  # bits, not old[0]; so recompute h[623] with new[0] and set new[623] = new[396] XOR that. #
  let last = xor32(nth(chunkA, 169), hword(nth(old, 623), head(p1))) in
  tapp(p1, tapp(chunkA, tapp(chunkB0, [last]))) in
let temper = fun (y0: Int) ->
  let y1 = xor32(y0, y0 / 2048) in
  let y2 = xor32(y1, and32(int_mod(y1 * 128, p32), 2636928640)) in
  let y3 = xor32(y2, and32(int_mod(y2 * 32768, p32), 4022730752)) in
  xor32(y3, y3 / 262144) in
let genrand = fun (st) ->
  let (full, rem) = st in
  case rem
  | [] => let t = twist(full) in (temper(head(t)), (t, tail(t)))
  | (w :: rest) => (temper(w), (full, rest))
  end in
let mask_for = fun (mx: Int) -> let go = fun (m) -> if m >= mx then m else go(m * 2 + 1) in go(1) in
let rk_interval = fun (mx: Int, st) ->
  if mx == 0 then (0, st)
  else
    let mask = mask_for(mx) in
    let go = fun (s) -> let (w, s2) = genrand(s) in let v = int_mod(w, mask + 1) in if v <= mx then (v, s2) else go(s2)
    in go(st) in
type Arr =
  + Lf(Int)
  + Br(Arr, Arr) in
let abuild : ([Int], Int) -> Arr = fun (xs, size) ->
  if size == 1 then Lf(head(xs)) else let h = size / 2 in Br(abuild(ttake(xs, h), h), abuild(tdrop(xs, h), size - h)) in
let aget : (Arr, Int, Int) -> Int = fun (t, i, size) ->
  case t | Lf(v) => v | Br(l, r) => let h = size / 2 in if i < h then aget(l, i, h) else aget(r, i - h, size - h) end in
let aset : (Arr, Int, Int, Int) -> Arr = fun (t, i, v, size) ->
  case t | Lf(_) => Lf(v) | Br(l, r) => let h = size / 2 in if i < h then Br(aset(l, i, v, h), r) else Br(l, aset(r, i - h, v, size - h)) end in
type ArrF =
  + LfF(Float)
  + BrF(ArrF, ArrF) in
let abuildf : ([Float], Int) -> ArrF = fun (xs, size) ->
  if size == 1 then LfF(head(xs)) else let h = size / 2 in BrF(abuildf(ttake(xs, h), h), abuildf(tdrop(xs, h), size - h)) in
let agetf : (ArrF, Int, Int) -> Float = fun (t, i, size) ->
  case t | LfF(v) => v | BrF(l, r) => let h = size / 2 in if i < h then agetf(l, i, h) else agetf(r, i - h, size - h) end in
# permutation of 0..n-1 as a list, == np.random.RandomState(seed).permutation(n). #
# Delegates to the native `np_permutation` builtin (fast numpy-exact MT19937 + Fisher-Yates); #
# the pure-Hazel implementation below is kept as a verified reference but is no longer on the path. #
let perm_list = fun (n: Int, seed: Int) -> np_permutation(seed, n) in
# n_test = ceil(test_size * n), matching sklearn _validate_shuffle_split #
let tts_n_test = fun (ts: Float, n: Int) -> int_of_float(ceil(ts *. float_of_int(n))) in
# gather a float column (as a tree) at the given permuted indices #
let gather_f = fun (tree: ArrF, idxs: [Int], n: Int) -> map(idxs, (fun (idx) -> agetf(tree, idx, n))) in
let dot = fun (u: [Float], v: [Float]) -> sum(map(zip(u, v), (fun (a, b) -> a *. b))) in
# Gaussian elimination (no pivoting; centered OLS systems are well-conditioned). aug: n rows each #
# of length n+1 (A | b). Returns the solution vector [Float] of length n. #
let gauss = fun (aug, n) ->
  let fwd = fold_left(mkrange(n), (fun (rows, p) ->
      let piv = nth(rows, p) in
      let pv = nth(piv, p) in
      map(zip(rows, mkrange(n)), (fun (r, ri) ->
        if ri <= p then r else let f = nth(r, p) /. pv in map(zip(r, piv), (fun (a, b) -> a -. f *. b))))), aug) in
  fold_left(reverse(mkrange(n)), (fun (xs, p) ->
      let row = nth(fwd, p) in
      let known = sum(map(zip(take(drop(row, p + 1), n - p - 1), xs), (fun (a, x) -> a *. x))) in
      ((nth(row, n) -. known) /. nth(row, p)) :: xs), []) in
# Multiple-predictor OLS via the mean-centered normal equations (cols = k feature columns); #
# returns (intercept, [slopes]) matching sklearn LinearRegression. #
let olsk = fun (cols: [[Float]], y: [Float]) ->
  let k = length(cols) in
  let means = map(cols, (fun (c) -> mean(c))) in
  let my = mean(y) in
  let ccols = map(zip(cols, means), (fun (c, m) -> map(c, (fun (v) -> v -. m)))) in
  let cy = map(y, (fun (v) -> v -. my)) in
  let sc = map(ccols, (fun (ci) -> map(ccols, (fun (cj) -> dot(ci, cj))))) in
  let tc = map(ccols, (fun (ci) -> dot(ci, cy))) in
  let beta = gauss(map(zip(sc, tc), (fun (row, t) -> tapp(row, [t]))), k) in
  (my -. sum(map(zip(beta, means), (fun (b, m) -> b *. m))), beta) in
# predict for a list of test feature columns: yhat_i = b0 + sum_j beta_j * tecols[j][i] #
let predict = fun (b0: Float, beta: [Float], tecols: [[Float]]) ->
  fold_left(zip(beta, tecols), (fun (acc, (b, col)) -> map(zip(acc, col), (fun (a, v) -> a +. b *. v))),
    map(head(tecols), (fun (_w) -> b0))) in
let sigmoid = fun (z: Float) -> 1.0 /. (1.0 +. exp(0.0 -. z)) in
# Unregularized logistic regression via IRLS / Newton-Raphson. `feats` is the design as a list of #
# columns INCLUDING a leading all-ones column (the intercept); `y` is 0/1 labels; `iters` Newton steps #
# from beta=0. Returns the coefficient vector (intercept first). Each step solves (X^T W X) d = X^T(y-p) #
# via `gauss`; at convergence this is the same optimum sklearn's LogisticRegression reaches. #
# L2-regularized logistic regression via IRLS/Newton. `lam` penalizes ALL coefficients (including #
# the intercept, matching sklearn's `liblinear` with intercept_scaling=1; lam = 1/C). lam=0 is the #
# plain MLE. step solves (X^T W X + lam*I) d = X^T(y-p) - lam*beta via `gauss`. #
let logreg_l2 = fun (feats: [[Float]], y: [Float], lam: Float, iters: Int) ->
  let p = length(feats) in
  let idx = mkrange(p) in
  let zero_n = map(head(feats), (fun (_w) -> 0.0)) in
  let step = fun (beta: [Float]) ->
    let eta =
      fold_left(zip(beta, feats),
        (fun (acc, (b, f)) -> map(zip(acc, f), (fun (a, v) -> a +. b *. v))), zero_n) in
    let pr = map(eta, (fun (e) -> sigmoid(e))) in
    let w = map(pr, (fun (q) -> q *. (1.0 -. q))) in
    let resid = map(zip(y, pr), (fun (yi, qi) -> yi -. qi)) in
    let g = map(zip(feats, beta), (fun (fa, ba) -> dot(fa, resid) -. lam *. ba)) in
    let hess =
      map(zip(feats, idx), (fun (fa, ia) ->
            let wfa = map(zip(w, fa), (fun (wi, fai) -> wi *. fai)) in
            map(zip(feats, idx),
              (fun (fb, ib) -> dot(wfa, fb) +. (if ia == ib then lam else 0.0))))) in
    let delta = gauss(map(zip(hess, g), (fun (hrow, gi) -> tapp(hrow, [gi]))), p) in
    map(zip(beta, delta), (fun (b, d) -> b +. d))
  in
  fold_left(mkrange(iters), (fun (beta, _i) -> step(beta)), map(feats, (fun (_f) -> 0.0)))
in
# plain (unregularized) logistic regression #
let logreg = fun (feats: [[Float]], y: [Float], iters: Int) -> logreg_l2(feats, y, 0.0, iters) in
