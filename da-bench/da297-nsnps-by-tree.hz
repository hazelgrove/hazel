# DA-Bench id 297: mean nsnps for rows with null vs non-null tree, Qrob_Chr05 tree_table.csv. #
# NOT in test.sh: our answer (null=4.26, notnull=43.31 over the 162/2495 numeric nsnps) is what #
# pandas itself produces -- verified with pandas 3.0.3: pd.read_csv parses the file cleanly to #
# (2822, 6) and df.groupby(tree.isna()) gives 43.31/4.26, matching us exactly. The label #
# (4.58 / 45.48) is NOT reproducible from this file by any standard pandas operation, so it is an #
# erroneous/unknown-origin reference value, not a parsing difference. #
let data = ^^csv("ts-sc4-wi100000-sl25000-Qrob_Chr05.tree_table.csv") in
let nn = num(map(filter(data, fun r -> string_trim(r.`tree`) != ""), fun r -> r.`nsnps`)) in
let nu = num(map(filter(data, fun r -> string_trim(r.`tree`) == ""), fun r -> r.`nsnps`)) in
(mean_with_tree_null = round2(mean(nu)), mean_with_tree_notnull = round2(mean(nn)))
