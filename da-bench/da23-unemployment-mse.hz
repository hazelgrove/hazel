# DA-Bench id 23: predict March-2020 employment from March-2019, unemployement_industry.csv. 70/30 #
# train_test_split(random_state=42) via the prelude RNG, simple linear regression (ols1) on train, #
# MSE on the test split #
let data = ^^csv("unemployement_industry.csv") in
let pairs =
  filter(zip(map(data, fun r -> r.`Mar.2019`), map(data, fun r -> r.`Mar.2020`)),
    fun (a, b) -> (string_trim(a) != "") && (string_trim(b) != "")) in
let x = map(pairs, fun (a, _b) -> float_of_string(string_trim(a))) in
let y = map(pairs, fun (_a, b) -> float_of_string(string_trim(b))) in
let n = length(x) in
let perm = perm_list(n, ^^seed(42)) in
let nt = tts_n_test(0.3, n) in
let tr = drop(perm, nt) in
let te = take(perm, nt) in
let xT = abuildf(x, n) in
let yT = abuildf(y, n) in
let (b0, b1) = ols1(gather_f(xT, tr, n), gather_f(yT, tr, n)) in
let tex = gather_f(xT, te, n) in
let tey = gather_f(yT, te, n) in
let yhat = map(tex, (fun (xi) -> b0 +. b1 *. xi)) in
(Mean_Squared_Error = round1(mean(map(zip(tey, yhat), (fun (yi, yh) -> (yi -. yh) *. (yi -. yh))))))
