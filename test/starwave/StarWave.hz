# Star wave: visitors come down from the stars wanting love, dropping rainbows on the town as they come. A heart sent up to a visitor connects, and it bursts into hearts. One step of the game (1/60 of a second): the launcher moved, your heart up, the formation marching across and down, faster as it thins, the rainbow drops falling and turning the town rainbow a floor at a time; the last heart connecting soon after the town is all rainbow (just right), before it (too soon), or too long after it or once they land (too late). And a robot that plays it, for 🤖 Hazel plays: keeping as many visitors as the town still needs rainbows from, then sending the last heart once it is all rainbow #
let md : (Int, Int) -> Int = fun (a, b) -> a - (a / b) * b;
let next : Int -> Int = fun s -> md(s * 48271, 2147483647);
let absi : Int -> Int = fun v -> if v < 0 then 0 - v else v;
let at : ([Int], Int) -> Int = fun (xs, i) -> case xs | [] => 0 | x :: rest => if i <= 0 then x else at(rest, i - 1) end;
let set_at : ([Int], Int, Int) -> [Int] = fun (xs, i, v) -> case xs | [] => [] | x :: rest => if i <= 0 then v :: rest else x :: set_at(rest, i - 1, v) end;
let alive : [Int] -> Int = fun xs -> case xs | [] => 0 | x :: rest => (if x > 0 then 1 else 0) + alive(rest) end;
let sum : [Int] -> Int = fun xs -> case xs | [] => 0 | x :: rest => x + sum(rest) end;
# ---- The town: building s from 54 + 140 s, 72 wide; its floors; its roof; 22 floors in all ---- #
let bx : Int -> Int = fun s -> 54 + 140 * s;
let floors : Int -> Int = fun s -> if s == 0 then 5 else if s == 1 then 7 else if s == 2 then 6 else 4;
let roof : Int -> Int = fun s -> 762 - 18 * floors(s);
let full : Int = 22;
# ---- A wave: 3 rows of visitors on the first, 4 on the second, then 5 (the top row kind 3, then 2, the rest 1), lower each wave, up to five waves down ---- #
let rows_of : Int -> Int = fun w -> if w >= 2 then 5 else 3 + w;
let kinds_from : (Int, Int) -> [Int] = fun (n, i) ->
  if i >= 45 then [] else
  (let r = i / 9 in if r >= n then 0 else if r == 0 then 3 else if r <= (n - 1) / 2 then 2 else 1) :: kinds_from(n, i + 1);
let top_of : Int -> Int = fun w -> 110 + 20 * (if w > 5 then 5 else w);
let wave_start : (Int, Int, Int, Int, Int, Int, Int, Int) -> Game = fun (cx, tries, hearts, wins, wave, seed, t, hit) ->
  (cx = cx, hx = 0 - 1, hy = 0 - 1, drops = [], aliens = kinds_from(rows_of(wave), 0), fx = 92, fy = top_of(wave), fdir = 1, march = 24, town = [0, 0, 0, 0],
   glow = 0, tries = tries, hearts = hearts, wins = wins, wave = wave, seed = seed, wait = 0, verdict = 0, over = false, hit = hit, t = t);
let start : Int -> Game = fun seed -> wave_start(300, 3, 0, 0, 0, next(seed + 1), 0, 0);
# ---- What is where ---- #
# the visitor a point is in: its number, or -1 #
let alien_at : ([Int], Int, Int, Int, Int) -> Int = fun (aliens, fx, fy, x, y) ->
  if x < fx || y < fy then 0 - 1 else
  let c = (x - fx) / 48 in let r = (y - fy) / 40 in
  if c > 8 || r > 4 || x - fx - c * 48 >= 32 || y - fy - r * 40 >= 24 then 0 - 1 else
  (let i = r * 9 + c in if at(aliens, i) > 0 then i else 0 - 1);
# the building over x: its number, or -1 #
let building_at : Int -> Int = fun x -> if x < 54 then 0 - 1 else (let s = (x - 54) / 140 in if s > 3 || x - bx(s) >= 72 then 0 - 1 else s);
# the columns with a visitor left: the first and the last; a column's lowest visitor; the bottom of the lowest row, or -1 #
let col_has : ([Int], Int) -> Bool = fun (aliens, c) -> at(aliens, c) > 0 || at(aliens, 9 + c) > 0 || at(aliens, 18 + c) > 0 || at(aliens, 27 + c) > 0 || at(aliens, 36 + c) > 0;
let first_col : ([Int], Int) -> Int = fun (aliens, c) -> if c > 8 then 0 else if col_has(aliens, c) then c else first_col(aliens, c + 1);
let last_col : ([Int], Int) -> Int = fun (aliens, c) -> if c < 0 then 8 else if col_has(aliens, c) then c else last_col(aliens, c - 1);
let lowest : ([Int], Int, Int) -> Int = fun (aliens, c, r) -> if r < 0 then 0 - 1 else if at(aliens, r * 9 + c) > 0 then r else lowest(aliens, c, r - 1);
let bottom : ([Int], Int, Int) -> Int = fun (aliens, fy, r) -> if r < 0 then 0 - 1 else if at(aliens, r * 9) > 0 || at(aliens, r * 9 + 1) > 0 || at(aliens, r * 9 + 2) > 0 || at(aliens, r * 9 + 3) > 0 || at(aliens, r * 9 + 4) > 0 || at(aliens, r * 9 + 5) > 0 || at(aliens, r * 9 + 6) > 0 || at(aliens, r * 9 + 7) > 0 || at(aliens, r * 9 + 8) > 0 then fy + r * 40 + 24 else bottom(aliens, fy, r - 1);
# ---- The rainbows ---- #
# the building a rainbow landing at x turns a floor of: the nearest with a floor still plain (the one under it, if it has one); -1 when the town is all rainbow #
let nearest_plain : ([Int], Int, Int, Int, Int) -> Int = fun (town, x, s, best, bd) ->
  if s > 3 then best else
  let d = absi(bx(s) + 36 - x) in
  if at(town, s) < floors(s) && d < bd then nearest_plain(town, x, s + 1, s, d) else nearest_plain(town, x, s + 1, best, bd);
# the drops a step on: each 4 down; one on a roof, or on the ground, turns a floor rainbow and is gone #
let fall : ([Drop], [Int]) -> ([Drop], [Int]) = fun (ds, town) ->
  case ds
  | [] => ([], town)
  | d :: rest =>
    let y = d.y + 4 in
    let s = building_at(d.x) in
    let landed = y >= 762 || (s >= 0 && y >= roof(s)) in
    let p = (if landed then nearest_plain(town, d.x, 0, 0 - 1, 100000) else 0 - 1) in
    let (more, t2) = fall(rest, (if p >= 0 then set_at(town, p, at(town, p) + 1) else town)) in
    (if landed then (more, t2) else ((x = d.x, y = y) :: more, t2))
  end;
let count : [Drop] -> Int = fun ds -> case ds | [] => 0 | _ :: rest => 1 + count(rest) end;
# the column a rainbow comes from: the first with a visitor left from column c on, round to the start #
let col_from : ([Int], Int, Int) -> Int = fun (aliens, c, k) -> if k > 8 then 0 - 1 else (let cc = md(c + k, 9) in if col_has(aliens, cc) then cc else col_from(aliens, c, k + 1));
# ---- One step ---- #
# the pause after a wave ends: everything as it was, a step on #
let paused : (Game, Int, Int) -> Game = fun (g, wait, hit) ->
  (cx = g.cx, hx = g.hx, hy = g.hy, drops = g.drops, aliens = g.aliens, fx = g.fx, fy = g.fy, fdir = g.fdir, march = g.march, town = g.town, glow = g.glow,
   tries = g.tries, hearts = g.hearts, wins = g.wins, wave = g.wave, seed = g.seed, wait = wait, verdict = g.verdict, over = g.over, hit = hit, t = g.t + 1);
# move: -1, 0 or 1 (6 units a step, the launcher kept on the field); fire: a heart from the launcher, if none is in the air. A heart goes up 12 a step, in front of the buildings; one reaching a visitor connects (the visitor gone, a heart counted). Every march (the steps between, 4 plus half the visitors left) the formation moves 8 its way, or, at the edge, 20 down and turns. Now and then (more often the more visitors are left) the lowest visitor of a column drops a rainbow, while the town has floors no rainbow is coming to; each turns a floor rainbow where it lands. Once the town is all rainbow the last heart has 8 seconds (480 steps). The wave ends just right, too soon or too late (the visitors down to 630, or the 8 seconds gone); anything but just right takes a try, and the last try ends the game. After a pause of 150 steps, the next wave, or the same wave again #
let step : (Game, Int, Bool) -> Game = fun (g, move, fire) ->
  if g.over then g else
  if g.wait > 1 then paused(g, g.wait - 1, 0) else
  if g.wait == 1 then wave_start(g.cx, g.tries, g.hearts, g.wins, (if g.verdict == 3 then g.wave + 1 else g.wave), g.seed, g.t + 1, 7) else
  let cx = (let x = g.cx + 6 * move in if x < 30 then 30 else if x > 570 then 570 else x) in
  let firing = fire && g.hy < 0 in
  let hx0 = (if firing then cx else g.hx) in
  let hy0 = (if firing then 724 else g.hy) in
  let hy1 = (if hy0 >= 0 then hy0 - 12 else 0 - 1) in
  let hitA = (if hy1 >= 0 then (let a = alien_at(g.aliens, g.fx, g.fy, hx0, hy1) in if a >= 0 then a else alien_at(g.aliens, g.fx, g.fy, hx0, hy1 + 6)) else 0 - 1) in
  let aliens = (if hitA >= 0 then set_at(g.aliens, hitA, 0) else g.aliens) in
  let heart_on = hy1 >= 0 && hitA < 0 in
  let hearts = g.hearts + (if hitA >= 0 then 1 else 0) in
  let left = alive(aliens) in
  let marching = g.march <= 1 in
  let edge = (if g.fdir > 0 then g.fx + last_col(aliens, 8) * 48 + 32 + 8 > 592 else g.fx + first_col(aliens, 0) * 48 - 8 < 8) in
  let fx = (if marching && !edge then g.fx + 8 * g.fdir else g.fx) in
  let fy = (if marching && edge then g.fy + 20 else g.fy) in
  let fdir = (if marching && edge then 0 - g.fdir else g.fdir) in
  let march = (if marching then 4 + left / 2 else g.march - 1) in
  let (drops0, town) = fall(g.drops, g.town) in
  let painted = sum(town) in
  let s1 = next(g.seed) in
  let c = col_from(aliens, md(s1 / 1000, 9), 0) in
  let lr = (if c >= 0 then lowest(aliens, c, 4) else 0 - 1) in
  let n = count(drops0) in
  let drop = lr >= 0 && painted + n < full && n < 3 && md(s1, 1000) < 3 + left / 3 in
  let drops = (if drop then (x = fx + c * 48 + 16, y = fy + lr * 40 + 24) :: drops0 else drops0) in
  let late = painted >= full && g.glow == 1 in
  let glow = (if painted >= full then (if g.glow > 0 then g.glow - 1 else 480) else 0) in
  let landed = left > 0 && bottom(aliens, fy, 4) >= 630 in
  let verdict = (if left == 0 then (if painted >= full then 3 else 5) else if landed then 4 else if late then 6 else 0) in
  if verdict > 0 then
    (let tries = (if verdict == 3 then g.tries else g.tries - 1) in
     (cx = cx, hx = 0 - 1, hy = 0 - 1, drops = [], aliens = aliens, fx = fx, fy = fy, fdir = fdir, march = march, town = town, glow = glow,
      tries = tries, hearts = hearts, wins = g.wins + (if verdict == 3 then 1 else 0), wave = g.wave, seed = s1, wait = (if tries <= 0 then 0 else 150),
      verdict = verdict, over = tries <= 0, hit = verdict, t = g.t + 1))
  else
    (cx = cx, hx = (if heart_on then hx0 else 0 - 1), hy = (if heart_on then hy1 else 0 - 1), drops = drops, aliens = aliens, fx = fx, fy = fy, fdir = fdir,
     march = march, town = town, glow = glow, tries = g.tries, hearts = hearts, wins = g.wins, wave = g.wave, seed = s1, wait = 0, verdict = g.verdict,
     over = false, hit = (if hitA >= 0 then 1 else 0), t = g.t + 1);
# ---- The robot (🤖 Hazel plays) ---- #
# the floors no rainbow is coming to yet (a falling drop will turn one) #
let to_come : Game -> Int = fun g -> full - sum(g.town) - count(g.drops);
# how many visitors to keep while p floors are still to come: the wave's share of them for p of the 22 floors, and one more; one, once every floor has its rainbow coming #
let keep : (Game, Int) -> Int = fun (g, p) -> if p <= 0 then 1 else 1 + (p * 9 * rows_of(g.wave) + full - 1) / full;
# the visitor to aim at: a column's lowest, the lowest rows first (the nearest the town) unless the town is all rainbow (then the nearest), where it will be when the heart gets there (the formation's march while the heart rises) #
let aim : (Game, Int, Int, Int) -> Int = fun (g, c, best, bd) ->
  if c > 8 then best else
  if !col_has(g.aliens, c) then aim(g, c + 1, best, bd) else
  let r = lowest(g.aliens, c, 4) in
  let rise = (724 - (g.fy + r * 40 + 12)) / 12 in
  let drift = (rise / (4 + alive(g.aliens) / 2)) * 8 * g.fdir in
  let x = g.fx + c * 48 + 16 + drift in
  let d = absi(x - g.cx) + (if g.glow > 0 then 0 else 120 * (4 - r)) in
  if d < bd then aim(g, c + 1, x, d) else aim(g, c + 1, best, bd);
# the robot's choice: under the visitor it aims at; a heart once the town is all rainbow, else only while more visitors are left than the town still needs (or the lowest row is near the town), never the last one before it is all rainbow #
let robot : Game -> Choice = fun g ->
  if g.over || g.wait > 0 then (move = 0, fire = false) else
  let left = alive(g.aliens) in
  let x = aim(g, 0, g.cx, 100000) in
  let move = (if x > g.cx + 3 then 1 else if x < g.cx - 3 then 0 - 1 else 0) in
  let near = 630 - bottom(g.aliens, g.fy, 4) < 50 in
  let want = g.glow > 0 || (left >= 2 && (near || left - 1 >= keep(g, to_come(g)))) in
  (move = move, fire = want && g.hy < 0 && absi(x - g.cx) <= 10)