# Pinball: ten boards as data, and one step of the game, 1/60 of a second: the flippers turned as their buttons are held, then in four small steps gravity, the walls, the bumpers, the flippers and the portals, then the drain. One module: in hazeljs a call into another module costs the build seconds. Round two (ticket 805): chambers with flippers of their own, portals that hold the ball a moment, a ball save, a launch from soft to full; round three: bumpers that ride tracks #
# ---- Building boards ---- #
let w : (Int, Int, Int, Int) -> Wall = fun (ax, ay, bx, by) -> (ax = ax, ay = ay, bx = bx, by = by, bounce = 50, kick = 0);
let sling : (Int, Int, Int, Int) -> Wall = fun (ax, ay, bx, by) -> (ax = ax, ay = ay, bx = bx, by = by, bounce = 60, kick = 55);
# a kicker: a wall that kicks harder: a kickback at an outlane's foot, a trampoline under a gap #
let kicker : (Int, Int, Int, Int, Int) -> Wall = fun (ax, ay, bx, by, k) -> (ax = ax, ay = ay, bx = bx, by = by, bounce = 60, kick = k);
let bp : (Int, Int, Int, Int) -> Bumper = fun (x, y, r, p) -> (x = x, y = y, r = r, points = p, track = 0 - 1, phase = 0);
# a bumper on track k, starting phase thousandths of the way round; a track: an oval round (cx, cy), rx across and ry down, once round in period steps #
let mover : (Int, Int, Int, Int) -> Bumper = fun (k, phase, r, p) -> (x = 0, y = 0, r = r, points = p, track = k, phase = phase);
let loop : (Int, Int, Int, Int, Int) -> Track = fun (cx, cy, rx, ry, period) -> (cx = cx, cy = cy, rx = rx, ry = ry, period = period);
let fl : (Int, Int, Int, Int) -> Flipper = fun (x, y, len, side) -> (x = x, y = y, len = len, side = side);
let gate : (Int, Int, Int, Int, Int) -> Portal = fun (x, y, r, tx, ty) -> (x = x, y = y, r = r, tx = tx, ty = ty);
let join : ([Wall], [Wall]) -> [Wall] = fun (xs, ys) -> case xs | [] => ys | x :: rest => x :: join(rest, ys) end;
let cat_w : [[Wall]] -> [Wall] = fun xss -> case xss | [] => [] | xs :: rest => join(xs, cat_w(rest)) end;
let join_l : ([Light], [Light]) -> [Light] = fun (xs, ys) -> case xs | [] => ys | x :: rest => x :: join_l(rest, ys) end;
let cat_l : [[Light]] -> [Light] = fun xss -> case xss | [] => [] | xs :: rest => join_l(xs, cat_l(rest)) end;
# an arc of n walls round (cx, cy), radius r, from angle a0 to a1 (thousandths of a radian; y down, so 0 is to the right and 1571 down) #
let arc : (Int, Int, Int, Int, Int, Int) -> [Wall] = fun (cx, cy, r, a0, a1, n) ->
  let px : Int -> Int = fun i -> cx + int_of_float(float_of_int(r) *. cos(float_of_int(a0 + (a1 - a0) * i / n) /. 1000.)) in
  let py : Int -> Int = fun i -> cy + int_of_float(float_of_int(r) *. sin(float_of_int(a0 + (a1 - a0) * i / n) /. 1000.)) in
  let go : Int -> [Wall] = fun i -> if i >= n then [] else w(px(i), py(i), px(i + 1), py(i + 1)) :: go(i + 1) in
  go(0);
# a row of n lamps from (x0, y0) to (x1, y1), in group g #
let lamps : (Int, Int, Int, Int, Int, Int) -> [Light] = fun (x0, y0, x1, y1, n, g) ->
  let go : Int -> [Light] = fun i -> if i >= n then [] else (x = x0 + (x1 - x0) * i / (n - 1), y = y0 + (y1 - y0) * i / (n - 1), group = g) :: go(i + 1) in
  go(0);
# What every board has: the right wall, the launch lane (its floor too) and the arch over the top; the rest (the left wall, the slopes, the flippers, the chambers) is each board's own #
let shell : [Wall] = join([w(580, 300, 580, 1000), w(545, 330, 545, 1000), w(545, 965, 580, 965)], arc(300, 300, 280, 3142, 6283, 16));
# a board: its name, colours and pattern, its walls, bumpers and their tracks, flippers, portals and lamps, and its gravity; the shell and the launch lane's start the same on every board #
let bd : (String, String, String, String, String, [Wall], [Bumper], [Track], [Flipper], [Portal], [Light], Int) -> Board = fun (name, bg, ink, glow, pattern, walls, bumpers, tracks, flippers, portals, lights, gravity) ->
  (name = name, bg = bg, ink = ink, glow = glow, pattern = pattern, walls = join(shell, walls), bumpers = bumpers, tracks = tracks, flippers = flippers, portals = portals, lights = lights,
   sx = 562, sy = 940, svx = 0, svy = 0 - 300, gravity = gravity);
