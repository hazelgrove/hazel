let board : Int -> Board = fun i ->
  let nth : ([Board], Int) -> Board = fun (bs, k) -> case bs | [] => bd("", "#000000", "#ffffff", "#ffffff", "", [], [], [], [], [], [], 260) | b :: rest => if k <= 0 then b else nth(rest, k - 1) end in
  nth(boards, i);
# ---- A game ---- #
let rests : [Flipper] -> [Int] = fun fs -> case fs | [] => [] | _ :: rest => 500 :: rests(rest) end;
# a new game on board i: three balls, the first in the launch lane, its save ready #
let start : Int -> Game = fun i ->
  let b = board(i) in
  (x = b.sx * 1000, y = b.sy * 1000, vx = 0, vy = 0, flips = rests(b.flippers), score = 0, balls = 3, over = false, hits = [], warp = 0, gate = 0 - 1, save = 0, t = 0);
# each flipper turned toward up while its side's button is held, quickly, else back down, more slowly (angles in thousandths of a radian: 500 resting, -500 up) #
let turn : ([Flipper], [Int], Bool, Bool) -> [Int] = fun (fs, angles, left, right) ->
  case (fs, angles)
  | (f :: frest, a :: arest) =>
    let held = (f.side == 1 && left) || (f.side == 0 - 1 && right) in
    (if held then (if a - 260 < 0 - 500 then 0 - 500 else a - 260) else (if a + 120 > 500 then 500 else a + 120)) :: turn(frest, arest, left, right)
  | _ => []
  end;
# a ball against a piece from (ax, ay) to (bx, by), th thick, whose far end moves (tdx, tdy) a step (a flipper's sweep; 0 for a wall): pushed out of it, its speed reflected (e its bounce) and a kick added along the push; and whether it touched #
let off_seg : (Ball, Float, Float, Float, Float, Float, Float, Float, Float, Float) -> (Ball, Bool) = fun (b, ax, ay, bx, by, th, e, kick, tdx, tdy) ->
  let dx = bx -. ax in
  let dy = by -. ay in
  let t0 = ((b.x -. ax) *. dx +. (b.y -. ay) *. dy) /. (dx *. dx +. dy *. dy +. 0.0001) in
  let t = (if t0 <. 0. then 0. else if t0 >. 1. then 1. else t0) in
  let cx = ax +. t *. dx in
  let cy = ay +. t *. dy in
  let d = sqrt((b.x -. cx) *. (b.x -. cx) +. (b.y -. cy) *. (b.y -. cy)) in
  let reach = 12. +. th in
  if d >=. reach || d <. 0.0001 then (b, false) else
  let nx = (b.x -. cx) /. d in
  let ny = (b.y -. cy) /. d in
  let vn = (b.vx -. t *. tdx) *. nx +. (b.vy -. t *. tdy) *. ny in
  let x2 = cx +. nx *. reach in
  let y2 = cy +. ny *. reach in
  if vn >=. 0. then ((x = x2, y = y2, vx = b.vx, vy = b.vy), true) else
  ((x = x2, y = y2, vx = b.vx -. (1. +. e) *. vn *. nx +. kick *. nx, vy = b.vy -. (1. +. e) *. vn *. ny +. kick *. ny), true);
# the ball against every wall (j counts them); a kicking wall touched scores 10 and is noted among the hits as 1000 + its number #
let walls_hit : (Ball, [Wall], Int, Int, [Int]) -> (Ball, Int, [Int]) = fun (b, ws, j, score, hits) ->
  case ws
  | [] => (b, score, hits)
  | v :: rest =>
    let (b2, hit) = off_seg(b, float_of_int(v.ax), float_of_int(v.ay), float_of_int(v.bx), float_of_int(v.by), 0., float_of_int(v.bounce) /. 100., float_of_int(v.kick) /. 10., 0., 0.) in
    let kicked = hit && v.kick > 0 in
    walls_hit(b2, rest, j + 1, (if kicked then score + 10 else score), (if kicked then (1000 + j) :: hits else hits))
  end;
# where a bumper is at step t, and how fast it moves (units a step): its own place, or on its track, so far round #
let track_at : ([Track], Int) -> Track = fun (ts, k) -> case ts | [] => (cx = 0, cy = 0, rx = 0, ry = 0, period = 1) | x :: rest => if k <= 0 then x else track_at(rest, k - 1) end;
let spot : ([Track], Bumper, Int) -> (Float, Float, Float, Float) = fun (ts, p, t) ->
  if p.track < 0 then (float_of_int(p.x), float_of_int(p.y), 0., 0.) else
  let tr = track_at(ts, p.track) in
  let w = (6283185307179586. /. 1000000000000000.) /. float_of_int(tr.period) in
  let th = w *. float_of_int(t) +. (6283185307179586. /. 1000000000000000.) *. float_of_int(p.phase) /. 1000. in
  (float_of_int(tr.cx) +. float_of_int(tr.rx) *. cos(th), float_of_int(tr.cy) +. float_of_int(tr.ry) *. sin(th), 0. -. float_of_int(tr.rx) *. w *. sin(th), float_of_int(tr.ry) *. w *. cos(th));
# the ball against every bumper, where it is at step t: pushed out and kicked away (harder by the bumper's own move toward it); its points scored, its number noted (i counts them) #
let bumps : (Ball, [Bumper], [Track], Int, Int, Int, [Int]) -> (Ball, Int, [Int]) = fun (b, bs, ts, t, i, score, hits) ->
  case bs
  | [] => (b, score, hits)
  | p :: rest =>
    let (px, py, ux, uy) = spot(ts, p, t) in
    let d = sqrt((b.x -. px) *. (b.x -. px) +. (b.y -. py) *. (b.y -. py)) in
    let reach = float_of_int(p.r) +. 12. in
    if d >=. reach || d <. 0.0001 then bumps(b, rest, ts, t, i + 1, score, hits) else
    let nx = (b.x -. px) /. d in
    let ny = (b.y -. py) /. d in
    let vn = b.vx *. nx +. b.vy *. ny in
    let push = ux *. nx +. uy *. ny in
    let out = (if vn <. 0. then 0. -. vn else vn) +. 6. +. (if push >. 0. then push else 0.) in
    bumps((x = px +. nx *. reach, y = py +. ny *. reach, vx = b.vx -. vn *. nx +. out *. nx, vy = b.vy -. vn *. ny +. out *. ny), rest, ts, t, i + 1, score + p.points, i :: hits)
  end;
# a flipper's tip, at angle a (radians) #
let tip : (Flipper, Float) -> (Float, Float) = fun (f, a) -> (float_of_int(f.x) +. float_of_int(f.side * f.len) *. cos(a), float_of_int(f.y) +. float_of_int(f.len) *. sin(a));
# the ball against every flipper, each at the angle it has reached in this small step (u of the way from a0 to a1), sweeping as it turns #
let flips_hit : (Ball, [Flipper], [Int], [Int], Float) -> Ball = fun (b, fs, a0s, a1s, u) ->
  case (fs, a0s, a1s)
  | (f :: frest, a0 :: r0, a1 :: r1) =>
    let a = (float_of_int(a0) +. (float_of_int(a1) -. float_of_int(a0)) *. u) /. 1000. in
    let (tx, ty) = tip(f, a) in
    let (ox, oy) = tip(f, float_of_int(a0) /. 1000.) in
    let (nx, ny) = tip(f, float_of_int(a1) /. 1000.) in
    let (b2, _) = off_seg(b, float_of_int(f.x), float_of_int(f.y), tx, ty, 8., 0.3, 0., nx -. ox, ny -. oy) in
    flips_hit(b2, frest, r0, r1, u)
  | _ => b
  end;
# into a portal: out at its other end, its speed kept (most of it), and which portal (i counts them; -1 for none) #
let through : (Ball, [Portal], Int) -> (Ball, Int) = fun (b, ps, i) ->
  case ps
  | [] => (b, 0 - 1)
  | p :: rest =>
    let dx = b.x -. float_of_int(p.x) in
    let dy = b.y -. float_of_int(p.y) in
    if dx *. dx +. dy *. dy <. float_of_int(p.r * p.r) then ((x = float_of_int(p.tx), y = float_of_int(p.ty), vx = b.vx *. 0.8, vy = b.vy *. 0.8), i) else through(b, rest, i + 1)
  end;
# no faster than 32 units a step: a ball no quicker than that cannot pass through a wall in a small step #
let cap : Ball -> Ball = fun b ->
  let s = sqrt(b.vx *. b.vx +. b.vy *. b.vy) in
  if s <=. 32. then b else (x = b.x, y = b.y, vx = b.vx *. 32. /. s, vy = b.vy *. 32. /. s);
# four small steps of a step: gravity, moving, then the walls, the bumpers, the flippers, the portals; a portal ends the step (its number given back, else -1) #
let sub : (Board, Ball, [Int], [Int], Int, Int, [Int], Int) -> (Ball, Int, [Int], Int) = fun (bo, b, a0s, a1s, k, score, hits, t) ->
  if k >= 4 then (b, score, hits, 0 - 1) else
  let g = float_of_int(bo.gravity) /. 1000. in
  let vy = b.vy +. g /. 4. in
  let moved = cap((x = b.x +. b.vx /. 4., y = b.y +. vy /. 4., vx = b.vx, vy = vy)) in
  let (b1, s1, h1) = walls_hit(moved, bo.walls, 0, score, hits) in
  let (b2, s2, h2) = bumps(b1, bo.bumpers, bo.tracks, t, 0, s1, h1) in
  let b3 = flips_hit(b2, bo.flippers, a0s, a1s, float_of_int(k + 1) /. 4.) in
  let (b4, gi) = through(cap(b3), bo.portals, 0) in
  if gi >= 0 then (b4, s2, h2, gi) else sub(bo, b4, a0s, a1s, k + 1, s2, h2, t);
# One step of the game on board i: the left and right flippers' buttons held or not, and the plunger let go (how hard, 1 to 100; 0 while not). A ball in a portal waits there 40 steps (the page shows its trip) and comes out with 25 points. A ball below the flippers is gone: within 8 seconds of its launch it is saved (once a ball) and waits in the launch lane again; else the next one waits there, or, with none left, the game is over. A ball waiting in the launch lane stays till the plunger is let go: then it is launched, from just out of the lane (on this board's gravity) at the softest to full speed at the hardest #
let step : (Int, Game, Bool, Bool, Int) -> Game = fun (i, g, left, right, launch) ->
  if g.over then g else
  let bo = board(i) in
  let a1s = turn(bo.flippers, g.flips, left, right) in
  if g.warp > 0 then (x = g.x, y = g.y, vx = g.vx, vy = g.vy, flips = a1s, score = g.score, balls = g.balls, over = false, hits = [], warp = g.warp - 1, gate = (if g.warp > 1 then g.gate else 0 - 1), save = g.save, t = g.t + 1) else
  let b0 = (x = float_of_int(g.x) /. 1000., y = float_of_int(g.y) /. 1000., vx = float_of_int(g.vx) /. 1000., vy = float_of_int(g.vy) /. 1000.) in
  let (b, score, hits, gate) = sub(bo, b0, g.flips, a1s, 0, g.score, [], g.t) in
  let ml : Float -> Int = fun f -> int_of_float(floor(f *. 1000. +. 0.5)) in
  let save = (if g.save > 0 then g.save - 1 else g.save) in
  if gate >= 0 then (x = ml(b.x), y = ml(b.y), vx = ml(b.vx), vy = ml(b.vy), flips = a1s, score = score + 25, balls = g.balls, over = false, hits = hits, warp = 40, gate = gate, save = save, t = g.t + 1) else
  if b.y >. 1030. then
    (if g.save > 0 then (x = bo.sx * 1000, y = bo.sy * 1000, vx = 0, vy = 0, flips = a1s, score = score, balls = g.balls, over = false, hits = 2000 :: hits, warp = 0, gate = 0 - 1, save = 0 - 1, t = g.t + 1)
     else if g.balls <= 1 then (x = g.x, y = g.y, vx = 0, vy = 0, flips = a1s, score = score, balls = 0, over = true, hits = hits, warp = 0, gate = 0 - 1, save = 0, t = g.t + 1)
     else (x = bo.sx * 1000, y = bo.sy * 1000, vx = 0, vy = 0, flips = a1s, score = score, balls = g.balls - 1, over = false, hits = hits, warp = 0, gate = 0 - 1, save = 0, t = g.t + 1))
  else
  let waiting = b.x >. 545. && b.y >. 920. && b.vy >. 0. -. 1. && b.vy <. 2. in
  let gr = float_of_int(bo.gravity) /. 1000. in
  let vmin = sqrt(2. *. gr *. 700.) in
  let v = vmin +. (32. -. vmin) *. float_of_int(if launch > 100 then 100 else launch) /. 100. in
  let push = 0 - int_of_float(v *. 1000.) in
  (x = ml(b.x), y = ml(b.y), vx = ml(b.vx), vy = (if waiting then (if launch > 0 then push else 0) else ml(b.vy)), flips = a1s, score = score, balls = g.balls, over = false, hits = hits,
   warp = 0, gate = 0 - 1, save = (if waiting && launch > 0 && save == 0 then 480 else save), t = g.t + 1)
