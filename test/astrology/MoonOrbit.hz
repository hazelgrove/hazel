# The Moon's terms summed: a term with the Sun's anomaly M is reduced by the Earth's eccentricity, E or E squared #
let moon_sum : ([(Int, Int, Int, Int, Float)], Float, Float, Float, Float, Float) -> Float = fun (ts, d, m, mp, f, e) ->
  case ts
  | [] => 0.
  | (a, b, c, k, coef) :: rest =>
    let factor = if b == 0 then 1. else if b == 1 || b == 0 - 1 then e else e *. e in
    coef *. factor *. sin(float_of_int(a) *. d +. float_of_int(b) *. m +. float_of_int(c) *. mp +. float_of_int(k) *. f)
      +. moon_sum(rest, d, m, mp, f, e)
  end;
# The Moon's apparent longitude (Meeus 47, astronomia's moonposition.position, with the nutation) #
let moon : Float -> Float = fun t ->
  let lp = Orbit.horner([(2183164477. /. 10000000.), (48126788123421. /. 100000000.), -(15786. /. 10000000.), 1. /. 538841., -1. /. 65194000.], t) in
  let d = Chart.rad(Orbit.horner([(2978501921. /. 10000000.), (4452671114034. /. 10000000.), -(18819. /. 10000000.), 1. /. 545868., -1. /. 113065000.], t)) in
  let m = Chart.rad(Orbit.horner([(3575291092. /. 10000000.), (359990502909. /. 10000000.), -(1536. /. 10000000.), 1. /. 24490000.], t)) in
  let mp = Chart.rad(Orbit.horner([(1349633964. /. 10000000.), (4771988675055. /. 10000000.), (87414. /. 10000000.), 1. /. 69699., -1. /. 14712000.], t)) in
  let f = Chart.rad(Orbit.horner([93.272095, (4832020175233. /. 10000000.), -(36539. /. 10000000.), -1. /. 3526000., 1. /. 863310000.], t)) in
  let a1 = Chart.rad(119.75 +. 131.849 *. t) in
  let a2 = Chart.rad(53.09 +. 479264.29 *. t) in
  let e = Orbit.horner([1., -0.002516, -(74. /. 10000000.)], t) in
  let extra = 3958. *. sin(a1) +. 1962. *. sin(Chart.rad(lp) -. f) +. 318. *. sin(a2) in
  Zodiac.normalize(lp +. (moon_sum(moon_terms, d, m, mp, f, e) +. extra) /. 1000000. +. Orbit.nutation(t))
