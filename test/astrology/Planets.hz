# The planets' mean orbital elements of date, each a polynomial in Julian centuries from J2000.0: mean longitude, semi-major axis (AU), eccentricity, inclination, ascending node, longitude of perihelion (degrees) (Meeus Table 31.A, from astronomia's src/planetelements.js) #
let elements : Body -> ([Float], [Float], [Float], [Float], [Float], [Float]) = fun b ->
  case b
  | Mercury => ([252.250906, (1494740722491. /. 10000000.), (3035. /. 10000000.), (18. /. 1000000000.)], [(38709831. /. 100000000.)], [(20563175. /. 100000000.), (20407. /. 1000000000.), -(283. /. 10000000000.), -(18. /. 100000000000.)], [7.004986, (18215. /. 10000000.), -(181. /. 10000000.), (56. /. 1000000000.)], [48.330893, (11861883. /. 10000000.), (17542. /. 100000000.), (215. /. 1000000000.)], [77.456119, (15564776. /. 10000000.), (29544. /. 100000000.), (9. /. 1000000000.)])
  | Venus => ([181.979801, (585192130302. /. 10000000.), (31014. /. 100000000.), (15. /. 1000000000.)], [(72332982. /. 100000000.)], [(677192. /. 100000000.), -(47765. /. 1000000000.), (981. /. 10000000000.), (46. /. 100000000000.)], [3.394662, (10037. /. 10000000.), -(88. /. 100000000.), -(7. /. 1000000000.)], [76.67992, (9011206. /. 10000000.), (40618. /. 100000000.), -(93. /. 1000000000.)], [131.563703, (14022288. /. 10000000.), -(107618. /. 100000000.), -(5678. /. 1000000000.)])
  | Sun => ([100.466457, (360007698278. /. 10000000.), (30322. /. 100000000.), (2. /. 100000000.)], [(1000001018. /. 1000000000.)], [(1670863. /. 100000000.), -(42037. /. 1000000000.), -(1267. /. 10000000000.), (14. /. 100000000000.)], [0.], [0.], [102.937348, (17195366. /. 10000000.), (45688. /. 100000000.), -(18. /. 1000000000.)])
  | Mars => ([355.433, (191416964471. /. 10000000.), (31052. /. 100000000.), (16. /. 1000000000.)], [(1523679342. /. 1000000000.)], [(9340065. /. 100000000.), (90484. /. 1000000000.), -(806. /. 10000000000.), -(25. /. 100000000000.)], [1.849726, -(6011. /. 10000000.), (1276. /. 100000000.), -(7. /. 1000000000.)], [49.558093, (7720959. /. 10000000.), (1557. /. 100000000.), (2267. /. 1000000000.)], [336.060234, (18410449. /. 10000000.), (13477. /. 100000000.), (536. /. 1000000000.)])
  | Jupiter => ([34.351519, (30363027748. /. 10000000.), (2233. /. 10000000.), (37. /. 1000000000.)], [(5202603209. /. 1000000000.), (1913. /. 10000000000.)], [(4849793. /. 100000000.), (163225. /. 1000000000.), -(4714. /. 10000000000.), -(201. /. 100000000000.)], [1.303267, -(54965. /. 10000000.), (466. /. 100000000.), -(2. /. 1000000000.)], [100.464407, (10209774. /. 10000000.), (40315. /. 100000000.), (404. /. 1000000000.)], [14.331207, (16126352. /. 10000000.), (103042. /. 100000000.), -(4464. /. 1000000000.)])
  | Saturn => ([50.077444, (12235110686. /. 10000000.), (51908. /. 100000000.), -(3. /. 100000000.)], [(9554909192. /. 1000000000.), -(2139. /. 1000000000.), (4. /. 1000000000.)], [(5554814. /. 100000000.), -(346641. /. 1000000000.), -(6436. /. 10000000000.), (34. /. 10000000000.)], [2.488879, -(37362. /. 10000000.), -(1519. /. 100000000.), (87. /. 1000000000.)], [113.665503, 0.877088, -(12176. /. 100000000.), -(2249. /. 1000000000.)], [93.057237, (19637613. /. 10000000.), (83753. /. 100000000.), (4928. /. 1000000000.)])
  | Uranus => ([314.055005, (4298640561. /. 10000000.), (3039. /. 10000000.), (26. /. 1000000000.)], [(19218446062. /. 1000000000.), -(372. /. 10000000000.), (98. /. 100000000000.)], [(4638122. /. 100000000.), -(27293. /. 1000000000.), (789. /. 10000000000.), (24. /. 100000000000.)], [0.773197, (7744. /. 10000000.), (3749. /. 100000000.), -(92. /. 1000000000.)], [74.005957, (5211278. /. 10000000.), (133947. /. 100000000.), (18484. /. 1000000000.)], [173.005291, 1.486379, (21406. /. 100000000.), (434. /. 1000000000.)])
  | Neptune => ([304.348665, (2198833092. /. 10000000.), (30882. /. 100000000.), (18. /. 1000000000.)], [(30110386869. /. 1000000000.), -(1663. /. 10000000000.), (69. /. 100000000000.)], [(945575. /. 100000000.), (6033. /. 1000000000.), 0., -(5. /. 100000000000.)], [1.769953, -(93082. /. 10000000.), -(708. /. 100000000.), (27. /. 1000000000.)], [131.784057, (11022039. /. 10000000.), (25952. /. 100000000.), -(637. /. 1000000000.)], [48.120276, (14262957. /. 10000000.), (38434. /. 100000000.), (2. /. 100000000.)])
  | _ => ([0.], [0.], [0.], [0.], [0.], [0.])
  end;
# A body's place around the Sun, from its elements at t: ecliptic coordinates of date, in AU #
let heliocentric : (Body, Float) -> (Float, Float, Float) = fun (b, t) ->
  let (ls, axes, es, incs, nodes, peris) = elements(b) in
  let (l, a, e, i, node, peri) = (Orbit.horner(ls, t), Orbit.horner(axes, t), Orbit.horner(es, t), Orbit.horner(incs, t), Orbit.horner(nodes, t), Orbit.horner(peris, t)) in
  let ma = Chart.rad(l -. peri) in
  let ea = Orbit.kepler(ma, e, ma, 8) in
  let xv = a *. (cos(ea) -. e) in
  let yv = a *. sqrt(1. -. e *. e) *. sin(ea) in
  let r = sqrt(xv *. xv +. yv *. yv) in
  let u = Chart.arctan2(yv, xv) +. Chart.rad(peri -. node) in
  let om = Chart.rad(node) in
  let ci = cos(Chart.rad(i)) in
  (r *. (cos(om) *. cos(u) -. sin(om) *. sin(u) *. ci), r *. (sin(om) *. cos(u) +. cos(om) *. sin(u) *. ci), r *. sin(u) *. sin(Chart.rad(i)));
# A planet's longitude as seen from the Earth (the Earth's elements are filed under the Sun's name, above) #
let planet : (Body, Float) -> Float = fun (b, t) ->
  let (x, y, z) = heliocentric(b, t) in
  let (xe, ye, ze) = heliocentric(Sun, t) in
  Zodiac.normalize(Chart.deg(Chart.arctan2(y -. ye, x -. xe)) +. Orbit.nutation(t))
