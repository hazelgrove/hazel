    "{\"lever_L\":false,\"lever_R\":false,\"wiring\":{\"tag\":\"Normal\"},\"draws\":[],\"pits_on\":[],\"covered\":[],\"hatch\":false,\"things\":[],\"rooms\":[],\"exits\":[],\"out\":{\"tag\":\"Auto\"},\"at_col\":2,\"at_row\":2,\"cols\":3,\"rows\":3,\"cells\":[{\"col\":0,\"row\":2,\"kind\":{\"tag\":\"Sea\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"SE\"},{\"tag\":\"S\"},{\"tag\":\"SW\"},{\"tag\":\"W\"}]},{\"col\":1,\"row\":0,\"kind\":{\"tag\":\"Crossing\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"NE\"},{\"tag\":\"S\"},{\"tag\":\"SW\"}]},{\"col\":1,\"row\":1,\"kind\":{\"tag\":\"Castle\"},\"ways\":[{\"tag\":\"NE\"},{\"tag\":\"SE\"},{\"tag\":\"W\"}]},{\"col\":1,\"row\":2,\"kind\":{\"tag\":\"Crossing\"},\"ways\":[{\"tag\":\"SE\"},{\"tag\":\"W\"},{\"tag\":\"NW\"}]},{\"col\":2,\"row\":0,\"kind\":{\"tag\":\"Waterfall\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"NE\"},{\"tag\":\"E\"},{\"tag\":\"S\"},{\"tag\":\"W\"}]},{\"col\":2,\"row\":2,\"kind\":{\"tag\":\"Crossing\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"E\"},{\"tag\":\"SE\"},{\"tag\":\"S\"},{\"tag\":\"W\"},{\"tag\":\"NW\"}]}]}",
    "{\"tag\":\"Way\",\"value\":{\"tag\":\"SW\"}}",
    "{\"tag\":\"Done\"}",
  ),
  (
    "World",
    "Way W from 2,2, 3x3 seed 2",
    "{\"lever_L\":false,\"lever_R\":false,\"wiring\":{\"tag\":\"Normal\"},\"draws\":[],\"pits_on\":[],\"covered\":[],\"hatch\":false,\"things\":[],\"rooms\":[],\"exits\":[],\"out\":{\"tag\":\"Auto\"},\"at_col\":2,\"at_row\":2,\"cols\":3,\"rows\":3,\"cells\":[{\"col\":0,\"row\":2,\"kind\":{\"tag\":\"Sea\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"SE\"},{\"tag\":\"S\"},{\"tag\":\"SW\"},{\"tag\":\"W\"}]},{\"col\":1,\"row\":0,\"kind\":{\"tag\":\"Crossing\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"NE\"},{\"tag\":\"S\"},{\"tag\":\"SW\"}]},{\"col\":1,\"row\":1,\"kind\":{\"tag\":\"Castle\"},\"ways\":[{\"tag\":\"NE\"},{\"tag\":\"SE\"},{\"tag\":\"W\"}]},{\"col\":1,\"row\":2,\"kind\":{\"tag\":\"Crossing\"},\"ways\":[{\"tag\":\"SE\"},{\"tag\":\"W\"},{\"tag\":\"NW\"}]},{\"col\":2,\"row\":0,\"kind\":{\"tag\":\"Waterfall\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"NE\"},{\"tag\":\"E\"},{\"tag\":\"S\"},{\"tag\":\"W\"}]},{\"col\":2,\"row\":2,\"kind\":{\"tag\":\"Crossing\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"E\"},{\"tag\":\"SE\"},{\"tag\":\"S\"},{\"tag\":\"W\"},{\"tag\":\"NW\"}]}]}",
    "{\"tag\":\"Way\",\"value\":{\"tag\":\"W\"}}",
    "{\"tag\":\"Done\"}",
  ),
  (
    "World",
    "Way NW from 2,2, 3x3 seed 2",
    "{\"lever_L\":false,\"lever_R\":false,\"wiring\":{\"tag\":\"Normal\"},\"draws\":[],\"pits_on\":[],\"covered\":[],\"hatch\":false,\"things\":[],\"rooms\":[],\"exits\":[],\"out\":{\"tag\":\"Auto\"},\"at_col\":2,\"at_row\":2,\"cols\":3,\"rows\":3,\"cells\":[{\"col\":0,\"row\":2,\"kind\":{\"tag\":\"Sea\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"SE\"},{\"tag\":\"S\"},{\"tag\":\"SW\"},{\"tag\":\"W\"}]},{\"col\":1,\"row\":0,\"kind\":{\"tag\":\"Crossing\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"NE\"},{\"tag\":\"S\"},{\"tag\":\"SW\"}]},{\"col\":1,\"row\":1,\"kind\":{\"tag\":\"Castle\"},\"ways\":[{\"tag\":\"NE\"},{\"tag\":\"SE\"},{\"tag\":\"W\"}]},{\"col\":1,\"row\":2,\"kind\":{\"tag\":\"Crossing\"},\"ways\":[{\"tag\":\"SE\"},{\"tag\":\"W\"},{\"tag\":\"NW\"}]},{\"col\":2,\"row\":0,\"kind\":{\"tag\":\"Waterfall\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"NE\"},{\"tag\":\"E\"},{\"tag\":\"S\"},{\"tag\":\"W\"}]},{\"col\":2,\"row\":2,\"kind\":{\"tag\":\"Crossing\"},\"ways\":[{\"tag\":\"N\"},{\"tag\":\"E\"},{\"tag\":\"SE\"},{\"tag\":\"S\"},{\"tag\":\"W\"},{\"tag\":\"NW\"}]}]}",
    "{\"tag\":\"Way\",\"value\":{\"tag\":\"NW\"}}",
    "{\"tag\":\"GoSquare\",\"value\":[1,1,{\"tag\":\"SE\"},{\"tag\":\"Done\"}]}",
  ),
];

let json = (v: Js.Unsafe.any): string =>
  Js.to_string(Js.Unsafe.meth_call(Js._JSON, "stringify", [|v|]));
let as_js = (j: string): Js.Unsafe.any =>
  Js.Unsafe.meth_call(
    Js._JSON,
    "parse",
    [|Js.Unsafe.inject(Js.string(j))|],
  );

/* run once: the program's value, the rooms' rules by their lower-case names */
let run = lazy(HazelLibCore.run(program));
let errors = (): int =>
  Js.Unsafe.get(Js.Unsafe.get(Lazy.force(run), "errors"), "length");
let rule = (room: string): Js.Unsafe.any =>
  Js.Unsafe.get(
    Js.Unsafe.get(Lazy.force(run), "value"),
    String.lowercase_ascii(room),
  );

let tests = (
  "HazelLib: Messed Up Dress Up's rules",
  [
    test_case("the game's program has no errors", `Quick, () =>
      check(int, "errors", 0, errors())
    ),
    ...List.map(
         room =>
           test_case(room ++ "'s on_event is a function", `Quick, () =>
             check(
               string,
               "typeof",
               "function",
               Js.to_string(Js.typeof(rule(room))),
             )
           ),
         ["TrapRoom", "TreeRoom", "Square", "Castle", "World"],
       ),
  ]
  @ List.map(
      ((room, what, g, ev, want)) =>
        test_case(room ++ ": " ++ what, `Quick, () =>
          check(
            string,
            "the commands the game's JS gives",
            want,
            json(
              Js.Unsafe.fun_call(rule(room), [|as_js(g), as_js(ev)|]),
            ),
          )
        ),
      cases,
    ),
);
