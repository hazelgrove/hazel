# Snake: one step of the game (the snake moved a cell its way, unless turned straight back on itself; a meal grows it by three; a wall, unless the walls wrap, or its own body ends the game; the next meal on a free cell, by chance), and a robot that plays it, for 🤖 Hazel plays: toward the food by moves after which it can still reach its own tail #
let n : Int = 20;
let md : (Int, Int) -> Int = fun (a, b) -> a - (a / b) * b;
let next : Int -> Int = fun s -> md(s * 48271, 2147483647);
let mem : (Int, [Int]) -> Bool = fun (v, xs) -> case xs | [] => false | x :: rest => x == v || mem(v, rest) end;
let len : [Int] -> Int = fun xs -> case xs | [] => 0 | _ :: rest => 1 + len(rest) end;
let drop_last : [Int] -> [Int] = fun xs -> case xs | [] => [] | x :: rest => (case rest | [] => [] | _ :: _ => x :: drop_last(rest) end) end;
# the cell a step from cell k going direction d: -1 off the board (where the walls do not wrap) #
let toward : (Int, Int, Bool) -> Int = fun (k, d, wrap) ->
  let r = k / n in
  let c = md(k, n) in
  let r1 = (if d == 0 then r - 1 else if d == 2 then r + 1 else r) in
  let c1 = (if d == 1 then c + 1 else if d == 3 then c - 1 else c) in
  if r1 >= 0 && r1 < n && c1 >= 0 && c1 < n then r1 * n + c1
  else if wrap then md(r1 + n, n) * n + md(c1 + n, n) else 0 - 1;
# the next meal: a cell by chance from the seed, or the next free one after it #
let free_from : (Int, [Int], Int) -> Int = fun (k, body, tries) ->
  if tries >= n * n then 0 - 1 else if mem(k, body) then free_from(md(k + 1, n * n), body, tries + 1) else k;
let place : (Int, [Int]) -> Int = fun (seed, body) -> free_from(md(seed, n * n), body, 0);
let start : (Int, Bool) -> Game = fun (seed, wrap) ->
  let body = [10 * n + 8, 10 * n + 7, 10 * n + 6] in
  let s = next(seed + 1) in
  (body = body, dir = 1, grow = 0, food = place(s, body), seed = s, wrap = wrap, score = 0, over = false, hit = 0, t = 0);
# ---- One step ---- #
# want: a direction to turn to, or -1 to go on; turning straight back is not a turn. The head moves a cell; the tail follows unless the snake is growing; a meal is 10 points and three cells to grow #
let step : (Game, Int) -> Game = fun (g, want) ->
  if g.over then g else
  let dir = (if want >= 0 && want <= 3 && want != md(g.dir + 2, 4) then want else g.dir) in
  let head = (case g.body | [] => 0 | h :: _ => h end) in
  let nh = toward(head, dir, g.wrap) in
  let kept = (if g.grow > 0 then g.body else drop_last(g.body)) in
  if nh < 0 || mem(nh, kept) then
    (body = g.body, dir = dir, grow = g.grow, food = g.food, seed = g.seed, wrap = g.wrap, score = g.score, over = true, hit = 2, t = g.t + 1)
  else
  let body = nh :: kept in
  let ate = nh == g.food in
  let s = (if ate then next(g.seed) else g.seed) in
  (body = body, dir = dir, grow = (if g.grow > 0 then g.grow - 1 else 0) + (if ate then 3 else 0), food = (if ate then place(s, body) else g.food), seed = s,
   wrap = g.wrap, score = g.score + (if ate then 10 else 0), over = false, hit = (if ate then 1 else 0), t = g.t + 1);
# ---- The robot (🤖 Hazel plays) ---- #
# how much room there is from a cell: a flood over the cells not in the snake, counting until it has found `want` of them, or no more #
let flood : (Bool, [Int], [Int], [Int], Int, Int) -> Int = fun (wrap, body, frontier, seen, count, want) ->
  if count >= want then count else
  case frontier
  | [] => count
  | k :: rest =>
    let add : ([Int], [Int], Int, Int) -> ([Int], [Int], Int) = fun (fr, sn, c, d) ->
      (let m = toward(k, d, wrap) in if m < 0 || mem(m, sn) || mem(m, body) then (fr, sn, c) else (m :: fr, m :: sn, c + 1)) in
    let (f0, s0, c0) = add(rest, seen, count, 0) in
    let (f1, s1, c1) = add(f0, s0, c0, 1) in
    let (f2, s2, c2) = add(f1, s1, c1, 2) in
    let (f3, s3, c3) = add(f2, s2, c2, 3) in
    flood(wrap, body, f3, s3, c3, want)
  end;
let absi : Int -> Int = fun v -> if v < 0 then 0 - v else v;
# how far a cell is from the food, rows plus columns (the short way round, where the walls wrap) #
let gap : (Int, Int, Bool) -> Int = fun (a, b, wrap) ->
  let dr = absi(a / n - b / n) in
  let dc = absi(md(a, n) - md(b, n)) in
  (if wrap && n - dr < dr then n - dr else dr) + (if wrap && n - dc < dc then n - dc else dc);
# can the head, at the frontier's cells, reach the cell `goal` (the tail's: it moves on, so it is free), over the cells not in `body`: a flood from it, stopping as soon as it finds it #
let reaches : (Bool, [Int], [Int], [Int], Int) -> Bool = fun (wrap, body, frontier, seen, goal) ->
  case frontier
  | [] => false
  | k :: rest =>
    let add : ([Int], [Int], Int) -> ([Int], [Int], Bool) = fun (fr, sn, d) ->
      (let m = toward(k, d, wrap) in if m == goal then (fr, sn, true) else if m < 0 || mem(m, sn) || mem(m, body) then (fr, sn, false) else (m :: fr, m :: sn, false)) in
    let (f0, s0, h0) = add(rest, seen, 0) in
    let (f1, s1, h1) = add(f0, s0, 1) in
    let (f2, s2, h2) = add(f1, s1, 2) in
    let (f3, s3, h3) = add(f2, s2, 3) in
    h0 || h1 || h2 || h3 || reaches(wrap, body, f3, s3, goal)
  end;
let last : [Int] -> Int = fun xs -> case xs | [] => 0 - 1 | x :: rest => (case rest | [] => x | _ :: _ => last(rest) end) end;
# the robot's choice (Matthew: "for snake -- we need better robot automation"; "We are running backwards, with no place to go, eventually --- we could leave ourselves space but do not"; "look at the other games for inspiration, especially the racer game"): of the three directions not straight back, a move is safe if, after it, the head can still reach the tail (the tail always moves on, so following it the snake can never be shut in) and, eating or growing, when the tail stays put a while, it has room at least as long as itself (the light trails' riders keep room the same way, by a flood). Of the safe moves, the one nearest the food, then the one hugging the most walls and body (so it fills the board from the edges in and leaves its room in one piece), straight on when as good. With none safe, the move with the most room (a flood with an early stop, as before); -1 to go on if none can move #
let robot : Game -> Int = fun g ->
  if g.over then 0 - 1 else
  let head = (case g.body | [] => 0 | h :: _ => h end) in
  let kept = (if g.grow > 0 then g.body else drop_last(g.body)) in
  let long = len(g.body) + g.grow + 2 in
  let worth : Int -> Int = fun d ->
    (let m = toward(head, d, g.wrap) in
     if d == md(g.dir + 2, 4) || m < 0 || mem(m, kept) then 0 - 100000 else
     let after = m :: kept in
     let tail = last(after) in
     let inner = drop_last(after) in
     let safe = reaches(g.wrap, inner, [m], [m], tail) && (g.grow == 0 && m != g.food || flood(g.wrap, inner, [m], [m], 1, long) >= long) in
     let hug = (let b : Int -> Int = fun e -> (let q = toward(m, e, g.wrap) in if q < 0 || mem(q, inner) then 1 else 0) in b(0) + b(1) + b(2) + b(3)) in
     if safe then 0 - 10 * gap(m, g.food, g.wrap) + 3 * hug + (if d == g.dir then 1 else 0)
     else 0 - 50000 + 10 * flood(g.wrap, kept, [m], [m], 1, long)) in
  let pick : (Int, Int, Int) -> Int = fun (d, bd, bw) -> if d > 3 then bd else (let w = worth(d) in if w > bw then pick(d + 1, d, w) else pick(d + 1, bd, bw)) in
  pick(0, 0 - 1, 0 - 100000)
