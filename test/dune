(include_subdirs unqualified)

(executable
 (name haz3ltest)
 (flags
  (:standard -open Core))
 (libraries core web menhirParser junit_alcotest bisect_ppx.runtime str)
 (modes js)
 (preprocess
  (pps ppx_deriving.show ppx_sexp_conv)))

(rule
 (alias runtest)
 (action
  (setenv
   IDB_STUB
   ./%{dep:idb_stub.js}
   (setenv
    TEST_JS
    %{dep:haz3ltest.bc.js}
    (run bash %{dep:run_node.sh})))))

(rule
 (alias test-quick)
 (action
  (setenv
   IDB_STUB
   ./%{dep:idb_stub.js}
   (setenv
    TEST_JS
    %{dep:haz3ltest.bc.js}
    (run bash %{dep:run_node.sh} -q)))))
