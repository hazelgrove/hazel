(include_subdirs unqualified)

; Test modules shared between the native and web test runners. Everything
; except the web-dependent suites lives here so the bulk of the tests can
; run natively without node.

(library
 (name haz3ltest_common)
 (wrapped false)
 (modules
  (:standard
   \
   Haz3ltest
   Haz3ltest_web
   Test_AgentControlFlow
   Test_AgentMultiTool
   Test_AgentTools
   Test_AgentUX
   Test_Derivation
   Test_GradingReport
   Test_PromptFactory
   Test_ReparseDocSlides
   Test_StepperBase
   Test_TextRoundtrip
   Test_WorkerServer))
 (libraries str haz3lcore menhirParser junit_alcotest bisect_ppx.runtime)
 (preprocess
  (pps ppx_deriving.show ppx_sexp_conv)))

(executable
 (name haz3ltest)
 (modules Haz3ltest)
 (libraries haz3ltest_common junit_alcotest bisect_ppx.runtime)
 (modes exe)
 (preprocess
  (pps ppx_deriving.show ppx_sexp_conv)))

; Suites that depend on the web library (still js_of_ocaml-only) run under
; node, same as before.

(executable
 (name haz3ltest_web)
 (modules
  Haz3ltest_web
  Test_AgentControlFlow
  Test_AgentMultiTool
  Test_AgentTools
  Test_AgentUX
  Test_Derivation
  Test_GradingReport
  Test_PromptFactory
  Test_ReparseDocSlides
  Test_StepperBase
  Test_TextRoundtrip
  Test_WorkerServer)
 (libraries haz3ltest_common web junit_alcotest bisect_ppx.runtime)
 (modes js)
 (preprocess
  (pps ppx_deriving.show ppx_sexp_conv)))

(rule
 (alias runtest)
 (action
  (run %{dep:haz3ltest.exe})))

(rule
 (alias runtest)
 (action
  (setenv
   IDB_STUB
   ./%{dep:idb_stub.js}
   (setenv
    TEST_JS
    %{dep:haz3ltest_web.bc.js}
    (run bash %{dep:run_node.sh})))))

(rule
 (alias test-quick)
 (action
  (run %{dep:haz3ltest.exe} -q)))

(rule
 (alias test-quick)
 (action
  (setenv
   IDB_STUB
   ./%{dep:idb_stub.js}
   (setenv
    TEST_JS
    %{dep:haz3ltest_web.bc.js}
    (run bash %{dep:run_node.sh} -q)))))
