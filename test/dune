(include_subdirs unqualified)

(executable
 (name haz3ltest)
 (libraries web menhirParser junit_alcotest bisect_ppx.runtime)
 (modes js)
 (preprocess
  (pps ppx_deriving.show)))

(rule
 (alias runtest)
 (action
  (setenv
   IDB_STUB
   ./%{dep:idb_stub.js}
   (setenv
    TEST_JS
    %{dep:haz3ltest.bc.js}
    (run bash %{dep:run_node.sh})))))

(rule
 (alias test-quick)
 (action
  (setenv
   IDB_STUB
   ./%{dep:idb_stub.js}
   (setenv
    TEST_JS
    %{dep:haz3ltest.bc.js}
    (run bash %{dep:run_node.sh} -q)))))
