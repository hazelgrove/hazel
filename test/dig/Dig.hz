# Gnome dig (Deep dig until 0.0.61): a level's ground made by chance (earth, gems, boulders, monsters in their pockets), and one step of the game (1/60 of a second): you dig a cell at a time; a boulder dug under wobbles, then falls, squashing what it lands on; the monsters follow the tunnels toward you, now and then burrowing (never into a gem); your lantern's flash stuns every monster within three cells of you, and a stunned one is caught by walking into it; and a robot that plays it, for 🤖 Hazel plays. (0.0.60, Matthew: "if the AI cannot clear every level, that implies that the levels that are too challenging to clear need a redesign to be clearable": the lantern all around you, at most four monsters, never faster than you dig, burrowing half as often; the robot clears every level of 200 grounds each, the first twelve) #
let w : Int = 14;
let h : Int = 16;
let md : (Int, Int) -> Int = fun (a, b) -> a - (a / b) * b;
let next : Int -> Int = fun s -> md(s * 48271, 2147483647);
let absi : Int -> Int = fun v -> if v < 0 then 0 - v else v;
let at : ([Int], Int) -> Int = fun (xs, i) -> case xs | [] => 1 | x :: rest => if i <= 0 then x else at(rest, i - 1) end;
let set_at : ([Int], Int, Int) -> [Int] = fun (xs, i, v) -> case xs | [] => [] | x :: rest => if i <= 0 then v :: rest else x :: set_at(rest, i - 1, v) end;
let dx : Int -> Int = fun d -> if d == 1 then 1 else if d == 3 then 0 - 1 else 0;
let dy : Int -> Int = fun d -> if d == 0 then 0 - 1 else if d == 2 then 1 else 0;
let inside : (Int, Int) -> Bool = fun (c, r) -> c >= 0 && c < w && r >= 0 && r < h;
let cell : ([Int], Int, Int) -> Int = fun (cs, c, r) -> if inside(c, r) then at(cs, r * w + c) else 1;
let rock_at : ([Rock], Int, Int) -> Bool = fun (rs, c, r) -> case rs | [] => false | x :: rest => (x.c == c && x.r == r) || rock_at(rest, c, r) end;
let mon_at : ([Mon], Int, Int) -> Bool = fun (ms, c, r) -> case ms | [] => false | m :: rest => (m.c == c && m.r == r) || mon_at(rest, c, r) end;
let awake_at : ([Mon], Int, Int) -> Bool = fun (ms, c, r) -> case ms | [] => false | m :: rest => (m.c == c && m.r == r && m.stun <= 0) || awake_at(rest, c, r) end;
# (0.0.68) an animal in a cell #
let animal_at : ([Animal], Int, Int) -> Bool = fun (ans, c, r) -> case ans | [] => false | a :: rest => (a.c == c && a.r == r) || animal_at(rest, c, r) end;
let count_gems : [Int] -> Int = fun cs -> case cs | [] => 0 | x :: rest => (if x == 2 then 1 else 0) + count_gems(rest) end;
# ---- A level's ground ---- #
let ground_from : Int -> [Int] = fun i -> if i >= w * h then [] else (if i < w then 0 else 1) :: ground_from(i + 1);
# n monsters by chance, each in a pocket of three dug cells (rows 5 to 14) #
let pockets : (Int, Int, [Int], [Mon]) -> ([Int], [Mon], Int) = fun (n, seed, cs, ms) ->
  if n <= 0 then (cs, ms, seed) else
  let s1 = next(seed) in
  let c = 1 + md(s1 / 7, w - 4) in let r = 5 + md(s1 / 1000, 10) in
  if cell(cs, c + 1, r) == 0 then pockets(n, s1, cs, ms) else
  pockets(n - 1, s1, set_at(set_at(set_at(cs, r * w + c, 0), r * w + c + 1, 0), r * w + c + 2, 0), (c = c + 1, r = r, stun = 0) :: ms);
# n gems by chance in the earth (rows 2 to 15) #
let gems_in : (Int, Int, [Int]) -> ([Int], Int) = fun (n, seed, cs) ->
  if n <= 0 then (cs, seed) else
  let s1 = next(seed) in
  let c = md(s1 / 7, w) in let r = 2 + md(s1 / 1000, h - 2) in
  if cell(cs, c, r) != 1 then gems_in(n, s1, cs) else gems_in(n - 1, s1, set_at(cs, r * w + c, 2));
# n boulders by chance in the earth (rows 2 to 12), each resting in a cell of its own #
let rocks_in : (Int, Int, [Int], [Rock]) -> ([Int], [Rock], Int) = fun (n, seed, cs, rs) ->
  if n <= 0 then (cs, rs, seed) else
  let s1 = next(seed) in
  let c = md(s1 / 7, w) in let r = 2 + md(s1 / 1000, 11) in
  if cell(cs, c, r) != 1 || cell(cs, c, r + 1) != 1 || rock_at(rs, c, r) then rocks_in(n, s1, cs, rs) else
  rocks_in(n - 1, s1, set_at(cs, r * w + c, 0), (c = c, r = r, wob = 0 - 1, falling = false) :: rs);
# (0.0.68; Matthew: "if a rock falls on an animal in the ground (not a ghost), we lose the level") the animals, each by chance in a cell of earth of its own: the rabbit in rows 2 to 4, the mole in rows 5 to 8, the badger in rows 12 to 14, or, with ground water at row wt, in the three rows just above it; never in the diving gear's column, gc #
let animals_in : ([Int], Int, [Int], Int, Int, [Animal]) -> ([Animal], Int) = fun (kinds, seed, cs, wt, gc, acc) ->
  case kinds
  | [] => (acc, seed)
  | k :: rest =>
    let s1 = next(seed) in
    let c = md(s1 / 7, w) in
    let r = (if k == 17 then 2 + md(s1 / 1000, 3) else if k == 15 then 5 + md(s1 / 1000, 4) else if wt < h then wt - 3 + md(s1 / 1000, 3) else 12 + md(s1 / 1000, 3)) in
    if cell(cs, c, r) != 1 || c == gc || animal_at(acc, c, r) then animals_in(kinds, s1, cs, wt, gc, acc)
    else animals_in(rest, s1, cs, wt, gc, (kind = k, c = c, r = r, fall = 0 - 1, walk = 0 - 1) :: acc)
  end;
let mini : (Int, Int) -> Int = fun (a, b) -> if a < b then a else b;
# a level: the surface open, a shaft down from the middle, then monsters (2, one more every other level, up to 4), gems (10, two more a level, up to 18) and boulders (5, one more a level, up to 8); the monsters move a cell every 14 steps on the first level, 13 on the second, then 12 (as long as you take to dig a cell). (0.0.68; Matthew: "let's include a ground-water element on some levels -- not all of them. the ground water forces the gnome to need diving equipment that's set in that level, at place where the gnome can get it before drowning, by expert play") From the second level on, half the levels by chance have ground water from row 10 or 11 down: every dug cell there is under water. Their diving gear lies three or four cells under the water, in a column no boulder is in, so that from the cell above the water, digging straight down to it takes 36 or 48 steps of your 100 steps of breath. Then the animals. hit: what to show as the level starts #
let level_of : (Int, Int, Int, Int, Int, Int) -> Game = fun (lv, seed, score, lives, t, hit) ->
  let cs0 = set_at(set_at(ground_from(0), w + 7, 0), 2 * w + 7, 0) in
  let (cs1, ms, s1) = pockets(mini(2 + lv / 2, 4), next(seed + 1), cs0, []) in
  let (cs2, s2) = gems_in(mini(10 + 2 * lv, 18), s1, cs1) in
  let (cs3, rs, s3) = rocks_in(mini(5 + lv, 8), s2, cs2, []) in
  let wt = (if lv >= 1 && md(s3 / 13, 2) == 0 then 10 + md(s3 / 17, 2) else h) in
  let free_col : Int -> Int = fun c -> (let rocky : [Rock] -> Bool = fun l -> case l | [] => false | x :: more => x.c == md(c, w) || rocky(more) end in if rocky(rs) then free_col(c + 1) else md(c, w)) in
  let gc = (if wt < h then free_col(md(s3 / 19, w)) else 0 - 1) in
  let (ans, s4) = animals_in([17, 15, 19], next(s3 + 5), cs3, wt, gc, []) in
  (px = 7, py = 0, pd = 2, pwait = 0, cells = cs3, rocks = rs, mons = ms, gems = count_gems(cs3), score = score, lives = lives, level = lv, seed = s4,
   flash = 0, mwait = 30, mpace = (let p = 14 - lv in if p < 12 then 12 else p), dead = 0, over = false, hit = hit, t = t,
   animals = ans, wt = wt, gear = (if wt < h then (wt + 2 + md(s3 / 23, 2)) * w + gc else 0 - 1), diving = false, air = 100);
let start : Int -> Game = fun seed -> level_of(0, seed, 0, 3, 0, 0);
# ---- The boulders ---- #
# each boulder a step on: resting over a dug cell (no boulder there), it wobbles 40 steps, then falls a cell every 4 steps; a monster it lands on is squashed (200 points); on you, you are caught; on an animal (0.0.68), the level is lost; where it cannot fall further it crumbles. The boulders, the monsters left, the points, whether you were caught, whether one squashed (5), landed (6) or fell on an animal (8) #
let roll : ([Rock], [Rock], [Int], [Mon], [Animal], Int, Int, Int, Bool, Int) -> ([Rock], [Mon], Int, Bool, Int) = fun (rs, kept, cs, ms, ans, px, py, score, hurt, ev) ->
  case rs
  | [] => (kept, ms, score, hurt, ev)
  | x :: rest =>
    let open = cell(cs, x.c, x.r + 1) == 0 && !rock_at(rest, x.c, x.r + 1) && !rock_at(kept, x.c, x.r + 1) in
    if !x.falling then
      (if !open then roll(rest, (c = x.c, r = x.r, wob = 0 - 1, falling = false) :: kept, cs, ms, ans, px, py, score, hurt, ev)
       else if x.wob < 0 then roll(rest, (c = x.c, r = x.r, wob = 40, falling = false) :: kept, cs, ms, ans, px, py, score, hurt, ev)
       else if x.wob <= 1 then roll(rest, (c = x.c, r = x.r, wob = 4, falling = true) :: kept, cs, ms, ans, px, py, score, hurt, ev)
       else roll(rest, (c = x.c, r = x.r, wob = x.wob - 1, falling = false) :: kept, cs, ms, ans, px, py, score, hurt, ev))
    else if x.wob > 1 then roll(rest, (c = x.c, r = x.r, wob = x.wob - 1, falling = true) :: kept, cs, ms, ans, px, py, score, hurt, ev)
    else if !open then roll(rest, kept, cs, ms, ans, px, py, score, hurt, (if ev == 0 then 6 else ev))
    else
      (let r1 = x.r + 1 in
       let squash = mon_at(ms, x.c, r1) in
       let ms2 = (if squash then (let drop : [Mon] -> [Mon] = fun l -> case l | [] => [] | m :: more => if m.c == x.c && m.r == r1 then drop(more) else m :: drop(more) end in drop(ms)) else ms) in
       roll(rest, (c = x.c, r = r1, wob = 4, falling = true) :: kept, cs, ms2, ans, px, py, score + (if squash then 200 else 0), hurt || (px == x.c && py == r1),
            (if ev == 8 || animal_at(ans, x.c, r1) then 8 else if squash then 5 else ev)))
  end;
# (0.0.69; Matthew: "can we make shafts of light that come into the holes, from the actual position of the sun", "the animals move away from the light in the hole") whether the sun shines into a cell: a straight line from its middle to the sun (as the page draws it, 1220 across and 210 above the ground, in hundredths of a cell), in steps of a sixth of a cell or so, passing through nothing but dug cells with no boulder, until it is above the ground #
let sunlit : ([Int], [Rock], Int, Int) -> Bool = fun (cs, rs, c, r) ->
  let x0 = c * 100 + 50 in let y0 = r * 100 + 50 in
  let ex = 1220 - x0 in let ey = 0 - 210 - y0 in
  let n = (let a = absi(ex) in let b = absi(ey) in (if a > b then a else b) / 16 + 1) in
  let go : Int -> Bool = fun i -> if i > n then true else
    (let qx = x0 + ex * i / n in let qy = y0 + ey * i / n in
     if qy < 100 then true else if qx < 0 || qx >= 1400 then false else
     if cell(cs, qx / 100, qy / 100) != 0 || rock_at(rs, qx / 100, qy / 100) then false else go(i + 1)) in
  go(1);
# (0.0.68; Matthew: "when the dirt is removed, the worms and moles, etc, should drop down") the animals a step on: one whose own cell is dug out, over a dug cell (no boulder, no animal in it), drops into it, then a cell every 4 steps. (0.0.69) One lying in a hole in the sunlight gets up and, every 20 steps, walks a cell along to the side: to a dug cell in the shade, the one away from the sun first, or else, none in the shade, away from the sun; in the shade, or held by the earth, it rests #
let settle : ([Animal], [Animal], [Int], [Rock]) -> [Animal] = fun (ans, all, cs, rs) ->
  case ans
  | [] => []
  | a :: rest =>
    let open = cell(cs, a.c, a.r) == 0 && cell(cs, a.c, a.r + 1) == 0 && !rock_at(rs, a.c, a.r + 1) && !animal_at(all, a.c, a.r + 1) in
    let still : Int -> Animal = fun wk -> (kind = a.kind, c = a.c, r = a.r, fall = 0 - 1, walk = wk) in
    (if open then (if a.fall > 1 then (kind = a.kind, c = a.c, r = a.r, fall = a.fall - 1, walk = 0 - 1) else (kind = a.kind, c = a.c, r = a.r + 1, fall = 4, walk = 0 - 1))
     else if cell(cs, a.c, a.r) != 0 || !sunlit(cs, rs, a.c, a.r) then still(0 - 1)
     else if a.walk > 1 then still(a.walk - 1)
     else if a.walk < 0 then still(20)
     else
       (let free : Int -> Bool = fun d -> (let k = a.c + d in inside(k, a.r) && cell(cs, k, a.r) == 0 && !rock_at(rs, k, a.r) && !animal_at(all, k, a.r)) in
        let shade : Int -> Bool = fun d -> free(d) && !sunlit(cs, rs, a.c + d, a.r) in
        let back = (if a.c * 100 + 50 < 1220 then 0 - 1 else 1) in
        let d = (if shade(back) then back else if shade(0 - back) then 0 - back else if free(back) then back else if free(0 - back) then 0 - back else 0) in
        (kind = a.kind, c = a.c + d, r = a.r, fall = 0 - 1, walk = 20))) :: settle(rest, all, cs, rs)
  end;
# ---- The monsters ---- #
# a monster's move: of the four ways, the dug cells (no boulder) nearer you; now and then (an eighth of its moves, by chance) it burrows a cell through the earth toward you, digging it, but never into a gem or an animal; a stunned one waits #
let toward : (Mon, [Int], [Rock], [Animal], Int, Int, Int) -> (Mon, [Int]) = fun (m, cs, rs, ans, px, py, luck) ->
  if m.stun > 0 then (m, cs) else
  let dist : Int -> Int = fun d -> (let c = m.c + dx(d) in let r = m.r + dy(d) in absi(c - px) + absi(r - py)) in
  let free : Int -> Bool = fun d -> (let c = m.c + dx(d) in let r = m.r + dy(d) in inside(c, r) && cell(cs, c, r) == 0 && !rock_at(rs, c, r)) in
  let best : (Int, Int, Int) -> Int = fun (d, bd, bv) -> if d > 3 then bd else (let v = dist(d) in if free(d) && v < bv then best(d + 1, d, v) else best(d + 1, bd, bv)) in
  let now = absi(m.c - px) + absi(m.r - py) in
  let d = best(0, 0 - 1, now + (if md(luck, 3) == 0 then 1 else 0)) in
  if d >= 0 then ((c = m.c + dx(d), r = m.r + dy(d), stun = 0), cs) else
  if md(luck / 3, 8) == 0 then
    (let dd = (if absi(m.c - px) > absi(m.r - py) then (if px > m.c then 1 else 3) else (if py > m.r then 2 else 0)) in
     let c = m.c + dx(dd) in let r = m.r + dy(dd) in
     if inside(c, r) && !rock_at(rs, c, r) && r > 0 && cell(cs, c, r) != 2 && !animal_at(ans, c, r) then ((c = c, r = r, stun = 0), set_at(cs, r * w + c, 0)) else (m, cs))
  else (m, cs);
let move_mons : ([Mon], [Int], [Rock], [Animal], Int, Int, Int) -> ([Mon], [Int]) = fun (ms, cs, rs, ans, px, py, seed) ->
  case ms | [] => ([], cs) | m :: rest => (let (m2, cs2) = toward(m, cs, rs, ans, px, py, md(seed / 11, 1000)) in let (more, cs3) = move_mons(rest, cs2, rs, ans, px, py, next(seed)) in (m2 :: more, cs3)) end;
let tick_stun : [Mon] -> [Mon] = fun ms -> case ms | [] => [] | m :: rest => (c = m.c, r = m.r, stun = (if m.stun > 0 then m.stun - 1 else 0)) :: tick_stun(rest) end;
# the lantern's flash: every monster within three cells of you (across and down together), whatever is between, stunned for 180 steps #
let reach : (Mon, Int, Int) -> Int = fun (m, px, py) -> absi(m.c - px) + absi(m.r - py);
let stun_near : ([Mon], Int, Int) -> [Mon] = fun (ms, px, py) ->
  case ms | [] => [] | m :: rest => (let d = reach(m, px, py) in (c = m.c, r = m.r, stun = (if d >= 1 && d <= 3 then 180 else m.stun))) :: stun_near(rest, px, py) end;
let catch_at : ([Mon], Int, Int) -> [Mon] = fun (ms, c, r) -> case ms | [] => [] | m :: rest => if m.c == c && m.r == r && m.stun > 0 then rest else m :: catch_at(rest, c, r) end;
let mcount : [Mon] -> Int = fun ms -> case ms | [] => 0 | _ :: rest => 1 + mcount(rest) end;
# ---- One step ---- #
# want: a way to go (-1 none): you turn to it, and every 8 steps move a cell, digging earth (12 steps) and taking a gem (50 points); not into a boulder. A stunned monster walked into is caught (100 points). flash: the lantern, every 60 steps. Then the boulders, the animals, then the monsters (every mpace steps); an awake monster in your cell catches you: a life gone, 90 steps waiting, then back at the top; the last life ends the game. (0.0.68) Under the ground water without the diving gear you hold your breath, 100 steps of it, back again as soon as you are out; out of breath, you are caught as by a monster. Walking into the gear's cell, you have it for the rest of the level. A boulder falling on an animal loses the level: a life gone, and the level begins again, new. Every gem taken: the next level, 300 points #
let step : (Game, Int, Bool) -> Game = fun (g, want, flash) ->
  if g.over then g else
  if g.dead > 0 then
    (px = (if g.dead == 1 then 7 else g.px), py = (if g.dead == 1 then 0 else g.py), pd = g.pd, pwait = 0, cells = g.cells, rocks = g.rocks, mons = g.mons, gems = g.gems,
     score = g.score, lives = g.lives, level = g.level, seed = g.seed, flash = g.flash, mwait = g.mwait, mpace = g.mpace, dead = g.dead - 1, over = false, hit = 0, t = g.t + 1,
     animals = settle(g.animals, g.animals, g.cells, g.rocks), wt = g.wt, gear = g.gear, diving = g.diving, air = 100)
  else
  let pd = (if want >= 0 && want <= 3 then want else g.pd) in
  let go = g.pwait <= 0 && want >= 0 && want <= 3 in
  let nc = g.px + dx(pd) in let nr = g.py + dy(pd) in
  let can = go && inside(nc, nr) && !rock_at(g.rocks, nc, nr) in
  let kind = (if can then cell(g.cells, nc, nr) else 0) in
  let px = (if can then nc else g.px) in let py = (if can then nr else g.py) in
  let cs0 = (if can && kind != 0 then set_at(g.cells, nr * w + nc, 0) else g.cells) in
  let gem = can && kind == 2 in
  let caught_mon = can && mon_at(g.mons, px, py) && !awake_at(g.mons, px, py) in
  let ms0 = (if caught_mon then catch_at(g.mons, px, py) else g.mons) in
  let pwait = (if can then (if kind != 0 then 12 else 8) else if g.pwait > 0 then g.pwait - 1 else 0) in
  let flashing = flash && g.flash <= 0 in
  let ms1 = tick_stun(if flashing then stun_near(ms0, px, py) else ms0) in
  let (rs, ms2, sc1, squashed_me, rev) = roll(g.rocks, [], cs0, ms1, g.animals, px, py, g.score + (if gem then 50 else 0) + (if caught_mon then 100 else 0), false, 0) in
  let ans = settle(g.animals, g.animals, cs0, rs) in
  let moving = g.mwait <= 1 in
  let s1 = next(g.seed) in
  let (ms3, cs1) = (if moving then move_mons(ms2, cs0, rs, ans, px, py, s1) else (ms2, cs0)) in
  let got = g.gear >= 0 && py * w + px == g.gear in
  let diving = g.diving || got in
  let wet = py >= g.wt && !diving in
  let air = (if wet then g.air - 1 else 100) in
  let mon_caught = squashed_me || awake_at(ms3, px, py) in
  let caught = mon_caught || (wet && air <= 0) in
  let lost = rev == 8 in
  let gems = count_gems(cs1) in
  let lives = (if caught || lost then g.lives - 1 else g.lives) in
  if lost && lives > 0 then level_of(g.level, s1, sc1, lives, g.t + 1, 8) else
  if gems == 0 && !caught && !lost then level_of(g.level + 1, s1, sc1 + 300, lives, g.t + 1, 3) else
  (px = px, py = py, pd = pd, pwait = pwait, cells = cs1, rocks = rs, mons = ms3, gems = gems, score = sc1, lives = lives, level = g.level, seed = s1,
   flash = (if flashing then 60 else if g.flash > 0 then g.flash - 1 else 0), mwait = (if moving then g.mpace else g.mwait - 1), mpace = g.mpace,
   dead = (if caught then 90 else 0), over = lives <= 0,
   hit = (if lost then 8 else if mon_caught then 2 else if caught then 9 else if rev == 5 then 5 else if got then 10 else if caught_mon then 4 else if gem then 1 else if flashing then 7 else rev), t = g.t + 1,
   animals = ans, wt = g.wt, gear = (if got then 0 - 1 else g.gear), diving = diving, air = air);
# ---- The robot (🤖 Hazel plays) ---- #
# an awake monster within k cells of a cell #
let awake_near : ([Mon], Int, Int, Int) -> Bool = fun (ms, c, r, k) -> case ms | [] => false | m :: more => (m.stun <= 0 && absi(m.c - c) + absi(m.r - r) <= k) || awake_near(more, c, r, k) end;
# a cell under a loose or falling boulder (the three cells below it) #
let under_loose : (Game, Int, Int) -> Bool = fun (g, c, r) ->
  let under : [Rock] -> Bool = fun rs -> case rs | [] => false | x :: more => (x.c == c && r > x.r && r <= x.r + 3 && (x.falling || x.wob >= 0)) || under(more) end in under(g.rocks);
# (0.0.68) a cell the robot keeps out of, whatever the monsters: off the ground, a boulder, under a loose or falling boulder; an animal's cell of earth (digging it would let the animal go); a cell under a resting boulder whose digging would let the boulder fall onto an animal; and, without the diving gear, the ground water, but for the gear's own column, down to the gear #
let blocked : (Game, Int, Int) -> Bool = fun (g, c, r) ->
  let down : Int -> Bool = fun k -> if k >= h || (k > r && cell(g.cells, c, k) != 0) then false else animal_at(g.animals, c, k) || down(k + 1) in
  !inside(c, r) || rock_at(g.rocks, c, r) || under_loose(g, c, r)
  || (animal_at(g.animals, c, r) && cell(g.cells, c, r) != 0)
  || (rock_at(g.rocks, c, r - 1) && cell(g.cells, c, r) != 0 && down(r))
  || (!g.diving && r >= g.wt && !(g.gear >= 0 && c == md(g.gear, w) && r <= g.gear / w));
# a cell the robot will not go into: a blocked one; an awake monster or beside one; while the lantern is still charging, within two cells of an awake monster #
let risky : (Game, Int, Int) -> Bool = fun (g, c, r) -> blocked(g, c, r) || awake_near(g.mons, c, r, (if g.flash > 0 then 2 else 1));
let has : ([Int], Int) -> Bool = fun (l, v) -> case l | [] => false | x :: more => x == v || has(more, v) end;
# the gems not beside an awake monster #
let gem_cells : (Game, [Int], Int) -> [Int] = fun (g, cs, i) -> case cs | [] => [] | x :: rest => if x == 2 && !risky(g, md(i, w), i / w) then i :: gem_cells(g, rest, i + 1) else gem_cells(g, rest, i + 1) end;
# a search spreading out from every cell of the frontier at once (the gems, the diving gear, or the monsters), a layer at a time, until it reaches your cell: the cell it came from, the next cell on the shortest way; -1 if none can be reached. It goes round the risky cells, or, plain, only round the blocked ones #
let spread : (Game, [Int], [Int], [Int], Bool) -> Int = fun (g, frontier, seen, out, plain) ->
  case frontier
  | [] => (case out | [] => 0 - 1 | _ :: _ => spread(g, out, seen, [], plain) end)
  | x :: rest =>
    let c = md(x, w) in let r = x / w in
    let near : Int -> Bool = fun d -> (c + dx(d) == g.px && r + dy(d) == g.py) in
    if near(0) || near(1) || near(2) || near(3) then x else
    let add : ([Int], [Int], Int) -> ([Int], [Int]) = fun (sn, o, d) ->
      (let c1 = c + dx(d) in let r1 = r + dy(d) in let k = r1 * w + c1 in
       if !inside(c1, r1) || has(sn, k) || (if plain then blocked(g, c1, r1) else risky(g, c1, r1)) then (sn, o) else (k :: sn, k :: o)) in
    let (s0, o0) = add(seen, out, 0) in let (s1, o1) = add(s0, o0, 1) in let (s2, o2) = add(s1, o1, 2) in let (s3, o3) = add(s2, o2, 3) in
    spread(g, rest, s3, o3, plain)
  end;
# the robot's choice: a flash when an awake monster is within three cells; a stunned monster beside you, caught; (0.0.68) under the water without the gear and short of the breath to dig on down to it, up; else a step toward the nearest gem it can reach without risk (and, turning straight back, now and then on ahead instead, where that is safe: no going round in circles); else toward the diving gear; else, the lantern charged, toward the nearest awake monster, to stun it; else away from the nearest awake monster #
let robot : Game -> Choice = fun g ->
  if g.over || g.dead > 0 then (dir = 0 - 1, flash = false) else
  let way : (Game, Int) -> Int = fun (g, x) -> (let c = md(x, w) in let r = x / w in if c > g.px then 1 else if c < g.px then 3 else if r > g.py then 2 else 0) in
  let awake_cells : [Mon] -> [Int] = fun ms -> case ms | [] => [] | m :: rest => if m.stun <= 0 then (m.r * w + m.c) :: awake_cells(rest) else awake_cells(rest) end in
  let threat : [Mon] -> Bool = fun ms -> case ms | [] => false | m :: more => (m.stun <= 0 && reach(m, g.px, g.py) >= 1 && reach(m, g.px, g.py) <= 3) || threat(more) end in
  let fl = g.flash <= 0 && threat(g.mons) in
  let stunned_dir : Int -> Int = fun d -> if d > 3 then 0 - 1 else (if mon_at(g.mons, g.px + dx(d), g.py + dy(d)) && !awake_at(g.mons, g.px + dx(d), g.py + dy(d)) && !blocked(g, g.px + dx(d), g.py + dy(d)) then d else stunned_dir(d + 1)) in
  let sd = stunned_dir(0) in
  if sd >= 0 then (dir = sd, flash = fl) else
  if g.pwait > 0 then (dir = 0 - 1, flash = fl) else
  if !g.diving && g.py >= g.wt && g.air < 12 * (g.gear / w - g.py + 1) + 16 && !rock_at(g.rocks, g.px, g.py - 1) then (dir = 0, flash = fl) else
  let gs = gem_cells(g, g.cells, 0) in
  let x = spread(g, gs, gs, [], false) in
  if x >= 0 then
    (let d0 = way(g, x) in
     if d0 == md(g.pd + 2, 4) && md(g.seed / 7, 3) == 0 && !risky(g, g.px + dx(g.pd), g.py + dy(g.pd)) then (dir = g.pd, flash = fl) else (dir = d0, flash = fl)) else
  let xg = (if g.gear >= 0 && !g.diving then spread(g, [g.gear], [g.gear], [], false) else 0 - 1) in
  if xg >= 0 then (dir = way(g, xg), flash = fl) else
  let am = awake_cells(g.mons) in
  let y = (if g.flash <= 0 then (case am | [] => 0 - 1 | _ :: _ => spread(g, am, am, [], true) end) else 0 - 1) in
  if y >= 0 && !has(am, y) then (dir = way(g, y), flash = fl) else
  let far : Int -> Int = fun d -> (let c = g.px + dx(d) in let r = g.py + dy(d) in if blocked(g, c, r) || awake_at(g.mons, c, r) then 0 - 1 else
    (let nearest : [Mon] -> Int = fun ms -> case ms | [] => 100 | m :: more => (let v = (if m.stun > 0 then 100 else absi(m.c - c) + absi(m.r - r)) in let u = nearest(more) in if v < u then v else u) end in nearest(g.mons))) in
  let pick : (Int, Int, Int) -> Int = fun (d, bd, bv) -> if d > 3 then bd else (let v = far(d) in if v > bv then pick(d + 1, d, v) else pick(d + 1, bd, bv)) in
  (dir = pick(0, 0 - 1, 0 - 1), flash = fl)