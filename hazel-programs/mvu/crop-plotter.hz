# Crop Plotter #

# Plant a 3x3 grove: pick a seed, then plant cells, rows, or columns. #
# Nested mapi over a list of lists; OnClick plants and OnDoubleClick uproots. #

type Plant = String in
type Grove = [[Plant]] in
type Row = Int in
type Col = Int in

type Model = (
  grove = Grove,
  currentSeed = Plant,
  seedInventory = [Plant]
) in

type Action =
  + SelectSeed(Int)
  + PlantSeed(Row, Col)
  + Uproot(Row, Col)
  + ClearGrove
  + PlantRow(Row)
  + PlantCol(Col)
in

let init: Model = (
  grove = [
    ["", "", ""],
    ["", "", ""],
    ["", "", ""]
  ],
  currentSeed = "🌱",
  seedInventory = ["🌱", "🌿", "🍄", "☘️", "🌸"]
) in

let setCell(grove: Grove, row: Row, col: Col, plant: Plant): Grove =
  mapi(grove, fun (i, r) ->
    if i == row
    then mapi(r, fun (j, c) -> if j == col then plant else c)
    else r)
in

let setRow(grove: Grove, targetRow: Row, plant: Plant): Grove =
  mapi(grove, fun (i, row) ->
    if i == targetRow
    then map(row, fun _ -> plant)
    else row)
in

let setCol(grove: Grove, col: Col, plant: Plant): Grove =
  map(grove, fun row ->
    mapi(row, fun (j, c) -> if j == col then plant else c))
in

let setAll(grove: Grove, plant: Plant): Grove =
  map(grove, fun row -> map(row, fun _ -> plant))
in

let updateGrove(model: Model, f: Grove -> Grove): Model =
  (
    grove = f(model.grove),
    currentSeed = model.currentSeed,
    seedInventory = model.seedInventory
  )
in

let update(model: Model, action: Action): Model =
  case action
  | SelectSeed(idx) =>
      (
        grove = model.grove,
        currentSeed = nth(model.seedInventory, idx),
        seedInventory = model.seedInventory
      )
  | PlantSeed(row, col) =>
      updateGrove(model, fun g -> setCell(g, row, col, model.currentSeed))
  | Uproot(row, col) =>
      updateGrove(model, fun g -> setCell(g, row, col, ""))
  | ClearGrove =>
      updateGrove(model, fun g -> setAll(g, ""))
  | PlantRow(row) =>
      updateGrove(model, fun g -> setRow(g, row, model.currentSeed))
  | PlantCol(col) =>
      updateGrove(model, fun g -> setCol(g, col, model.currentSeed))
  end
in

# ===== VIEW ===== #

let stripBtn(label: String, action: Action): HTML =
  Button(
    [
      OnClick(action),
      Style([
        ("width", "56px"), ("height", "20px"), ("font-size", "0.75em"),
        ("background", "var(--T1)"), ("color", "var(--BR3)"),
        ("border", "1px solid var(--BR1)"), ("border-radius", "3px"),
        ("font-family", "inherit"), ("cursor", "pointer")
      ])
    ],
    [Text(label)]
  )
in

let view(model: Model): HTML =
  Div(
    [Style([
      ("max-width", "320px"), ("margin", "0 auto"), ("text-align", "center"),
      ("font-family", "var(--code-font)"), ("font-size", "0.85em"),
      ("background", "var(--SAND)"), ("color", "var(--STONE)"),
      ("border", "1px solid var(--BR1)"), ("border-radius", "0.4em"),
      ("overflow", "hidden")
    ])],
    [
      Div(
        [Style([("padding", "0.9em 1em 0.8em")])],
        [
          Div([Style([("font-size", "1.2em"), ("font-weight", "bold"), ("color", "var(--BR4)")])],
              [Text("🌙 Crop Plotter")]),
          Div([Style([("font-size", "0.75em"), ("color", "var(--BR3)"), ("margin-top", "0.3em")])],
              [Text("Click to plant, double-click to uproot")])
        ]
      ),
      # Seed inventory: the held seed is marked by border colour, not width, #
      # so selecting one never shifts the row #
      Div(
        [Style([("display", "flex"), ("justify-content", "center"), ("gap", "0.4em"),
                ("padding", "0.7em 1em"), ("background", "var(--T2)"),
                ("border-top", "1px solid var(--BR1)"),
                ("border-bottom", "1px solid var(--BR1)")])],
        mapi(model.seedInventory, fun (idx, seed) ->
          Button(
            [
              OnClick(SelectSeed(idx)),
              Style([
                ("font-size", "1.2em"), ("padding", "0.2em 0.4em"), ("cursor", "pointer"),
                ("font-family", "inherit"), ("border-radius", "3px"),
                ("background", if seed == model.currentSeed then "var(--SAND)" else "var(--T1)"),
                ("border", if seed == model.currentSeed
                           then "1px solid var(--G0)"
                           else "1px solid var(--BR1)")
              ])
            ],
            [Text(seed)]
          )
        )
      ),
      Div(
        [Style([("padding", "0.7em 1em")])],
        [
          # Column planting strip, offset past the row-button column #
          Div(
            [Style([("display", "flex"), ("justify-content", "center"), ("gap", "2px"),
                    ("margin-left", "58px")])],
            mapi(nth(model.grove, 0), fun (col_idx, _cell) ->
              stripBtn("↓ col", PlantCol(col_idx))
            )
          ),
          # Grove grid, each row prefixed by its row-planting button #
          Div(
            [Style([("display", "inline-block"), ("margin-top", "2px")])],
            mapi(model.grove, fun (row_idx, row) ->
              Div(
                [Style([("display", "flex"), ("justify-content", "center"), ("gap", "2px"),
                        ("margin-bottom", "2px")])],
                [stripBtn("→ row", PlantRow(row_idx))] @
                mapi(row, fun (col_idx, cell) ->
                  Button(
                    [
                      OnClick(PlantSeed(row_idx, col_idx)),
                      OnDoubleClick(Uproot(row_idx, col_idx)),
                      Style([
                        ("width", "56px"), ("height", "56px"), ("font-size", "1.5em"),
                        ("background", "var(--T1)"), ("border", "1px solid var(--BR1)"),
                        ("border-radius", "3px"), ("font-family", "inherit"),
                        ("cursor", "pointer")
                      ])
                    ],
                    [Text(if cell == "" then " " else cell)]
                  )
                )
              )
            )
          ),
          Button(
            [
              OnClick(ClearGrove),
              Style([("width", "100%"), ("margin-top", "0.5em"), ("padding", "0.4em"),
                     ("background", "var(--T1)"), ("color", "var(--STONE)"),
                     ("border", "1px solid var(--BR1)"), ("border-radius", "3px"),
                     ("cursor", "pointer"), ("font-family", "inherit"),
                     ("font-size", "0.85em")])
            ],
            [Text("🌾 Clear Grove")]
          )
        ]
      ),
      Div(
        [Style([("padding", "0.6em 1em"), ("font-size", "0.75em"), ("color", "var(--BR3)"),
                ("border-top", "1px solid var(--BR1)")])],
        [Text("Holding " ++ model.currentSeed)]
      )
    ]
  )
in

let subs(_model: Model): Sub = SubNone in

# ===== TESTS ===== #

# With (model, action) order, `update` already has fold_left's shape #
let run(model: Model, actions: [Action]): Model =
  fold_left(actions, update, model)
in

hint "planting a single cell"
test
  update(init, PlantSeed(0, 0)).grove
    == [["🌱", "", ""], ["", "", ""], ["", "", ""]]
end;

hint "row and column planting cross"
test
  let m = run(init, [PlantRow(0), PlantCol(1)]) in
  m.grove == [["🌱", "🌱", "🌱"], ["", "🌱", ""], ["", "🌱", ""]]
end;

hint "planting uses the selected seed, uprooting clears a cell"
test
  let m = run(init, [SelectSeed(2), PlantRow(0), Uproot(0, 1)]) in
  m.grove == [["🍄", "", "🍄"], ["", "", ""], ["", "", ""]]
    && m.currentSeed == "🍄"
end;

hint "clearing the grove empties every cell"
test
  let m = run(init, [PlantCol(1), ClearGrove]) in
  m.grove == [["", "", ""], ["", "", ""], ["", "", ""]]
end;

# Nothing here issues a command, so `update` returns a bare Model and is #
# lifted into the (Model, Cmd) shape the app tuple expects. #

let noCmd(f: (Model, Action) -> Model): (Model, Action) -> (Model, Cmd) =
  fun (model, action) -> (f(model, action), CmdNone)
in

(init, noCmd(update), view, subs)
