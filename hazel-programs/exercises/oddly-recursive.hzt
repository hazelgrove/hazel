@title
Oddly Recursive

@flags
id=3335e34d-d211-4332-91e2-815e9e183885 required_tests=6 provided_tests=2

@points
test_validation=1 mutation_testing=1 impl_grading=2

@prompt
Write a recursive function that determines whether the given integer is odd. 

`odd(n)` is equivalent to `true` iff `n` is odd.

@prelude
let not : Bool -> Bool =
  fun x ->
    if x then false else true
in ¿

@code
let odd: Int -> Bool =
  fun n ->¿
in ¿

@your-tests
test not(false) end;
test not(not(true)) end;
¿

@solution
let odd:Int->Bool =
  fun x ->
    if x < 0
    then odd(-x)
    else if x == 0 then false
    else not(odd(x-1))
in ¿

@bug always returns false
let odd: Int -> Bool =
  fun x -> false
in ¿

@bug always returns true
let odd: Int -> Bool =
  fun x -> true
in ¿

@bug incorrect base case
let odd: Int -> Bool =
  fun x -> if x < 0 then odd(-x)
  else if x == 0 then true
  else if x == 1 then true
  else odd(x - 1) in
¿

@test
test not(odd(0)) end;
test odd(1) end;
test not(odd(2)) end;
test odd(3) end;
test not(odd(42)) end;
test odd(27) end

@hints
zero

@syntax odd is recursive
(IsRecursive odd)
