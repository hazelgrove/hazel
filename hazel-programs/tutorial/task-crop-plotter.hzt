@code
type Plant = String in
type Grove = [[Plant]] in
type Row = Int in
type Col = Int in

type Model = (
  grove = Grove,
  currentSeed = Plant,
  seedInventory = [Plant]
) in

type Action =
  + SelectSeed(Int)
  + PlantSeed(Row, Col)
  + Uproot(Row, Col)
  + ClearGrove
  + PlantRow(Row)
  # TODO: Add PlantCol(Col) here #
in

let init: Model = (
  grove = [
    ["", "", ""],
    ["", "", ""],
    ["", "", ""]
  ],
  currentSeed = "🌱",
  seedInventory = ["🌱", "🌿", "🍄", "☘️", "🌸"]
) in

let setCell(grove: Grove, row: Row, col: Col, plant: Plant): Grove =
  mapi(grove, fun (i, r) ->
    if i == row
    then mapi(r, fun (j, c) -> if j == col then plant else c)
    else r)
in

let setRow(grove: Grove, targetRow: Row, plant: Plant): Grove =
  mapi(grove, fun (i, row) ->
    if i == targetRow
    then map(row, fun _ -> plant)
    else row)
in

# TODO: Complete setCol helper here, AFTER calling it in update below #
let setCol(grove: Grove, col: Col, plant: Plant): Grove =
¿


in

let setAll(grove: Grove, plant: Plant): Grove =
  map(grove, fun row -> map(row, fun _ -> plant))
in

let updateGrove(m: Model, f: Grove -> Grove): Model =
  (
    grove = f(m.grove),
    currentSeed = m.currentSeed,
    seedInventory = m.seedInventory
  )
in

let update(m: Model, action: Action): Model =
  case action
  | SelectSeed(idx) =>
      (
        grove = m.grove,
        currentSeed = nth(m.seedInventory, idx),
        seedInventory = m.seedInventory
      )
  | PlantSeed(row, col) =>
      updateGrove(m, fun g -> setCell(g, row, col, m.currentSeed))
  | Uproot(row, col) =>
      updateGrove(m, fun g -> setCell(g, row, col, ""))
  | ClearGrove =>
      updateGrove(m, fun g -> setAll(g, ""))
  | PlantRow(row) =>
      updateGrove(m, fun g -> setRow(g, row, m.currentSeed))
  # TODO: Add PlantCol case here #
  end
in

let run(init: Model, actions: [Action]): Model =
  fold_left(actions, fun (m, a) -> update(m, a), init)
in

# Existing tests #
test
  let m = update(init, PlantRow(1)) in
  m.grove == [["", "", ""], ["🌱", "🌱", "🌱"], ["", "", ""]]
end;

# New tests for PlantCol #
test
  let m = update(init, PlantCol(0)) in
  m.grove == [["🌱", "", ""], ["🌱", "", ""], ["🌱", "", ""]]
end;

test
  let m = update(init, PlantCol(2)) in
  m.grove == [["", "", "🌱"], ["", "", "🌱"], ["", "", "🌱"]]
end;

test
  let m = run(init, [PlantRow(0), PlantCol(1)]) in
  m.grove == [["🌱", "🌱", "🌱"], ["", "🌱", ""], ["", "🌱", ""]]
end;

test
  let m = run(init, [SelectSeed(2), PlantCol(1)]) in
  m.grove == [["", "🍄", ""], ["", "🍄", ""], ["", "🍄", ""]]
  && m.currentSeed == "🍄"
end

