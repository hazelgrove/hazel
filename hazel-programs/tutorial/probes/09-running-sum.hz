# PROBES TUTORIAL - PART 9: WRITING EXERCISE (FOLD)                #

# Implement `running_sum`: compute a list where each element       #
# is the sum of all elements up to that position.                   #
#                                                                   #
#   running_sum([1, 2, 3]) == [1, 3, 6]                            #
#   running_sum([5]) == [5]                                         #
#   running_sum([]) == []                                           #
#                                                                   #
# Use fold_left to walk through the list:                           #
#   fold_left(list, fn, init) -> result                             #
#   fn takes (accumulator, element) and returns new accumulator     #
#                                                                   #
# Tip: You'll need to track both a running total and the result    #
# list. Use a tuple (total, result_list) as your accumulator.      #
#                                                                   #
# Other useful functions:                                           #
#   append(list1, list2) -> list                                    #
#   Tuple access via pattern: let (x, y) = t                       #
#                                                                   #
# Turn on auto-probe and click inside your fold callback.           #
# In Many mode you can see the accumulator at each step.            #
# =============================================================== #

let running_sum = fun nums ->
  ?


in

test
  running_sum([1, 2, 3])
  == [1, 3, 6]
end;

test
  running_sum([5])
  == [5]
end;

test
  running_sum([])
  == []
end;

test
  running_sum([1, 1, 1, 1])
  == [1, 2, 3, 4]
end

