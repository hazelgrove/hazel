# PROBES TUTORIAL - PART 8: WRITING EXERCISE (CLAMP)               #

# Now it's your turn to write some Hazel code.                     #
# Implement `clamp`: constrain a number to be within [lo, hi].     #
#                                                                   #
#   clamp(5, 0, 10) == 5    (in range — return x)                  #
#   clamp(-3, 0, 10) == 0   (below min — return lo)                #
#   clamp(15, 0, 10) == 10  (above max — return hi)                #
#                                                                   #
# Replace the ? with your implementation using if/else:             #
#   if cond then expr else expr                                     #
#                                                                   #
# Turn on auto-probe and click inside your function as you write   #
# to see intermediate values update live.                           #
# =============================================================== #

let clamp = fun (x, lo, hi) ->
  ?


in

test
  clamp(5, 0, 10)
  == 5
end;

test
  clamp(-3, 0, 10)
  == 0
end;

test
  clamp(15, 0, 10)
  == 10
end;

test
  clamp(0, 0, 10)
  == 0
end;

test
  clamp(10, 0, 10)
  == 10
end

