# PROBES TUTORIAL - PART 10: SAMPLE COLORS                        #

# When you click a sample, other samples change color. These      #
# colors show how each sample's evaluation relates to the one     #
# you selected, whether it ran before, after, or nested          #
# inside or around it.                                             #
#                                                                  #
# Look at the LEGEND at the bottom of the probe sidebar.          #
# Hover over each entry to see what it represents.                #
# =============================================================== #

# BEFORE AND AFTER                                                 #
#                                                                  #
# The simplest case: expressions that evaluate in sequence.        #
#                                                                  #
# TRY THIS: Click the sample for `second` below.                  #
# - `first` shows a Before color (it finished evaluating earlier)  #
# - `third` shows an After color (it hasn't started yet)           #
# Click `first` or `third` to see the pattern shift.               #

let first = ^^probe(1 + 2) in
let second = ^^probe(3 * 4) in
let third = ^^probe(5 + 6) in

# =============================================================== #

# CONTAINS AND INSIDE                                              #
#                                                                  #
# Evaluation isn't just a flat sequence... it has depth.            #
# When you call `daily_water(250, Full)`, the call starts,        #
# then the function body runs, then the call finishes.            #
# The call *contains* the body; the body is *inside* the call.    #
#                                                                  #
# Contains and Before share a color because both represent         #
# things whose evaluation *started* before the focus sample.       #
# Inside and After share a color because both represent            #
# things whose evaluation *finished* after the focus sample.       #
#                                                                  #
# TRY THIS: Click a call sample at the bottom of this section     #
# (e.g. the first one). The body samples above change color       #
# to show they are INSIDE that call.                               #
#                                                                  #
# Now click a body sample instead (e.g. `adj`). The calls         #
# below that launched it are colored as CONTAINS.                  #

type MoonPhase = + New + Waxing + Full + Waning in

let phase_mult: MoonPhase -> Float =
  fun phase -> case phase
    | New => 1.2
    | Full => 0.88
    | Waxing => 1.1
    | Waning => 0.95
  end
in

let daily_water: (Int, MoonPhase) -> Int =
  fun (base, phase) ->
    let adj =
      ^^probe(float_of_int(base) *. phase_mult(phase)) in
    ^^probe(int_of_float(adj))
in

^^probe(daily_water(250, Full));
^^probe(daily_water(50, New));
^^probe(daily_water(180, Waning));

# =============================================================== #

# DEEPER NESTING                                                   #
#                                                                  #
# With map, each iteration of the callback is inside the           #
# enclosing call. Different calls to the same function show        #
# as unrelated (gray) they're siblings, not ancestors.           #
#                                                                  #
# TRY THIS: Switch to Many mode (double-click a sample).          #
# Click a sample at the `plant` level inside the map callback.    #
# - Samples from the same outer call are colored (related)         #
# - Samples from a different call to bed_labels are gray           #

type Plant = (name = String, icon = String, water = Int) in
let fern: Plant = (name = "Fern", icon = "🌿", water = 250) in
let orchid: Plant = (name = "Orchid", icon = "🌸", water = 180) in
let cactus: Plant = (name = "Cactus", icon = "🍄", water = 50) in

let bed_labels: [Plant] -> [String] =
  fun ^^probe(bed) ->
    ^^probe(map(bed, fun ^^probe(plant) ->
      plant.icon ++ " " ++ plant.name
      ++ ": " ++ string_of_int(plant.water) ++ "ml"
    ))
in

^^probe(bed_labels([fern, orchid]));
^^probe(bed_labels([cactus]))

# =============================================================== #
# You don't need to memorize the color categories. The sidebar   #
# legend is always available. As you work through the study        #
# tasks, the colors help you see at a glance which samples        #
# are connected to whatever you're currently focused on.           #

# END OF PART 10 - Select the next slide from the top menu        #
