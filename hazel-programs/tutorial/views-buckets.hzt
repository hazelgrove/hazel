@title
Views / Hash Buckets

@flags
version=1 id=b3000010-0010-0010-0010-000000000010

@prompt
A `Table` is a hash table with separate chaining: key `k` goes to bucket `k` mod `m`, at the end of that bucket's chain. `^buckets` draws one four lines tall: the slots as a column, each chain as a row of links, and any link past the second in red, since every lookup that reaches it pays an extra step. Every `Table` probe in scope draws this way, so the same ten keys in tables of 4 to 7 buckets show how a size sharing a factor with many keys (4, here) piles them into one chain.

@code
# A Table is a hash table with separate chaining: one chain of keys #
# per bucket #
type Table = + Table([[Int]]) in

# Buckets: the slots as a column, each chain as a row of links. A link #
# past the second is an extra probe on every lookup there, so it is red. #
let ^buckets = {
  type Model = Table;
  type Action = + Nothing;
  let s : Int -> String = string_of_int;
  let row(i: Int): Int = 2 + 12 * i;
  let view(t: Model): HTML =
    case t
    | Table(chains) =>
      let bucket(i: Int, chain: [Int]): HTML =
        Node("g", [],
          [Node("text", [Create("x", "8"), Create("y", s(row(i) + 8)), Create("text-anchor", "end"),
                         Style([("font-family", "var(--code-font)"), ("font-size", "8px"),
                                ("fill", "currentColor"), ("fill-opacity", "0.55")])], [Text(s(i))]),
           Node("rect", [Create("x", "11.5"), Create("y", s(row(i)) ++ ".5"),
                         Create("width", "8"), Create("height", "8"), Create("rx", "1"),
                         Style([("fill", "none"), ("stroke", "currentColor"),
                                ("stroke-opacity", "0.5")])], [])]
          @ (if chain == [] then []
             else [Node("line", [Create("x1", "20"), Create("x2", s(20 + 14 * length(chain) - 8)),
                                 Create("y1", s(row(i) + 4) ++ ".5"), Create("y2", s(row(i) + 4) ++ ".5"),
                                 Style([("stroke", "currentColor"), ("stroke-opacity", "0.4")])], [])])
          @ mapi(chain, fun (k: Int, _: Int) ->
              Node("rect", [Create("x", s(24 + 14 * k)), Create("y", s(row(i) + 2)),
                            Create("width", "10"), Create("height", "5"), Create("rx", "1.5"),
                            Style(if k < 2 then [("fill", "currentColor")]
                                  else [("fill", "var(--text-error)"),
                                        ("opacity", "var(--sample-fade, 1)")])], []))) in
      Node("svg", [Create("viewBox", "0 0 124 88"), Width("124"), Height("88")],
        mapi(chains, bucket))
    end;
  let init : Model = Table([[4, 8], [], [6]]);
  let update(m: Model, _: Action): Model = m;
  let expand(m: Model): Table = m;
  let wrap(v: Table): Model = v;
  let shape : LivelitShape = Block(12, 4)
} in

# Key k goes to bucket k mod m, at the end of its chain #
let insert(chains: [[Int]], m: Int, k: Int): [[Int]] =
  mapi(chains, fun (i: Int, chain: [Int]) -> if i == k - k / m * m then chain @ [k] else chain)
in

let build(m: Int, keys: [Int]): Table =
  let t = Table(fold_left(keys, fun (cs: [[Int]], k: Int) -> insert(cs, m, k),
                          map(range(1, m), fun _ -> []))) in
  ^^probe(t)



in

# Ten keys, many of them multiples of 4, in tables of 4 to 7 buckets #
let keys = [8, 12, 20, 4, 16, 7, 28, 9, 24, 3] in
[build(4, keys), build(5, keys), build(6, keys), build(7, keys)]
