type OptInt = + None + Some(Int);
type OptString = + None + Some(String);

# This only works if every column in the dataset was optional otherwise it will get stuck in indet #
# (benchmark) dropna #
let requires = [];
let ensures = [
  (enforced=("static"), "schema(t2) is equal to schema(t1)")
];
let dropna =
  typfun R ->
    fun (t1 : [R]) ->
      List.filter(
        t1,
        fun row ->
          ! List.any(to_lvs(row), fun e -> e.value == (None : Option))
      )
      : [R];
type StudentFullyOptional = (
  name= OptString,
  age= OptInt,
  favorite_color= OptString
);
let students_fully_optional : [StudentFullyOptional] = (
  [
    (Some("Bob"), None, Some("blue")),
    (Some("Alice"), Some(17), Some("green")),
    (Some("Eve"), Some(13), None)
  ]
);
test
  dropna@<(
    name= OptString,
    age= OptInt,
    favorite_color= OptString
  )>(students_fully_optional)
  == [(Some("Alice"), Some(17), Some("green"))]
  : [
    (name= OptString, age= OptInt, favorite_color= OptString)
  ] end
