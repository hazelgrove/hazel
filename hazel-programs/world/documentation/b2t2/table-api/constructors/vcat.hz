type Student = (
  name= String,
  age= Int,
  favorite_color= String
);
let students : [Student] = (
  [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]
);

# (benchmark) vcat #
let requires = [
  (enforced=("static"), "schema(t1) is equal to schema(t2)")
];
let ensures = [
  (enforced=("static"), "schema(t3) is equal to schema(t1)"),
  (enforced=("no"), "nrows(t3) is equal to nrows(t1) + nrows(t2)")
];
#Hazel tables are lists; so vcat is just list concatenation. This is also the same as add_rows#
let vcat =
  typfun r -> fun (t1 : [r], t2 : [r]) -> t1 @ t2;

test
  let update = (
    typfun row ->
      fun (t1 : [row], f : (row -> ?)) ->
        List.map(t1, fun (r : row) -> (r : ?) ... f(r)) : [?]
  ) in
  vcat@<Student>(
    students,
    update@<Student>(students, fun r -> (age= r.age + 1))
  )
  == (
    [
      ("Bob", 12, "blue"),
      ("Alice", 17, "green"),
      ("Eve", 13, "red"),
      ("Bob", 13, "blue"),
      ("Alice", 18, "green"),
      ("Eve", 14, "red")
    ]
    : [Student]
  ) end
