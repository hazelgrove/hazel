type GradebookEntry = (
  name= String,
  age= Int,
  quiz1= Int,
  quiz2= Int,
  midterm= Int,
  quiz3= Int,
  quiz4= Int,
  final= Int
);
let gradebook : [GradebookEntry] = (
  [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ]
);

# (benchmark) tfilter #
let requires = [
  (enforced=("static"), "schema(r) is equal to schema(t1)")
];
let ensures = [
  (enforced=("static"), "schema(t2) is equal to schema(t1)")
];
let tfilter =
  typfun r ->
    fun (t : [r], f : r -> Bool) -> List.filter(t, f) : [r];
test
  tfilter@<GradebookEntry>(gradebook, fun s -> String.length(s.name) > 3)
  == [("Alice", 17, 6, 8, 88, 8, 7, 85)]
  : [GradebookEntry] end
