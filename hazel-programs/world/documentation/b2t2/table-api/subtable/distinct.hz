type GradebookEntry = (
  name= String,
  age= Int,
  quiz1= Int,
  quiz2= Int,
  midterm= Int,
  quiz3= Int,
  quiz4= Int,
  final= Int
);
let gradebook : [GradebookEntry] = (
  [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ]
);

# (benchmark) distinct #
let requires = [];
let ensures = [
  (enforced=("static"), "schema(t2) is equal to schema(t1)")
];
let distinct =
  typfun row ->
    fun (t : [row]) ->
      List.fold_left(
        t,
        fun (
          acc,
          elem
        ) -> if List.mem(acc, elem) then acc else acc @ [elem],
        []
      )
      : [row];
test
  distinct@<(quiz3= Int)>(List.map(gradebook, select_labels(_, `quiz3`)))
  == [7, 8] : [(quiz3= Int)] end
