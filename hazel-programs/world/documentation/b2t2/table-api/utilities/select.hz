type Student = (
  name= String,
  age= Int,
  favorite_color= String
);
let students : [Student] = (
  [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]
);

# (benchmark) select #
let requires = [];
let ensures = [
  (enforced=("static"), "schema(r1) == schema(t1)"),
  (enforced=("no"), "n is in range(nrows(t1))"),
  (enforced=("static"), "schema(t2) == schema(r2)"),
  (enforced=("no"), "nrows(t2) == nrows(t1)")
];

let select =
  typfun r1 ->
    typfun r2 ->
      fun (t1 : [r1], f : ((r1, Int) -> r2)) ->
        List.mapi(t1, fun (i, r) -> f(r, i)) : [r2];

test
  select@<Student>@<((id= Int, color= String, age= Int))>(
    students,
    fun (r, i) -> (id= i, color= r.favorite_color, age= r.age)
  )
  == [
    (id=0, color="blue", age=12),
    (id=1, color="green", age=17),
    (id= 2, color= "red", age= 13)
  ] end
