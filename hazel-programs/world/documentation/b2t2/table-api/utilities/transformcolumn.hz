type Student = (
  name= String,
  age= Int,
  favorite_color= String
);
let students : [Student] = (
  [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]
);

# (benchmark) transformColumn #
let requires = [
  (enforced=("no"), "c is in header(t1) ")
];
let ensures = [
  (enforced=("no"), "v1 is of sort schema(t1)[c]"),
  (enforced=("live"), "header(t2) is equal to header(t1)"),
  (enforced=("live"), "for all c' in header(t2), if c' is equal to c then schema(t2)[c'] is equal to the sort of v2"),
  (enforced=("live"), "otherwise, then schema(t2)[c'] is equal to schema(t1)[c']"),
  (enforced=("no"), "nrows(t2) is equal to nrows(t1)")
];
let transform_column =
  fun (t : [?], c : String, f : (? -> ?)) ->
    List.map(
      t,
      fun r ->
        List.map(
          to_lvs(r),
          fun e ->
            if e.label == c
            then (label= e.label, value= f(e.value))
            else e
        )
        |> from_lvs
    )
    : [?];

let expected = [
  (name="Bob Smith", age=12, favorite_color="blue"),
  (name="Alice Smith", age=17, favorite_color="green"),
  (name= "Eve Smith", age= 13, favorite_color= "red")
];
test
  transform_column(students, "name", fun n -> n ++ " Smith")
  == expected end;

# (idiomatic) Idiomatic way to do this #
test
  List.map(students, fun r -> r ... (name= r.name ++ " Smith"))
  == expected end
