type Student = (
  name= String,
  age= Int,
  favorite_color= String
);
let students : [Student] = (
  [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]
);

# (benchmark) getColumn (by index) #
let requires = [
  (enforced=("no"), "n is in range(ncols(t))")
];
let ensures = [
  (enforced=("no"), "length(vs) is equal to nrows(t)"),
  (enforced=("live"), "for all v in vs, v is of sort schema(t)[header(t)[n]]")
];
# We don't currently have positional projection on tuples as a builtin #
let get_column1 =
  fun (t, n : Int) ->
    List.map(t, fun r -> to_lvs(r) |> List.nth(_, n)).value;
# Examples #
test
  get_column1(students, 0) == ["Bob", "Alice", "Eve"] end;
test
  get_column1(students, 1) == [12, 17, 13] end;
?;

# (benchmark) getColumn (by name) #
let requires = [(enforced=("no"), "c is in header(t)")];
let ensures = [
  (enforced=("live"), "for all v in vs, v is of sort schema(t)[c]"),
  (enforced=("no"), "length(vs) is equal to nrows(t)")
];
# This is just the projection operator `.` If you use it directly you get the non-length requires/ensures constraints #
let get_column2 =
  fun (t, c : String) ->
    List.map(t, fun r -> to_lvs(r) |> List.find(_,fun label=l, value=v -> l == c)).value;
# Examples #
test
  get_column2(students, "name")
  == ["Bob", "Alice", "Eve"] end;
test
  get_column2(students, "age") == [12, 17, 13] end;
# Using projection #
test
  students.name == ["Bob", "Alice", "Eve"] end;
test
  students.age == [12, 17, 13] end
