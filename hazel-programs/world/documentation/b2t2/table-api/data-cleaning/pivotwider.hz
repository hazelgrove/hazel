# (benchmark) pivotWider #
let requires = [
  (enforced=("no"), "c1 is in header(t1)"),
  (enforced=("no"), "c2 is in header(t1)"),
  (enforced=("no"), "schema(t1)[c1] is ColName"),
  (enforced=("no"), "concat(removeAll(header(t1), [c1, c2]), removeDuplicates(getColumn(t1, c1))) has no duplicates")
];
let ensures = [
  (enforced=("live"), "header(t2) is equal to concat(removeAll(header(t1), [c1, c2]), removeDuplicates(getColumn(t1, c1)))"),
  (enforced=("live"), "for all c in removeAll(header(t1), [c1, c2]), schema(t2)[c] is equal to schema(t1)[c]"),
  (enforced=("live"), "for all c in removeDuplicates(getColumn(t1, c1)), schema(t2)[c] is equal to schema(t1)[c2]")
];
let distinct =
  fun xs ->
    case xs
    | [] => []
    | (x :: xs) =>
      let seen = distinct(xs) in
      if List.mem(xs, x) then xs else x :: xs
    end;
let pivot_wider =
  fun (t1, c1, c2) ->
    let kept_columns =
      List.map(
        t1,
        fun row ->
          let entries = to_lvs(row) in
          List.filter(
            entries,
            fun (label= l, value= v) -> ! List.mem([c1, c2], l)
          )
          |> from_lvs
      )
      |> distinct in
    let new_columns =
      List.flat_map(
        t1,
        fun row ->
          let entries = to_lvs(row) in
          List.find_map(
            entries,
            fun (label= l, value= v) ->
              if l == c1 then Some(v) else None
          )
          |> Option.to_list
      )
      |> distinct in
    List.map(
      kept_columns,
      fun kept ->
        kept
        ... (
          List.map(
            new_columns,
            fun c -> (
              label= c,
              value=
              List.find_map(
                t1,
                fun r ->
                  let entries = to_lvs(r) in
                  if (
                    List.filter(
                      entries,
                      fun (label= l, value= v) -> ! List.mem([c1,c2], l)
                    )
                    |> from_lvs
                  )
                  == kept
                  && List.find_map(
                    entries,
                    fun (label= l, value= v) ->
                      if l == c1 then Some(v) else None
                  )
                  == Some(c)
                  then List.find_map(
                    entries,
                    fun (label= l, value= v) ->
                      if l == c2 then Some(v) else None
                  )
                  else None
              )
            )
          )
          |> from_lvs
        )
    )
    : [?];
type Student = (
  name= String,
  age= Int,
  favorite_color= String
);
let students : [Student] = (
  [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]
);
# We are not flattening the rows in this to coallesce the sparseness #
test
  pivot_wider(students, "name", "age")
  == [
    (favorite_color="blue", `Bob`=Some(12), `Alice`=None, `Eve`=None),
    (favorite_color="green", `Bob`=None, `Alice`=Some(17), `Eve`=None),
    (favorite_color="red", `Bob`=None, `Alice`=None, `Eve`=Some(13))
  ] end
