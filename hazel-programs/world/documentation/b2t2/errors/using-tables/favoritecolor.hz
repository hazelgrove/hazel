let tfilter = (
  typfun row ->
    fun (t1 : [row], pred : row -> Bool) -> List.filter(t1, pred)
);
type Student = (
  name= String,
  age= Int,
  favorite_color= String
);
let students : [Student] = (
  [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]
);
let incorrect =
  tfilter@<Student>(students, fun r -> r.favorite_color);
let correct =
  tfilter@<Student>(students, fun r -> r.favorite_color == "green");
test
  correct == [("Alice", 17, "green") : Student] end
