type GradebookEntry = (
  name= String,
  age= Int,
  quiz1= Int,
  quiz2= Int,
  midterm= Int,
  quiz3= Int,
  quiz4= Int,
  final= Int
);
let gradebook : [GradebookEntry] = [
  ("Bob",   12, 8, 9, 77, 7, 9, 87),
  ("Alice", 17, 6, 8, 88, 8, 7, 85),
  ("Eve", 13, 7, 9, 84, 8, 8, 77)
];
let quiz_col_names =
  List.range(1, 5)
  |> List.map(_, fun i -> "quiz" ++ String.of_int(i));
let sum = List.fold_left(_, Int.plus, 0);
List.map(
  gradebook,
  fun gb ->
    let scores =
      to_lvs(gb)
      |> List.filter(_, fun e -> List.mem(quiz_col_names, e.label))
      |> List.map(_, fun e -> e.value) in
    gb
    ... (
      average_score=
      Float.of_int(sum(scores)) /. Float.of_int(List.length(scores))
    )
)
