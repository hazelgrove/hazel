let get_value =
  fun (r : ?, label : String) ->
    List.find(to_lvs(r), fun e ->e.label == label).value;
let add_rows =
  typfun row -> fun (r : row, rs : [row]) -> rs @ [r];
let add_col =
  fun (t : [?], c : String, vs : [?]) ->
    List.zip(t, vs)
    |> List.map(_, fun (r, v) -> from_lvs(to_lvs(r) @ [(c, v)]));
let remove_duplicates =
  fun (xs : [?]) ->
    List.fold_left(
      xs,
      fun (seen, x) -> if List.mem(seen, x) then seen else seen @ [x],
      []
    );
let drop_columns =
  fun (t : [?], c : [String]) ->
    List.map(
      t,
      fun row ->
        to_lvs(row)
        |> List.filter(
          _,
          fun entry -> ! List.any(c, fun col -> entry.label == col)
        )
        |> from_lvs
    );
let build_col =
  fun (t : [?], c : String, f : ? -> ?) ->
    List.map(t, fun (r) -> from_lvs(to_lvs(r) @ [(c, f(r))]));
let empty_table : [()] = [];
let table_of_column =
  fun c, vs ->
    let t1 = add_rows@<?>(empty_table, List.map(vs, fun _ -> ())) in
    add_col(t1, c, vs);
let get_col =
  fun (t, c : String) ->
    List.map(t, fun r -> to_lvs(r) |> List.find(_, fun (label=l, value=v) -> l == c)).value;
let group_by_subtractive =
  fun t, c ->
    let keys =
      get_col(t, c)
      |> remove_duplicates
      |> table_of_column("key", _) in
    let make_group =
      fun kr ->
        let k = kr.key in
        let g = List.filter(t, fun r -> get_value(r, c) == k) in
        drop_columns(g, [c]) in
    build_col(keys, "groups", make_group);

type GradebookEntry = (
  name= String,
  age= Int,
  quiz1= Int,
  quiz2= Int,
  midterm= Int,
  quiz3= Int,
  quiz4= Int,
  final= Int
);
let gradebook : [GradebookEntry] = [
  ("Bob",   12, 8, 9, 77, 7, 9, 87),
  ("Alice", 17, 6, 8, 88, 8, 7, 85),
  ("Eve", 13, 7, 9, 84, 8, 8, 77)
];

group_by_subtractive(gradebook, "name")
