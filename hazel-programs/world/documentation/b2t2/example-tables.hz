# Example Tables from B2T2 #
# Tables copied from https://github.com/brownplt/B2T2/blob/main/ExampleTables.md #
type OptInt = + None + Some(Int);
type OptString = + None + Some(String);
type Student = (
  name= String,
  age= Int,
  favorite_color= String
);
let students : [Student] = [
  ("Bob", 12, "blue"),
  ("Alice", 17, "green"),
  ("Eve", 13, "red")
];

type StudentMissing = (
  name= String,
  age= OptInt,
  favorite_color= OptString
);
let studentsMissing : [StudentMissing] = [
  ("Bob", None, Some("blue")),
  ("Alice", Some(17), Some("green")),
  ("Eve", Some(13), None)
];

type Employee = (
  last_name= String,
  department_id= OptInt
);
let employees : [Employee] = [
  ("Rafferty", Some(31)),
  ("Jones", Some(33)),
  ("Heisenberg", Some(33)),
  ("Robinson", Some(34)),
  ("Smith", Some(34)),
  ("Williams", None)
];

type Department = (
  department_id= Int,
  department_name= String
);
let departments : [Department] = [
  (31, "Sales"),
  (33, "Engineering"),
  (34, "Clerical"),
  (35, "Marketing")
];

type JellyAnon = (
  get_acne= Bool,
  red= Bool,
  black= Bool,
  white= Bool,
  green= Bool,
  yellow= Bool,
  brown= Bool,
  orange= Bool,
  pink= Bool,
  purple= Bool
);
let jellyAnon : [JellyAnon] = [
  (true, false, false, false, true, false, false, true, false, false),
  (true, false, true, false, true, true, false, false, false, false),
  (false, false, false, false, true, false, false, false, true, false),
  (false, false, false, false, false, true, false, false, false, false),
  (false, false, false, false, false, true, false, false, true, false),
  (true, false, true, false, false, false, false, true, true, false),
  (false, false, true, false, false, false, false, false, true, false),
  (true, false, false, false, false, false, true, true, false, false),
  (true, false, false, false, false, false, false, true, false, false),
  (false, true, false, false, false, true, true, false, true, false)
];

