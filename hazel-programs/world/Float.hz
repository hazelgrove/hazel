# Float: floating-point numbers #
module Float = {
  let infinity = $prim.infinity;
  let neg_infinity = $prim.neg_infinity;
  let nan = $prim.nan;
  let epsilon = $prim.epsilon_float;
  let pi = $prim.pi;
  let abs = $prim.abs_float;
  let ceil = $prim.ceil;
  let floor = $prim.floor;
  let round = $prim.round;
  let exp = $prim.exp;
  let log = $prim.log;
  let log10 = $prim.log10;
  let sqrt = $prim.sqrt;
  let sin = $prim.sin;
  let cos = $prim.cos;
  let tan = $prim.tan;
  let asin = $prim.asin;
  let acos = $prim.acos;
  let atan = $prim.atan;
  let min = $prim.float_min;
  let max = $prim.float_max;
  let clamp = $prim.float_clamp;
  let mod = $prim.float_mod;
  let is_finite = $prim.is_finite;
  let is_infinite = $prim.is_infinite;
  let is_nan = $prim.is_nan;
  let compare = $prim.float_compare;
  let plus = $prim.float_plus;
  let minus = $prim.float_minus;
  let times = $prim.float_times;
  let power = $prim.float_power;
  let divide = $prim.float_divide;
  let lt = $prim.float_lt;
  let lte = $prim.float_lte;
  let gt = $prim.float_gt;
  let gte = $prim.float_gte;
  let eq = $prim.float_eq;
  let neq = $prim.float_neq;
  let of_int = $prim.float_of_int;
  let of_sint = $prim.float_of_sint;
  let of_nat = $prim.float_of_nat;
  let of_bool = $prim.float_of_bool;
  let of_string = $prim.float_of_string
}
