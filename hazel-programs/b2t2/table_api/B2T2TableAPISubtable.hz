type Student = (name=String, age=Int, favorite_color=String) in
let students : [Student] = ^^fold([
("Bob", 12, "blue"),
("Alice", 17, "green"),
("Eve", 13, "red")
]) in
type GradebookEntry = (name=String, age=Int, quiz1=Int, quiz2=Int, midterm=Int, quiz3=Int, quiz4=Int, final=Int) in
let gradebook : [GradebookEntry] = ^^fold([
("Bob",   12, 8, 9, 77, 7, 9, 87),
("Alice", 17, 6, 8, 88, 8, 7, 85),
("Eve",   13, 7, 9, 84, 8, 8, 77)
]) in
let select_rows1 =
let requires = [(enforced=^^check(false), "for all n in ns, n is in range(nrows(t1))")] in
let ensures = [
(enforced=^^check(true), "schema(t2) is equal to schema(t1)"),
(enforced=^^check(false), "nrows(t2) is equal to length(ns)")
] in
# We drop rows that are out of bounds #
let select_rows1 = typfun r -> fun (t1:[r], ns:[Int]) -> map(ns, nth_opt(t1, _)) |> filter_map(_, fun x ->x) in

test select_rows1@<Student>(students, [2, 0, 2, 1]) == [("Eve", 13, "red"), ("Bob", 12, "blue"), ("Eve", 13, "red"), ("Alice", 17, "green")] : [Student] end
in
let select_rows2 =
let requires = [(enforced=^^check(false), "length(bs) is equal to nrows(t1)")] in
let ensures = [
(enforced=^^check(true), "schema(t2) is equal to schema(t1)"),
(enforced=^^check(false), "nrows(t2) is equal to length(ns)")
] in
let select_rows2 = typfun r -> fun (t1:[r],bs:[Bool]) -> zip(bs, t1) |> filter_map(_, fun (b,r) -> if b then Some(r) else None) in

test select_rows2@<Student>(students, [true, false, true]) == [("Bob", 12, "blue"), ("Eve", 13, "red")] : [Student] end
in
let select_cols1 =
let requires = [(enforced=^^check(false), "length(bs) is equal to ncols(t1)")] in
let ensures = [
(enforced=^^check(false), "header(t2) is a subsequence of header(t1)"),
(enforced=^^check(false), "for all i in range(ncols(t1)), header(t1)[i] is in header(t2) if and only if bs[i] is equal to true"),
(enforced=^^check(false), "schema(t2) is a subsequence of schema(t1)"),
(enforced=^^check(false), "nrows(t2) is equal to nrows(t1)")
] in

let select_cols1 = fun (t1:[?], bs:[Bool]) ->
map(t1,fun r -> to_lvs(r) |> zip(_, bs) |> filter_map(_, fun (e, b) -> if b then Some(e) else None) |> from_lvs) in

test select_cols1(students, [true, true, false]) == [(name="Bob", age=12), (name="Alice", age=17), (name="Eve", age=13)] end
in
let select_cols2 =
let requires = [
(enforced=^^check(false), "ns has no duplicates"),
(enforced=^^check(false), "for all n in ns, n is in range(ncols(t1))")
] in
let ensures = [
(enforced=^^check(false), "ncols(t2) is equal to length(ns)"),
(enforced=^^check(false), "for all i in range(length(ns)), header(t2)[i] is equal to header(t1)[ns[i]]"),
(enforced=^^check(false), "for all c in header(t2), schema(t2)[c] is equal to schema(t1)[c]"),
(enforced=^^check(false), "nrows(t2) is equal to nrows(t1)")
] in
let select_cols2 = fun (t1:[?], ns:[Int]) ->
map(t1,fun r -> to_lvs(r) |>(fun entries -> map(ns,nth_opt(entries,_))) |> filter_map(_,fun (e) -> e) |> from_lvs) in

test select_cols2(students, [2, 1]) == [(favorite_color="blue", age=12), (favorite_color="green", age=17), (favorite_color="red", age=13)] end
in
let select_cols_3 = 
let requires=[
(enforced=^^check(false), "cs has no duplicates"),
(enforced=^^check(false), "for all c in cs, c is in header(t1)")
] in
let ensures=[
(enforced=^^check(false), "header(t2) is equal to cs"),
(enforced=^^check(false), "for all c in header(t2), schema(t2)[c] is equal to schema(t1)[c]"),
(enforced=^^check(false), "nrows(t2) is equal to nrows(t1)")
] in 
let select_cols3 = fun (t1:[?], cs:[String]) ->
map(t1,fun r -> to_lvs(r) |>(fun entries -> filter_map(cs, fun c -> find_opt(entries, fun e -> e.label == c))) |> from_lvs) in

test select_cols3(students, ["favorite_color", "age"]) == [(favorite_color="blue", age=12), (favorite_color="green", age=17), (favorite_color="red", age=13)] end;

# We have label filtering on tuples as a primitive operation but without row types there's no way to give it a first-class type. This is the idiomatic way to do the operation #
test map(students, select_labels(_, `favorite_color`, `age`)) == [(favorite_color="blue", age=12), (favorite_color="green", age=17), (favorite_color="red", age=13)] end
in
let head =
let requires=[
(enforced=^^check(false), "if n is non-negative then n is in range(nrows(t1))"),
(enforced=^^check(false), "if n is negative then - n is in range(nrows(t1))")
] in
let ensures=[
(enforced=^^check(true), "schema(t2) is equal to schema(t1)"),
(enforced=^^check(false), "if n is non-negative then nrows(t2) is equal to n"),
(enforced=^^check(false), "if n is negative then nrows(t2) is equal to nrows(t1) + n")
] in

let head = typfun r -> fun (t1:[r], n:Int) ->
take(t1, if n >=0 then n else length(t1) + n):[r] in

test head@<Student>(students, -2) == [("Bob", 12, "blue")] : [Student] end
in
let distinct = 
let requires=[] in
let ensures=[(enforced=^^check(true), "schema(t2) is equal to schema(t1)")] in
let distinct = typfun row ->fun (t:[row]) ->
fold_left(t, fun (acc,elem) -> if mem(acc,elem) then acc else acc @ [elem], []):[row] in

test distinct@<(quiz3=Int)>(map(gradebook, select_labels(_, `quiz3`))) == [7, 8] : [(quiz3=Int)] end
in
let drop_column =
# omit_labels is a primitive operation to drop columns but without row types there's no way to give it a first-class type. This is the idiomatic way to do the operation #
let requires=[(enforced=^^check(false), "c is in header(t1)")] in # This is ensured if using omit_labels #
let ensures=[
(enforced=^^check(false), "nrows(t2) is equal to nrows(t1)"),
(enforced=^^check(false), "header(t2) is equal to removeAll(header(t1), [c])"), # This is ensured if using omit_labels #
(enforced=^^check(false), "schema(t2) is a subsequence of schema(t1)")
] in

let drop_column = fun (t:[?], c:String) ->
map(t, fun row -> to_lvs(row) |> filter(_, fun entry -> entry.label != c) |> from_lvs):[?] in

test drop_column(gradebook, "final") == [
("Bob",   12, 8, 9, 77, 7, 9),
("Alice", 17, 6, 8, 88, 8, 7),
("Eve",   13, 7, 9, 84, 8, 8)
] : ^^fold([(name=String, age=Int, quiz1=Int, quiz2=Int, midterm=Int, quiz3=Int, quiz4=Int)]) end;
test map(gradebook, omit_labels(_, `final`)) == [
("Bob",   12, 8, 9, 77, 7, 9),
("Alice", 17, 6, 8, 88, 8, 7),
("Eve",   13, 7, 9, 84, 8, 8)
] : ^^fold([(name=String, age=Int, quiz1=Int, quiz2=Int, midterm=Int, quiz3=Int, quiz4=Int)]) end
in
let drop_columns =
# omit_labels is a primitive operation to drop columns but without row types there's no way to give it a first-class type. This is the idiomatic way to do the operation #
let requires=[
(enforced=^^check(false), "for all c in cs, c is in header(t1)"), # This is ensured if using omit_labels #
(enforced=^^check(false), "cs has no duplicates")
] in
let ensures=[
(enforced=^^check(false), "nrows(t2) is equal to nrows(t1)"),
(enforced=^^check(false), "header(t2) is equal to removeAll(header(t1), cs)"), # This is ensured if using omit_labels #
(enforced=^^check(false), "schema(t2) is a subsequence of schema(t1)")
] in

let drop_columns = fun (t:[?], cs:[String]) ->
map(t,fun row -> to_lvs(row) |> filter(_, fun entry -> !any(cs, string_eq(entry.label, _))) |> from_lvs):[?] in

test drop_columns(gradebook, ["final", "midterm"]) == [
("Bob",   12, 8, 9, 7, 9),
("Alice", 17, 6, 8, 8, 7),
("Eve",   13, 7, 9, 8, 8)

] : ^^fold([(name=String, age=Int, quiz1=Int, quiz2=Int, quiz3=Int, quiz4=Int)]) end;
test map(gradebook, omit_labels(_, `final`, `midterm`)) == [
("Bob",   12, 8, 9, 7, 9),
("Alice", 17, 6, 8, 8, 7),
("Eve",   13, 7, 9, 8, 8)
] : ^^fold([(name=String, age=Int, quiz1=Int, quiz2=Int, quiz3=Int, quiz4=Int)]) end
in
let tfilter = 
let requires=[(enforced=^^check(true), "schema(r) is equal to schema(t1)")] in
let ensures=[(enforced=^^check(true), "schema(t2) is equal to schema(t1)")] in
let tfilter = typfun r ->fun (t:[r], f: r -> Bool) -> filter(t, f):[r] in

test tfilter@<GradebookEntry>(gradebook, fun s -> string_length(s.name) > 3) == [("Alice", 17, 6, 8, 88, 8, 7, 85)] : [GradebookEntry] end
in
?