type GradebookEntry = (name=String, age=Int, quiz1=Int, quiz2=Int, midterm=Int, quiz3=Int, quiz4=Int, final=Int) in
let gradebook : [GradebookEntry] = ^^fold([
("Bob",   12, 8, 9, 77, 7, 9, 87),
("Alice", 17, 6, 8, 88, 8, 7, 85),
("Eve",   13, 7, 9, 84, 8, 8, 77)
]) in
let requires = [
(enforced=^^check(false), "for all c in header(r2), c is in header(t1)")
] in
let ensures = [
(enforced=^^check(true), "schema(r1) == schema(t1)"),
(enforced=^^check(false), "header(t2) == header(t1)"),
(enforced=^^check(false), "for all c in header(t2): if c in header(r2) then schema(t2)[c] == schema(r2)[c]"),
(enforced=^^check(false), "otherwise, schema(t2)[c] == schema(t1)[c]"),
(enforced=^^check(false), "nrows(t2) == nrows(t1)")
] in
let update = typfun row -> fun (t1:[row], f:(row -> ?)) ->
map(t1, fun (r : row) -> (r : ?) ... f(r)) : [?] in

test
 update@<GradebookEntry>(gradebook, fun r -> (midterm=85<=r.midterm, final=85<=r.final)) ==
 [(name="Bob", age=12, quiz1=8, quiz2=9, midterm=false, quiz3=7, quiz4=9, final=true),
(name="Alice", age=17, quiz1=6, quiz2=8, midterm=true, quiz3=8, quiz4=7, final=true),
(name="Eve", age=13, quiz1=7, quiz2=9, midterm=false, quiz3=8, quiz4=8, final=false)]
end;

# Without being polymorphic has better types #
test
map(gradebook, fun (r : GradebookEntry) -> r ... (midterm=85<=r.midterm, final=85<=r.final)) ==
[(name="Bob", age=12, quiz1=8, quiz2=9, midterm=false, quiz3=7, quiz4=9, final=true),
(name="Alice", age=17, quiz1=6, quiz2=8, midterm=true, quiz3=8, quiz4=7, final=true),
(name="Eve", age=13, quiz1=7, quiz2=9, midterm=false, quiz3=8, quiz4=8, final=false)]
end