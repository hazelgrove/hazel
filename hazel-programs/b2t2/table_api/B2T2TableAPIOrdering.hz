type GradebookEntry = (name=String, age=Int, quiz1=Int, quiz2=Int, midterm=Int, quiz3=Int, quiz4=Int, final=Int) in
let gradebook : [GradebookEntry] = ^^fold([
("Bob",   12, 8, 9, 77, 7, 9, 87),
("Alice", 17, 6, 8, 88, 8, 7, 85),
("Eve",   13, 7, 9, 84, 8, 8, 77)
]) in
let tsort = 
let requires=[
(enforced=^^check(false), "c is in header(t1)"),
(enforced=^^check(false), "schema(t1)[c] is Number")
] in
let ensures=[
(enforced=^^check(false), "nrows(t2) is equal to nrows(t1)"),
(enforced=^^check(true), "schema(t2) is equal to schema(t1)")
] in
# Idiomatically I think we would do this with a implicit comparator on tuples and then project them #
# This could be done in a typesafe way if a function was passed to do the projection #
let get_value = fun (r, c : String) -> (to_lvs(r) |> find(_, fun (label=l, value=v) -> l == c)).value in
let tsort = typfun r -> fun (t: [?], c: String, b: Bool) -> 
let sorted = sort(fun (first, second) ->
if get_value(first,c) < get_value(second,c) then Lt else Gt,
t) in 
(if b then sorted else reverse(sorted)) : [r] in

test tsort@<GradebookEntry>(gradebook, "final", false) == [
("Bob",   12, 8, 9, 77, 7, 9, 87),
("Alice", 17, 6, 8, 88, 8, 7, 85),
("Eve",   13, 7, 9, 84, 8, 8, 77)
] : [GradebookEntry] end
in
let sort_by_columns =
let requires=[
(enforced=^^check(false), "cs has no duplicates"),
(enforced=^^check(false), "for all c in cs, c is in header(t1)"),
(enforced=^^check(false), "for all c in cs, schema(t1)[c] is Number")
] in
let ensures=[
(enforced=^^check(false), "nrows(t2) is equal to nrows(t1)"),
(enforced=^^check(true), "schema(t2) is equal to schema(t1)")
] in

let lexicographical =typfun t -> fun (comparator : (t,t) -> Ord, ts :[t], ts' :[t]) ->
case (ts,ts')
| ([], []) =>Eq
| ([], _) =>Lt
| (_, []) =>Gt
| (x::xs, y::ys) =>
case comparator(x,y)
| Eq =>lexicographical@<t>(comparator,xs,ys)
| ord =>ord 
end 
end 
in
let int_compare =fun (first, second) ->
if first < second then Lt else if first > second then Gt else Eq in

# Idiomatically I think we would do this with a implicit comparator on tuples and then project them #
let sort_by_columns = typfun r ->
let get_values = fun (r,c :[String]) ->(let entries = to_lvs(r) in filter_map(c,fun c -> find_opt(entries,fun (label=l, value=v) ->string_eq(c,l)))).value in
fun (t:[?], c:[String]) -> sort(fun (f, g) -> let res = lexicographical@<Int>(int_compare,get_values(f,c),get_values(g,c)) in
res,t) : [r] 
in

test sort_by_columns@<GradebookEntry>(gradebook, ["quiz2", "quiz1"])
== [
("Alice", 17, 6, 8, 88, 8, 7, 85),
("Eve",   13, 7, 9, 84, 8, 8, 77),
("Bob",   12, 8, 9, 77, 7, 9, 87)
] : [GradebookEntry] end
in
let order_by = 
let requires=[] in
let ensures=[
(enforced=^^check(true), "schema(r) is equal to schema(t1)"),
(enforced=^^check(true), "schema(t2) is equal to schema(t1)"),
(enforced=^^check(false), "nrows(t2) is equal to nrows(t1)")
] in

# We don't currently have a way to encode a existential type for the key so we're currently using the unknown type. #
# Idiomatically you'd just compose these at the callsite #
let order_by = typfun row-> fun (t1 :[row], comparators : [(get_key=row -> ?, comparator= ? -> Ord)])  ->
let compare = fun (a, b, comparators) -> 
case comparators
| [] => Eq
| (hd::tl) => case hd.comparator(hd.get_key(a), hd.get_key(b))
| Eq => compare(a,b, tl)
| other => other
end
end
in
sort(compare(_,_,comparators),t1): [row] in

test
let average = fun ns -> fold_left(ns, int_plus, 0) / length(ns) in
let midtermAndFinal = fun (r : GradebookEntry) -> [r.midterm, r.final] in
let comp_int = fun a,b -> if a > b then Gt else Lt in
let desc = fun f -> fun (a,b) -> case f(a,b)
| Eq => Eq
| Gt => Lt
| Lt => Gt
end in
let compare_grade = fun (g1, g2) -> comp_int(average(g1), average(g2)) in
let name_length = fun (r : GradebookEntry) -> r.name |> string_length in
order_by@<GradebookEntry>(gradebook, [(name_length, desc(comp_int)), (midtermAndFinal, compare_grade)])
== [
("Alice", 17, 6, 8, 88, 8, 7, 85),
("Eve",   13, 7, 9, 84, 8, 8, 77),
("Bob",   12, 8, 9, 77, 7, 9, 87)
] : [GradebookEntry] end
in ?