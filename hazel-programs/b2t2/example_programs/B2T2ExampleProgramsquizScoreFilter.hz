type GradebookEntry = (name=String, age=Int, quiz1=Int, quiz2=Int, midterm=Int, quiz3=Int, quiz4=Int, final=Int) in
let gradebook : [GradebookEntry] = [
("Bob",   12, 8, 9, 77, 7, 9, 87),
("Alice", 17, 6, 8, 88, 8, 7, 85),
("Eve",   13, 7, 9, 84, 8, 8, 77)
] in
let sum = fold_left(_, int_plus, 0) in
map(
gradebook,
fun gb -> 
let scores = to_lvs(gb)
|> filter(_, fun e -> string_match("quiz.*", e.label)) 
|> map(_, fun e -> e.value) in 

gb ... (average_score=float_of_int(sum(scores)) /. float_of_int(length(scores)))
)