let factorial : Int -> Int =
fun n ->
  if n == 0 then 1
  else n * factorial(n - 1)
in

let _ = hint "factorial base case"
        test factorial(0) == 1 end in

let _ = hint "factorial of 1"
        test factorial(1) == 1 end in

let _ = hint "factorial of 5"
        test factorial(5) == 120 end in

let length : [?] -> Int =
fun xs ->
case xs
| [] => 0
| _::tl => 1 + length(tl)
end
in

let _ = hint "empty list length"
        test length([]) == 0 end in

let _ = hint "list length"
        test length([1, 2, 3]) == 3 end in

let _ = hint "intentional failure"
        test 2 + 2 == 5 end in

()
