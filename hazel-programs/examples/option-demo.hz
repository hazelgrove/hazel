let safe_div = fun x -> fun y ->
  if y == 0
  then None
  else Some(x / y)
in

let unwrap_or = fun default -> fun opt ->
  case opt
  | None => default
  | Some(x) => x
  end
in

test safe_div(10)(2) == Some(5) end;
test safe_div(10)(0) == None end;
test unwrap_or(0)(safe_div(10)(0)) == 0 end;

(safe_div(100)(5), safe_div(100)(0))
