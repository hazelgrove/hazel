# TABLE EXPLORER #

# `explorer` is a function that RETURNS an app, and it is polymorphic in the #
# table's row type. The column to group by and the column to total are #
# parameters, so ONE definition drives an app for any B2T2 table. #

# That is the part a fixed model cannot reach. A literal 4-tuple's `view` #
# fixes one row type, so the same feature written that way is one whole app #
# per schema. Here it is one app, instantiated twice at the bottom. #

# Tables and groupByRetentive are from hazel-programs/docs/b2t2. #

type Student = (name = String, age = Int, favorite_color = String) in

let students : [Student] = [
  ("Bob", 12, "blue"), ("Alice", 17, "green"), ("Eve", 13, "red"),
  ("Ada", 12, "blue"), ("Grace", 17, "red")
] in

type GradebookEntry = (
  name = String, age = Int,
  quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int
) in

let gradebook : [GradebookEntry] = [
  ("Bob", 12, 8, 9, 77, 7, 9, 87),
  ("Alice", 17, 6, 8, 88, 8, 7, 85),
  ("Eve", 13, 7, 9, 84, 8, 8, 77)
] in


# ===== B2T2: groupByRetentive ===== #

# The idiomatic (v2) form from table-api-utilities-groupbyretentive.hz: it #
# takes a function projecting out the group key, so it needs no reflection #
# over column names and keeps its static guarantees. #

let groupByRetentive :
  poly row -> poly key -> ([row], (row -> key)) -> [(key = key, groups = [row])] =
  typfun row ->
    typfun key ->
      fun (t1, c) ->
        case t1
        | [] => []
        | x::xs =>
          let k = c(x) in
          let grouped = groupByRetentive@<row>@<key>(xs, c) in
          case find_opt(grouped, fun g -> g.key == k)
          | Some(g) => ((key = g.key) ... (groups = g.groups @ [x]))
                       :: filter(grouped, fun g -> g.key != k)
          | None => ((key = k) ... (groups = [x])) :: grouped
          end
        end
in


# ===== THE APP ===== #

# The model is a list of hidden keys, so it is the same shape whatever the #
# table's rows are — which is what lets one app serve every schema. #

type Model = (hidden = [String]) in

type Action =
  + Toggle(String)
  + ShowAll
in

let w = 320.0 in
let h = 180.0 in
let base = 140.0 in

let at : (String, Float) -> Attr = fun (k, v) -> Create(k, to_fixed(v, 2)) in

let barsView : ([(label=String, value=Float)], [String]) -> HTML =
  fun (totals, hidden) ->
    let n = length(totals) in
    let vmax =
      fold_left(map(totals, fun r -> r.value),
                fun (a, v) -> if v >. a then v else a, 1.0) in
    let step = w /. float_of_int(if n <= 0 then 1 else n) in
    Node("svg", [
      Create("viewBox", "0 0 " ++ to_fixed(w, 0) ++ " " ++ to_fixed(h, 0)),
      Class("chart-svg")
    ],
    concat(mapi(totals, fun (i, r) ->
      let off = mem(hidden, r.label) in
      let bh = if off then 2.0 else r.value /. vmax *. 110.0 in
      let x = step *. float_of_int(i) +. step *. 0.15 in
      let bw = step *. 0.7 in
      [
        Node("rect", [
          at("x", x), at("y", base -. bh), at("width", bw), at("height", bh),
          Create("fill", if off then "var(--BR2)" else "var(--chart-1)"),
          Create("cursor", "pointer"),
          OnClick(Toggle(r.label))
        ], [Node("title", [], [
             Text(r.label ++ ": " ++ to_fixed(r.value, 0)
                  ++ (if off then " (hidden — click to show)" else " (click to hide)"))])]),
        Node("text", [
          at("x", x +. bw /. 2.0), at("y", base -. bh -. 4.0),
          Class("chart-value")
        ], [Text(if off then "—" else to_fixed(r.value, 0))]),
        Node("text", [
          at("x", x +. bw /. 2.0), at("y", base +. 14.0),
          Class("chart-axis-text chart-axis-x")
        ], [Text(r.label)])
      ])))
in

# One definition, any schema: `key` and `amount` project the two columns the #
# app needs out of whatever a row happens to be. #

let explorer =
  typfun row ->
    fun (table: [row], key: row -> String, amount: row -> Float) ->
      let totals : [(label=String, value=Float)] =
        map(groupByRetentive@<row>@<String>(table, key), fun g ->
          (label = g.key,
           value = fold_left(map(g.groups, amount), fun (a, v) -> a +. v, 0.0)))
      in

      let init : Model = (hidden = []) in

      let update : (Model, Action) -> (Model, Cmd) =
        fun (model, action) ->
          case action
          | Toggle(k) =>
              ((hidden =
                  if mem(model.hidden, k)
                  then filter(model.hidden, fun x -> x != k)
                  else model.hidden @ [k]),
               CmdNone)
          | ShowAll => ((hidden = []), CmdNone)
          end
      in

      let view : Model -> HTML =
        fun model ->
          let shown = filter(totals, fun r -> !mem(model.hidden, r.label)) in
          let sum =
            fold_left(map(shown, fun r -> r.value), fun (a, v) -> a +. v, 0.0) in
          Div([], [
            barsView(totals, model.hidden),
            Div([], [
              Text(string_of_int(length(shown)) ++ " of "
                   ++ string_of_int(length(totals)) ++ " groups, total "
                   ++ to_fixed(sum, 0) ++ "  "),
              Button([OnClick(ShowAll)], [Text("Show all")])
            ])
          ])
      in

      let subs : Model -> Sub = fun _ -> SubNone in

      (init, update, view, subs)
in


# ===== TWO TABLES, ONE APP ===== #

hint "groups are keyed by the projected column"
test
  let (_, _, _, _) = explorer@<Student>(students, fun s -> s.favorite_color,
                                        fun s -> float_of_int(s.age)) in
  length(groupByRetentive@<Student>@<String>(students, fun s -> s.favorite_color)) == 3
end;

hint "hiding a group drops it from the total, and Show all brings it back"
test
  let (init, update, _, _) =
    explorer@<Student>(students, fun s -> s.favorite_color,
                       fun s -> float_of_int(s.age)) in
  let (hidBlue, _) = update(init, Toggle("blue")) in
  let (again, _) = update(hidBlue, Toggle("blue")) in
  let (cleared, _) = update(hidBlue, ShowAll) in
  hidBlue.hidden == ["blue"] && again.hidden == [] && cleared.hidden == []
end;

let byColor =
  ^^probe_html(explorer@<Student>(students, fun s -> s.favorite_color,
                                  fun s -> float_of_int(s.age))) in

let byStudent =
  ^^probe_html(explorer@<GradebookEntry>(gradebook, fun g -> g.name,
                                         fun g -> float_of_int(g.final))) in

(byColor, byStudent)
