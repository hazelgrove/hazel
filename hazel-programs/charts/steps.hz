# STEPS #

# What a probe does that the html projector cannot: record MANY samples. #

# The probe below sits inside a recursive function, so it records one #
# sample per step of the run. The sample navigator scrubs through them and #
# each sample draws its own chart, so the whole run is inspectable rather #
# than just its answer. A projector shows one live value — the latest — and #
# would have replaced the recursive call in order to show it. #

# A probe is also additive: the code it draws from is still on screen and #
# still typeable, which a projector cannot offer since it stands where the #
# code was. The html at the bottom uses both ends of that. #

type Row = (label=String, value=Float) in

let plots : [Row] = [
  ("Bed A", 8.0), ("Bed B", 3.0), ("Bed C", 5.0), ("Bed D", 1.0)
] in

let w = 300.0 in
let base = 110.0 in

let at : (String, Float) -> Attr = fun (k, v) -> Create(k, to_fixed(v, 2)) in

let chart : (String, [Row]) -> HTML =
  fun (caption, rows) ->
    let n = length(rows) in
    let step = w /. float_of_int(if n <= 0 then 1 else n) in
    Div([], [
      Div([Class("chart-caption")], [Text(caption)]),
      Node("svg", [
        Create("viewBox", "0 0 " ++ to_fixed(w, 0) ++ " 140"),
        Class("chart-svg")
      ],
      concat(mapi(rows, fun (i, r) ->
        let bh = r.value /. 12.0 *. 90.0 in
        let x = step *. float_of_int(i) +. step *. 0.15 in
        let bw = step *. 0.7 in
        [
          Node("rect", [
            at("x", x), at("y", base -. bh), at("width", bw), at("height", bh),
            Create("fill", "var(--chart-1)"), Class("chart-mark")
          ], [Node("title", [], [Text(r.label ++ ": " ++ to_fixed(r.value, 1))])]),
          Node("text", [
            at("x", x +. bw /. 2.0), at("y", base -. bh -. 4.0),
            Class("chart-value")
          ], [Text(to_fixed(r.value, 1))]),
          Node("text", [
            at("x", x +. bw /. 2.0), at("y", base +. 16.0),
            Class("chart-axis-text chart-axis-x")
          ], [Text(r.label)])
        ])))
    ])
in

# Each bed grows toward the plot average: a diffusion step. Watching one #
# number is useless here; watching the shape settle is the whole point. #

let settle : [Row] -> [Row] =
  fun rows ->
    let total = fold_left(map(rows, fun r -> r.value), fun (a, v) -> a +. v, 0.0) in
    let mean = total /. float_of_int(length(rows)) in
    map(rows, fun r -> (label = r.label, value = r.value +. (mean -. r.value) *. 0.4))
in

# The probe is INSIDE the recursion, so it fires once per step. Scrub the #
# samples to replay the run. #

let run : ([Row], Int) -> [Row] =
  fun (rows, n) ->
    if n <= 0
    then rows
    else
      let next = settle(rows) in
      let _ = ^^probe_html(chart("step " ++ string_of_int(n), next)) in
      run(next, n - 1)
in

let settled = run(plots, 6) in


# ===== TWO: HTML THAT EDITS ITS OWN SOURCE ===== #

# Clicking a handler does not evaluate anything here. It REWRITES the #
# source, piping the probed html into the handler: `H` becomes `H |> bump`, #
# and the program's own pipeline evaluates that — with statics, elaboration, #
# and the scope `H` already sits in. Evaluating the transform inside the #
# renderer instead cannot work: a probe has no elaborated syntax and no #
# environment to resolve `bump` in. #

# Two consequences worth knowing. The rewrite names `bump` rather than #
# inlining it, so editing the definition changes what every committed call #
# does. And each click appends another stage, so the edits read as a #
# pipeline you can prune a line at a time. #

let bump : HTML -> HTML =
  fun node ->
    case node
    | Div(attrs, kids) => Div(attrs, kids @ [Li([], [Text("another bed")])])
    | _ => node
    end
in

let beds = ^^probe_html(Div([], [
  Button([OnClick(bump)], [Text("Add a bed")]),
  Li([], [Text("Bed A")]),
  Li([], [Text("Bed B")])
])) in

(settled, beds)
