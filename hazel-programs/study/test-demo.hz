let factorial : Int -> Int =
fun n ->
  if n == 0 then 1
  else n * factorial(n - 1)
in

hint "factorial base case"
  test factorial(0) == 1 end;

hint "factorial of 1"
  test factorial(1) == 1 end;

hint "factorial of 5"
  test factorial(5) == 120 end;

let length : [?] -> Int =
fun xs ->
case xs
| [] => 0
| _::tl => 1 + length(tl)
end
in

hint "empty list length"
  test length([]) == 0 end;

hint "list length"
  test length([1, 2, 3]) == 3 end;

hint "intentional failure"
  test 2 + 2 == 5 end;

()
