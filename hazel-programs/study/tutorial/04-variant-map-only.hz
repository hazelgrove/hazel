# PART 4 VARIANT: PIN WITH MAP #

# A 🐛 has sneaked into our garden data! This time, #
# we're using map to process plants in batches. The map #
# callback runs once per plant per bed — that's a lot #
# of samples when multiple beds are involved. #

# Scroll to the bottom for instructions. #

# ============================================================ #

type Plant = (
  name = String,
  icon = String,
  water = Int
) in

let fern: Plant = (name = "Fern", icon = "🌿", water = 250) in
let orchid: Plant = (name = "Orchid", icon = "🌷", water = 180) in
let cactus: Plant = (name = "Cactus", icon = "🌵", water = 50) in
let rose: Plant = (name = "Rose", icon = "🐛", water = 190) in
let lily: Plant = (name = "Lily", icon = "🪷", water = 200) in
let daisy: Plant = (name = "Daisy", icon = "🌼", water = 160) in

type Bed = (
  name = String,
  plants = [Plant]
) in

let shade_garden: Bed = (
  name = "Shade Garden",
  plants = [fern, lily, daisy]
) in

let sun_terrace: Bed = (
  name = "Sun Terrace",
  plants = [orchid, cactus, rose]
) in

let mixed_bed: Bed = (
  name = "Mixed Bed",
  plants = [fern, orchid, lily, cactus]
) in

# This function maps over a bed's plants to build labels. #
# It's called 3 times (once per bed), so the map callback #
# runs 3+3+4 = 10 times total. #

let bed_labels: Bed -> [String] =
  fun bed ->
  let bed_name = bed.name in
  map(bed.plants, fun plant ->
    let label = plant.icon ++ " " ++ plant.name in
    let info = string_of_int(plant.water) ++ "ml" in
    label ++ ": " ++ info
  )
in

# These tests pass #
test bed_labels(shade_garden)
  == ["🌿 Fern: 250ml", "🪷 Lily: 200ml", "🌼 Daisy: 160ml"]
end;
test bed_labels(mixed_bed)
  == ["🌿 Fern: 250ml", "🌷 Orchid: 180ml",
      "🪷 Lily: 200ml", "🌵 Cactus: 50ml"]
end;

# 1. Turn on auto-probe and click inside `bed_labels`. #
#    The map callback has 10 samples per expression — #
#    values from all 3 beds mixed together. Chaotic! #
# 2. Try Many mode (double-click a sample). Even more #
#    overwhelming: 10 values side by side. #
# 3. Now look at `bed_name` — it's OUTSIDE the map, so #
#    it has just 3 samples (one per bed call). Navigate #
#    to "Sun Terrace". #
# 4. Choose "Pin enclosing call" (or press P). This pins #
#    the bed_labels(sun_terrace) call. #
# 5. Now the map callback has only 3 iterations — just #
#    Sun Terrace's 3 plants. In Many mode, you can see #
#    all 3 side by side. Can you spot the 🐛? #

# Alternatively: probe the failing test below, click its #
# sample, and select "Pin this call" for the same effect. #

# This test is FAILING! #
test bed_labels(sun_terrace)
  == ["🌷 Orchid: 180ml", "🌵 Cactus: 50ml", "🌹 Rose: 190ml"]
end

# END #
