# PROBES TUTORIAL - PART 4: PINNING                               #

# A bug has snuck into the garden data and left... a bug!         #
# With many calls generating a wall of samples, it's hard to see  #
# what's going on. Pinning lets you cut through the noise and     #
# focus on one call at a time.                                    #

# This slide has two exercises. Scroll down for instructions.     #
# =============================================================== #

type Plant = (
  name = String,
  icon = String,
  water = Int
) in

let fern: Plant = (name = "Fern", icon = "🌿", water = 250) in
let orchid: Plant = (name = "Orchid", icon = "🌸", water = 180) in
let cactus: Plant = (name = "Cactus", icon = "🍄", water = 50) in
let rose: Plant = (name = "Rose", icon = "🐛", water = 190) in
let lily: Plant = (name = "Lily", icon = "☘️", water = 200) in
let daisy: Plant = (name = "Daisy", icon = "🌱", water = 160) in

# =================== EXERCISE 1 =================== #
# Pin from a test call site                           #

let make_label: (Plant, Int) -> String =
  fun (plant, days) ->
    let header = plant.icon ++ " " ++ plant.name in
    let total = plant.water * days in
    let amount =
      string_of_int(total) ++ "ml/"
      ++ string_of_int(days) ++ "d" in
    header ++ ": " ++ amount
in

# These tests all pass #
test make_label(fern, 7) == "🌿 Fern: 1750ml/7d" end;
test make_label(fern, 14) == "🌿 Fern: 3500ml/14d" end;
test make_label(orchid, 5) == "🌸 Orchid: 900ml/5d" end;
test make_label(orchid, 10) == "🌸 Orchid: 1800ml/10d" end;
test make_label(cactus, 7) == "🍄 Cactus: 350ml/7d" end;
test make_label(cactus, 14) == "🍄 Cactus: 700ml/14d" end;
test make_label(lily, 7) == "☘️ Lily: 1400ml/7d" end;
test make_label(lily, 3) == "☘️ Lily: 600ml/3d" end;
test make_label(daisy, 7) == "🌱 Daisy: 1120ml/7d" end;

# One of the 10 tests above is failing. Here's what to do:         #
# 1. Turn on auto-probe (Sidebar toggle or cmd/ctrl-P).            #
# 2. Click inside the function `make_label` above.                 #
# 3. There are 10 calls, so each expression has 10 values.         #
#    Try Many mode (double-click a sample) to see the chaos!       #
# 4. Now add a probe within the failing test: Put your caret on    #
#    the `(` after the `make_label` call in the test below, add    #
#    a probe, and then click its sample and hit "Pin this call".   #
# 5. Go back to `make_label`. Even in Many mode, only the          #
#    pinned call's samples remain. Can you spot the 🐛 now?        #

# Note: If you click around the rest of the program when you       #
# have a pin you may see a new kind of icon: ⍟ means samples are   #
# "hidden by pin". Clicking the icon removes the pin remotely.     #

# This test is FAILING! #
test
  make_label(rose, 7)
  == "🌹 Rose: 1330ml/7d" end;

# ========================== EXERCISE 2 ========================== #
# Pin enclosing call — narrowing a map                             #

# Same 🐛, different situation. This function uses map             #
# to process each plant in a garden bed. It's called 3             #
# times, so the map callback runs 3+3+4 = 10 times.                #
# That's 10 samples from 3 different beds, all mixed!              #

type Bed = (
  name = String,
  plants = [Plant]
) in

let shade_garden: Bed = (
  name = "Shade Garden",
  plants = [fern, lily, daisy]
) in

let sun_terrace: Bed = (
  name = "Sun Terrace",
  plants = [orchid, cactus, rose]
) in

let mixed_bed: Bed = (
  name = "Mixed Bed",
  plants = [fern, orchid, lily, cactus]
) in

let bed_labels: Bed -> [String] =
  fun bed ->
  let _name = bed.name in
  map(bed.plants, fun plant ->
    let label = plant.icon ++ " " ++ plant.name in
    let info = string_of_int(plant.water) ++ "ml" in
    label ++ ": " ++ info
  )
in

test
  bed_labels(shade_garden)
  == ["🌿 Fern: 250ml", "☘️ Lily: 200ml", "🌱 Daisy: 160ml"]
end;
test
  bed_labels(mixed_bed)
  == ["🌿 Fern: 250ml", "🌸 Orchid: 180ml",
      "☘️ Lily: 200ml", "🍄 Cactus: 50ml"]
end;

# You can also pin from INSIDE a function body:                    #
# 1. Click inside `bed_labels`. The map callback has               #
#    10 samples — values from all 3 beds jumbled together.         #
# 2. Look at `bed_name` — it's OUTSIDE the map, so it              #
#    has just 3 samples (one per bed). Navigate to find            #
#    "Sun Terrace".                                                #
# 3. Click the sample and choose "Pin enclosing call" (or P).      #
#    This pins the bed_labels(sun_terrace) call.                   #
# 4. The map callback now has only 3 iterations — just             #
#    Sun Terrace's plants. Switch to Many mode to see              #
#    all 3 side by side. There's that 🐛 again!                    #

# This test is FAILING! #
test
  bed_labels(sun_terrace)
  == ["🌸 Orchid: 180ml", "🍄 Cactus: 50ml", "🌹 Rose: 190ml"]
end

