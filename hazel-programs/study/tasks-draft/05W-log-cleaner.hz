# Moonphase Log Cleaner v2                             #
#                                                      #
# Garden keepers record observations in a messy        #
# log with entry numbers, emoji markers, inconsistent  #
# dashes, and extra whitespace. Implement clean_entry  #
# to standardize each log entry.                       #
#                                                      #
# Each raw entry has a number marker (a hash sign      #
# then digits), a moon emoji, a phase name, and        #
# notes after dashes. See the test cases below         #
# for examples.                                        #
#                                                      #
# Cleaned entries should look like:                    #
#   "🌕 Full Moon: clear skies, planted moonbloom"     #
#   "🌑 New Moon: cloudy, harvested starfern"          #
#                                                      #
# The moon emojis stay! Only the entry numbers         #
# should be removed.                                   #
#                                                      #
# Steps:                                               #
#   1. Trim leading/trailing whitespace                #
#   2. Remove entry numbers (hash followed by digits)  #
#   3. Normalize " -- " or "--" into ": "              #
#   4. Collapse multiple spaces into one               #
#   5. Final trim for any leftover edge spaces         #
#                                                      #
# Some standard library functions that may be useful:                                 #
#   string_trim: String -> String                      #
#   string_match: (String, String) -> Bool             #
#   string_replace: (String, String, String) -> String #
#                                                      #
# These functions are tragically underdocumented!      #
# You will have to figure out what those String        #
# arguments mean by experimenting with probes.         #
#                                                      #
# One of the String arguments is a regex pattern.      #
# Some useful regex building blocks:                   #
#   + means "one or more of the preceding"             #
#   * means "zero or more of the preceding"            #
#   [abc] matches any one character from the set       #
#   [0-9] matches any digit                            #
#   A space in a pattern matches a literal space       #
#                                                      #
# Tip: Build one step at a time! After each line,      #
# check the probe to see what your pattern did.        #

let clean_entry: String -> String = fun entry ->
  ?



in

test
  clean_entry("  #42 🌕 Full Moon -- clear skies, planted moonbloom  ") ==
  "🌕 Full Moon: clear skies, planted moonbloom"
end;

test
  clean_entry("#7 🌑  New Moon--cloudy,   harvested starfern") ==
  "🌑 New Moon: cloudy, harvested starfern"
end;

test
  clean_entry("  #103 🌓 Half Moon -- light rain, pruned duskrose  ") ==
  "🌓 Half Moon: light rain, pruned duskrose"
end;

test
  clean_entry("#15 🌗 Crescent--foggy,  checked   moth traps") ==
  "🌗 Crescent: foggy, checked moth traps"
end
