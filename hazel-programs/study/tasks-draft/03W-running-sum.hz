# RUNNING SUM TASK                             #
#                                              #
# Implement running_sum: compute a list where  #
# each element is the sum of all elements up   #
# to and including that position.              #
#                                              #
# Examples:                                    #
#   running_sum([1, 2, 3]) == [1, 3, 6]        #
#   running_sum([5]) == [5]                    #
#   running_sum([]) == []                      #
#                                              #
# Some standard library functions that may be  #
# useful (work out the argument order with     #
# probes):                                     #
#   fold_left : ([a], (acc, a) -> acc, acc) -> acc #
#   append : ([a], [a]) -> [a]                 #
#   rev : [a] -> [a]                           #
#   length : [a] -> Int                        #
#                                              #
# Tip: you may need to track both the running  #
# total and the result list in your fold.      #

let running_sum = fun nums ->
  ?
in

test
  running_sum([1, 2, 3])
  == [1, 3, 6]
end;

test
  running_sum([5])
  == [5]
end;

test
  running_sum([])
  == []
end;

test
  running_sum([1, 1, 1, 1])
  == [1, 2, 3, 4]
end
