# GARDEN PATH - SOLUTION #

let grove_name = fun path ->
  let parts = string_split("/", path) in
  nth(parts, 1)
in

test
  grove_name("/moonlit-grove/ferns/watering")
  == "moonlit-grove"
end;

test
  grove_name("/night-garden/herbs/rosemary")
  == "night-garden"
end;

test
  grove_name("/")
  == ""
end
