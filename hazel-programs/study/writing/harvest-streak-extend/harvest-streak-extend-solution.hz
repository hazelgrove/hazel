# HARVEST STREAK EXTENSION - SOLUTION #

# Night Garden Harvest Ledger #
# Track harvests and streak bonuses #

# Quality tiers from the moonlit fields #
type Quality =
  + Bronze      # Common harvest, basic value #
  + Silver      # Good quality, moderate bonus #
  + Gold        # Excellent harvest, high value #
  + Starlight   # Legendary, blessed by the moon #
in

# Crops that grow under the night sky #
type Crop =
  + Moonmelon   # Glows faintly, sweet taste #
  + Starfruit   # Shaped like stars, tangy #
  + Nightshade  # Purple bloom, magical properties #
  + Duskwheat   # Golden stalks, hearty grain #
  + Glowpumpkin # Orange and luminescent #
in

# A single harvest from the garden #
type Harvest = (
  crop = Crop,
  quality = Quality,
  quantity = Int
) in

# The harvest ledger tracks all harvests and bonuses #
type Model = (
  harvests = [Harvest],
  totalValue = Int,
  streakBonus = Int,
  lastQuality = Quality
) in

# Actions the farmer can take #
type Action =
  + RecordHarvest(Harvest)  # Log a new harvest #
  + ClaimBonus              # Collect accumulated streak bonus #
  + CloseDay                # End the harvest day, reset streaks #
  + PremiumSale             # Claim bonus with premium multiplier #
in

# Calculate base value of a crop #
let cropValue : Crop -> Int =
  fun c ->
    case c
    | Moonmelon => 15
    | Starfruit => 20
    | Nightshade => 20
    | Duskwheat => 10
    | Glowpumpkin => 12
    end
in

# Quality multiplier for harvest value #
let qualityMultiplier : Quality -> Int =
  fun q ->
    case q
    | Bronze => 1
    | Silver => 2
    | Gold => 3
    | Starlight => 5
    end
in

# Calculate the value of a single harvest #
let harvestValue : Harvest -> Int =
  fun h ->
    cropValue(h.crop) * qualityMultiplier(h.quality) * h.quantity
in

# Initial empty ledger #
let initModel : Model = (
  harvests = [],
  totalValue = 0,
  streakBonus = 0,
  lastQuality = Bronze
) in

# Process a harvest action and update the ledger #
let processHarvest : (Model, Harvest) -> Model =
  fun (ledger, h) ->
    let value = harvestValue(h) in
    # Check if this harvest continues the quality streak #
    # First harvest never continues a streak (no previous harvest) #
    # Compare current quality with the PREVIOUS lastQuality #
    let isFirst = length(ledger.harvests) == 0 in
    let continues = !isFirst && h.quality == ledger.lastQuality in
    # Now update lastQuality to current harvest #
    let newLast = h.quality in
    let newStreak =
      if continues
      then ledger.streakBonus + 5
      else 0
    in
    (
      harvests = h :: ledger.harvests,
      totalValue = ledger.totalValue + value + newStreak,
      streakBonus = newStreak,
      lastQuality = newLast
    )
in

# Claim the streak bonus and reset it #
let claimBonus : Model -> Model =
  fun ledger ->
    (
      harvests = ledger.harvests,
      totalValue = ledger.totalValue + ledger.streakBonus,
      streakBonus = 0,
      lastQuality = ledger.lastQuality
    )
in

# Close the harvest day - reset streak tracking #
let closeDay : Model -> Model =
  fun ledger ->
    (
      harvests = ledger.harvests,
      totalValue = ledger.totalValue,
      streakBonus = 0,
      lastQuality = Bronze
    )
in

# Premium multiplier: 2x if streak bonus is strong, 1x otherwise #
let premiumMultiplier : Int -> Int =
  fun streakBonus ->
    if streakBonus >= 10 then 2 else 1
in

# Main update function - dispatch actions #
let update : (Model, Action) -> Model =
  fun (ledger, action) ->
    case action
    | RecordHarvest(h) => processHarvest(ledger, h)
    | ClaimBonus => claimBonus(ledger)
    | CloseDay => closeDay(ledger)
    | PremiumSale =>
        let payout = ledger.streakBonus * premiumMultiplier(ledger.streakBonus) in
        (
          harvests = ledger.harvests,
          totalValue = ledger.totalValue + payout,
          streakBonus = 0,
          lastQuality = ledger.lastQuality
        )
    end
in

# Run multiple actions in sequence #
let run : (Model, [Action]) -> Model =
  fun (ledger, actions) ->
    fold_left(actions, update, ledger)
in

# ===== TESTS ===== #

# Regression: basic harvest recording still works #
hint "recording harvest adds to total value"
test
  let h = (crop = Moonmelon, quality = Bronze, quantity = 2) in
  let ledger = update(initModel, RecordHarvest(h)) in
  # Moonmelon(15) * Bronze(1) * 2 = 30, no streak bonus on first #
  ledger.totalValue == 30
end;

# Regression: streak bonus still works #
hint "same quality builds streak"
test
  let h1 = (crop = Moonmelon, quality = Gold, quantity = 1) in
  let h2 = (crop = Starfruit, quality = Gold, quantity = 1) in
  let ledger = run(initModel, [RecordHarvest(h1), RecordHarvest(h2)]) in
  ledger.streakBonus == 5
end;

# Regression: claim bonus still works #
hint "claiming bonus adds to total and resets streak"
test
  let h1 = (crop = Moonmelon, quality = Gold, quantity = 1) in
  let h2 = (crop = Starfruit, quality = Gold, quantity = 1) in
  let ledger = run(initModel, [
    RecordHarvest(h1),
    RecordHarvest(h2),
    ClaimBonus
  ]) in
  ledger.streakBonus == 0
end;

# PremiumSale: low streak gives 1x multiplier #
hint "PremiumSale with low streak uses 1x multiplier"
test
  # Two same-quality harvests build streakBonus to 5 #
  let h1 = (crop = Moonmelon, quality = Silver, quantity = 1) in
  let h2 = (crop = Starfruit, quality = Silver, quantity = 1) in
  let ledger = run(initModel, [
    RecordHarvest(h1),
    RecordHarvest(h2),
    PremiumSale
  ]) in
  # streakBonus was 5, multiplier = 1, payout = 5 #
  # h1: 15*2*1 = 30, h2: 20*2*1 + 5 = 45, PremiumSale: +5 #
  ledger.totalValue == 30 + 45 + 5
end;

# PremiumSale: high streak gives 2x multiplier #
hint "PremiumSale with high streak uses 2x multiplier"
test
  # Three same-quality harvests build streakBonus to 10 #
  let h1 = (crop = Moonmelon, quality = Gold, quantity = 1) in
  let h2 = (crop = Starfruit, quality = Gold, quantity = 1) in
  let h3 = (crop = Nightshade, quality = Gold, quantity = 1) in
  let ledger = run(initModel, [
    RecordHarvest(h1),
    RecordHarvest(h2),
    RecordHarvest(h3),
    PremiumSale
  ]) in
  # streakBonus was 10, multiplier = 2, payout = 20 #
  # h1: 15*3=45, h2: 20*3+5=65, h3: 20*3+10=70, PremiumSale: +20 #
  ledger.totalValue == 45 + 65 + 70 + 20
end;

# PremiumSale resets streak after claiming #
hint "PremiumSale resets streak to zero"
test
  let h1 = (crop = Moonmelon, quality = Gold, quantity = 1) in
  let h2 = (crop = Starfruit, quality = Gold, quantity = 1) in
  let h3 = (crop = Nightshade, quality = Gold, quantity = 1) in
  let ledger = run(initModel, [
    RecordHarvest(h1),
    RecordHarvest(h2),
    RecordHarvest(h3),
    PremiumSale
  ]) in
  ledger.streakBonus == 0
end;

# PremiumSale with no streak gives zero payout #
hint "PremiumSale with zero streak adds nothing"
test
  let h = (crop = Moonmelon, quality = Bronze, quantity = 1) in
  let ledger = run(initModel, [
    RecordHarvest(h),
    PremiumSale
  ]) in
  # streakBonus was 0, payout = 0 * 1 = 0 #
  ledger.totalValue == 15
end;

# Demo: Premium sale harvest day #
run(initModel, [
  RecordHarvest((crop = Nightshade, quality = Gold, quantity = 1)),
  RecordHarvest((crop = Starfruit, quality = Gold, quantity = 1)),
  RecordHarvest((crop = Moonmelon, quality = Gold, quantity = 1)),
  PremiumSale
])
