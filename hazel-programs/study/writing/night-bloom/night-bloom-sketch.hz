# NIGHT BLOOM FILTER TASK                        #
#                                                #
# A plant catalog has entries like:              #
#   "Moonbloom [night] 200ml"                    #
#   "Duskrose [day] 150ml"                        #
#                                                #
# Filter to night-blooming plants and extract    #
# just their names: ["Moonbloom", "Starfern"]    #
#                                                #
# Steps:                                         #
#   1. is_night: check if entry contains "night" #
#   2. extract_name: get the first word          #
#   3. Combine with filter and map               #
#                                                #
# Available functions:                           #
#   string_match(pattern, str) -> Bool           #
#   string_split(separator, str) -> [String]     #
#   nth(list, index) -> element                  #
#   filter(list, predicate) -> list              #
#   map(list, fn) -> list                        #
#                                                #
# Note: string_match uses regex patterns.        #
# The pattern "[abc]" matches any of a, b, c.   #
#                                                #
# Tip: Use probes to see what your pattern       #
# actually matches -- regex can be surprising!   #

let entries = [
