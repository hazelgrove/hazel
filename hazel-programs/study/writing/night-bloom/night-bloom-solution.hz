# NIGHT BLOOM FILTER - SOLUTION #

let entries = [
  "Starbloom [night] 200ml",
  "Sunfern [day] 150ml",
  "Moonvine [night] 175ml",
  "Thornrose [day] 100ml"
] in

# Check if entry is a night-blooming plant #
let is_night: String -> Bool = fun entry ->
  string_match("night", entry)
in

# Extract just the plant name from an entry #
let extract_name: String -> String = fun entry ->
  let parts = string_split(" ", entry) in
  nth(parts, 0)
in

# Combine: filter night entries, then extract names #
let night_names =
  map(filter(entries, is_night), extract_name)
in

test night_names == ["Starbloom", "Moonvine"] end;

test is_night("Starbloom [night] 200ml") == true end;

test is_night("Sunfern [day] 150ml") == false end;

test extract_name("Moonvine [night] 175ml") == "Moonvine" end
