# Crop Tally                                           #
#                                                      #
# Garden rows are recorded as space-separated          #
# strings of plant names:                              #
#   "fern orchid fern cactus"                          #
#   "orchid starfern fern orchid"                      #
#                                                      #
# Count how many times a given plant appears           #
# across all rows of the garden.                       #
#                                                      #
# Steps:                                               #
#   1. count_in_row: count a plant in one row string   #
#   2. count_in_garden: total a plant across all rows  #
#                                                      #
# Available functions:                                 #
#   string_split: (String, String) -> [String]         #
#   filter: ([?], ? -> Bool) -> [?]                    #
#   length: [?] -> Int                                 #
#   map: ([?], ? -> ?) -> [?]                          #
#   fold_left: ([?], (?, ?) -> ?, ?) -> ?              #
#                                                      #
# fold_left combines list elements into one value      #
# using a function and a starting value.               #
#                                                      #
# Tip: Try each function on a simple example first     #
# and probe the result. The argument order for these   #
# functions may not be what you expect!                #

let garden = [
  "fern orchid fern cactus",
  "orchid starfern fern orchid",
  "cactus fern orchid orchid"
] in

# Count how many times plant appears in a row string #
let count_in_row: (String, String) -> Int =
  fun (row, plant) ->
    ?



in

# Count a plant across all garden rows #
let count_in_garden: ([String], String) -> Int =
  fun (garden, plant) ->
    ?



in

test count_in_row("fern orchid fern cactus", "fern") == 2 end;

test count_in_row("orchid starfern fern orchid", "fern") == 1 end;

test count_in_garden(garden, "fern") == 4 end;

test count_in_garden(garden, "orchid") == 5 end;

test count_in_garden(garden, "cactus") == 2 end
