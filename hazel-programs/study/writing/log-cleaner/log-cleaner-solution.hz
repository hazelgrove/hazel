# MOONPHASE LOG CLEANER - SOLUTION #

let clean_entry: String -> String = fun entry ->
  let s = string_trim(entry) in
  let s = string_replace("[🌕🌑🌓🌗]", s, "") in
  let s = string_replace(" *-- *", s, ": ") in
  let s = string_replace(" +", s, " ") in
  string_trim(s)
in

test
  clean_entry("  🌕 Full Moon -- clear skies, planted moonvine  ")
  == "Full Moon: clear skies, planted moonvine"
end;

test
  clean_entry("🌑  New Moon--cloudy,   harvested starbloom")
  == "New Moon: cloudy, harvested starbloom"
end;

test
  clean_entry("  🌓 Half Moon -- light rain, pruned thornrose  ")
  == "Half Moon: light rain, pruned thornrose"
end;

test
  clean_entry("🌗 Crescent--foggy,  checked   moth traps")
  == "Crescent: foggy, checked moth traps"
end
