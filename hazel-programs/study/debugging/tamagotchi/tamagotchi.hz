# HAUNTED TOASTER - A Tamagotchi-style Virtual Pet #
# Your pet is a possessed kitchen appliance with feelings #

type Stat = Int in  # 0-100 range #

type Stats = (
  hunger = Stat,     # 0 = starving, 100 = stuffed #
  happiness = Stat,  # 0 = miserable, 100 = ecstatic #
  energy = Stat,     # 0 = exhausted, 100 = hyperactive #
  health = Stat      # 0 = broken, 100 = pristine #
) in

type Evolution =
  + BabyToaster      # Just possessed, learning the ropes #
  + TeenToaster      # Moody, unpredictable #
  + AdultToaster     # Mature, stable #
  + GoldenToaster    # Legendary, well-cared-for #
  + RustyToaster     # Neglected, cranky #
in

type Personality =
  + Cheerful
  + Grumpy
  + Anxious
  + Balanced
in

type Memory = (
  timesFed = Int,
  timesPlayed = Int,
  timesSlept = Int,
  timesNeglected = Int
) in

type Model = (
  stats = Stats,
  evolution = Evolution,
  personality = Personality,
  memory = Memory,
  age = Int           # Time ticks elapsed #
) in

type Action =
  + Feed              # Reduces hunger, slight energy boost #
  + Play              # Increases happiness, costs energy #
  + Sleep             # Restores energy, slight health boost #
  + Repair            # Fixes health issues #
  + TimeTick          # Time passes, stats decay #
in

# Utility: clamp value between 0 and 100 #
let clamp : Int -> Int =
  fun x ->
    if x < 0 then 0
    else if x > 100 then 100
    else x
in

# Initial state: a fresh baby toaster #
let init: Model = (
  stats = (
    hunger = 50,
    happiness = 50,
    energy = 50,
    health = 100
  ),
  evolution = BabyToaster,
  personality = Balanced,
  memory = (
    timesFed = 0,
    timesPlayed = 0,
    timesSlept = 0,
    timesNeglected = 0
  ),
  age = 0
) in

# Calculate stat decay based on current stats and interactions #
let decayStats : Stats -> Stats =
  fun s ->
    let hungerDecay = 5 in
    let happinessDecay =
      if s.hunger < 30 then 8  # Hungry makes mood worse #
      else 3
    in
    let energyDecay = 2 in
    let healthDecay =
      if s.energy < 20 then 5   # Exhaustion hurts health #
      else if s.hunger < 20 then 3  # Starvation hurts health #
      else 0
    in
    (
      hunger = clamp(s.hunger - hungerDecay),
      happiness = clamp(s.happiness - happinessDecay),
      energy = clamp(s.energy - energyDecay),
      health = clamp(s.health - healthDecay)
    )
in

# Determine personality based on memory #
let calcPersonality : Memory -> Personality =
  fun m ->
    let careScore = m.timesFed + m.timesPlayed + m.timesSlept in
    let neglectScore = m.timesNeglected in
    if neglectScore > careScore then Grumpy
    else if m.timesPlayed > m.timesFed + m.timesSlept then Cheerful
    else if m.timesNeglected > 5 then Anxious
    else Balanced
in

# Determine evolution based on age and care quality #
let calcEvolution : (Int, Memory) -> Evolution =
  fun (age, m) ->
    let careScore = m.timesFed + m.timesPlayed + m.timesSlept in
    let neglectScore = m.timesNeglected in
    if age < 10 then BabyToaster
    else if age < 25 then TeenToaster
    else if careScore > neglectScore * 3 then GoldenToaster
    else if neglectScore > careScore then RustyToaster
    else AdultToaster
in

# Check if stats indicate neglect (any stat critically low) #
let isNeglected : Stats -> Bool =
  fun s ->
    s.hunger < 15 || s.happiness < 15 || s.energy < 10 || s.health < 20
in

# Update memory based on action #
let updateMemory : (Memory, Action, Stats) -> Memory =
  fun (m, action, stats) ->
    case action
    | Feed => (m.timesFed + 1, m.timesPlayed, m.timesSlept, m.timesNeglected)
    | Play => (m.timesFed, m.timesPlayed + 1, m.timesSlept, m.timesNeglected)
    | Sleep => (m.timesFed, m.timesPlayed, m.timesSlept + 1, m.timesNeglected)
    | Repair => m
    | TimeTick =>
        if isNeglected(stats)
        then (m.timesFed, m.timesPlayed, m.timesSlept, m.timesNeglected + 1)
        else m
    end
in

# Apply an action to stats #
let applyAction : (Stats, Action, Personality) -> Stats =
  fun (s, action, personality) ->
    # Personality affects action effectiveness #
    let bonus = case personality
      | Cheerful => 5
      | Grumpy => -5
      | Anxious => -2
      | Balanced => 0
      end
    in
    case action
    | Feed =>
        (
          hunger = clamp(s.hunger + 30 + bonus),
          happiness = clamp(s.happiness + 5),
          energy = clamp(s.energy + 10),
          health = s.health
        )
    | Play =>
        if s.energy < 20
        then # Too tired to play effectively #
          (
            hunger = s.hunger,
            happiness = clamp(s.happiness + 5),
            energy = clamp(s.energy - 5),
            health = s.health
          )
        else
          (
            hunger = clamp(s.hunger - 10),
            happiness = clamp(s.happiness + 25 + bonus),
            energy = clamp(s.energy - 15),
            health = s.health
          )
    | Sleep =>
        (
          hunger = clamp(s.hunger - 5),
          happiness = s.happiness,
          energy = clamp(s.energy + 40 + bonus),
          health = clamp(s.health + 5)
        )
    | Repair =>
        (
          hunger = s.hunger,
          happiness = clamp(s.happiness - 10),  # Repairs are uncomfortable #
          energy = s.energy,
          health = clamp(s.health + 35 + bonus)
        )
    | TimeTick => decayStats(s)
    end
in

# Main update function #
let update : (Model, Action) -> Model =
  fun (m, action) ->
    let newStats = applyAction(m.stats, action, m.personality) in
    let newMemory = updateMemory(m.memory, action, m.stats) in
    let newAge = case action
      | TimeTick => m.age + 1
      | _ => m.age
      end
    in
    (
      stats = newStats,
      evolution = calcEvolution(newAge, newMemory),
      personality = calcPersonality(newMemory),
      memory = newMemory,
      age = newAge
    )
in

# Run multiple actions in sequence #
let do : (Model, [Action]) -> Model =
  fun (model: Model, actions: [Action]) ->
    fold_left(actions, update, model)
in

# Generate n TimeTicks (range is inclusive, so use n-1) #
let timePasses : Int -> [Action] =
  fun n ->
    if n <= 0 then []
    else map(range(1, n), fun _ -> TimeTick)
in

# ===== TESTS ===== #

# Basic feeding test #
hint "feeding increases hunger stat"
test
  let m = update(init, Feed) in
  m.stats.hunger > init.stats.hunger
end;

hint "feeding also gives small happiness boost"
test
  let m = update(init, Feed) in
  m.stats.happiness > init.stats.happiness
end;

# Playing tests #
hint "playing increases happiness when has energy"
test
  let m = update(init, Play) in
  m.stats.happiness > init.stats.happiness
end;

hint "playing costs energy"
test
  let m = update(init, Play) in
  m.stats.energy < init.stats.energy
end;

hint "playing when exhausted is less effective"
test
  let exhausted = (
    stats = (hunger = 50, happiness = 30, energy = 10, health = 80),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let m = update(exhausted, Play) in
  # Only +5 happiness instead of +25 #
  m.stats.happiness == 35
end;

# Sleeping tests #
hint "sleeping restores energy"
test
  let tired = (
    stats = (hunger = 50, happiness = 50, energy = 30, health = 80),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let m = update(tired, Sleep) in
  m.stats.energy == 70
end;

hint "sleeping improves health slightly"
test
  let m = update(init, Sleep) in
  m.stats.health > init.stats.health || m.stats.health == 100
end;

# Repair tests #
hint "repair increases health"
test
  let damaged = (
    stats = (hunger = 50, happiness = 50, energy = 50, health = 40),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let m = update(damaged, Repair) in
  m.stats.health == 75
end;

hint "repair is uncomfortable (decreases happiness)"
test
  let m = update(init, Repair) in
  m.stats.happiness < init.stats.happiness
end;

# Time decay tests #
hint "time tick reduces hunger"
test
  let m = update(init, TimeTick) in
  m.stats.hunger < init.stats.hunger
end;

hint "time tick reduces energy"
test
  let m = update(init, TimeTick) in
  m.stats.energy < init.stats.energy
end;

hint "hunger affects happiness decay rate"
test
  let hungry = (
    stats = (hunger = 20, happiness = 50, energy = 50, health = 80),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let full = (
    stats = (hunger = 80, happiness = 50, energy = 50, health = 80),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let hungryAfter = update(hungry, TimeTick) in
  let fullAfter = update(full, TimeTick) in
  # Hungry toaster loses more happiness #
  hungryAfter.stats.happiness < fullAfter.stats.happiness
end;

hint "exhaustion hurts health"
test
  let exhausted = (
    stats = (hunger = 50, happiness = 50, energy = 15, health = 50),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let m = update(exhausted, TimeTick) in
  m.stats.health < exhausted.stats.health
end;

# Evolution tests #
hint "starts as baby toaster"
test
  init.evolution == BabyToaster
end;

hint "evolves to teen after age 10"
test
  let m = do(init, timePasses(10)) in
  m.evolution == TeenToaster
end;

hint "well-cared-for toaster becomes golden"
test
  # Must interleave care with time to avoid neglect #
  # Need age >= 25 and careScore > neglectScore * 3 #
  let wellCared = do(init, [
    # Day 1-5: good care routine (15 care, 10 ticks) #
    Feed, Play, Sleep, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick,
    # Day 6-10: continue care (12 care, 15 ticks) #
    Feed, Play, Sleep, TimeTick, TimeTick, TimeTick,
    Feed, Sleep, TimeTick, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick, TimeTick,
    Feed, Sleep, TimeTick, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick, TimeTick
  ]) in
  # age = 25, careScore = 27 (10 feed + 8 play + 9 sleep), neglectScore = 0 #
  wellCared.evolution == GoldenToaster
end;

# Memory tests #
hint "feeding increments timesFed"
test
  let m = do(init, [Feed, Feed, Feed]) in
  m.memory.timesFed == 3
end;

hint "playing increments timesPlayed"
test
  let m = do(init, [Play, Play]) in
  m.memory.timesPlayed == 2
end;

# Personality tests #
hint "lots of play creates cheerful personality"
test
  let playful = do(init, [
    Play, Play, Play, Play, Play,
    Feed, Sleep
  ]) in
  playful.personality == Cheerful
end;

# Stat clamping tests #
hint "stats cannot go below 0"
test
  let dying = (
    stats = (hunger = 5, happiness = 5, energy = 5, health = 5),
    evolution = RustyToaster,
    personality = Grumpy,
    memory = init.memory,
    age = 30
  ) in
  let m = do(dying, timePasses(5)) in
  m.stats.hunger >= 0 && m.stats.happiness >= 0 &&
  m.stats.energy >= 0 && m.stats.health >= 0
end;

hint "stats cannot exceed 100"
test
  let healthy = (
    stats = (hunger = 90, happiness = 90, energy = 90, health = 95),
    evolution = GoldenToaster,
    personality = Cheerful,
    memory = (timesFed = 10, timesPlayed = 10, timesSlept = 10, timesNeglected = 0),
    age = 30
  ) in
  let m = do(healthy, [Feed, Sleep]) in
  m.stats.hunger <= 100 && m.stats.energy <= 100 && m.stats.health <= 100
end;

# Personality affects stats tests #
hint "cheerful personality gives bonus to actions"
test
  let cheerfulModel = (
    stats = (hunger = 50, happiness = 50, energy = 50, health = 50),
    evolution = AdultToaster,
    personality = Cheerful,
    memory = init.memory,
    age = 25
  ) in
  let grumpyModel = (
    stats = (hunger = 50, happiness = 50, energy = 50, health = 50),
    evolution = AdultToaster,
    personality = Grumpy,
    memory = init.memory,
    age = 25
  ) in
  let cheerfulFed = update(cheerfulModel, Feed) in
  let grumpyFed = update(grumpyModel, Feed) in
  cheerfulFed.stats.hunger > grumpyFed.stats.hunger
end;

# Complex scenario tests #
hint "daily routine maintains health"
test
  let dailyRoutine = [Feed, Play, Sleep, TimeTick, TimeTick] in
  let m = do(init, dailyRoutine) in
  m.stats.health >= init.stats.health - 5
end;

hint "neglect leads to rusty evolution"
test
  # Just let time pass without care #
  let neglected = do(init, timePasses(30)) in
  neglected.evolution == RustyToaster
end;

hint "age increases with time ticks"
test
  let m = do(init, timePasses(5)) in
  m.age == 5
end;

hint "age does not increase with other actions"
test
  let m = do(init, [Feed, Play, Sleep, Repair]) in
  m.age == 0
end;

# Final demo: simulate a week of care #
do(init, [
  # Day 1 #
  Feed, Play, Sleep, TimeTick, TimeTick,
  # Day 2 #
  Feed, Play, TimeTick, TimeTick,
  # Day 3 #
  Feed, Sleep, TimeTick, TimeTick,
  # Day 4 #
  Feed, Play, Play, Sleep, TimeTick, TimeTick,
  # Day 5 #
  Feed, Repair, Sleep, TimeTick, TimeTick
])
