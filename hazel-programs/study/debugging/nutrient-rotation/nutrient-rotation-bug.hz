# NIGHT GARDEN NUTRIENT TRACKER #
# A mystical soil management system for sustainable moon farming #

# Soil nutrients are measured 0-100 #
# N = Nitrogen, P = Phosphorus, K = Potassium #
type Soil = (
  n = Int,
  p = Int,
  k = Int
) in

# Crops of the night garden #
type Crop =
  + Nightbeans      # Nitrogen fixer - restores N when harvested #
  + Mooncorn        # Heavy feeder - depletes N significantly #
  + Startomatoes    # Balanced - moderate use of all nutrients #
  + TwilightClover  # Cover crop - restores N when turned under #
in

# A garden plot tracks soil, current crop (if any), and season #
type Plot = (
  soil = Soil,
  crop = +None +Some(Crop),
  season = Int
) in

# Actions that can be performed on a plot #
type Action =
  + Plant(Crop)
  + Harvest
  + Compost         # Add organic matter, boosts all nutrients #
  + SeasonChange    # Time passes, nutrients settle #
in

# Utility: clamp value between 0 and 100 #
let clamp : Int -> Int =
  fun x ->
    if x < 0 then 0
    else if x > 100 then 100
    else x
in

# Initial balanced soil - good starting conditions #
let balancedSoil : Soil = (n = 60, p = 60, k = 60) in

# Create a fresh plot with balanced soil #
let newPlot : Plot = (
  soil = balancedSoil,
  crop = None,
  season = 1
) in

# Calculate how a crop affects soil when planted #
let plantingCost : (Soil, Crop) -> Soil =
  fun (s, crop) ->
    case crop
    | Nightbeans => (n = s.n, p = clamp(s.p - 5), k = clamp(s.k - 5))
    | Mooncorn => (n = clamp(s.n - 5), p = clamp(s.p - 5), k = clamp(s.k - 5))
    | Startomatoes => (n = clamp(s.n - 5), p = clamp(s.p - 5), k = clamp(s.k - 5))
    | TwilightClover => (n = s.n, p = clamp(s.p - 3), k = clamp(s.k - 3))
    end
in

# Calculate how a crop affects soil when harvested #
let harvestEffect : (Soil, Crop) -> Soil =
  fun (s, crop) ->
    case crop
    | Nightbeans =>
        (n = clamp(s.n + 15), p = clamp(s.p - 10), k = clamp(s.k - 10))
    | Mooncorn =>
        (n = clamp(s.n - 30), p = clamp(s.p - 10), k = clamp(s.k - 15))
    | Startomatoes =>
        (n = clamp(s.n - 15), p = clamp(s.p - 15), k = clamp(s.k - 15))
    | TwilightClover =>
        (n = s.n, p = clamp(s.p + 20), k = clamp(s.k - 5))
    end
in

# Apply compost - boosts all nutrients #
let applyCompost : Soil -> Soil =
  fun s ->
    (n = clamp(s.n + 10), p = clamp(s.p + 10), k = clamp(s.k + 10))
in

# Season change - minor settling/leaching #
let seasonSettle : Soil -> Soil =
  fun s ->
    (n = clamp(s.n - 3), p = clamp(s.p - 2), k = clamp(s.k - 2))
in

# Main update function #
let update : (Plot, Action) -> Plot =
  fun (p, action) ->
    case action
    | Plant(crop) =>
        case p.crop
        | Some(_) => p
        | None =>
            (
              soil = plantingCost(p.soil, crop),
              crop = Some(crop),
              season = p.season
            )
        end
    | Harvest =>
        case p.crop
        | None => p
        | Some(crop) =>
            (
              soil = harvestEffect(p.soil, crop),
              crop = None,
              season = p.season
            )
        end
    | Compost =>
        (
          soil = applyCompost(p.soil),
          crop = p.crop,
          season = p.season
        )
    | SeasonChange =>
        (
          soil = seasonSettle(p.soil),
          crop = p.crop,
          season = p.season + 1
        )
    end
in

# Run multiple actions in sequence #
let farm : (Plot, [Action]) -> Plot =
  fun (plot, actions) ->
    fold_left(actions, update, plot)
in

# ===== TESTS ===== #

hint "planting sets the current crop"
test
  let p = update(newPlot, Plant(Mooncorn)) in
  p.crop == Some(Mooncorn)
end;

hint "cannot plant when crop already growing"
test
  let p = farm(newPlot, [Plant(Mooncorn), Plant(Startomatoes)]) in
  p.crop == Some(Mooncorn)
end;

hint "planting has small nutrient cost"
test
  let p = update(newPlot, Plant(Startomatoes)) in
  p.soil.n < newPlot.soil.n
end;

hint "harvesting clears the crop"
test
  let p = farm(newPlot, [Plant(Mooncorn), Harvest]) in
  p.crop == None
end;

hint "harvesting nothing changes nothing"
test
  let p = update(newPlot, Harvest) in
  p == newPlot
end;

hint "mooncorn depletes nitrogen heavily"
test
  let p = farm(newPlot, [Plant(Mooncorn), Harvest]) in
  p.soil.n < newPlot.soil.n - 20
end;

hint "nightbeans restore nitrogen"
test
  let depleted = (
    soil = (n = 30, p = 50, k = 50),
    crop = None,
    season = 1
  ) in
  let p = farm(depleted, [Plant(Nightbeans), Harvest]) in
  p.soil.n > depleted.soil.n
end;

hint "twilight clover restores nitrogen significantly"
test
  let depleted = (
    soil = (n = 30, p = 60, k = 60),
    crop = None,
    season = 1
  ) in
  let p = farm(depleted, [Plant(TwilightClover), Harvest]) in
  p.soil.n >= 45
end;

hint "startomatoes deplete all nutrients moderately"
test
  let p = farm(newPlot, [Plant(Startomatoes), Harvest]) in
  p.soil.n < newPlot.soil.n &&
  p.soil.p < newPlot.soil.p &&
  p.soil.k < newPlot.soil.k
end;

hint "compost boosts all nutrients"
test
  let p = update(newPlot, Compost) in
  p.soil.n > newPlot.soil.n &&
  p.soil.p > newPlot.soil.p &&
  p.soil.k > newPlot.soil.k
end;

hint "compost respects maximum (100)"
test
  let rich = (soil = (n = 95, p = 95, k = 95), crop = None, season = 1) in
  let p = update(rich, Compost) in
  p.soil.n == 100 && p.soil.p == 100 && p.soil.k == 100
end;

hint "season advances counter"
test
  let p = update(newPlot, SeasonChange) in
  p.season == 2
end;

hint "season change causes minor nutrient loss"
test
  let p = update(newPlot, SeasonChange) in
  p.soil.n < newPlot.soil.n
end;

hint "mooncorn then clover rotation restores nitrogen"
test
  let start = (soil = (n = 60, p = 60, k = 60), crop = None, season = 1) in
  let afterMooncorn = farm(start, [Plant(Mooncorn), Harvest]) in
  let afterClover = farm(afterMooncorn, [Plant(TwilightClover), Harvest]) in
  afterClover.soil.n > afterMooncorn.soil.n &&
  afterClover.soil.n >= 40
end;

hint "nutrients cannot go below 0"
test
  let poor = (soil = (n = 10, p = 10, k = 10), crop = None, season = 1) in
  let p = farm(poor, [Plant(Mooncorn), Harvest]) in
  p.soil.n >= 0 && p.soil.p >= 0 && p.soil.k >= 0
end;

hint "nutrients cannot exceed 100"
test
  let rich = (soil = (n = 90, p = 90, k = 90), crop = None, season = 1) in
  let p = farm(rich, [Compost, Compost, Compost]) in
  p.soil.n <= 100 && p.soil.p <= 100 && p.soil.k <= 100
end;

# Full season demo #
farm(newPlot, [
  Plant(Mooncorn),
  SeasonChange,
  Harvest,
  Plant(TwilightClover),
  SeasonChange,
  Harvest,
  Compost,
  Plant(Nightbeans),
  SeasonChange,
  Harvest
])
