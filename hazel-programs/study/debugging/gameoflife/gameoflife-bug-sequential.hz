# CONWAY'S GAME OF LIFE #
# Cellular automaton with birth/death rules #

type Cell = + Dead + Alive in

type Grid = (
  cells = [Cell],
  width = Int,
  height = Int
) in

let makeGrid : (Int, Int) -> Grid =
  fun (w, h) ->
    (
      cells = map(range(0, w * h - 1), fun _ -> Dead),
      width = w,
      height = h
    )
in

let toIndex : (Grid, Int, Int) -> Int =
  fun (g, x, y) ->
    y * g.width + x
in

let inBounds : (Grid, Int, Int) -> Bool =
  fun (g, x, y) ->
    x >= 0 && x < g.width && y >= 0 && y < g.height
in

let getCell : (Grid, Int, Int) -> Cell =
  fun (g, x, y) ->
    if inBounds(g, x, y)
    then nth(g.cells, toIndex(g, x, y))
    else Dead
in

let setCell : (Grid, Int, Int, Cell) -> Grid =
  fun (g, x, y, cell) ->
    let idx = toIndex(g, x, y) in
    (
      cells = mapi(g.cells, fun (i, c) -> if i == idx then cell else c),
      width = g.width,
      height = g.height
    )
in

let countNeighbors : (Grid, Int, Int) -> Int =
  fun (g, x, y) ->
    let neighbors = [
      getCell(g, x - 1, y - 1),
      getCell(g, x,     y - 1),
      getCell(g, x + 1, y - 1),
      getCell(g, x - 1, y),
      getCell(g, x + 1, y),
      getCell(g, x - 1, y + 1),
      getCell(g, x,     y + 1),
      getCell(g, x + 1, y + 1)
    ] in
    length(filter(neighbors, fun c -> c == Alive))
in

let nextCellState : (Cell, Int) -> Cell =
  fun (current, neighbors) ->
    case current
    | Alive =>
        if neighbors == 2 || neighbors == 3
        then Alive
        else Dead
    | Dead =>
        if neighbors == 3
        then Alive
        else Dead
    end
in

# BUG: Sequential update - each cell sees the updated state of previous cells #
# instead of all cells seeing the same original state #
let step : Grid -> Grid =
  fun g ->
    let indices = range(0, g.width * g.height - 1) in
    fold_left(indices, fun (currentGrid, idx) ->
      let x = idx - (idx / g.width) * g.width in
      let y = idx / g.width in
      let current = getCell(currentGrid, x, y) in
      let neighbors = countNeighbors(currentGrid, x, y) in
      let newState = nextCellState(current, neighbors) in
      setCell(currentGrid, x, y, newState)
    , g)
in

let setAlive : (Grid, [(Int, Int)]) -> Grid =
  fun (g, coords) ->
    fold_left(coords, fun (grid, xy) ->
      let (x, y) = xy in
      setCell(grid, x, y, Alive)
    , g)
in

let countAlive : Grid -> Int =
  fun g ->
    length(filter(g.cells, fun c -> c == Alive))
in

# Test: blinker should oscillate correctly with simultaneous update #
hint "updates are simultaneous not sequential"
test
  let g = setAlive(makeGrid(5, 5), [(1, 2), (2, 2), (3, 2)]) in
  let g2 = step(g) in
  getCell(g2, 1, 2) == Dead &&
  getCell(g2, 3, 2) == Dead
end;

let blinker = setAlive(makeGrid(5, 5), [(1, 2), (2, 2), (3, 2)]) in
step(blinker)
