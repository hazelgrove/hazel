# TIC-TAC-TOE #
# Classic 3x3 game with cats vs dogs #

type Cell = + Empty + X + O in

type Board = [Cell] in

type Player = + PlayerX + PlayerO in

type GameStatus =
  + InProgress
  + Won(Player)
  + Draw
in

type Model = (
  board = Board,
  turn = Player,
  status = GameStatus
) in

let emptyBoard : Board =
  [Empty, Empty, Empty,
   Empty, Empty, Empty,
   Empty, Empty, Empty]
in

let init : Model = (
  board = emptyBoard,
  turn = PlayerX,
  status = InProgress
) in

let getCell : (Board, Int) -> Cell =
  fun (board, pos) ->
    nth(board, pos)
in

let setCell : (Board, Int, Cell) -> Board =
  fun (board, pos, cell) ->
    mapi(board, fun (i, c) -> if i == pos then cell else c)
in

let playerCell : Player -> Cell =
  fun p ->
    case p
    | PlayerX => X
    | PlayerO => O
    end
in

let threeInRow : (Cell, Cell, Cell) -> Option =
  fun (a, b, c) ->
    case (a, b, c)
    | (X, X, X) => Some(X)
    | (O, O, O) => Some(O)
    | _ => None
    end
in

let getCells3 : (Board, Int, Int, Int) -> (Cell, Cell, Cell) =
  fun (board, i, j, k) ->
    (getCell(board, i), getCell(board, j), getCell(board, k))
in

let checkWinner : Board -> Option =
  fun board ->
    let row0 = threeInRow(getCells3(board, 0, 1, 2)) in
    let row1 = threeInRow(getCells3(board, 3, 4, 5)) in
    let row2 = threeInRow(getCells3(board, 6, 7, 8)) in
    let col0 = threeInRow(getCells3(board, 0, 3, 6)) in
    let col1 = threeInRow(getCells3(board, 1, 4, 7)) in
    let col2 = threeInRow(getCells3(board, 2, 5, 8)) in
    let diag1 = threeInRow(getCells3(board, 0, 4, 8)) in
    let diag2 = threeInRow(getCells3(board, 2, 4, 6)) in
    case row0 | Some(c) => Some(c) | None =>
    case row1 | Some(c) => Some(c) | None =>
    case row2 | Some(c) => Some(c) | None =>
    case col0 | Some(c) => Some(c) | None =>
    case col1 | Some(c) => Some(c) | None =>
    case col2 | Some(c) => Some(c) | None =>
    case diag1 | Some(c) => Some(c) | None =>
    diag2
    end end end end end end end
in

let isFull : Board -> Bool =
  fun board ->
    for_all(board, fun c -> c != Empty)
in

let cellToPlayer : Cell -> Player =
  fun c ->
    case c
    | X => PlayerX
    | O => PlayerO
    | Empty => PlayerX
    end
in

let calcStatus : Board -> GameStatus =
  fun board ->
    case checkWinner(board)
    | Some(c) => Won(cellToPlayer(c))
    | None =>
        if isFull(board) then Draw
        else InProgress
    end
in

# BUG: nextPlayer is swapped - X returns X, O returns O #
let nextPlayer : Player -> Player =
  fun p ->
    case p
    | PlayerX => PlayerX
    | PlayerO => PlayerO
    end
in

let isValidMove : (Model, Int) -> Bool =
  fun (m, pos) ->
    pos >= 0 && pos < 9 &&
    getCell(m.board, pos) == Empty &&
    m.status == InProgress
in

let move : (Model, Int) -> Model =
  fun (m, pos) ->
    if isValidMove(m, pos) then
      let newBoard = setCell(m.board, pos, playerCell(m.turn)) in
      let newStatus = calcStatus(newBoard) in
      (
        board = newBoard,
        turn = nextPlayer(m.turn),
        status = newStatus
      )
    else m
in

let play : (Model, [Int]) -> Model =
  fun (model, moves) ->
    fold_left(moves, move, model)
in

# Test: O should get a turn after X #
hint "O places O marker"
test
  let m = play(init, [0, 4]) in
  getCell(m.board, 4) == O
end;

play(init, [4, 0, 2, 6, 1, 3, 7])
