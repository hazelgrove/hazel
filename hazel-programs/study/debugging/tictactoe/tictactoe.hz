# TIC-TAC-TOE #
# Classic 3x3 game with cats vs dogs #

type Cell = + Empty + X + O in

type Board = [Cell] in  # 9 cells, row-major: [0,1,2,3,4,5,6,7,8] #

type Player = + PlayerX + PlayerO in

type GameStatus =
  + InProgress
  + Won(Player)
  + Draw
in

type Model = (
  board = Board,
  turn = Player,
  status = GameStatus
) in

# Initial empty board #
let emptyBoard : Board =
  [Empty, Empty, Empty,
   Empty, Empty, Empty,
   Empty, Empty, Empty]
in

let init : Model = (
  board = emptyBoard,
  turn = PlayerX,
  status = InProgress
) in

# Get cell at position (0-8) #
let getCell : (Board, Int) -> Cell =
  fun (board, pos) ->
    nth(board, pos)
in

# Set cell at position #
let setCell : (Board, Int, Cell) -> Board =
  fun (board, pos, cell) ->
    mapi(board, fun (i, c) -> if i == pos then cell else c)
in

# Convert player to their cell marker #
let playerCell : Player -> Cell =
  fun p ->
    case p
    | PlayerX => X
    | PlayerO => O
    end
in

# Check if three cells are the same and not empty #
let threeInRow : (Cell, Cell, Cell) -> Option =
  fun (a, b, c) ->
    case (a, b, c)
    | (X, X, X) => Some(X)
    | (O, O, O) => Some(O)
    | _ => None
    end
in

# Get cells at positions #
let getCells3 : (Board, Int, Int, Int) -> (Cell, Cell, Cell) =
  fun (board, i, j, k) ->
    (getCell(board, i), getCell(board, j), getCell(board, k))
in

# Check all winning lines #
let checkWinner : Board -> Option =
  fun board ->
    # Rows #
    let row0 = threeInRow(getCells3(board, 0, 1, 2)) in
    let row1 = threeInRow(getCells3(board, 3, 4, 5)) in
    let row2 = threeInRow(getCells3(board, 6, 7, 8)) in
    # Columns #
    let col0 = threeInRow(getCells3(board, 0, 3, 6)) in
    let col1 = threeInRow(getCells3(board, 1, 4, 7)) in
    let col2 = threeInRow(getCells3(board, 2, 5, 8)) in
    # Diagonals #
    let diag1 = threeInRow(getCells3(board, 0, 4, 8)) in
    let diag2 = threeInRow(getCells3(board, 2, 4, 6)) in
    # Return first winning line found #
    case row0 | Some(c) => Some(c) | None =>
    case row1 | Some(c) => Some(c) | None =>
    case row2 | Some(c) => Some(c) | None =>
    case col0 | Some(c) => Some(c) | None =>
    case col1 | Some(c) => Some(c) | None =>
    case col2 | Some(c) => Some(c) | None =>
    case diag1 | Some(c) => Some(c) | None =>
    diag2
    end end end end end end end
in

# Check if board is full #
let isFull : Board -> Bool =
  fun board ->
    for_all(board, fun c -> c != Empty)
in

# Convert winning cell to player #
let cellToPlayer : Cell -> Player =
  fun c ->
    case c
    | X => PlayerX
    | O => PlayerO
    | Empty => PlayerX  # shouldn't happen #
    end
in

# Determine game status from board #
let calcStatus : Board -> GameStatus =
  fun board ->
    case checkWinner(board)
    | Some(c) => Won(cellToPlayer(c))
    | None =>
        if isFull(board) then Draw
        else InProgress
    end
in

# Switch turns #
let nextPlayer : Player -> Player =
  fun p ->
    case p
    | PlayerX => PlayerO
    | PlayerO => PlayerX
    end
in

# Check if move is valid #
let isValidMove : (Model, Int) -> Bool =
  fun (m, pos) ->
    pos >= 0 && pos < 9 &&
    getCell(m.board, pos) == Empty &&
    m.status == InProgress
in

# Make a move #
let move : (Model, Int) -> Model =
  fun (m, pos) ->
    if isValidMove(m, pos) then
      let newBoard = setCell(m.board, pos, playerCell(m.turn)) in
      let newStatus = calcStatus(newBoard) in
      (
        board = newBoard,
        turn = nextPlayer(m.turn),
        status = newStatus
      )
    else m  # Invalid move, no change #
in

# Play a sequence of moves #
let play : (Model, [Int]) -> Model =
  fun (model, moves) ->
    fold_left(moves, move, model)
in

# ===== TESTS ===== #

hint "initial board is empty"
test
  for_all(init.board, fun c -> c == Empty)
end;

hint "X plays first"
test
  init.turn == PlayerX
end;

hint "game starts in progress"
test
  init.status == InProgress
end;

hint "move places correct marker"
test
  let m = move(init, 0) in
  getCell(m.board, 0) == X
end;

hint "turn alternates after move"
test
  let m = move(init, 0) in
  m.turn == PlayerO
end;

hint "O places O marker"
test
  let m = play(init, [0, 4]) in
  getCell(m.board, 4) == O
end;

hint "invalid move on occupied cell"
test
  let m = play(init, [0, 0]) in  # X plays 0, O tries 0 #
  getCell(m.board, 0) == X &&    # Still X, not O #
  m.turn == PlayerO              # Still O's turn #
end;

hint "X wins with top row"
test
  let m = play(init, [0, 3, 1, 4, 2]) in  # X: 0,1,2 O: 3,4 #
  m.status == Won(PlayerX)
end;

hint "O wins with middle column"
test
  let m = play(init, [0, 1, 2, 4, 6, 7]) in  # X: 0,2,6 O: 1,4,7 #
  m.status == Won(PlayerO)
end;

hint "X wins with main diagonal"
test
  let m = play(init, [0, 1, 4, 2, 8]) in  # X: 0,4,8 O: 1,2 #
  m.status == Won(PlayerX)
end;

hint "X wins with anti-diagonal"
test
  let m = play(init, [2, 0, 4, 1, 6]) in  # X: 2,4,6 O: 0,1 #
  m.status == Won(PlayerX)
end;

hint "draw when board full with no winner"
test
  let m = play(init, [0, 1, 2, 5, 3, 6, 4, 8, 7]) in
  case m.status | Draw => true | _ => false end
end;

hint "no moves after win"
test
  let m = play(init, [0, 3, 1, 4, 2, 5]) in
  case m.status | Won(PlayerX) => getCell(m.board, 5) == Empty | _ => false end
end;

hint "can't move to position 9 or higher"
test
  let m = move(init, 9) in
  for_all(m.board, fun c -> c == Empty)
end;

hint "can't move to negative position"
test
  let m = move(init, -1) in
  for_all(m.board, fun c -> c == Empty)
end;

hint "O wins with bottom row"
test
  let m = play(init, [0, 6, 1, 7, 4, 8]) in  # X: 0,1,4 O: 6,7,8 #
  m.status == Won(PlayerO)
end;

hint "X wins with left column"
test
  let m = play(init, [0, 1, 3, 4, 6]) in  # X: 0,3,6 O: 1,4 #
  m.status == Won(PlayerX)
end;

hint "X wins with right column"
test
  let m = play(init, [2, 0, 5, 1, 8]) in  # X: 2,5,8 O: 0,1 #
  m.status == Won(PlayerX)
end;

# Demo: a quick game #
play(init, [4, 0, 2, 6, 1, 3, 7])
