      count@<(
        name = String,
        get_acne = Bool,
        red = Bool,
        black = Bool,
        white = Bool,
        green = Bool,
        yellow = Bool,
        brown = Bool,
        orange = Bool,
        pink = Bool,
        purple = Bool,
        `brown and get acne` = Bool
      )>@<Bool>(brown_and_get_acne_table, fun r -> r.`brown and get acne`) in
