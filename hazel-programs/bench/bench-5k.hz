    (enforced=^^check(true), "schema(r2) == schema(t1)"),
    (enforced=^^check(true), "schema(r3) == schema(t2)"),
    (enforced = ^^check(true), "schema(t2) == schema(r4)")
  ] in
  let select_many : poly r1 -> poly r2 -> poly r3 -> ([r1], (r1, Int) -> [r2], (r1, r2) -> r3) -> [r3] =
    typfun r1 ->
      typfun r2 ->
        typfun r3 ->
          fun (t1 : [r1], project : ((r1, Int) -> [r2]), result : ((r1, r2) -> r3)) ->
