let bench_66 = (
  type Student = (name = String, age = Int, favorite_color = String) in
  let students : [Student] = [("Bob", 12, "blue"), ("Alice", 17, "green"), ("Eve", 13, "red")] in
  
  # V1: This version is a higher order function that takes a function for constructing the resulting row offering more type safety #
  let v1 =
    let _requires = [(enforced = ^^check(false), "c is not in header(t1)")] in
    let _ensures = [
      (enforced=^^check(true), "schema(r) is equal to schema(t1)"),
      (enforced=^^check(true), "header(t2) is equal to concat(header(t1), [c])"), # Assuming user passes tuple extension #
      (enforced=^^check(true), "for all c' in header(t1), schema(t2)[c'] is equal to schema(t1)[c']"), # Assuming user passes tuple extension #
      (enforced=^^check(true), "schema(t2)[c] is equal to the sort of v"), # Assuming user passes tuple extension #
      (enforced = ^^check(false), "nrows(t2) is equal to nrows(t1)")
    ] in
    let build_column =
      typfun r -> typfun v -> typfun r' -> fun (t : [r], c : ((r, v) -> r'), f : (r -> v)) -> map(t, fun r -> c(r, f(r))) : [r'] in
    # Examples #
    test
      build_column@<Student>@<Bool>@<(name = String, age = Int, favorite_color = String, `is-teenager` = Bool)>(students, fun (s, b) -> s ... (`is-teenager` = b), fun student -> student.age > 12 && student.age < 20)
      == (
        [("Bob", 12, "blue", false), ("Alice", 17, "green", true), ("Eve", 13, "red", true)]
        : [(name = String, age = Int, favorite_color = String, `is-teenager` = Bool)]
      ) end in
  
  # V2: This version more closely matches the TableAPI and takes a string column. Given the lack of row polymorphism no constraints are ensured #
  let v2 =
    let _requires = [(enforced = ^^check(false), "c is not in header(t1)")] in
    let _ensures = [
      (enforced=^^check(false), "schema(r) is equal to schema(t1)"),
      (enforced=^^check(false), "header(t2) is equal to concat(header(t1), [c])"),
      (enforced=^^check(false), "for all c' in header(t1), schema(t2)[c'] is equal to schema(t1)[c']"),
      (enforced=^^check(false), "schema(t2)[c] is equal to the sort of v"),
      (enforced = ^^check(false), "nrows(t2) is equal to nrows(t1)")
    ] in
    #Lack of first class labels requires writing this with from_lvs and to_lvs. With a known column v1 should be used#
    let build_column = fun (t : [?], c : String, f : ? -> ?) -> map(t, fun (r) -> from_lvs(to_lvs(r) @ [(c, f(r))])) in
    # Examples #
    test
      build_column(students, "is-teenager", fun student -> student.age > 12 && student.age < 20)
      == (
        [("Bob", 12, "blue", false), ("Alice", 17, "green", true), ("Eve", 13, "red", true)]
        : [(name = String, age = Int, favorite_color = String, `is-teenager` = Bool)]
      ) end in
  ?
) in
let bench_67 = (
  type Student = (name = String, age = Int, favorite_color = String) in
  let students : [Student] = [("Bob", 12, "blue"), ("Alice", 17, "green"), ("Eve", 13, "red")] in
  type Jelly = (get_acne = Bool, red = Bool, black = Bool) in
  let petiteJelly : [Jelly] = [(true, false, false), (true, false, true)] in
  
  # V1: This version is more idiomatic and requires the caller to provide tuple extension via a higher order function. Therefore more constraints are ensured #
  let v1 =
    let _requires = [(enforced = ^^check(false), "concat(header(t1), header(t2)) has no duplicates")] in
    let _ensures = [
      (enforced=^^check(true), "schema(t3) is equal to concat(schema(t1), schema(t2))"), # Assuming the higher order function provided is tuple extension #
      (enforced = ^^check(false), "nrows(t3) is equal to nrows(t1) * nrows(t2)")
    ] in
    let cross_join =
      typfun r1 ->
        typfun r2 ->
          typfun r3 -> fun (t1 : [r1], t2 : [r2], combine : ((r1, r2) -> r3)) -> flat_map(t1, fun r1 -> map(t2, fun r2 -> combine(r1, r2))) : [r3] in
    # Examples #
    test
      cross_join@<Student>@<Jelly>@<(name = String, age = Int, favorite_color = String, get_acne = Bool, red = Bool, black = Bool)>(students, petiteJelly, fun (s, j) -> s ... j)
      == (
        [
          ("Bob", 12, "blue", true, false, false),
          ("Bob", 12, "blue", true, false, true),
          ("Alice", 17, "green", true, false, false),
          ("Alice", 17, "green", true, false, true),
          ("Eve", 13, "red", true, false, false),
          ("Eve", 13, "red", true, false, true)
        ]
        : [(name = String, age = Int, favorite_color = String, get_acne = Bool, red = Bool, black = Bool)]
      ) end in
  # V2: This version more closely matches the TableAPI. Given the lack of row polymorphism no constraints are ensured #
  let v2 =
    let _requires = [(enforced = ^^check(false), "concat(header(t1), header(t2)) has no duplicates")] in
    let _ensures = [
      (enforced=^^check(false), "schema(t3) is equal to concat(schema(t1), schema(t2))"),
      (enforced = ^^check(false), "nrows(t3) is equal to nrows(t1) * nrows(t2)")
    ] in
    # V1 is the more idiomatic version #
    let cross_join = fun (t1 : [?], t2 : [?]) -> flat_map(t1, fun r1 -> map(t2, fun r2 -> r1 ... r2)) in
    # Examples #
    test
      cross_join(students, petiteJelly)
      == (
        [
          ("Bob", 12, "blue", true, false, false),
          ("Bob", 12, "blue", true, false, true),
          ("Alice", 17, "green", true, false, false),
          ("Alice", 17, "green", true, false, true),
          ("Eve", 13, "red", true, false, false),
          ("Eve", 13, "red", true, false, true)
        ]
        : [(name = String, age = Int, favorite_color = String, get_acne = Bool, red = Bool, black = Bool)]
      ) end in
  ?
) in
