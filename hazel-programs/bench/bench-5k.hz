let bench_40 = (
  # Lambda Calculus via evaluation by substitution #
  
  # An Expression is a variable, function, or application #
  type Exp =
    + Var(String)
    + Lam(String, Exp)
    + Ap(Exp, Exp) in
  
  # Substitute Exp v for variable name in Exp e #
  let subst: (Exp, String, Exp) -> Exp =
    fun (v, name, e) ->
      case e
      | Var(x) =>
        if x == name then v else e
      | Lam(x, body) =>
        Lam(x, subst(v, name, body))
      | Ap(f, arg) =>
        Ap(subst(v, name, f), subst(v, name, arg)) end in
  
  # Evaluation can result in either an Exp or an Error #
  type Result =
    + Error(String)
    + Ok(Exp)
  in
  
  # A sum type with no constructors is the built-in Void type. #
  # Since Void has no inhabitants, an eliminator on a Void value can #
  # return any type -- here, any Result -- without ever producing one. #
  let absurd: Void -> Result =
    fun v -> case v end
  in
  
  # Since Void has no inhabitants, any complete expression of type Void #
  # must fail to terminate -- there is no Void value to produce. #
  let diverge: () -> Void =
    fun () -> diverge()
  in
  
  # Evaluation by substitution #
  let go: Exp -> Result =
    fun e ->
      case e
      | Var(_n) => Error("Free Variable")
      | Lam(x, body) => Ok(Lam(x, body))
      | Ap(e1,e2) =>
        case go(e1)
        | Ok(Lam(x, body))=>
          case go(e2)
          | Error(err) => Error(err)
          | Ok(arg) => go(subst(arg, x, body)) end
        | _ => Error("Not a Function") end end in
  
  test
    go(Var("yo"))
    == Error("Free Variable") end;
  
  test
    go(Ap(Var("no"), Lam("bro", Var("bro"))))
    == Error("Not a Function") end;
  
  test
    go(Lam("yo", Var("yo")))
    == Ok(Lam("yo", Var("yo"))) end;
  
  test
    go(Ap(Lam("yo", Var("yo")), Lam("bro", Var("bro"))))
    == Ok(Lam("bro", Var("bro"))) end;
  
  ¿
) in
let bench_41 = (
  # Hazel Language Quick Reference #
  
  # Empty holes stand for missing expressions, patterns, or types #
  let empty_hole = ¿ in
  
  # Non-empty holes are the red boxes around type errors #
  # (you can still run programs with non-empty holes) #
  let non_empty_hole : Int = true in
  
  let warnings = (
    # Warnings are orange boxes around unused variables #
    (let x = 0 in 1),
    # Prefixing a variable name with an underscore disables the warning... #
    (let _x = 0 in 1),
    # ...and so does the presence of an empty hole in the unused variable's scope #
    (let x = 0 in ¿)
  ) in
  
  # Booleans #
  let bool: Bool = true in
  let operators = !true && false || true in
  
  let conditional = if !true then 1 else 2 in
  
  # Integers #
  let num = 1 : Int in 
  let arithmetic = -num*1 + 2/3 - 4**5 in
  let comparison =
    (0 == 0, 0 < 1, 1 <= 1, 2 > 1, 1 >= 1 )
  in
  
  # Integers are unlimited by default #
  let big_num: Int = 10000000000000000000000000 in
  # Use SInt for fixed-with system integers #
  let bad_num: SInt = 1000000000000000000000000 in
  # Use Nat for non-negative integers #
  let nat : Nat = 5 in
  
  # Floating Point Numbers #
  let float: Float = 0.1 in
  let arithmetic = 0. *. 1. +. 2. /. 3. -. 4. **. 5. in
  let comparison =
    (0. ==. 0., 0. <. 1., 1. <=. 1., 2. >. 1., 1. >=. 1.)
  in
  
  # "use" lets you set the default number format #
  # for literals and operators. #
  let natural = 
    use Nat in 
    1 + 2 * 5 
  in
  
  # Strings #
  let string = "Hello, world!" in 
  let concatenation  = string ++ " Goodbye." in
  let comparison = string == "Hello, world!" in
  
  # Tuples (Destructured with let expressions) #
  let tuple : (Int, Bool, (Bool, Int)) =
    (1, true, (false, 3)) in
  let (a, b, (c, d)) = tuple in
  
  # Functions (Take a single argument which can be a tuple) #
  let y : (Int, Int, Int) -> Int =
    fun (m, x, b) -> m * x + b in
  
  # Recursive Functions (Arrow type annotation required) #
  let double_recursively : Int -> Int =
    fun n ->
      if n == 0
      then 0
      else double_recursively(n - 1) + 2
  in
  
  # Mutual Recursion (bind tuples of functions) #
  let (even : Int -> Bool, odd : Int -> Bool) = (
    fun n -> if n == 0 then true else odd(n - 1),
    fun n -> if n == 0 then false else even(n - 1)
  )
  in
  
  # Lists #
  let empty_list : [Int] = [] in
  let non_empty_list : [Int] = 1::2::3::[] in
  let list_literals : [Int] = [1, 2, 3] in
  let length : [Int] -> Int =
    fun xs ->
      case xs
      | [] => 0
      | _hd::tl => 1 + length(tl)
      end
  in
  let has_at_least_two_elements : [Int] -> Bool =
    fun xs ->
      case xs
      | [] => false
      | _::[] => false
      | _::_::_ => true
      end 
  in
  
  # Algebraic Data Types #
  type Exp =
    + Var(String)
    + Lam(String, Exp)
    + Ap(Exp, Exp) in
  let exp_equal: (Exp, Exp) -> Bool =
    fun es ->
      case es
      | Var(x), Var(y) => x == y
      | Lam(x1, e1), Lam(x2, e2) =>
        x1 == x2 && exp_equal(e1, e2)
      | Ap(e1, e2), Ap(e3, e4) =>
        exp_equal(e1, e3) && exp_equal(e2, e4)
      | _ => false
      end
  in
  
  # Void is the built-in empty sum -- a type with no inhabitants. #
  # Eliminating a Void value is "absurd": it can stand in for any type. #
  let absurd : Void -> Int =
    fun v -> case v end
  in
  
  # Polymorphic Functions #
  let poly_id: poly a -> a -> a =
    typfun a -> fun x: a -> x
  in
  let
    apply_both:
    poly a -> poly b -> (poly c -> c -> c) -> ((a, b) -> (a, b))
  =
    typfun a -> typfun b ->
      fun f: poly c -> (c -> c) ->
        fun (x, y): (a, b) -> (f@<a>(x), f@<b>(y))
  in
  let list_length: poly a -> [a] -> Int =
    typfun a -> fun l : [a] ->
      case l
      | [] => 0
      | _hd::tl => 1 + list_length@<a>(tl)
      end
  in
  
  # Tests, separated by semicolons #
  test 2 + 2 == 4 end;
  test 3 + 3 == 6 end;
  test 2 + 2 == 5 end;
  
  # The value of the program is shown at the bottom #  
  ¿
) in
let bench_42 = (
  # PLAYING CARD LITERALS #
  
  type Suit = (Hearts + Diamonds + Clubs + Spades) in
  type Rank = + Ace + Jack + Queen + King
  + Two + Three + Four + Five + Six + Seven + Eight + Nine + Ten in
  
  # A card is a pair of a suit and a rank!#
  type Card = (Suit, Rank) in
  
  # Use alt/option-l to display a card as a card. #
  let one_card = ^^card((Spades,Jack)) in
  # Decks (list of cards) can also be displayed as cards: #
  let deck: [Card] = ^^card([(Hearts, King), (Clubs, Queen), (Clubs, Four), (Clubs, Ace), (Diamonds, Four), (Hearts, Nine), (Clubs, Ace), (Diamonds, Ten), (Diamonds, Nine),((Hearts, King)), (Spades, Two), (Spades, Ace), (Clubs, Ace)]) in
  
  # Clicking on a card flips it over (just for fun) #
  # Shift-clicking on a card lets you pick a different card#
  
  # You can use the card display in patterns too. #
  # A wildcard pattern can be used for the rank or suit#
  let flush = fun hand ->
    case hand
    | ^^card([(Hearts, _), (Hearts, _), (Hearts, _), (Hearts, _), (Hearts, _)]) => true
    | ^^card([(Clubs,_),(Clubs,_),(Clubs,_),(Clubs,_),(Clubs,_)]) => true
    | ^^card([(Diamonds,_),(Diamonds,_),(Diamonds,_),(Diamonds,_),(Diamonds,_)]) => true
    | ^^card([(Spades,_),(Spades,_),(Spades,_),(Spades,_),(Spades,_)]) => true
    | _ => false  
    end in
  
  test flush([^^card((Hearts, King)),^^card((Hearts, Queen)),^^card((Hearts, Jack)),^^card((Hearts, Ten)),^^card((Hearts, Ace))]) end
) in
let bench_43 = (
  # LIVELITS #
  # A livelit is a live GUI widget which can be inserted into expressions. #
  # It elaborates to a value of some given type. #
  
  # Invocation: #
  # To invoke a livelit, insert the name of the livelit (always prefixed with ^) then space. #
  # The context inspector shows which livelits are available and their elaboration type. #
  
  # Each livelit maintains an internal model, which is not generally something the #
  # programmer should need to look at. You can see the internal model by toggling #
  # the livelit projector off (bottom right corner of Hazel). #
  
  # Built-in Livelits: #
  # Currently, all livelits are built in: #
  
  # 1. ^slider #
  # Elaboration Type: Int                                                     #
  # Elaboration: The current value of the slider, which is between 0 and 100. #
  # Internal Model: Int                                                       #
  let slider_val = ^^livelit(^slider(85)) in
  
  # 2. ^emotion #
  # Elaboration Type: String                                      #
  # Elaboration: Returns a String representing an emotion,        #
  #              determined as follows based on the slider value: #
  #                if value < 40 then "sad"                       #
  #                if value > 70 then "happy"                     #
  #                otherwise "neutral"                            #
  # Internal Model: Int                                           #
  let current_mood = ^^livelit(^emotion(0)) in¿
) in
let bench_44 = (
  # MODULES #
  
  # Modules use curly-brace syntax with semicolon-separated items. #
  # The `module` keyword supports capitalized module names. #
  # Modules are syntactic sugar for labeled tuples. #
  
  
  # A. MODULE CONSTRUCTION AND ACCESS #
  
  # 1. Defining and accessing a module #
  module Geometry = {
    type Point = (Int, Int);
    type Distance = Int;
    let origin : Point = (0, 0);
    let manhattan =
      fun (x, y) : Point -> x + y
  } in
  
  let pt : Geometry.Point = (3, 4) in
  let dist : Geometry.Distance = Geometry.manhattan(pt) in
  
  # 2. Empty module #
  module Empty = {} in
  
  # 3. Lowercase `let` works too #
  let colors = {
    let red = 1;
    let green = 2;
    let blue = 3
  } in
  let r = colors.red in
  
  # 4. Later bindings can reference earlier ones #
  module Counter = {
    let start = 0;
    let next = start + 1;
    let after = next + 1
  } in
  
  # 5. Shadowing: last binding wins #
  module M = {
    let x = 1;
    let x = "hello"
  } in
  
  # 6. Test assertion inside a module #
  module M = {
    test 1 + 1 == 2 end;
    let result = 99
  } in
  
  
  # B. QUALIFIED TYPE ACCESS #
  
  # 7. Type aliases are accessible via dot notation in types #
  module Units = {
    type Meters = Int;
    type Seconds = Int
  } in
  let height : Units.Meters = 170 in
  let duration : Units.Seconds = 60 in
  
  # 8. Nested modules and nested type access #
  module Outer = {
    module Inner = {
      type T = Bool;
      let value = true
    }
  } in
  let b : Outer.Inner.T = Outer.Inner.value in
  
  # 9. Module aliasing propagates type exports #
  module Base = {
    type Id = Int
  } in
  module App = {
    module Db = Base;
    type UserId = Db.Id
  } in
  let uid : App.Db.Id = 42 in
  let uid2 : App.UserId = uid in
  
  # 10. Variable aliasing propagates type exports too #
  module M = {
    type T = Int
  } in
  let n = M in
  let x : n.T = 5 in
  
  # 11. Error: nonexistent type member #
  module M = {
    type Real = Int
  } in
  let bad : M.Fake = 1 in
  
  
  # C. MODULE SIGNATURES #
  
  # Signatures use curly-brace syntax in type position: #
  # { let name : Type; ... } #
  
  # 12. Module matching its signature #
  module M : {let x : Int} = {let x = 42} in
  
  # 13. Empty signature #
  module M : {} = {} in
  
  # 14. Error: member type doesn't match signature #
  module M : {let x : Int} = {let x = true} in
  
  # 15. Error: one matching, one non-matching member #
  module M : {
    let x : Int;
    let y : Bool
  } = {
    let x = 1;
    let y = 2
  } in
  
  # 16. Error: module is missing a required member #
  module M : {
    let x : Int;
    let y : Bool;
    let z : String
  } = {
    let x = 1;
    let y = true
  } in
  
  # 17. Error: empty module missing all members #
  module M : {
    let x : Int;
    let y : Bool
  } = {} in
  
  # Module sig as alias #
  type MT = {let x: Int} in
  let _ : MT = {let x = 4} in
  
  # D. SUGAR & LIMITATIONS #
  
  # Modules are syntactic sugar for labeled tuples. #
  # Module signatures are sugar for labeled tuple types. #
  
  # 18. Module values are labeled tuples #
  test () == {} end;
  test (x=1) == {let x = 1} end;
  test (x=1, y=true) == {let x = 1; let y = true} end;
  
  # 19. Signatures and tuple types are interchangeable #
  module Mm : {let x : Int} = {let x = 1} in
  let mt : {let x : Int} = (x=1) in
  let tm : (x=Int) = {let x = 1} in
  let tt : (x=Int) = (x=1) in
  
  # 20. Type errors work regardless of which sugar is used #
  module Mm : {let x : Int} = {let x = true} in
  let mt : {let x : Int} = (x=true) in
  let tm : (x=Int) = {let x = true} in
  let tt : (x=Int) = (x=true) in
  
  # No width subtyping yet: signatures must be precise. #
  
  # 21. Error: extra member not allowed by signature #
  module M : {let x : Int} = {
    let x = 1;
    let y = 2
  } in
  
  # 22. Error: extra member not allowed by empty signature #
  module M : {} = {let x = 1} in
  
  # 23. Limitation: type declarations in signatures are ignored #
  module M : {
    type T = Int;
    let x : T;
    let y : T
  } = {
    let x = 4;
    let y = true
  } in
  
  # 24. Limitation: mismatched labels not caught in some cases #
  let m : {let x : ?} = {let y = 1} in
  let m : (x=?) = (y=1) in 
  ¿
) in
let bench_45 = (
  # Polymorphism #
  
  # We can take types as parameters to type functions, #
  # and use them in annoatations in the body: #
  let id = typfun A -> fun x : A -> x in
  
  # Such functions are applied like so: #
  let ex1 = id@<Int>(1) in # 1 #
  
  # We can annotate the type of a type function with a poly. #
  let const : poly A -> poly B -> A -> B -> A = 
    typfun A -> typfun B -> fun x -> fun y -> x in
  let ex2 = const@<Int>@<String>(2)("Hello World") in # 2 #
  
  # We can go beyond rank 1 polymorphism: #
  let apply_both : poly A -> poly B -> (poly D -> D -> D) -> (A , B) -> (A , B) =
    typfun A -> typfun B -> fun f -> fun (x, y) -> (f@<A>(x), f@<B>(y)) in  
  let ex3 = apply_both@<Int>@<String>(id)(3, "Hello World") in # (3, "Hello World") # 
  
  # Finally, here is a more in-depth, yet applicable example: polymorphic map #
  let emptylist : poly A -> [A] = typfun A -> [] in # polymorphic constant #
  let map : poly A -> poly B -> (A -> B) -> ([A] -> [B]) = 
    typfun A -> typfun B -> fun f : (A -> B) -> fun l : [A] -> 
      case l
      | h :: t => f(h) :: map@<A>@<B>(f)(t)
      | _ => emptylist@<B>   
      end in
  let ex4 = map@<Int>@<String>(string_of_int)([1,2,3]) in # ["1", "2", "3"] #
  
  
  # Recursive types #
  
  # We can express recursive types using type aliases #
  type MyList = Nil + Cons(Int, MyList) in
  
  # Hazel does not (yet) support higher-kinded or existential types, #
  # So we cannot implement our own polymorphic lists. #
  
  # Now anything that returns an element of the least fixed point matches MyList. #
  let x : MyList = Cons(1, Cons(2, Cons(3, Nil))) in
  
  # Note that if the sum is the top level operator, #
  # type aliases are implicitly least fixed points on their own name: #
  type MyList2 = Nil + Cons(Int, MyList2) in
  type Broken = Int -> (HasInt(Int) + HasMore(Int, Broken)) in 
  
  
  let list_of_mylist : (MyList -> [Int]) = fun myl : MyList -> 
    case myl 
    | Nil => []
    | Cons(h, t) => h :: list_of_mylist(t)    
    end in
  let ex5 = list_of_mylist(x) in # [1, 2, 3] #
  
  
  # All output from examples: #
  (ex1, ex2, ex3, ex4, ex5)
) in
let bench_46 = (
  #  _____           _                #
  # |  __ \         | |               #
  # | |__) | __ ___ | |__   ___  ___  #
  # |  ___/ '__/ _ \| '_ \ / _ \/ __| #
  # | |   | | | (_) | |_) |  __/\__ \ #
  # |_|   |_|  \___/|_.__/ \___||___/ #
  #    INLINE EVAL WITH LIVE PROBES   #
  
  # INTRODUCTION #
  
  # Probe permit a kind of inline evaluation, #
  # similar to value hints in Emacs or IntelliJ. #
  
  # You can put one on any expression or pattern to see #
  # the values it takes on during evaluation. Sampled #
  # values are sorted by left-to-right by most-recent. #
  
  # When a sample is selected, you can hover over it to see #
  # relevant environment variables, and all /other/ samples #
  # are decorated according to their relative position in #
  # the call stack relative to the selected sample. #
  
  # Probes replace print statements while also offering some #
  # stepping debugger features to help maintain context when #
  # navigating between different probed expressions, which may #
  # take on many values across nested or recursive functions. #
  
  
  # TUTORIAL #
  
  # The expression 10 * 10 below has a probe.  #
  # Its value, 20, is shown in a cell to the right. #
  let chips = ^^probe(10 + 10) in
  
  # To probe the below expression, put your caret to #
  # left of the `(` and either press ctrl/cmd-E or #
  # context-click and select `Add probe` from the menu. #
  let mult = (1 + 2 * 3) in
  # The expression should be underlined in green, #
  # and a cell reading `7` should appear to the right. #
  # The same shortcut or context menu toggle removes it. #
  
  # Click the below cell (with value 140) to select it. #
  let score = ^^probe(chips * mult) in
  # Notice when you hover over a selected cell, it #
  # shows the values of any contained variables. #
  
  # Probes only have cells if the are evaluated. #
  # Below, only the first case branch is evaluated. #
  # Hover over the empty set symbol to see a tooltip. #
  let check = case ^^check(false)
  | false => ^^probe("checks out")
  | true => ^^probe("you cheated")  
  end in
  
  # Probes can be placed on expressions #
  let pow = ^^probe(50 ** 2) in
  # And also on patterns (e.g. variables) #
  let ^^probe(pow) = ^^slider(54) ** 2 in
  
  # FUNCTIONS #
  
  # Because functions can run multiple times, they can #
  # have multiple samples. Note the closure counts circles #
  # are all 2, indicating each probe was evaluated twice. #
  # Double click on any sample to show all samples. #
  let celsius = fun ^^probe(farenheit) ->
    # Click to select the cell above reading 72.5 #
    let diff = ^^probe(farenheit -. 32.) in
    # This highlights cells below corresponding to the same #
    # function call: the cells reading 40.5 and 22.5) #
    ^^probe(5./.9. *. diff) in
  
  # It also accents the text of the sample of the #
  # relevant function call site in pink#
  ^^probe(celsius(72.5));
  # Now select the cell above reading 22.5 #
  ^^probe(celsius(103.1));
  # Note the 72.5, 40.5, and 22.5 are no longer green-highlit #
  # as they are not part of the same call as /the expression/ #
  # `celsius(t1)`. However, they now have blue text, indicating #
  # they are below that function call in the call stack #
  
  # BRANCHING IN FUNCTIONS #
  
  # Select `6` then `5` then '4' below: #
  # (If there is a no-enter sign instead of a sample, #
  # this means that the sample cursor is aligned to #
  # another function. Just click on the sign to realign it) #
  let cases= fun ^^probe(x) ->
    case x 
    # Note how each activate exactly one branch below: #
    | 4 => ^^probe(true)
    # Select the `5` above and then the `false` below: #
    | 5 => ^^probe(false)
    # Note the same things are highlit as both cells are #
    # from the same call to cases#
    | _ => ^^probe(true) end    
  in
  # Select `true` below and then the `4` cell #
  # for the argument x to `cases` above. #
  ^^probe(cases(4));
  # Note how the same cells stay indicated, but the kind #
  # of indication changes. The `true` below the `4` above #
  # goes from blue text (created by the cases(4) call) #
  # to green highlighting (part of the same call as `4`). #
  # The formerly selected lower `true` now has pink text #
  # since it indicates the call where indicated `4` lives. #
  ^^probe(cases(5));
  ^^probe(cases(6));
  
  
  # FUNCTIONS CALLING FUNCTIONS #
  
  # Select `9` below. Note four cells below become pink #
  let fourth = fun f -> 4 * ^^probe(f) - 4 in
  # This is because they represent function calls #
  # above the `9` cell in the function call stack. #
  # For example 32 below represents the call producing `9`.  #
  let third = fun t -> ^^probe(fourth(t - 3)) / 3 in
  # Now, select `32` above. Note the 9 now has blue text. #
  # This represents that it is below the `32` call in the stack. #
  # Now select `10` below, which is a call to `third`: #
  let second = fun s -> ^^probe(third(2 * s)) + 2 in
  # Note that `9` and `32` both have blue text as the are below in the stack. #
  # Now select 12 below, representing a call to `second` #
  let first = fun f -> ^^probe(second(f + 1)) * 2 in
  # Note how the colors have changed. Finally, select `24` below, #
  # and then again select 12, 10, 32, and 9 in turn. #
  ^^probe(first(5));
  
  # RECURSION #
  # Note how cells are lowered/raised to indicate their #
  # relative call stack depth to the selected cell #
  let fact = fun ^^probe(x) ->
    case ^^probe(x)
    | 1 => ^^probe(1)
    | _ =>
      let r = ^^probe(fact(x-1)) 
      in x*^^probe(r)  
    end in
  test ^^probe(fact(5)) == 120 end;
  
  # TAIL RECURSION #
  let fact1 = let go =
    fun (^^probe(x),
      ^^probe(acc)) ->
      case ^^probe(x)
      | 1 => ^^probe(acc)
      | _ =>
        let r = ^^probe(x*acc) 
        in ^^probe(go(x-1, r)) 
      end in
  fun x -> ^^probe(go(x,1)) in
  test ^^probe(fact1(5)) == 120 end;
  
  
  let fib: Int -> Int =
    # Multiple recursive calls can get complicated! #
    fun x -> ^^probe(case ^^probe(x)
    | 0 => ^^probe(1)
    | 1 => ^^probe(1)
    | n =>   
      # Select the first `1` below, and use left/right arrow keys #
      # to move between samples, considering how the other samples change. #
      ^^probe(fib(x-1))
      + ^^probe(fib(x-2)) 
    end)
  in
  test ^^probe(fib(1)) == 1 end;
  test ^^probe(fib(2)) == 2 end;
  test ^^probe(fib(3)) == 3 end;
  test ^^probe(fib(4)) == 5 end;
  test ^^probe(fib(5)) == 8 end;
  test ^^probe(fib(6)) == 13 end;
  
  # FUNCTIONS IN FUNCTIONS #
  # The frunk factory prethunks your frunk for later clunking #
  let frunk_factory = fun ^^probe(y) ->
    # This is a play area to explore nested function definitions #
    # and functions returning functions #
    let factor =
      4 + ^^probe(10 * y) in
    let refactor = fun ^^probe(x) ->
      ^^probe(x + factor) in
    let factor =
      ^^probe(refactor(factor))
      - ^^probe(refactor(y)) in 
    let perturb = fun ^^probe(s) ->
      factor + ^^probe(refactor(s)) in
    fun ^^probe(z) ->
      ^^probe(perturb(3*z))
      + ^^probe(perturb(5*z))  
  in let new_frunk = ^^probe(frunk_factory(7)) in
  test ^^probe(new_frunk(4)) == 314 end;
  test ^^probe(new_frunk(6)) == 330 end;
  
  # STATICS PROBES: These show inferred type information. #
  # Double clicking toggles from analytic to synthetic type. #
  
  let a: Bool = ^^statics(1) in
  let b: Bool = ^^statics(true) in 
  let c: (String, ?) = ^^statics((?, 1)) in
  b;
  
  
  # RICH PROBES: Domain-specific interfaces for probe samples             #
  # A probe sample's context menu offers "View as ..." entries that open  #
  # domain-specific interactive views of the sample's value. Today the    #
  # only one available is "View as table", which accepts any list of      #
  # labeled tuples. The sample below has it opened already — click the    #
  # probe sample to open its context menu and choose "Hide table" to      #
  # close the modal. Inside the table you can drop columns, rename,       #
  # sort, filter, group by, etc.                                          #
  
  let inventory = ^^table([
    (item="Apple",  qty=24, price=0.50),
    (item="Bread",  qty= 8, price=2.75),
    (item="Cheese", qty= 3, price=6.20),
    (item="Donut",  qty=12, price=1.10),
    (item="Eggs",   qty= 6, price=3.40)
  ]) in
  ^^probe_table(inventory)
  
  
  
  
  
  
  
  # Actions you take in the table modal are real syntax edits — they    #
  # rewrite the underlying probed expression. Try dropping a column,    #
  # then close the modal: the source above now ends in `|> map(...)`.   #
) in
let bench_47 = (
  # _____  _____    _____      _  _____  _____  ______ #
  #|     ||   _ |  |     |    | ||     ||     ||      |#
  #|  _  ||  | ||  |  _  |    | ||  ___||     ||_    _|#
  #| |_| ||  |_||_ | | | |    | || |___ |     |  |  |  #
  #|  ___||   __  || |_| | ___| ||  ___||    _|  |  |  #
  #| |    |  |  | ||     ||     || |___ |   |_   |  |  #
  #|_|    |__|  |_||_____||_____||_____||_____|  |__|  #
  
  # Some kinds of syntax have dedicated GUIs.          #
  # The menu at the bottom left shows which GUIs       #
  # (if any) are applicable to the current term        #
  # indicated by the caret.                            #
  
  # A. A fold projector collapse a term, replacing     #
  #    it with `...` until it is expanded again.       #
  #    Terms can be projected using alt/option-f.      #
  #    Clicking a fold toggles a hover term display.   #
  
  let fold = ^^fold((
    ("Well",
      ("hello",
        ("there!",
          ["Please close me when you're done"]
        )
      )
    )
  )) in
  
  # B. Projectors applying to specific data literals.  #
  #    These can be applied using alt/option-l.        #
  #    Three base types literals use inline views:     #
  
  let guard: Bool = ^^check(true) in
  let phase: Int = ^^slider(44) in
  let float: Float = ^^sliderf(79.00) in
  
  #    One ADT uses a tab-style two-line view.         #
  #    See the `Cards` slide for more information.     #
  let card: (+Spades, +Jack) = ^^card((Spades, Jack)) in
  
  # Inline error decorations (same as for tokens)      #
  
  let (a:Int, f: Bool) = ^^check(true), ^^slider(28) in
  
  # The String base type get a multiline view:         #
  
  let _ = ^^text("") in
  let __ = ^^text("\n") in
  let ___ = ^^text("a") in
  let ____ =^^text("shift\n")in
  let _____ =^^text("\nmalicious") in
  let ______ = ^^text("a\n shift\n   malicious")in
  
  # Multiline error decorations #
  
  let box: Int = ^^text("\nmalicious") in
  
  # The bottom toggle or backspace removes projectors. #
  # Projectors are preserved on in-editor copy/paste   #
  # and are persisted as ^^projector_name(data) when   #
  # pasted externally; pasting this here projects it.  #
  
  ^^fold("Put it back")
) in
let bench_48 = (
  # Sample: Quiz scores from multiple students #
  type GradebookEntry = (
    name=String, 
    age=Int, 
    quiz1=Int, 
    quiz2=Int, 
    quiz3=Int, 
    quiz4=Int, 
    final=Int
  ) in
  
  let gradebook : [GradebookEntry] = [
    ("Alice", 12, 8, 9, 7, 8, 87),
    ("Bob", 17,  6, 8, 8, 7, 85),
    ("Alice", 13, 9, 10, 8, 8, 90),
    ("Charlie", 14, 7, 9, 9, 6, 77),
    ("Bob", 18, 10, 6, 6, 6, 93)
  ] in
  
  # Same value, displayed as a table via the Table projector: #
  ^^table([
    (name="Alice", age=12, quiz1=8, quiz2=9, quiz3=7, quiz4=8, final=87),
    (name="Bob", age=17, quiz1=6, quiz2=8, quiz3=8, quiz4=7, final=85),
    (name="Alice", age=13, quiz1=9, quiz2=10, quiz3=8, quiz4=8, final=90),
    (name="Charlie", age=14, quiz1=7, quiz2=9, quiz3=9, quiz4=6, final=77),
    (name = "Bob",age = 18,quiz1 = 10,quiz2 = 6,quiz3 = 6,quiz4 = 6,final = 93)
  ]);
  
  # Projection over Lists of Labeled Tuples #
  # Pull out all final exam scores using projection over the table #
  ^^probe(gradebook.final);
  
  # The to_lvs operation on labeled tuples converts them to a list of (label, value) entries. #
  # We can map this over a table to do things like extracting all quiz scores and compute an average. #
  let average = ^^fold(fun (ns: [Int]) -> float_of_int(fold_left(ns, int_plus, 0))  /. float_of_int(length(ns))) in
  let gradebook_with_average = 
    map(gradebook,
      fun e: GradebookEntry ->
        let ^^statics(with_average) = 
          e ... (quiz_average=
          to_lvs(omit_labels(e, `name`))
          |> filter(_, fun (label, _score):^^fold((label=String, value=Int)) -> string_match("quiz.*", label))
          |> map(_, fun e -> e.value)
          |> average)
        in ^^probe(with_average))
  in
  ^^probe(gradebook_with_average.quiz_average);
  
  # `group_by_label`: Group records by a label's value and pivot into a tuple of lists #
  # Example: Game leaderboard entries grouped by level #
  let leaderboard = [
    (level="forest", player="Aria", score=1200),
    (level="desert", player="Ben", score=900),
    (level="forest", player="Cleo", score=1500),
    (level="cave", player="Dana", score=700),
    (level="desert", player="Eli", score=1300)
  ] in
  
  let ^^probe(by_level) = group_by_label(leaderboard, `level`) in
  ^^probe(by_level.forest);
  ^^probe(by_level.cave);
  ^^probe(by_level.desert).score;
  
  # Example: Wildlife Tracking Grid of Species Sightings #
  # Each row represents presence/absence of species seen by a camera on a given day #
  type DailySighting = (day=Int, fox=Bool, deer=Bool, rabbit=Bool, bear=Bool, owl=Bool, raccoon=Bool, wolf=Bool, moose=Bool) in
  let sightings : [DailySighting] = [
    (1, ^^check(true), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false)),
    (2, ^^check(false), ^^check(true), ^^check(true), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false)),
    (3, ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false)),
    (4, ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false)),
    (5, ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false)),
    (6, ^^check(false), ^^check(true), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(true)),
    (7, ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false)),
    (8, ^^check(true), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false)),
    (9, ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false))
  ] in
  # to_lvs the grid into a long format table for analysis #
  let lvs : [(label=String, value=Bool)] = flat_map(sightings, fun sighting:^^fold((day=Int, fox=Bool, deer=Bool, rabbit=Bool, bear=Bool, owl=Bool, raccoon=Bool, wolf=Bool, moose=Bool)) -> to_lvs(omit_labels(sighting, `day`))) in
  let counts : [String] -> [(String, Int)] = ^^fold(fun elems -> case elems
  | [] => []
  | (hd :: tl) => 
    let rest = counts(tl) in
    case rest
    | [] => [(hd, 1)]
    | ((prev, count)::tl) => 
      if prev == hd
      then (prev,count+1) :: tl 
      else (hd, 1) :: rest 
    end 
  end) in                  
  # Show counts for each species#
  let sighting_counts =   
    filter(lvs, fun (label=_l, value=v) -> v).label
    |> sort(fun (a,b) -> string_compare(a,b), _)
    |> counts 
  in ^^probe(sighting_counts);
  gradebook
) in
let bench_49 = (
  # Tuples can have labels, including ones with special characters or spaces using backticks ` #
  let labeled_tuple = (a=1, b=2.0, c=true, `the-answer`=42, `multi word`="yes") in
  
  # These labels can be projected #
  test labeled_tuple.a == 1 end;
  test labeled_tuple.b == 2.0 end;
  test labeled_tuple.`the-answer` == 42 end;
  test labeled_tuple.`multi word` == "yes" end;
  
  # These can be encoded in the types #
  let typed_lt : (a=Int, b=Float, c=Bool, `the-answer`=Int, `multi word`=String) = labeled_tuple in
  
  # Labels are optional and can be interspersed throughout a tuple #
  let mixed_labels : (Int, a=String, Float, flag=Bool) = (1, a="String Value", 2.5, flag=true) in
  
  type Person = (String, age=Int, favorite_color=String) in
  
  # These labels can be automatically applied based on the type expectation #
  let alice : Person = ("Alice", 22, "Blue") in
  test alice.age == 22 end;
  
  # Explicitly Labeled elements are automatically reordered #
  let bob : Person = (age=25, favorite_color="Red", "Bob") in
  
  # Destructuring #
  let (bobs_name, age=bobs_age, favorite_color=bobs_favorite_color) = bob in
  
  # As Labeled Function Arguments #
  let make_person = fun name=n, age=a -> (n, a, favorite_color="red") in
  let consistent_variable_arg = (name="Valid", age=1) in
  let more_people : [Person] = [
    make_person("Bob", 25),                # Labels Elided #
    make_person(name="Alice", age=22),     # Labels Present #
    make_person(age=23, "Mallory"),        # Labels Rearranging #
    make_person(consistent_variable_arg)   # Variables with labels #
  ] in
  
  # Labeled args can also be inferred from the type signature #
  let make_name : (first=String, last=String) -> String = fun f, b -> f ++ " " ++ b in
  test string_compare(make_name(first="Hay", last="Zul"), "Hay Zul") == Eq end;
  
  # Args can also be used like a tuple and projected #
  let make_name : (first=String, last=String) -> String = fun args -> args.first ++ " " ++ args.last in  
  
  # Projection over Lists of Labeled Tuples #
  let people : [(name=String, age=Int)] = [
    (name="Alice", age=30),
    (name="Bob", age=25),
    (name="Charlie", age=28)
  ] in
  ^^probe(people.age);  
  ^^probe(people.name);
  # --- Type-level operators for projection and extension --- #
  
  # Type-level projection mirrors expression-level projection #
  let name_only : Person.favorite_color = "Red" in
  let age_only : Person.age = 30 in
  
  # Type-level extension mirrors expression-level extension #
  type Base = (a=Int, b=Int, Int) in
  type Extended = Base ... (b=String, c=Int) in
  # Extended is (a=Int, b=String, Int, c=Int) #
  let e : Extended = (a=1, b="", 1, c=2) in
  
  # `to_lvs`: Convert a labeled tuple into a list of (label, value) entries #
  # Example: Character attributes as key-value pairs #
  let ^^statics(attributes) = (strength=10, agility=8, intelligence=7, `magic bonus`=2) in       
  let ^^probe(lvs) =   
    ^^statics(to_lvs(attributes)) 
  in  
  
  # `from_lvs`: Convert a list of (label, value) pairs back into a labeled tuple #
  # This is the inverse of `to_lvs` when applied to labeled-only tuples #
  let entries : [(label=String, value=Int)] = [("strength", 10), ("agility", 8), ("intelligence", 7)] in
  let reconstructed = from_lvs(entries) in
  ^^probe(reconstructed);
  # Edge case: duplicate labels in from_lvs (projection is stuck) #
  ^^fold((
    let entries_with_dupes : [(label=String, value=Int)] = [("x", 1), ("x", 2)] in
    let ^^probe(duplicate_entries) = from_lvs(entries_with_dupes) in
    ^^probe(duplicate_entries.x)
  ));
  
  # Tuple Extension using `...` #
  # This expression merges two tuples, updating existing labels and appending new ones or unlabeled values to the end #
  # Example: combining experimental measurements with sensor metadata #
  let ^^statics(reading) =(1618033, temperature=22.5,humidity=0.55) in
  let ^^statics(metadata) =(sensor_id="A17",humidity=0.52) in
  let ^^statics(enriched_reading) = reading ... metadata in
  ^^probe(enriched_reading);
  
  # Singleton unlabeled tuples #
  # Write a single unlabeled field using an underscore #
  let single = (_=1) in
  let typed_single : (_=Int) = (_=42) in
  
  # Useful for extension with just one field #
  let base = (name="Alice", age=30) in
  let ^^probe(extended) = base ... (_="Engineer") in
  
  # Label Selection and Projection #
