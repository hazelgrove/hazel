        build_column@<JellyNamed>@<Bool>@<(
          name = String,
          get_acne = Bool,
          red = Bool,
          black = Bool,
          white = Bool,
          green = Bool,
          yellow = Bool,
          brown = Bool,
          orange = Bool,
          pink = Bool,
          purple = Bool,
