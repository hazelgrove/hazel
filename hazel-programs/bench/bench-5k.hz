let bench_21 = (
  type Student = (name = String, age = Int, favorite_color = String) in
  let students : [Student] = [("Bob", 12, "blue"), ("Alice", 17, "green"), ("Eve", 13, "red")] in
  type GradebookEntry = (name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int) in
  let gradebook : [GradebookEntry] = [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ] in
  
  # V1: This version is idiomatic but is a higher order function requiring the caller to construct the resulting schema by passing in a function. #
  # In addition the right side of the table is wrapped in a single option type marking the whole row as present or absent. A future operation could turn a optional tuple into a tuple of optional values #
  let v1 =
    let _requires = [
      (enforced=^^check(true), "cs has no duplicates"), # Ensured by projection function #
      (enforced=^^check(true), "for all c in cs, c is in header(t1)"), # Ensured by projection function #
      (enforced=^^check(true), "for all c in cs, c is in header(t2)"), # Ensured by projection function #
      (enforced=^^check(true), "for all c in cs, schema(t1)[c] is equal to schema(t2)[c]"), # Ensured by projection function #
      (enforced = ^^check(false), "concat(header(t1), removeAll(header(t2), cs)) has no duplicates")
    ] in
    let _ensures = [
      (enforced=^^check(false), "header(t3) is equal to concat(header(t1), removeAll(header(t2), cs))"),
      (enforced=^^check(true), "for all c in header(t1), schema(t3)[c] is equal to schema(t1)[c]"), # If combine function is just adding new column#
      (enforced=^^check(false), "for all c in removeAll(header(t2), cs), schema(t3)[c] is equal to schema(t2)[c]"),
      (
        enforced = ^^check(false),
        "nrows(t3) is equal to nrows(t1) if distinct(selectColumns(t2, cs)) is equal to selectColumns(t2, cs), otherwise each row of t1 may have several matches"
      )
    ] in
    # We just require the caller to combine the resulting rows. The closest to leftJoin would be to just wrap the right row in a new column. #
    # The caller could also decide to flatten the option type into individual optional columns #
    let left_join =
      typfun r1 ->
        typfun r2 ->
          typfun r3 ->
            typfun k ->
              fun (t1 : [r1], t2 : [r2], proj1 : r1 -> k, proj2 : r2 -> k, combine : (r1, (+ None + Some(r2))) -> r3) ->
                flat_map(
                  t1,
                  fun (r1 : r1) ->
                    let t2' = filter(t2, fun (r2 : r2) -> proj1(r1) == proj2(r2)) in
                    case t2'
                    | [] => [combine(r1, None)]
                    | _ => map(t2', fun (r2 : r2) -> combine(r1, Some(r2)))
                    end
                )
                : [r3] in
    # Examples #
    test
      left_join@<Student>@<GradebookEntry>@<(name = String, age = Int, favorite_color = String, gradebook = (+ None + Some(GradebookEntry)))>@<String>(students, gradebook, fun (s : Student) -> s.name, fun (g : GradebookEntry) -> g.name, fun (s, g) -> s ... (gradebook = g))
      == (
        [
          ("Bob", 12, "blue", Some("Bob", 12, 8, 9, 77, 7, 9, 87)),
          ("Alice", 17, "green", Some("Alice", 17, 6, 8, 88, 8, 7, 85)),
          ("Eve", 13, "red", Some("Eve", 13, 7, 9, 84, 8, 8, 77))
        ]
        : [(name = String, age = Int, favorite_color = String, gradebook = (+ None + Some(GradebookEntry)))]
      ) end in
  
  # V2: This version works by dynamically building the schema from the first row of each table. It closely matches the Table API but does not gurantee many constraints. #
  let v2 =
    let _requires = [
      (enforced=^^check(false), "cs has no duplicates"),
      (enforced=^^check(false), "for all c in cs, c is in header(t1)"),
      (enforced=^^check(false), "for all c in cs, c is in header(t2)"),
      (enforced=^^check(false), "for all c in cs, schema(t1)[c] is equal to schema(t2)[c]"),
      (enforced = ^^check(false), "concat(header(t1), removeAll(header(t2), cs)) has no duplicates")
    ] in
    let _ensures = [
      (enforced=^^check(false), "header(t3) is equal to concat(header(t1), removeAll(header(t2), cs))"),
      (enforced=^^check(false), "for all c in header(t1), schema(t3)[c] is equal to schema(t1)[c]"),
      (enforced=^^check(false), "for all c in removeAll(header(t2), cs), schema(t3)[c] is equal to schema(t2)[c]"),
      (
        enforced = ^^check(false),
        "nrows(t3) is equal to nrows(t1) if distinct(selectColumns(t2, cs)) is equal to selectColumns(t2, cs), otherwise each row of t1 may have several matches"
      )
    ] in
    # Since we don't have the schema as a runtime value there's no way to dynamically build up the right table columns unless there's at least one row. So we extract the columns from the first row. #
    # If there is no row we just return the lefthand table's columns #
    # All the columns of the right table are wrapped in an option type since they may be absent#
    let left_join =
      let project_labels_str = fun (v, cs) -> to_lvs(v) |> filter(_, fun e -> mem(cs, e.label)) |> from_lvs in
      let omit_labels_str = fun (v, cs) -> to_lvs(v) |> filter(_, fun e -> ! mem(cs, e.label)) |> from_lvs in
      let make_optional = fun (v) -> to_lvs(v) |> map(_, fun e -> e ... (value = Some(e.value))) |> from_lvs in
      fun (t1 : [?], t2 : [?], cs : [String]) ->
        let right_columns =
          case hd_opt(t2)
          |None => []
          |Some(v) => to_lvs(v) |> map(_, fun e -> e.label)
          end in
        flat_map(
          t1,
          fun r1 ->
            let matched = filter(t2, fun r2 -> project_labels_str(r2, cs) == project_labels_str(r1, cs)) in
            case matched
            | [] => [r1 ... (from_lvs(map(filter(right_columns, fun e -> !mem(cs, e)), fun lc -> (label = lc, value = None))))]
            | _ => map(matched, fun r2 -> r1 ... (make_optional(omit_labels_str(r2, cs))))
            end
        ) in
    # Examples #
    test
      left_join(students, gradebook, ["name", "age"])
      == (
        [
          ("Bob", 12, "blue", Some(8), Some(9), Some(77), Some(7), Some(9), Some(87)),
          ("Alice", 17, "green", Some(6), Some(8), Some(88), Some(8), Some(7), Some(85)),
          ("Eve", 13, "red", Some(7), Some(9), Some(84), Some(8), Some(8), Some(77))
        ]
        : [
          (
            name = String,
            age = Int,
            favorite_color = String,
            quiz1 = Option,
            quiz2 = Option,
            midterm = Option,
            quiz3 = Option,
            quiz4 = Option,
            final = Option
          )
        ]
      ) end in
  ?
) in
let bench_22 = (
  let _requires = [
    (enforced=^^check(false), "length(rs) is positive"),
    (enforced = ^^check(true), "for all r in rs, schema(r) is equal to schema(rs[0])")
  ] in
  let _ensures = [(enforced=^^check(true), "schema(t) is equal to schema(rs[0])"), (enforced = ^^check(false), "nrows(t) is equal to length(rs)")] in
  # Hazel's tables are lists so this is just the identity function #
  let values = typfun row -> fun (rs : [row]) -> rs in
  
  # Examples #
  test
    values@<(name = String)>([("Alexander")]) == [(name = "Alexander")] end
) in
let bench_23 = (
  let _requires = [(enforced = ^^check(true), "schema(t1) is equal to schema(t2)")] in
  let _ensures = [
    (enforced=^^check(true), "schema(t3) is equal to schema(t1)"),
    (enforced = ^^check(false), "nrows(t3) is equal to nrows(t1) + nrows(t2)")
  ] in
  #Hazel tables are lists; so vcat is just list concatenation. This is also the same as add_rows#
  let vcat = typfun r -> fun (t1 : [r], t2 : [r]) -> t1 @ t2 in
  
  test
    let update = typfun row -> fun (t1 : [row], f : (row -> ?)) -> map(t1, fun (r : row) -> (r : ?) ... f(r)) : [?] in
    type Student = (name = String, age = Int, favorite_color = String) in
    let students : [Student] = [("Bob", 12, "blue"), ("Alice", 17, "green"), ("Eve", 13, "red")] in
    vcat@<Student>(students, update@<Student>(students, fun r -> (age = r.age + 1)))
    == (
      [("Bob", 12, "blue"), ("Alice", 17, "green"), ("Eve", 13, "red"), ("Bob", 13, "blue"), ("Alice", 18, "green"), ("Eve", 14, "red")]
      : [Student]
    ) end
) in
let bench_24 = (
  let pivot_longer =
    let _requires = [
      (enforced=^^check(false), "length(cs) is positive"),
      (enforced=^^check(false), "cs has no duplicates"),
      (enforced=^^check(false), "for all c in cs, c is in header(t1)"),
      (enforced=^^check(false), "for all c in cs, schema(t1)[c] is equal to schema(t1)[cs[0]]"),
      (enforced = ^^check(false), "concat(removeAll(header(t1), cs), [c1, c2]) has no duplicates")
    ] in
    let _ensures = [
      (enforced=^^check(false), "header(t2) is equal to concat(removeAll(header(t1), cs), [c1, c2])"),
      (enforced=^^check(false), "for all c in removeAll(header(t1), cs), schema(t2)[c] is equal to schema(t1)[c]"),
      (enforced=^^check(false), "schema(t2)[c1] is equal to ColName"),
      (enforced = ^^check(false), "schema(t2)[c2] is equal to schema(t1)[cs[0]]")
    ] in
    let pivot_longer =
      fun (t1, cs, c1, c2) ->
        flat_map(
          t1,
          fun row ->
            let entries = to_lvs(row) in
            let pivot_entries, other_entries = partition(entries, fun (label = l, value = _v) -> contains(cs, fun s -> l == s)) in
            let rest = from_lvs(other_entries) in
            map(pivot_entries, fun (label = l, value = v) -> rest ... (from_lvs([(label=c1, value=l), (label = c2, value = v)])))
        )
        : [?] in
    type GradebookEntry = (name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int) in
    let gradebook : [GradebookEntry] = ^^fold([
      ("Bob",   12, 8, 9, 77, 7, 9, 87),
      ("Alice", 17, 6, 8, 88, 8, 7, 85),
      ("Eve",   13, 7, 9, 84, 8, 8, 77)
    ]) in
    let expected = ^^fold([
      (name="Bob", age=12, quiz1=8, quiz2=9, quiz3=7, quiz4=9, exam="midterm", score=77),
      (name="Bob", age=12, quiz1=8, quiz2=9, quiz3=7, quiz4=9, exam="final", score=87),
      (name="Alice", age=17, quiz1=6, quiz2=8, quiz3=8, quiz4=7, exam="midterm", score=88),
      (name="Alice", age=17, quiz1=6, quiz2=8, quiz3=8, quiz4=7, exam="final", score=85),
      (name="Eve", age=13, quiz1=7, quiz2=9, quiz3=8, quiz4=8, exam="midterm", score=84),
      (name="Eve", age=13, quiz1=7, quiz2=9, quiz3=8, quiz4=8, exam="final", score=77)
    ]) in
    test
      pivot_longer(gradebook, ["midterm", "final"], "exam", "score") == expected end;
    # The idiomatic way to do this with concrete data. Giving good type feedback#
    test
      flat_map(
        gradebook,
        fun (entry : GradebookEntry) ->
          map(
            to_lvs(select_labels(entry, `midterm`, `final`)),
            fun (e : (label = String, value = Int)) -> omit_labels(entry, `midterm`, `final`) ... (exam = e.label, score = e.value)
          )
      )
      == expected end in
  let pivot_wider =
    let _requires = [
      (enforced=^^check(false), "c1 is in header(t1)"),
      (enforced=^^check(false), "c2 is in header(t1)"),
      (enforced=^^check(false), "schema(t1)[c1] is ColName"),
      (enforced = ^^check(false), "concat(removeAll(header(t1), [c1, c2]), removeDuplicates(getColumn(t1, c1))) has no duplicates")
    ] in
    let _ensures = [
      (enforced=^^check(false), "header(t2) is equal to concat(removeAll(header(t1), [c1, c2]), removeDuplicates(getColumn(t1, c1)))"),
      (enforced=^^check(false), "for all c in removeAll(header(t1), [c1, c2]), schema(t2)[c] is equal to schema(t1)[c]"),
      (enforced = ^^check(false), "for all c in removeDuplicates(getColumn(t1, c1)), schema(t2)[c] is equal to schema(t1)[c2]")
    ] in
    let distinct =
      fun xs ->
        case xs
        | [] => []
        | (x :: xs) =>
          let _seen = distinct(xs) in
          if mem(xs, x) then xs else x :: xs
        end in
    let pivot_wider =
      fun (t1, c1, c2) ->
        let kept_columns =
          map(
            t1,
            fun row ->
              let entries = to_lvs(row) in
              filter(entries, fun (label = l, value = _v) -> ! mem([c1, c2], l)) |> from_lvs
          )
          |> distinct in
        let new_columns =
          flat_map(
            t1,
            fun row ->
              let entries = to_lvs(row) in
              find_map(entries, fun (label = l, value = v) -> if l == c1 then Some(v) else None) |> option_to_list
          )
          |> distinct in
        map(
          kept_columns,
          fun kept ->
            kept
            ... (
              map(
                new_columns,
                fun c -> (
                  label = c,
                  value =
                  find_map(
                    t1,
                    fun r ->
                      let entries = to_lvs(r) in
                      if (filter(entries, fun (label = l, value = _v) -> ! mem([c1,c2], l)) |> from_lvs) == kept
                      && find_map(entries, fun (label = l, value = v) -> if l == c1 then Some(v) else None) == Some(c)
                      then find_map(entries, fun (label = l, value = v) -> if l == c2 then Some(v) else None)
                      else None
                  )
                )
              )
              |> from_lvs
            )
        )
        : [?] in
    type Student = (name = String, age = Int, favorite_color = String) in
    let students : [Student] = ^^fold([
      ("Bob", 12, "blue"),
      ("Alice", 17, "green"),
      ("Eve", 13, "red")
    ]) in
    # We are not flattening the rows in this to coallesce the sparseness #
    test
      pivot_wider(students, "name", "age")
      == [
        (favorite_color="blue", `Bob`=Some(12), `Alice`=None, `Eve`=None),
        (favorite_color="green", `Bob`=None, `Alice`=Some(17), `Eve`=None),
        (favorite_color = "red", `Bob` = None, `Alice` = None, `Eve` = Some(13))
      ] end in
  ?
) in
let bench_25 = (
  type OptInt = + None + Some(Int) in
  type OptString = + None + Some(String) in
  type StudentMissing = (name = String, age = OptInt, favorite_color = OptString) in
  let studentsMissing : [StudentMissing] = ^^fold([
    ("Bob", None, Some("blue")),
    ("Alice", Some(17), Some("green")),
    ("Eve", Some(13), None)
  ]) in
  let complete_cases =
    # Instead of taking a colName we're taking a project function to make it type-safe. #
    # This only works for option columns #
    let _requires = [(enforced = ^^check(true), "c is in header(t)")] in
    let _ensures = [(enforced = ^^check(false), "length(bs) is equal to nrows(t)")] in
    let complete_cases =
      typfun R ->
        typfun C ->
          fun (t : [R], project : (R -> + None + Some(C))) ->
            map(
              t,
              fun (r : R) ->
                case project(r)
                | Some(_) => true
                | None => false
                end
            )
            : [Bool] in
    test
      complete_cases@<StudentMissing>@<Int>(studentsMissing, fun r -> r.age) == [false, true, true] : [Bool] end in
  let dropna =
    # This only works if every column in the dataset was optional otherwise it will get stuck in indet #
    let _requires = [] in
    let _ensures = [(enforced = ^^check(true), "schema(t2) is equal to schema(t1)")] in
    let dropna = typfun R -> fun (t1 : [R]) -> filter(t1, fun row -> ! any(to_lvs(row), fun e -> e.value == (None : Option))) : [R] in
    type StudentFullyOptional = (name = OptString, age = OptInt, favorite_color = OptString) in
    let students_fully_optional : [StudentFullyOptional] = ^^fold([
      (Some("Bob"), None, Some("blue")),
      (Some("Alice"), Some(17), Some("green")),
      (Some("Eve"), Some(13), None)
    ]) in
    test
      dropna@<(name = OptString, age = OptInt, favorite_color = OptString)>(students_fully_optional)
      == [(Some("Alice"), Some(17), Some("green"))] : [(name = OptString, age = OptInt, favorite_color = OptString)] end in
  let fillna =
    let _requires = [(enforced=^^check(false), "c is in header(t1)"), (enforced = ^^check(false), "v is of sort schema(t1)[c]")] in
    let _ensures = [(enforced=^^check(false), "schema(t2) is equal to schema(t1)"), (enforced = ^^check(false), "nrows(t2) is equal to nrows(t1)")] in
    let fillna =
      fun (t1 : [?], c : String, v) ->
        let rows = map(t1, to_lvs) in
        let mapped =
          map(
            rows,
            fun entries ->
              from_lvs(
                filter(entries, fun e -> ! (e.label == c))
                @ [
                  case option_bind(find_opt(entries, fun e -> (e.label == c)), fun x -> x.value)
                  | None => (label = c, value = v)
                  | Some(v) => (label = c, value = v)
                  end
                ]
              )
          )
          : [?] in
        mapped in
    test
      fillna(studentsMissing, "favorite_color", "white")
      == [("Bob", None, "blue"), ("Alice", Some(17), "green"), ("Eve", Some(13), "white")]
      : [(name = String, age = OptInt, favorite_color = String)] end;
    # The idiomatic way to do this would be to just map the column. This gives you the schema safety. #
    test
      map(
        studentsMissing,
        fun (r : StudentMissing) ->
          r
          ... (
            favorite_color =
            case r.favorite_color
            | None => "white"
            | Some(v) => v
            end
          )
      )
      == [("Bob", None, "blue"), ("Alice", Some(17), "green"), ("Eve", Some(13), "white")]
      : [(name = String, age = OptInt, favorite_color = String)] end in
  ?
) in
let bench_26 = (
  type GradebookEntry = (name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int) in
  let gradebook : [GradebookEntry] = (
    [("Bob",   12, 8, 9, 77, 7, 9, 87), ("Alice", 17, 6, 8, 88, 8, 7, 85), ("Eve", 13, 7, 9, 84, 8, 8, 77)]
  ) in
  let tsort =
    let _requires = [(enforced=(false), "c is in header(t1)"), (enforced = (false), "schema(t1)[c] is Number")] in
    let _ensures = [(enforced=(false), "nrows(t2) is equal to nrows(t1)"), (enforced = (true), "schema(t2) is equal to schema(t1)")] in
    # Idiomatically I think we would do this with a implicit comparator on tuples and then project them #
    # This could be done in a typesafe way if a function was passed to do the projection #
    let get_value = fun (r, c : String) -> (to_lvs(r) |> find(_, fun (label=l, value=_v) -> l == c)).value in
    let tsort =
      typfun r ->
        fun (t : [?], c : String, b : Bool) ->
          let sorted = sort(fun (first, second) -> if get_value(first, c) < get_value(second, c) then Lt else Gt, t) in
          (if b then sorted else reverse(sorted)) : [r] in
    test
      tsort@<GradebookEntry>(gradebook, "final", false)
      == [("Bob",   12, 8, 9, 77, 7, 9, 87), ("Alice", 17, 6, 8, 88, 8, 7, 85), ("Eve", 13, 7, 9, 84, 8, 8, 77)] : [GradebookEntry] end in
  let sort_by_columns =
    let _requires = [
      (enforced=(false), "cs has no duplicates"),
      (enforced=(false), "for all c in cs, c is in header(t1)"),
      (enforced = (false), "for all c in cs, schema(t1)[c] is Number")
    ] in
    let _ensures = [(enforced=(false), "nrows(t2) is equal to nrows(t1)"), (enforced = (true), "schema(t2) is equal to schema(t1)")] in
    let lexicographical =
      typfun t ->
        fun (comparator : (t, t) -> Ord, ts : [t], ts' : [t]) ->
          case (ts, ts')
          | ([], []) => Eq
          | ([], _) => Lt
          | (_, []) => Gt
          | (x::xs, y::ys) =>
            case comparator(x, y)
            | Eq => lexicographical@<t>(comparator, xs, ys)
            | ord => ord
            end
          end in
    let int_compare = fun (first, second) -> if first < second then Lt else if first > second then Gt else Eq in
    # Idiomatically I think we would do this with a implicit comparator on tuples and then project them #
    let sort_by_columns =
      typfun r ->
        let get_values =
          fun (r, c : [String]) -> (let entries = to_lvs(r) in filter_map(c,fun c -> find_opt(entries,fun (label=l, value=_v) ->(c == l)))).value in
        fun (t : [?], c : [String]) ->
          sort((fun (f, g) -> let res = lexicographical@<Int>(int_compare,get_values(f,c),get_values(g,c)) in
          res), t) : [r] in
    test
      sort_by_columns@<GradebookEntry>(gradebook, ["quiz2", "quiz1"])
      == [("Alice", 17, 6, 8, 88, 8, 7, 85), ("Eve",   13, 7, 9, 84, 8, 8, 77), ("Bob", 12, 8, 9, 77, 7, 9, 87)] : [GradebookEntry] end in
  let order_by =
    let _requires = [] in
    let _ensures = [
      (enforced=(true), "schema(r) is equal to schema(t1)"),
      (enforced=(true), "schema(t2) is equal to schema(t1)"),
      (enforced = (false), "nrows(t2) is equal to nrows(t1)")
    ] in
    # We don't currently have a way to encode a existential type for the key so we're currently using the unknown type. #
    # Idiomatically you'd just compose these at the callsite #
    let order_by =
      typfun row ->
        fun (t1 : [row], comparators : [(get_key = row -> ?, comparator = ? -> Ord)]) ->
          let compare =
            fun (a, b, comparators) ->
              case comparators
              | [] => Eq
              | (hd::tl) =>
                case hd.comparator(hd.get_key(a), hd.get_key(b))
                | Eq => compare(a, b, tl)
                | other => other
                end
              end in
          sort(compare(_,_,comparators), t1) : [row] in
    test
      let average = fun ns -> fold_left(ns, int_plus, 0) / length(ns) in
      let midtermAndFinal = fun (r : GradebookEntry) -> [r.midterm, r.final] in
      let comp_int = fun a, b -> if a > b then Gt else Lt in
      let desc =
        fun f ->
          fun (a, b) ->
            case f(a, b)
            | Eq => Eq
            | Gt => Lt
            | Lt => Gt
            end in
      let compare_grade = fun (g1, g2) -> comp_int(average(g1), average(g2)) in
      let name_length = fun (r : GradebookEntry) -> r.name |> string_length in
      order_by@<GradebookEntry>(gradebook, [(name_length, desc(comp_int)), (midtermAndFinal, compare_grade)])
      == [("Alice", 17, 6, 8, 88, 8, 7, 85), ("Eve",   13, 7, 9, 84, 8, 8, 77), ("Bob", 12, 8, 9, 77, 7, 9, 87)] : [GradebookEntry] end in
  ?
) in
let bench_27 = (
  let nrows =
    let _requires = [] in
    let _ensures = [(enforced = ^^check(false), "n is equal to nrows(t)")] in
    # Tables are just lists so nrows is just list length #
    let nrows = length in
    test
      nrows([]) == 0 end in
  
  let ncols =
    let _requires = [] in
    let _ensures = [(enforced = ^^check(false), "n is equal to ncols(t)")] in
    # Only works for non-empty tables since we don't keep a schema #
    let ncols =
      fun (t : [?]) ->
        case t
        | (x::_xs) => to_lvs(x) |> length
        | _ => 0
        end in
    # Examples #
    test
      ncols([()]) == 0 end;
    test
      ncols([(a = 1, b = 2)]) == 2 end in
  
  let header =
    let _requires = [] in
    let _ensures = [(enforced = ^^check(false), "cs is equal to header(t)")] in
    # Only works for non-empty tables since we don't keep a schema #
    let header =
      fun (t : [?]) ->
        case t
        | (x::_xs) => to_lvs(x) |> map(_, fun x -> x.label)
        | _ => []
        end in
    # Examples #
    test
      header([()]) == [] end;
    test
      header([(a = 1, b = 2)]) == ["a", "b"] end in
  ?
) in
let bench_28 = (
  type Student = (name = String, age = Int, favorite_color = String) in
  let students : [Student] = [("Bob", 12, "blue"), ("Alice", 17, "green"), ("Eve", 13, "red")] in
  type GradebookEntry = (name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int) in
  let gradebook : [GradebookEntry] = [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ] in
  let select_rows1 =
    let _requires = [(enforced = ^^check(false), "for all n in ns, n is in range(nrows(t1))")] in
    let _ensures = [(enforced=^^check(true), "schema(t2) is equal to schema(t1)"), (enforced = ^^check(false), "nrows(t2) is equal to length(ns)")] in
    # We drop rows that are out of bounds #
    let select_rows1 = typfun r -> fun (t1 : [r], ns : [Int]) -> map(ns, nth_opt(t1, _)) |> filter_map(_, fun x -> x) in
    test
      select_rows1@<Student>(students, [2, 0, 2, 1]) == [("Eve", 13, "red"), ("Bob", 12, "blue"), ("Eve", 13, "red"), ("Alice", 17, "green")] : [Student] end in
  let select_rows2 =
    let _requires = [(enforced = ^^check(false), "length(bs) is equal to nrows(t1)")] in
    let _ensures = [(enforced=^^check(true), "schema(t2) is equal to schema(t1)"), (enforced = ^^check(false), "nrows(t2) is equal to length(ns)")] in
    let select_rows2 = typfun r -> fun (t1 : [r], bs : [Bool]) -> zip(bs, t1) |> filter_map(_, fun (b, r) -> if b then Some(r) else None) in
    test
      select_rows2@<Student>(students, [true, false, true]) == [("Bob", 12, "blue"), ("Eve", 13, "red")] : [Student] end in
  let select_cols1 =
    let _requires = [(enforced = ^^check(false), "length(bs) is equal to ncols(t1)")] in
    let _ensures = [
      (enforced=^^check(false), "header(t2) is a subsequence of header(t1)"),
      (enforced=^^check(false), "for all i in range(ncols(t1)), header(t1)[i] is in header(t2) if and only if bs[i] is equal to true"),
      (enforced=^^check(false), "schema(t2) is a subsequence of schema(t1)"),
      (enforced = ^^check(false), "nrows(t2) is equal to nrows(t1)")
    ] in
    let select_cols1 =
      fun (t1 : [?], bs : [Bool]) ->
        map(t1, fun r -> to_lvs(r) |> zip(_, bs) |> filter_map(_, fun (e, b) -> if b then Some(e) else None) |> from_lvs) in
    test
      select_cols1(students, [true, true, false]) == [(name="Bob", age=12), (name="Alice", age=17), (name = "Eve", age = 13)] end in
  let select_cols2 =
    let _requires = [(enforced=^^check(false), "ns has no duplicates"), (enforced = ^^check(false), "for all n in ns, n is in range(ncols(t1))")] in
    let _ensures = [
      (enforced=^^check(false), "ncols(t2) is equal to length(ns)"),
      (enforced=^^check(false), "for all i in range(length(ns)), header(t2)[i] is equal to header(t1)[ns[i]]"),
      (enforced=^^check(false), "for all c in header(t2), schema(t2)[c] is equal to schema(t1)[c]"),
      (enforced = ^^check(false), "nrows(t2) is equal to nrows(t1)")
    ] in
    let select_cols2 =
      fun (t1 : [?], ns : [Int]) ->
        map(t1, fun r -> to_lvs(r) |> (fun entries -> map(ns, nth_opt(entries, _))) |> filter_map(_, fun (e) -> e) |> from_lvs) in
    test
      select_cols2(students, [2, 1])
      == [(favorite_color="blue", age=12), (favorite_color="green", age=17), (favorite_color = "red", age = 13)] end in
  let select_cols_3 =
    let _requires = [(enforced=^^check(false), "cs has no duplicates"), (enforced = ^^check(false), "for all c in cs, c is in header(t1)")] in
    let _ensures = [
      (enforced=^^check(false), "header(t2) is equal to cs"),
      (enforced=^^check(false), "for all c in header(t2), schema(t2)[c] is equal to schema(t1)[c]"),
      (enforced = ^^check(false), "nrows(t2) is equal to nrows(t1)")
    ] in
    let select_cols3 =
      fun (t1 : [?], cs : [String]) ->
        map(t1, fun r -> to_lvs(r) |> (fun entries -> filter_map(cs, fun c -> find_opt(entries, fun e -> e.label == c))) |> from_lvs) in
    test
      select_cols3(students, ["favorite_color", "age"])
      == [(favorite_color="blue", age=12), (favorite_color="green", age=17), (favorite_color = "red", age = 13)] end;
    # We have label filtering on tuples as a primitive operation but without row types there's no way to give it a first-class type. This is the idiomatic way to do the operation #
    test
      map(students, select_labels(_, `favorite_color`, `age`))
      == [(favorite_color="blue", age=12), (favorite_color="green", age=17), (favorite_color = "red", age = 13)] end in
  let head =
    let _requires = [
      (enforced=^^check(false), "if n is non-negative then n is in range(nrows(t1))"),
      (enforced = ^^check(false), "if n is negative then - n is in range(nrows(t1))")
    ] in
    let _ensures = [
      (enforced=^^check(true), "schema(t2) is equal to schema(t1)"),
      (enforced=^^check(false), "if n is non-negative then nrows(t2) is equal to n"),
      (enforced = ^^check(false), "if n is negative then nrows(t2) is equal to nrows(t1) + n")
    ] in
    let head = typfun r -> fun (t1 : [r], n : Int) -> take(t1, if n >= 0 then n else length(t1) + n) : [r] in
    test
      head@<Student>(students, - 2) == [("Bob", 12, "blue")] : [Student] end in
  let distinct =
    let _requires = [] in
    let _ensures = [(enforced = ^^check(true), "schema(t2) is equal to schema(t1)")] in
    let distinct = typfun row -> fun (t : [row]) -> fold_left(t, fun (acc, elem) -> if mem(acc, elem) then acc else acc @ [elem], []) : [row] in
    test
      distinct@<(quiz3 = Int)>(map(gradebook, select_labels(_, `quiz3`))) == [7, 8] : [(quiz3 = Int)] end in
  let drop_column =
    # omit_labels is a primitive operation to drop columns but without row types there's no way to give it a first-class type. This is the idiomatic way to do the operation #
    let _requires = [(enforced = ^^check(false), "c is in header(t1)")] in
    # This is ensured if using omit_labels #
    let _ensures = [
      (enforced=^^check(false), "nrows(t2) is equal to nrows(t1)"),
      (enforced=^^check(false), "header(t2) is equal to removeAll(header(t1), [c])"), # This is ensured if using omit_labels #
      (enforced = ^^check(false), "schema(t2) is a subsequence of schema(t1)")
    ] in
    let drop_column =
      fun (t : [?], c : String) -> map(t, fun row -> to_lvs(row) |> filter(_, fun entry -> entry.label != c) |> from_lvs) : [?] in
    test
      drop_column(gradebook, "final")
      == [("Bob",   12, 8, 9, 77, 7, 9), ("Alice", 17, 6, 8, 88, 8, 7), ("Eve", 13, 7, 9, 84, 8, 8)]
      : [(name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int)] end;
    test
      map(gradebook, omit_labels(_, `final`))
      == [("Bob",   12, 8, 9, 77, 7, 9), ("Alice", 17, 6, 8, 88, 8, 7), ("Eve", 13, 7, 9, 84, 8, 8)]
      : [(name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int)] end in
  let drop_columns =
    # omit_labels is a primitive operation to drop columns but without row types there's no way to give it a first-class type. This is the idiomatic way to do the operation #
    let _requires = [
      (enforced=^^check(false), "for all c in cs, c is in header(t1)"), # This is ensured if using omit_labels #
      (enforced = ^^check(false), "cs has no duplicates")
    ] in
    let _ensures = [
      (enforced=^^check(false), "nrows(t2) is equal to nrows(t1)"),
      (enforced=^^check(false), "header(t2) is equal to removeAll(header(t1), cs)"), # This is ensured if using omit_labels #
      (enforced = ^^check(false), "schema(t2) is a subsequence of schema(t1)")
    ] in
    let drop_columns =
      fun (t : [?], cs : [String]) ->
        map(t, fun row -> to_lvs(row) |> filter(_, fun entry -> ! any(cs, fun s -> entry.label == s)) |> from_lvs) : [?] in
    test
      drop_columns(gradebook, ["final", "midterm"])
      == [("Bob",   12, 8, 9, 7, 9), ("Alice", 17, 6, 8, 8, 7), ("Eve", 13, 7, 9, 8, 8)]
      : [(name = String, age = Int, quiz1 = Int, quiz2 = Int, quiz3 = Int, quiz4 = Int)] end;
    test
      map(gradebook, omit_labels(_, `final`, `midterm`))
      == [("Bob",   12, 8, 9, 7, 9), ("Alice", 17, 6, 8, 8, 7), ("Eve", 13, 7, 9, 8, 8)]
      : [(name = String, age = Int, quiz1 = Int, quiz2 = Int, quiz3 = Int, quiz4 = Int)] end in
  let tfilter =
    let _requires = [(enforced = ^^check(true), "schema(r) is equal to schema(t1)")] in
    let _ensures = [(enforced = ^^check(true), "schema(t2) is equal to schema(t1)")] in
    let tfilter = typfun r -> fun (t : [r], f : r -> Bool) -> filter(t, f) : [r] in
    test
      tfilter@<GradebookEntry>(gradebook, fun s -> string_length(s.name) > 3) == [("Alice", 17, 6, 8, 88, 8, 7, 85)] : [GradebookEntry] end in
  ?
) in
let bench_29 = (
  type Student = (name = String, age = Int, favorite_color = String) in
  let students : [Student] = ^^fold([
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]) in
  
  let _requires = [
    (enforced=^^check(false), "for all c in header(r), c is in header(t)"),
    (enforced = ^^check(false), "for all c in header(r), schema(r)[c] == schema(t)[c]")
  ] in
  let _ensures = [
    (enforced=^^check(false), "result is None or Some(n) where n in range(nrows(t))"),
    (enforced = ^^check(false), "if Some(n), then getRow(t, n) matches r on all fields in header(r)")
  ] in
  let find =
    fun (t : [?], r : ?) ->
      let is_match =
        fun (row : ?) ->
          let row_entries = to_lvs(row) in
          let r_entries = to_lvs(r) in
          all(
            r_entries,
            fun e ->
              case find_opt(row_entries, fun e' -> e'.label == e.label)
              | Some(e') => e'.value == e.value
              | None => false
              end
          )
          : Bool in
      find_index(t, is_match) : (+ None + Some(Int)) in
  
  test
    find(students, (age = 13)) == Some(2) end;
  # Idiomatic way to do this is type safe but requires the user to project the labels manually #
  test
    find_index(students, fun r -> r == (r ... (age = 13))) == Some(2) end
) in
let bench_30 = (
  type GradebookEntrySeq = (name = String, age = Int, quizzes = [Int], midterm = Int, final = Int) in
  let gradebookSeq : [GradebookEntrySeq] = ^^fold([
    ("Bob",   12, [8, 9, 7, 9], 77, 87),
    ("Alice", 17, [6, 8, 8, 7], 88, 85),
    ("Eve",   13, [7, 9, 8, 8], 84, 77)
  ]) in
  let _requires = [
    (enforced=^^check(false), "cs has no duplicates"),
    (enforced=^^check(false), "for all c in cs, c is in header(t1)"),
    (enforced=^^check(false), "for all c in cs, schema(t1)[c] is Seq<X> for some sort X"),
    (
      enforced = ^^check(false),
      "for all i in range(nrows(t1)), for all c1 and c2 in cs, length(getValue(getRow(t1, i), c1)) is equal to length(getValue(getRow(t1, i), c2))"
    )
  ] in
  let _ensures = [
    (enforced=^^check(false), "header(t2) is equal to header(t1)"),
    (
      enforced = ^^check(false),
      "for all c in header(t2) :"
      ++ "if c is in cs then schema(t2)[c] is equal to the element sort of schema(t1)[c]"
      ++ "otherwise, schema(t2)[c] is equal to schema(t1)[c]"
    )
  ] in
  let flatten =
    fun (t1 : [?], cs : [String]) ->
      let _select_cols =
        fun (r : ?, cs : [String]) -> to_lvs(r) |> (fun entries -> filter_map(cs, fun c -> find_opt(entries, fun e -> e.label == c))) |> from_lvs in
      flat_map(
        t1,
        fun r ->
          let (_non_seq_entries, seq_entries) = partition(to_lvs(r), fun (label = l, value = _v) -> ! mem(cs, l)) in
          case map(seq_entries, fun (label = l, value = vs) -> map(vs, fun v -> [(label = l, value = v)]))
          | [] => []
          | (col1 :: cols) => fold_left(cols, fun (acc, a) -> zip(acc, a) |> map(_, fun (a, b) -> a @ b), col1) |> map(_, from_lvs)
          end
          |> map(_, fun rest -> r ... rest)
      )
      : [?] in
  let expected = ^^fold([
    (name="Bob", age=12, quizzes=8, midterm=77, final=87),
    (name="Bob", age=12, quizzes=9, midterm=77, final=87),
    (name="Bob", age=12, quizzes=7, midterm=77, final=87),
    (name="Bob", age=12, quizzes=9, midterm=77, final=87),
    (name="Alice", age=17, quizzes=6, midterm=88, final=85),
    (name="Alice", age=17, quizzes=8, midterm=88, final=85),
    (name="Alice", age=17, quizzes=8, midterm=88, final=85), 
    (name="Alice", age=17, quizzes=7, midterm=88, final=85), 
    (name="Eve", age=13, quizzes=7, midterm=84, final=77), 
    (name="Eve", age=13, quizzes=9, midterm=84, final=77), 
    (name="Eve", age=13, quizzes=8, midterm=84, final=77), 
    (name="Eve", age=13, quizzes=8, midterm=84, final=77)
  ]) in
  test
    flatten(gradebookSeq, ["quizzes"]) == expected end;
  # Idiomatic way to do this #
  test
    flat_map(gradebookSeq, fun r -> map(r.quizzes, fun r' -> r ... (quizzes = r'))) == expected end
) in
let bench_31 = (
  type Student = (name = String, age = Int, favorite_color = String) in
  let students : [Student] = ([("Bob", 12, "blue"), ("Alice", 17, "green"), ("Eve", 13, "red")]) in
  let expected = (
    [
      (key="blue", groups=[(name="Bob", age=12, favorite_color="blue")]),
      (key="green", groups=[(name="Alice", age=17, favorite_color="green")]),
      (key = "red", groups = [(name = "Eve", age = 13, favorite_color = "red")])
    ]
  ) in
  
  # This way closely follows the TableAPI by taking a string column name but provides no static guarantees #
  let v1 =
    let _requires = [(enforced=(false), "c is in header(t1)"), (enforced = (false), "schema(t1)[c] is a categorical sort")] in
    let _ensures = [
      (enforced=(false), "header(t2) == [key, groups]"),
      (enforced=(false), "schema(t2)[key] == schema(t1)[c]"),
      (enforced=(false), "schema(t2)[groups] == Table"),
      (enforced=(false), "getColumn(t2, key) has no duplicates"),
      (enforced=(false), "for all t in getColumn(t2, groups), schema(t) == schema(t1)"),
      (enforced = (false), "nrows(t2) == length(removeDuplicates(getColumn(t1, c)))")
    ] in
    let group_by_retentive =
      fun (t1 : [?], c : String) ->
        let get_value = fun (r : ?, label : String) -> find_opt(to_lvs(r), fun e -> e.label == label) |> option_map(_, fun e -> e.value) in
        let remove_duplicates = fun (xs : [?]) -> fold_left(xs, fun (seen, x) -> if mem(seen, x) then seen else seen @ [x], []) : [?] in
        let get_key = fun (r : ?) -> get_value(r, c) in
        let keys = map(t1, get_key) |> filter_map(_, fun opt -> opt) |> remove_duplicates in
        map(
          keys,
          fun k ->
            let rows =
              filter(
                t1,
                fun r ->
                  case get_key(r)
                  | Some(k') => k' == k
                  | None => false
                  end
              ) in
            (key = k) ... (groups = rows)
        )
        : [?] in
    test
      group_by_retentive(students, "favorite_color") == expected end in
  # This is the more idiomatic way and takes a function to project out the group #
  let v2 =
    let _requires = [
      (enforced=(true), "c is in header(t1)"),
      (enforced = (true), "schema(t1)[c] is a categorical sort")
      # Verifies it's a string column #
    ] in
    let _ensures = [
      (enforced=(true), "header(t2) == [key, groups]"),
      (enforced=(true), "schema(t2)[key] == schema(t1)[c]"),
      (enforced=(true), "schema(t2)[groups] == Table"),
      (enforced=(false), "getColumn(t2, key) has no duplicates"),
      (enforced=(true), "for all t in getColumn(t2, groups), schema(t) == schema(t1)"),
      (enforced = (false), "nrows(t2) == length(removeDuplicates(getColumn(t1, c)))")
    ] in
    let group_by_retentive : poly row -> poly key -> ([row], (row -> key)) -> [(key = key, groups = [row])] =
      typfun row ->
        typfun key ->
          fun (t1, c) ->
            case t1
            | [] => []
            | x::xs =>
              let key = c(x) in
              let grouped = group_by_retentive@<row>@<key>(xs, c) in
              case find_opt(grouped, fun g -> g.key == key)
              | Some(g) => ((key = g.key) ... (groups = g.groups @ [x])) :: filter(grouped, fun g -> g.key != key)
              | None => ((key = key) ... (groups = [x])) :: grouped
              end
            end in
    test
      group_by_retentive@<Student>@<String>(students, fun r -> r.favorite_color) == expected end in
  ?
) in
let bench_32 = (
  type Student = (name = String, age = Int, favorite_color = String) in
  let students : [Student] = ^^fold([
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]) in
  
  let _requires = [(enforced=^^check(false), "c is in header(t1)"), (enforced = ^^check(false), "schema(t1)[c] is a categorical sort")] in
  let _ensures = [
    (enforced=^^check(false), "header(t2) == [key, groups]"),
    (enforced=^^check(false), "schema(t2)[key] == schema(t1)[c]"),
    (enforced=^^check(false), "schema(t2)[groups] == Table"),
    (enforced=^^check(false), "getColumn(t2, key) has no duplicates"),
    (enforced=^^check(false), "for all t in getColumn(t2, groups), header(t) == removeAll(header(t1), [c])"),
    (enforced=^^check(false), "for all t in getColumn(t2, groups), schema(t) is a subsequence of schema(t1)"),
    (enforced = ^^check(false), "nrows(t2) == length(removeDuplicates(getColumn(t1, c)))")
  ] in
  
  let group_by_subtractive =
    let get_value = ^^fold(fun (r:?, label:String) ->
      find_opt(to_lvs(r), fun e -> e.label == label) |> option_map(_, fun e -> e.value)) in
    let remove_duplicates = fun (xs : [?]) -> fold_left(xs, fun (seen, x) -> if mem(seen, x) then seen else seen @ [x], []) : [?] in
    fun (t1 : [?], c : String) ->
      let get_key = fun (r : ?) -> get_value(r, c) in
      let keys = map(t1, get_key) |> filter_map(_, fun opt -> opt) |> remove_duplicates in
      map(
        keys,
        fun k ->
          let rows =
            filter(
              t1,
              fun r ->
                case get_key(r)
                |Some(k') => k' == k
                |None => false
                end
            )
            |> map(_, fun r -> to_lvs(r) |> filter(_, fun e -> e.label != c) |> from_lvs) in
          (key = k) ... (groups = rows)
      ) in
  let expected = ^^fold([
    (key="blue", groups=[(name="Bob", age=12)]),
    (key="green", groups=[(name="Alice", age=17)]),
    (key="red", groups=[(name="Eve", age=13)])
  ]) in
  
  test
    group_by_subtractive(students, "favorite_color") == expected end
) in
let bench_33 = (
  type GradebookEntry = (name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int) in
  let gradebook : [GradebookEntry] = ^^fold([
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve",   13, 7, 9, 84, 8, 8, 77)
  ]) in
  type Student = (name = String, age = Int, favorite_color = String) in
  let students : [Student] = ^^fold([
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]) in
  
  let _requires = [] in
  let _ensures = [
    (enforced=^^check(true), "schema(r1) == schema(t1)"),
    (enforced=^^check(true), "schema(r2) == schema(t2)"),
    (enforced=^^check(true), "schema(r3) == schema(t1)"),
    (enforced=^^check(true), "schema(r3) == schema(t1)"),
    (enforced = ^^check(false), "nrows(t4) == nrows(t1)")
  ] in
  let group_join : poly r1 -> poly r2 -> poly r3 -> poly k -> ([r1], [r2], r1 -> k, r2 -> k, (r1, [r2]) -> r3) -> [r3] =
    typfun r1 ->
      typfun r2 ->
        typfun r3 ->
          typfun k ->
            fun (t1 : [r1], t2 : [r2], get_key1 : (r1 -> k), get_key2 : (r2 -> k), aggregate : ((r1, [r2]) -> r3)) ->
              map(
                t1,
                fun (r : r1) ->
                  let t2' : [r2] = filter(t2, fun r' : r2 -> get_key1(r) == get_key2(r')) in
                  aggregate(r, t2')
              )
              : [r3] in
  let average = fun ns -> fold_left(ns, int_plus, 0) / length(ns) in
  
  test
    group_join@<^^fold(Student)>@<^^fold(GradebookEntry)>@<^^fold((name=String, age=Int, favorite_color=String, average=Int))>@<String>(students, gradebook, fun r -> r.name, fun r -> r.name, fun (r, t) -> r ... (average = average(t.final)))
    == [("Bob", 12, "blue", 87), ("Alice", 17, "green", 85), ("Eve", 13, "red", 77)]
    : [(name = String, age = Int, favorite_color = String, average = Int)] end
) in
let bench_34 = (
  type GradebookEntry = (name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int) in
  let gradebook : [GradebookEntry] = ^^fold([
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve",   13, 7, 9, 84, 8, 8, 77)
  ]) in
  type Student = (name = String, age = Int, favorite_color = String) in
  let students : [Student] = ^^fold([
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]) in
  
  let _requires = [] in
  let _ensures = [
    (enforced=^^check(true), "schema(r1) == schema(t1)"),
    (enforced=^^check(true), "schema(r2) == schema(t2)"),
    (enforced=^^check(true), "schema(r3) == schema(t1)"),
    (enforced=^^check(true), "schema(r4) == schema(t2)"),
    (enforced = ^^check(true), "schema(t3) == schema(r5)")
  ] in
  let join : poly r1 -> poly r2 -> poly r3 -> poly k -> ([r1], [r2], r1 -> k, r2 -> k, (r1, r2) -> r3) -> [r3] =
    typfun r1 ->
      typfun r2 ->
        typfun r3 ->
          typfun k ->
            fun (t1 : [r1], t2 : [r2], get_key1 : (r1 -> k), get_key2 : (r2 -> k), combine : ((r1, r2) -> r3)) ->
              flat_map(
                t1,
                fun (r : r1) ->
                  let t2' : [r2] = filter(t2, fun r' : r2 -> get_key1(r) == get_key2(r')) in
                  map(t2', fun r' : r2 -> combine(r, r'))
              )
              : [r3] in
  
  test
