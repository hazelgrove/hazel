let bench_1 = (
  # No type correlates to missing schema. There is no error as it's valid data without labels#
  let missingSchema = [("Bob", 12, "blue"), ("Alice", 17, "green"), ("Eve", 13, "red")] in
  
  type Schema = [(name = String, age = Int, `favorite color` = String)] in
  
  # The missing row is represented as a hole. #
  let missingRow : Schema = [("Bob", 12, "blue"), ("Alice", 17, "green"), ?] in
  
  # The missing cell is represented as a hole#
  let missingCell : Schema = [("Bob", 12, ?), ("Alice", 17, "green"), ("Eve", 13, "red")] in
  
  # The age/name columns are swapped. The error is added to every relevant cell and says which column it's for as well as the type error #
  let swappedColumns : Schema = [(12, "Bob", "blue"), (17, "Alice","green"), (13, "Eve", "red")] in
  
  # Error marks are added onto the tuples.  The last row uses explicit labels which makes the inconsistency easier to identify  by marking the unknown label.#
  let schemaTooShort : [(name = String, age = Int)] = [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    (name = "Eve", age = 13, `favorite color` = "red")
  ] in
  
  # Error marks are added onto the tuples showing the inconsistency. The last row uses explicit labels which makes the inconsistency easier to identity #
  let schemaTooLong : [(name = String, age = Int, `favorite number` = Int, `favorite color` = String)] = [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    (name = "Eve", age = 13, `favorite color` = "red")
  ] in
  ?
) in
let bench_2 = (
  type Image = ? in
  # Representing column names as projection functions for better error localization since we don't do first-class labels #
  let scatter_plot : poly row -> ([row], row -> Int, row -> Int) -> Image = ? in
  # Using ? for the categorical variables #
  let pie_chart : poly row -> ([row], row -> ?, row -> Int) -> Image = ? in
  
  let mid_final =
    type GradebookEntry = (name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int) in
    let gradebook : [GradebookEntry] = ^^fold([
      ("Bob",   12, 8, 9, 77, 7, 9, 87),
      ("Alice", 17, 6, 8, 88, 8, 7, 85),
      ("Eve",   13, 7, 9, 84, 8, 8, 77)
    ]) in
    # Currently requires explicit type application. Error message is localized to error and shows what possible labels are. #
    let incorrect = scatter_plot@<GradebookEntry>(gradebook, fun r -> r.mid, fun r -> r.final) in
    let correct = scatter_plot@<GradebookEntry>(gradebook, fun r -> r.midterm, fun r -> r.final) in
    ? in
  
  let black_and_white =
    type JellyAnon = (
      get_acne = Bool,
      red = Bool,
      black = Bool,
      white = Bool,
      green = Bool,
      yellow = Bool,
      brown = Bool,
      orange = Bool,
      pink = Bool,
      purple = Bool
    ) in
    let jellyAnon : [JellyAnon] = ^^fold([
      (^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false)),
      (^^check(true), ^^check(false), ^^check(true), ^^check(false), ^^check(true), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false)),
      (^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false)),
      (^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false)),
      (^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(true), ^^check(false)),
      (^^check(true), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(true), ^^check(false)),
      (^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false)),
      (^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(true), ^^check(false), ^^check(false)),
      (^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false)),
      (^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(true), ^^check(false), ^^check(true), ^^check(false))
    ]) in
    # Using alternative buildColumn that takes projection to new tuple #
    # The version taking a string can be used but it would give no static errors #
    let build_column : poly r1 -> poly r2 -> poly r3 -> ([r1], r1 -> r2, (r1, r2) -> r3) -> [r3] =
      typfun r1 -> typfun r2 -> typfun r3 -> fun (table, project, build_result) -> map(table, fun r : r1 -> build_result(r, project(r))) in
    let incorrect =
      let eat_black_and_white = fun r : JellyAnon -> r.`black and white` == true in
      build_column@<JellyAnon>@<(`eat black and white` = Bool)>@<(
        get_acne = Bool,
        red = Bool,
        black = Bool,
        white = Bool,
        green = Bool,
        yellow = Bool,
        brown = Bool,
        orange = Bool,
        pink = Bool,
        purple = Bool,
        `eat black and white` = Bool
      )>(jellyAnon, fun r -> (`eat black and white` = eat_black_and_white(r)), fun (a, b) -> a ... (`eat black and white` = b))
      # b is being autolabeled here# in
    let correct =
      let eat_black_and_white = fun r : JellyAnon -> r.black == true && r.white == true in
      build_column@<JellyAnon>@<(`eat black and white` = Bool)>@<(
        get_acne = Bool,
        red = Bool,
        black = Bool,
        white = Bool,
        green = Bool,
        yellow = Bool,
        brown = Bool,
        orange = Bool,
        pink = Bool,
        purple = Bool,
        `eat black and white` = Bool
      )>(jellyAnon, fun r -> (`eat black and white` = eat_black_and_white(r)), fun (a, b) -> a ... (`eat black and white` = b))
      # b is being autolabeled here# in
    ? in
  
  let pie_count =
    type JellyAnon = (
      get_acne = Bool,
      red = Bool,
      black = Bool,
      white = Bool,
      green = Bool,
      yellow = Bool,
      brown = Bool,
      orange = Bool,
      pink = Bool,
      purple = Bool
    ) in
    let jellyAnon : [JellyAnon] = ^^fold([
      (^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false)),
      (^^check(true), ^^check(false), ^^check(true), ^^check(false), ^^check(true), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false)),
      (^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false)),
      (^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false)),
      (^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(true), ^^check(false)),
      (^^check(true), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(true), ^^check(false)),
      (^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false)),
      (^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(true), ^^check(false), ^^check(false)),
      (^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(false), ^^check(false)),
      (^^check(false), ^^check(true), ^^check(false), ^^check(false), ^^check(false), ^^check(true), ^^check(true), ^^check(false), ^^check(true), ^^check(false))
    ]) in
    let count =
      typfun row ->
        typfun v ->
          fun (t1 : [row], proj : row -> v) ->
            let go =
              fun (groups : [(value = v, count = Int)], row : row) ->
                case find_opt(groups, fun g -> g.value == proj(row))
                | None => (value = proj(row), count = 1) :: groups
                | Some(value=_v,count=c) => (value = proj(row), count = c + 1) :: filter(groups, fun g -> g.value != proj(row))
                end in
            fold_left(t1, go, []) : [(value = v, count = Int)] in
    let incorrect =
      pie_chart@<(value = Bool, count = Int)>(count@<JellyAnon>@<Bool>(jellyAnon, fun r -> r.get_acne), fun r -> r.`true`, fun r -> r.get_acne) in
    let correct =
      pie_chart@<(value = Bool, count = Int)>(count@<JellyAnon>@<Bool>(jellyAnon, fun r -> r.get_acne), fun r -> r.value, fun r -> r.count) in
    ? in
  ?
) in
let bench_3 = (
  type Image = ? in
  # Representing column names as projection functions for better error localization since we don't do first-class labels #
  let scatter_plot : poly row -> ([row], row -> Int, row -> Int) -> Image = ? in
  # Using ? for the categorical variables #
  let pie_chart : poly row -> ([row], row -> ?, row -> Int) -> Image = ? in
  
  let brown_get_acne =
    type JellyNamed = (
      name = String,
      get_acne = Bool,
      red = Bool,
      black = Bool,
      white = Bool,
      green = Bool,
      yellow = Bool,
      brown = Bool,
      orange = Bool,
      pink = Bool,
      purple = Bool
    ) in
    let jellyNamed : [JellyNamed] = (
      [
        ("Emily",    (true), (false), (false), (false), (true), (false), (false), (true), (false), (false)),
        ("Jacob",    (true), (false), (true), (false), (true), (true), (false), (false), (false), (false)),
        ("Emma",     (false), (false), (false), (false), (true), (false), (false), (false), (true), (false)),
        ("Aidan",    (false), (false), (false), (false), (false), (true), (false), (false), (false), (false)),
        ("Madison",  (false), (false), (false), (false), (false), (true), (false), (false), (true), (false)),
        ("Ethan",    (true), (false), (true), (false), (false), (false), (false), (true), (true), (false)),
        ("Hannah",   (false), (false), (true), (false), (false), (false), (false), (false), (true), (false)),
        ("Matthew",  (true), (false), (false), (false), (false), (false), (true), (true), (false), (false)),
        ("Hailey",   (true), (false), (false), (false), (false), (false), (false), (true), (false), (false)),
        ("Nicholas", (false), (true), (false), (false), (false), (true), (true), (false), (true), (false))
      ]
    ) in
    let brown_and_get_acne = fun r : JellyNamed -> r.brown && r.get_acne in
    let count = (
      typfun row ->
        typfun v ->
          fun (t1 : [row], proj : row -> v) ->
            let go =
              fun (groups : [(value = v, count = Int)], row : row) ->
                case find_opt(groups, fun g -> g.value == proj(row))
                | None => (value = proj(row), count = 1) :: groups
                | Some(value=_v,count=c) => (value = proj(row), count = c + 1) :: filter(groups, fun g -> g.value != proj(row))
                end in
            fold_left(t1, go, []) : [(value = v, count = Int)]
    ) in
    let build_column : poly r1 -> poly r2 -> poly r3 -> ([r1], r1 -> r2, (r1, r2) -> r3) -> [r3] = (
      typfun r1 -> typfun r2 -> typfun r3 -> fun (table, project, build_result) -> map(table, fun r : r1 -> build_result(r, project(r)))
    ) in
    let _incorrect =
      let brown_and_get_acne_table =
        build_column@<JellyNamed>@<Bool>@<(
          name = String,
          get_acne = Bool,
          red = Bool,
          black = Bool,
          white = Bool,
          green = Bool,
          yellow = Bool,
          brown = Bool,
          orange = Bool,
          pink = Bool,
          purple = Bool,
          part2 = Bool
        )>(jellyNamed, brown_and_get_acne, fun (t, v) -> t ... (part2 = v)) in
      count@<(
        name = String,
        get_acne = Bool,
        red = Bool,
        black = Bool,
        white = Bool,
        green = Bool,
        yellow = Bool,
        brown = Bool,
        orange = Bool,
        pink = Bool,
        purple = Bool,
        part2 = Bool
      )>@<Bool>(brown_and_get_acne_table, fun r -> r.`brown and get acne`) in
    let correct =
      let brown_and_get_acne_table =
        build_column@<JellyNamed>@<Bool>@<(
          name = String,
          get_acne = Bool,
          red = Bool,
          black = Bool,
          white = Bool,
          green = Bool,
          yellow = Bool,
          brown = Bool,
          orange = Bool,
          pink = Bool,
          purple = Bool,
          `brown and get acne` = Bool
        )>(jellyNamed, brown_and_get_acne, fun (t, v) -> t ... (`brown and get acne` = v)) in
      count@<(
        name = String,
        get_acne = Bool,
        red = Bool,
        black = Bool,
        white = Bool,
        green = Bool,
        yellow = Bool,
        brown = Bool,
        orange = Bool,
        pink = Bool,
        purple = Bool,
        `brown and get acne` = Bool
      )>@<Bool>(brown_and_get_acne_table, fun r -> r.`brown and get acne`) in
    test
      correct == [(value=false, count=9), (value = true, count = 1)] end in
  
  let get_only_row =
    let tfilter = (typfun row -> fun (t1 : [row], pred : row -> Bool) -> filter(t1, pred)) in
    type Student = (name = String, age = Int, favorite_color = String) in
    let students : [Student] = ([("Bob", 12, "blue"), ("Alice", 17, "green"), ("Eve", 13, "red")]) in
    let _incorrect =
      # No static error. Dynamic error `undefined.favorite_color`#
      nth(tfilter@<Student>(students, fun r -> r.name == "Alice"), 1).favorite_color in
    let correct = nth(tfilter@<Student>(students, fun r -> r.name == "Alice"), 0).favorite_color in
    test
      correct == "green" end in
  
  let favorite_color =
    let tfilter = (typfun row -> fun (t1 : [row], pred : row -> Bool) -> filter(t1, pred)) in
    type Student = (name = String, age = Int, favorite_color = String) in
    let students : [Student] = ([("Bob", 12, "blue"), ("Alice", 17, "green"), ("Eve", 13, "red")]) in
    let _incorrect = tfilter@<Student>(students, fun r -> r.favorite_color) in
    let correct = tfilter@<Student>(students, fun r -> r.favorite_color == "green") in
    test
      correct == [("Alice", 17, "green") : Student] end in
  ?
) in
let bench_4 = (
  let brown_jellybeans =
    type JellyAnon = (
      get_acne = Bool,
      red = Bool,
      black = Bool,
      white = Bool,
      green = Bool,
      yellow = Bool,
      brown = Bool,
      orange = Bool,
      pink = Bool,
      purple = Bool
    ) in
    let jellyAnon : [JellyAnon] = (
      [
        ((true), (false), (false), (false), (true), (false), (false), (true), (false), (false)),
        ((true), (false), (true), (false), (true), (true), (false), (false), (false), (false)),
        ((false), (false), (false), (false), (true), (false), (false), (false), (true), (false)),
        ((false), (false), (false), (false), (false), (true), (false), (false), (false), (false)),
        ((false), (false), (false), (false), (false), (true), (false), (false), (true), (false)),
        ((true), (false), (true), (false), (false), (false), (false), (true), (true), (false)),
        ((false), (false), (true), (false), (false), (false), (false), (false), (true), (false)),
        ((true), (false), (false), (false), (false), (false), (true), (true), (false), (false)),
        ((true), (false), (false), (false), (false), (false), (false), (true), (false), (false)),
        ((false), (true), (false), (false), (false), (true), (true), (false), (true), (false))
      ]
    ) in
    # Version that uses string params for the column names gives no static errors #
    let v1 =
      let get_value = fun (r, c : String) -> (to_lvs(r) |> find_opt(_, fun label = l, value = _v -> l == c)) |> option_map(_, fun e -> e.value) in
      let nrows = length in
      let tfilter = filter in
      let option_get =
        fun o ->
          case o
          | Some(v) => v
          end in
      let incorrect =
        let keep = fun r -> get_value(r, "color") |> option_get in
        let count_participants = fun (t, _color) -> nrows(tfilter(t, keep)) in
        count_participants(jellyAnon, "brown") in
      let correct =
        let count_participants =
          fun (t, color) ->
            let keep = fun r -> get_value(r, color) |> option_get in
            nrows(tfilter(t, keep)) in
        count_participants(jellyAnon, "brown") in
      ? in
    # Version that uses higher order functions to get static errors #
    let v2 =
      let nrows = length in
      let tfilter = filter in
      let incorrect =
        let keep = fun (r : JellyAnon) -> r.color in
        let count_participants = typfun row -> fun (t : [row], _color : row -> Bool) -> length(filter(t, keep)) in
        count_participants@<JellyAnon>(jellyAnon, fun r -> r.brown) in
      let correct =
        let count_participants =
          typfun row ->
            fun (t : [row], color : row -> Bool) ->
              let keep = fun (r : row) -> color(r) in
              length(filter(t, keep)) in
        count_participants@<JellyAnon>(jellyAnon, fun r -> r.brown) in
      ? in
    ? in
  
  let employee_to_department =
    type OptInt = + None + Some(Int) in
    type Employee = (last_name = String, department_id = OptInt) in
    let employees : [Employee] = (
      [("Rafferty", Some(31)), ("Jones", Some(33)), ("Heisenberg", Some(33)), ("Robinson", Some(34)), ("Smith", Some(34)), ("Williams", None)]
    ) in
    type Department = (department_id = Int, department_name = String) in
    let departments : [Department] = ([(31, "Sales"), (33, "Engineering"), (34, "Clerical"), (35, "Marketing")]) in
    let tfilter = typfun row -> fun (t : [row], pred : (row -> Bool)) -> filter(t, pred) : [row] in
    let get_row = typfun row -> fun (t : [row], n : Int) -> nth(t, n) : row in
    let build_column = typfun row -> typfun row' -> fun (t : [row], fn : (row -> row')) -> map(t, fn) : [row'] in
    let incorrect =
      let last_name_to_dept_id =
        fun (dept_tab : [Department], name : String) ->
          let match_name = fun (r : Department) -> r.last_name == name in
          let matched_tab = tfilter@<Department>(dept_tab, match_name) in
          let matched_row = get_row@<Department>(matched_tab, 0) in
          matched_row.`department_id` in
      let employee_to_department =
        fun (_name : String, empl_tab : [Employee], dept_tab : [Department]) ->
          build_column@<Employee>@<(last_name = String, department_id = OptInt, department_name = String)>(empl_tab, fun r -> r ... (department_name = last_name_to_dept_id(dept_tab, r.`last_name`))) in
      ? in
    let correct =
      let dept_id_to_dept_name =
        fun (dept_tab : [Department], dept_id : Int) ->
          let match_name = fun (r : Department) -> r.department_id == dept_id in
          let matched_tab = tfilter@<Department>(dept_tab, match_name) in
          let matched_row = get_row@<Department>(matched_tab, 0) in
          matched_row.department_name in
      let employee_to_department =
        fun (name : String, empl_tab : [Employee], dept_tab : [Department]) ->
          let match_name = fun r -> r.last_name == name in
          let matched_tab = tfilter@<Employee>(empl_tab, match_name) in
          let matched_row = get_row@<Employee>(matched_tab, 0) in
          let dept_id = matched_row.department_id in
          dept_id_to_dept_name(
            dept_tab,
            case dept_id
            | Some(dept_id) => dept_id
            | _ => ?
            end
          ) in
      test
        employee_to_department("Jones", employees, departments) == "Engineering" end in
    ? in
  ?
) in
let bench_5 = (
  type GradebookEntry = (name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int) in
  let gradebook : [GradebookEntry] = ^^fold([
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve",   13, 7, 9, 84, 8, 8, 77)
  ]) in
  
  # Version with String Columns matching API #
  let get_value = fun (r, c) -> find(to_lvs(r), fun e -> e.label == c).value in
  let dot_product = fun (t1, c1 : String, c2 : String) -> fold_left(map(t1, fun r -> (get_value(r,c1) * get_value(r, c2))), int_plus, 0) in
  ^^probe(dot_product(gradebook, "quiz1", "quiz2"))
  ;
  
  # Version using function for column access #
  let dot_product =
    typfun R -> fun (t1 : [R], c1 : R -> Int, c2 : R -> Int) -> fold_left(map(t1, fun r -> (c1(r) * c2(r))), int_plus, 0) : Int in
  let result =
    dot_product@<(name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int)>(gradebook, fun e -> e.quiz1, fun e -> e.quiz2) in
  ^^probe(result)
) in
let bench_6 = (
  let get_value = fun (r : ?, label : String) -> find(to_lvs(r),fun e ->e.label ==label).value in
  let add_rows = typfun row -> fun (r : row, rs : [row]) -> rs @ [r] in
  let add_col = fun (t : [?], c : String, vs : [?]) -> zip(t, vs) |> map(_, fun (r, v) -> from_lvs(to_lvs(r) @ [(c, v)])) in
  let remove_duplicates = fun (xs : [?]) -> fold_left(xs, fun (seen, x) -> if mem(seen, x) then seen else seen @ [x], []) in
  let build_col = fun (t : [?], c : String, f : ? -> ?) -> map(t, fun (r) -> from_lvs(to_lvs(r) @ [(c, f(r))])) in
  let empty_table : [()] = [] in
  let table_of_column =
    fun c, vs ->
      let t1 = add_rows@<?>(empty_table, map(vs, fun _ -> ())) in
      add_col(t1, c, vs) in
  let get_col = fun (t, c : String) -> map(t, fun r -> to_lvs(r) |> find(_,fun label=l, value=_v -> (l == c))).value in
  let group_by_retentive =
    fun t, c ->
      let keys = get_col(t, c) |> remove_duplicates |> table_of_column("key", _) in
      let make_group =
        fun kr ->
          let k = kr.key in
          filter(t, fun r -> get_value(r, c) == k) in
      build_col(keys, "groups", make_group) in
  
  type GradebookEntry = (name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int) in
  let gradebook : [GradebookEntry] = [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ] in
  
  group_by_retentive(gradebook, "name")
) in
let bench_7 = (
  let get_value = fun (r : ?, label : String) -> find(to_lvs(r), fun e ->e.label == label).value in
  let add_rows = typfun row -> fun (r : row, rs : [row]) -> rs @ [r] in
  let add_col = fun (t : [?], c : String, vs : [?]) -> zip(t, vs) |> map(_, fun (r, v) -> from_lvs(to_lvs(r) @ [(c, v)])) in
  let remove_duplicates = fun (xs : [?]) -> fold_left(xs, fun (seen, x) -> if mem(seen, x) then seen else seen @ [x], []) in
  let drop_columns =
    fun (t : [?], c : [String]) -> map(t, fun row -> to_lvs(row) |> filter(_, fun entry -> ! any(c, fun s -> entry.label == s)) |> from_lvs) in
  let build_col = fun (t : [?], c : String, f : ? -> ?) -> map(t, fun (r) -> from_lvs(to_lvs(r) @ [(c, f(r))])) in
  let empty_table : [()] = [] in
  let table_of_column =
    fun c, vs ->
      let t1 = add_rows@<?>(empty_table, map(vs, fun _ -> ())) in
      add_col(t1, c, vs) in
  let get_col = fun (t, c : String) -> map(t, fun r -> to_lvs(r) |> find(_, fun (label=l, value=_v) -> (l == c))).value in
  let group_by_subtractive =
    fun t, c ->
      let keys = get_col(t, c) |> remove_duplicates |> table_of_column("key", _) in
      let make_group =
        fun kr ->
          let k = kr.key in
          let g = filter(t, fun r -> get_value(r, c) == k) in
          drop_columns(g, [c]) in
      build_col(keys, "groups", make_group) in
  
  type GradebookEntry = (name = String, age = Int, quiz1 = Int, quiz2 = Int, midterm = Int, quiz3 = Int, quiz4 = Int, final = Int) in
  let gradebook : [GradebookEntry] = [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ] in
  
  group_by_subtractive(gradebook, "name")
) in
let bench_8 = (
  let fisherTest = (
    fun (xs : [Bool], ys : [Bool]) ->
      let zipped = zip(xs, ys) in
      let contigencyTable =
        fold_left(
          zipped,
          fun (
            ((a,b),(c,d)),
            e
            : (Bool, Bool)
          ) ->
            case e
            | (false, false) => ((a+1,b), (c, d))
            | (false, true) => ((a,b+1), (c, d))
            | (true, false) => ((a,b), (c + 1, d))
            | (true, true) => ((a,b), (c, d + 1))
            end,
          ((0,0), (0, 0))
        ) in
      let factorial = fun (n : Int) -> if n == 0 then 1 else n * factorial(n - 1) in
      let ((a,b), (c, d)) = contigencyTable in
      let numerator = factorial(a + b) * factorial(c + d) * factorial(a + c) * factorial(b + d) in
      let denominator = factorial(a) * factorial(b) * factorial(c) * factorial(d) * factorial(a + b + c + d) in
      float_of_int(numerator) /. float_of_int(denominator)
  ) in
  
  let pHacking =
    fun t ->
      let jelly_anon = map(t, fun r -> omit_labels(r, `get_acne`)) in
      let get_acne = t.get_acne in
      let header = to_lvs(head(jelly_anon)) |> map(_, fun e -> e.label) in
      map(header, fun c -> (c, fisherTest(get_acne, map(t, fun r -> (to_lvs(r) |> find(_, fun e -> e.label == c)).value))))
      |> filter(_, fun (_c, p) -> p <. 0.05)
      |> map(_, fun (c, _p) -> "We found a link between " ++ c ++ " jelly beans and acne (p < 0.05).") in
  
  type JellyNamed = (
    name = String,
    get_acne = Bool,
    red = Bool,
    black = Bool,
    white = Bool,
    green = Bool,
    yellow = Bool,
    brown = Bool,
    orange = Bool,
    pink = Bool,
    purple = Bool
  ) in
  let jellyNamed : [JellyNamed] = [
    ("Emily",    (true), (false), (false), (false), (true), (false), (false), (true), (false), (false)),
    ("Jacob",    (true), (false), (true), (false), (true), (true), (false), (false), (false), (false)),
    ("Emma",     (false), (false), (false), (false), (true), (false), (false), (false), (true), (false)),
    ("Aidan",    (false), (false), (false), (false), (false), (true), (false), (false), (false), (false)),
    ("Madison",  (false), (false), (false), (false), (false), (true), (false), (false), (true), (false)),
    ("Ethan",    (true), (false), (true), (false), (false), (false), (false), (true), (true), (false)),
    ("Hannah",   (false), (false), (true), (false), (false), (false), (false), (false), (true), (false)),
    ("Matthew",  (true), (false), (false), (false), (false), (false), (true), (true), (false), (false)),
    ("Hailey",   (true), (false), (false), (false), (false), (false), (false), (true), (false), (false)),
    ("Nicholas", (false), (true), (false), (false), (false), (true), (true), (false), (true), (false))
  ] in
  
  pHacking(map(jellyNamed, fun r -> omit_labels(r, `name`)))
) in
