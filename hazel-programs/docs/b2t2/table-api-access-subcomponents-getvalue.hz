# (benchmark) getValue #
let requires = [(enforced=("no"), "c is in header(r)")] in
let ensures = [
  (enforced=("live"), "v is of sort schema(r)[c]")
] in
# This is just the projection operator `.` If you use it directly you get the requires/ensures constraints #
let get_value =
  fun (r, c : String) ->
    (to_lvs(r) |> find_opt(_, fun label= l, value= v -> l == c))
    |> option_map(_, fun e -> e.value) in
# Examples #
test
  get_value((name="Bob", age=12), "name") == Some("Bob") end;
test
  get_value((name="Bob", age=12), "age") == Some(12) end;
# Using projection #
test
  (name="Bob", age=12).name == "Bob" end;
?
