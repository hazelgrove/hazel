type Student = (
  name= String,
  age= Int,
  favorite_color= String
) in
let students : [Student] = (
  [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]
) in
type GradebookEntry = (
  name= String,
  age= Int,
  quiz1= Int,
  quiz2= Int,
  midterm= Int,
  quiz3= Int,
  quiz4= Int,
  final= Int
) in
let gradebook : [GradebookEntry] = (
  [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ]
) in

# (benchmark) tuple extension (`r1 ... r2`) concatenates two rows directly. #
# The row types are unknown, so fewer constraints are guaranteed statically. #
let requires = [
  (enforced=("no"), "concat(header(t1), header(t2)) has no duplicates"),
  (enforced=("no"), "nrows(t1) is equal to nrows(t2)")
] in
let ensures = [
  (enforced=("live"), "schema(t3) is equal to concat(schema(t1), schema(t2))"),
  (enforced=("no"), "nrows(t3) is equal to nrows(t1)")
] in
let hcat =
  fun (t1 : [?], t2 : [?]) ->
    zip(t1, t2) |> map(_, fun (r1, r2) -> r1 ... r2) in
# Examples #
test
  hcat(students, gradebook)
  == (
    [
      ("Bob", 12, "blue", 8, 9, 77, 7, 9, 87),
      ("Alice", 17, "green", 6, 8, 88, 8, 7, 85),
      ("Eve", 13, "red", 7, 9, 84, 8, 8, 77)
    ]
    : (
      [
        (
          name= String,
          age= Int,
          favorite_color= String,
          quiz1= Int,
          quiz2= Int,
          midterm= Int,
          quiz3= Int,
          quiz4= Int,
          final= Int
        )
      ]
    )
  ) end;

# (idiomatic) version taking a function combining the rows. #
let requires = [
  (enforced=("no"), "concat(header(t1), header(t2)) has no duplicates"),
  (enforced=("no"), "nrows(t1) is equal to nrows(t2)")
] in
let ensures = [
  (enforced=("static"), "schema(t3) is equal to concat(schema(t1), schema(t2))"), # Assuming the higher order function provided is tuple extension #
  (enforced=("no"), "nrows(t3) is equal to nrows(t1)")
] in
let hcat =
  typfun r1 ->
    typfun r2 ->
      typfun r3 ->
        fun (t1 : [r1], t2 : [r2], combine : (r1, r2) -> r3) ->
          (zip(t1, t2) |> map(_, combine)) : [r3] in
# Examples #
test
  hcat@<Student>@<GradebookEntry>@<(
    (
      name= String,
      age= Int,
      favorite_color= String,
      quiz1= Int,
      quiz2= Int,
      midterm= Int,
      quiz3= Int,
      quiz4= Int,
      final= Int
    )
  )>(students, gradebook, fun (s, g) -> s ... g)
  == (
    [
      ("Bob", 12, "blue", 8, 9, 77, 7, 9, 87),
      ("Alice", 17, "green", 6, 8, 88, 8, 7, 85),
      ("Eve", 13, "red", 7, 9, 84, 8, 8, 77)
    ]
    : (
      [
        (
          name= String,
          age= Int,
          favorite_color= String,
          quiz1= Int,
          quiz2= Int,
          midterm= Int,
          quiz3= Int,
          quiz4= Int,
          final= Int
        )
      ]
    )
  ) end
