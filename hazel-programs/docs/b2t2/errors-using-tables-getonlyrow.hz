let tfilter = (
  typfun row ->
    fun (t1 : [row], pred : row -> Bool) -> filter(t1, pred)
) in
type Student = (
  name= String,
  age= Int,
  favorite_color= String
) in
let students : [Student] = (
  [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]
) in
let incorrect =
  # No static error. Dynamic error `undefined.favorite_color`#
  nth(tfilter@<Student>(students, fun r -> r.name == "Alice"), 1).favorite_color in
let correct =
  nth(tfilter@<Student>(students, fun r -> r.name == "Alice"), 0).favorite_color in
test
  correct == "green" end
