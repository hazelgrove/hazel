type GradebookEntry = (
  name= String,
  age= Int,
  quiz1= Int,
  quiz2= Int,
  midterm= Int,
  quiz3= Int,
  quiz4= Int,
  final= Int
) in
let gradebook : [GradebookEntry] = (
  [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ]
) in

# (benchmark) orderBy #
let requires = [] in
let ensures = [
  (enforced=("static"), "schema(r) is equal to schema(t1)"),
  (enforced=("static"), "schema(t2) is equal to schema(t1)"),
  (enforced=("no"), "nrows(t2) is equal to nrows(t1)")
] in
# order_by is benchmark-style higher-order: B2T2 itself passes each sort key as #
# a getKey function paired with a comparator. It uses only `.` projection. #
let order_by =
  typfun row ->
    fun (
      t1 : [row],
      comparators : [(get_key= row -> ?, comparator= ? -> Ord)]
    ) ->
      let compare =
        fun (a, b, comparators) ->
          case comparators
          | [] => Eq
          | (hd::tl) =>
            case hd.comparator(hd.get_key(a), hd.get_key(b))
            | Eq => compare(a, b, tl)
            | other => other
            end
          end in
      sort(compare(_,_,comparators), t1) : [row] in
test
  let average =
    fun ns -> fold_left(ns, int_plus, 0) / length(ns) in
  let midtermAndFinal =
    fun (r : GradebookEntry) -> [r.midterm, r.final] in
  let comp_int = fun a, b -> if a > b then Gt else Lt in
  let desc =
    fun f ->
      fun (a, b) ->
        case f(a, b)
        | Eq => Eq
        | Gt => Lt
        | Lt => Gt
        end in
  let compare_grade =
    fun (g1, g2) -> comp_int(average(g1), average(g2)) in
  let name_length =
    fun (r : GradebookEntry) -> string_length(r.name) in
  order_by@<GradebookEntry>(
    gradebook,
    [
      (name_length, desc(comp_int)),
      (midtermAndFinal, compare_grade)
    ]
  )
  == [
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve",   13, 7, 9, 84, 8, 8, 77),
    ("Bob", 12, 8, 9, 77, 7, 9, 87)
  ]
  : [GradebookEntry] end
