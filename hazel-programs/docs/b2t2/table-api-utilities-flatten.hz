type GradebookEntrySeq = (
  name= String,
  age= Int,
  quizzes= [Int],
  midterm= Int,
  final= Int
) in
let gradebookSeq : [GradebookEntrySeq] = (
  [
    ("Bob",   12, [8, 9, 7, 9], 77, 87),
    ("Alice", 17, [6, 8, 8, 7], 88, 85),
    ("Eve", 13, [7, 9, 8, 8], 84, 77)
  ]
) in

# (benchmark) flatten #
let requires = [
  (enforced=("no"), "cs has no duplicates"),
  (enforced=("no"), "for all c in cs, c is in header(t1)"),
  (enforced=("no"), "for all c in cs, schema(t1)[c] is Seq<X> for some sort X"),
  (enforced=("no"), "for all i in range(nrows(t1)), for all c1 and c2 in cs, length(getValue(getRow(t1, i), c1)) is equal to length(getValue(getRow(t1, i), c2))")
] in
let ensures = [
  (enforced=("live"), "header(t2) is equal to header(t1)"),
  (enforced=("live"), "for all c in header(t2) :" ++ "if c is in cs then schema(t2)[c] is equal to the element sort of schema(t1)[c]" ++ "otherwise, schema(t2)[c] is equal to schema(t1)[c]")
] in
let flatten =
  fun (t1 : [?], cs : [String]) ->
    flat_map(
      t1,
      fun r ->
        case filter(to_lvs(r), fun e -> mem(cs, e.label))
        | [] => [r] : [?]
        | e :: es =>
          fold_left(
            es,
            fun (acc, e2) ->
              zip(acc, e2.value)
              |> map(_, fun (lvs, v) -> lvs @ [(label= e2.label, value= v)]),
            map(e.value, fun v -> [(label= e.label, value= v)])
          )
          |> map(_, fun rest -> r ... from_lvs(rest))
        end
    )
    : [?] in
let expected = (
  [
    (name="Bob", age=12, quizzes=8, midterm=77, final=87),
    (name="Bob", age=12, quizzes=9, midterm=77, final=87),
    (name="Bob", age=12, quizzes=7, midterm=77, final=87),
    (name="Bob", age=12, quizzes=9, midterm=77, final=87),
    (name="Alice", age=17, quizzes=6, midterm=88, final=85),
    (name="Alice", age=17, quizzes=8, midterm=88, final=85),
    (name="Alice", age=17, quizzes=8, midterm=88, final=85),
    (name="Alice", age=17, quizzes=7, midterm=88, final=85),
    (name="Eve", age=13, quizzes=7, midterm=84, final=77),
    (name="Eve", age=13, quizzes=9, midterm=84, final=77),
    (name="Eve", age=13, quizzes=8, midterm=84, final=77),
    (name= "Eve", age= 13, quizzes= 8, midterm= 84, final= 77)
  ]
) in
test
  flatten(gradebookSeq, ["quizzes"]) == expected end;

# (idiomatic) Idiomatic way to do this #
test
  flat_map(
    gradebookSeq,
    fun r -> map(r.quizzes, fun r' -> r ... (quizzes= r'))
  )
  == expected end
