type Image = ? in
# Representing column names as projection functions for better error localization since we don't do first-class labels #
let scatter_plot
: poly row -> ([row], row -> Int, row -> Int) -> Image =
  ? in
# Using ? for the categorical variables #
let pie_chart
: poly row -> ([row], row -> ?, row -> Int) -> Image =
  ? in

let brown_get_acne =
  type JellyNamed = (
    name= String,
    get_acne= Bool,
    red= Bool,
    black= Bool,
    white= Bool,
    green= Bool,
    yellow= Bool,
    brown= Bool,
    orange= Bool,
    pink= Bool,
    purple= Bool
  ) in
  let jellyNamed : [JellyNamed] = (
    [
      ("Emily",    true, false, false, false, true, false, false, true, false, false),
      ("Jacob",    true, false, true, false, true, true, false, false, false, false),
      ("Emma",     false, false, false, false, true, false, false, false, true, false),
      ("Aidan",    false, false, false, false, false, true, false, false, false, false),
      ("Madison",  false, false, false, false, false, true, false, false, true, false),
      ("Ethan",    true, false, true, false, false, false, false, true, true, false),
      ("Hannah",   false, false, true, false, false, false, false, false, true, false),
      ("Matthew",  true, false, false, false, false, false, true, true, false, false),
      ("Hailey",   true, false, false, false, false, false, false, true, false, false),
      ("Nicholas", false, true, false, false, false, true, true, false, true, false)
    ]
  ) in
  let brown_and_get_acne =
    fun r : JellyNamed -> r.brown && r.get_acne in
  let count = (
    typfun row ->
      typfun v ->
        fun (t1 : [row], proj : row -> v) ->
          let go =
            fun (groups : [(value= v, count= Int)], row : row) ->
              case find_opt(groups, fun g -> g.value == proj(row))
              | None => (value= proj(row), count= 1) :: groups
              | Some(value=v,count=c) =>
                (value= proj(row), count= c + 1)
                :: filter(groups, fun g -> g.value != proj(row))
              end in
          fold_left(t1, go, []) : [(value= v, count= Int)]
  ) in
  let build_column
  : poly r1 ->
    poly r2 ->
      poly r3 -> ([r1], r1 -> r2, (r1, r2) -> r3) -> [r3] = (
    typfun r1 ->
      typfun r2 ->
        typfun r3 ->
          fun (table, project, build_result) ->
            map(table, fun r : r1 -> build_result(r, project(r)))
  ) in
  let incorrect =
    let brown_and_get_acne_table =
      build_column@<JellyNamed>@<Bool>@<(
        name= String,
        get_acne= Bool,
        red= Bool,
        black= Bool,
        white= Bool,
        green= Bool,
        yellow= Bool,
        brown= Bool,
        orange= Bool,
        pink= Bool,
        purple= Bool,
        part2= Bool
      )>(
        jellyNamed,
        brown_and_get_acne,
        fun (t, v) -> t ... (part2= v)
      ) in
    count@<(
      name= String,
      get_acne= Bool,
      red= Bool,
      black= Bool,
      white= Bool,
      green= Bool,
      yellow= Bool,
      brown= Bool,
      orange= Bool,
      pink= Bool,
      purple= Bool,
      part2= Bool
    )>@<Bool>(
      brown_and_get_acne_table,
      fun r -> r.`brown and get acne`
    ) in
  let correct =
    let brown_and_get_acne_table =
      build_column@<JellyNamed>@<Bool>@<(
        name= String,
        get_acne= Bool,
        red= Bool,
        black= Bool,
        white= Bool,
        green= Bool,
        yellow= Bool,
        brown= Bool,
        orange= Bool,
        pink= Bool,
        purple= Bool,
        `brown and get acne`= Bool
      )>(
        jellyNamed,
        brown_and_get_acne,
        fun (t, v) -> t ... (`brown and get acne`= v)
      ) in
    count@<(
      name= String,
      get_acne= Bool,
      red= Bool,
      black= Bool,
      white= Bool,
      green= Bool,
      yellow= Bool,
      brown= Bool,
      orange= Bool,
      pink= Bool,
      purple= Bool,
      `brown and get acne`= Bool
    )>@<Bool>(
      brown_and_get_acne_table,
      fun r -> r.`brown and get acne`
    ) in
  test
    correct
    == [(value=false, count=9), (value= true, count= 1)] end in
?
