type GradebookEntry = (
  name= String,
  age= Int,
  quiz1= Int,
  quiz2= Int,
  midterm= Int,
  quiz3= Int,
  quiz4= Int,
  final= Int
) in
let gradebook : [GradebookEntry] = (
  [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ]
) in

# (benchmark) dropColumn #
let requires = [
  (enforced=("no"), "c is in header(t1)")
] in
# This is ensured if using omit_labels #
let ensures = [
  (enforced=("no"), "nrows(t2) is equal to nrows(t1)"),
  (enforced=("live"), "header(t2) is equal to removeAll(header(t1), [c])"), # This is ensured if using omit_labels #
  (enforced=("live"), "schema(t2) is a subsequence of schema(t1)")
] in
let drop_column =
  fun (t : [?], c : String) ->
    map(
      t,
      fun row ->
        to_lvs(row)
        |> filter(_, fun entry -> entry.label != c)
        |> from_lvs
    )
    : [?] in
test
  drop_column(gradebook, "final")
  == [
    ("Bob",   12, 8, 9, 77, 7, 9),
    ("Alice", 17, 6, 8, 88, 8, 7),
    ("Eve", 13, 7, 9, 84, 8, 8)
  ]
  : (
    [
      (
        name= String,
        age= Int,
        quiz1= Int,
        quiz2= Int,
        midterm= Int,
        quiz3= Int,
        quiz4= Int
      )
    ]
  ) end;

# (idiomatic) omit_labels is a primitive operation to drop columns but without row types there's no way to give it a first-class type. This is the idiomatic way to do the operation #
test
  map(gradebook, omit_labels(_, `final`))
  == [
    ("Bob",   12, 8, 9, 77, 7, 9),
    ("Alice", 17, 6, 8, 88, 8, 7),
    ("Eve", 13, 7, 9, 84, 8, 8)
  ]
  : (
    [
      (
        name= String,
        age= Int,
        quiz1= Int,
        quiz2= Int,
        midterm= Int,
        quiz3= Int,
        quiz4= Int
      )
    ]
  ) end
