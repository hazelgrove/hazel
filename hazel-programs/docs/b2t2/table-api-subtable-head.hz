type Student = (
  name= String,
  age= Int,
  favorite_color= String
) in
let students : [Student] = (
  [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]
) in

# (benchmark) head #
let requires = [
  (enforced=("no"), "if n is non-negative then n is in range(nrows(t1))"),
  (enforced=("no"), "if n is negative then - n is in range(nrows(t1))")
] in
let ensures = [
  (enforced=("static"), "schema(t2) is equal to schema(t1)"),
  (enforced=("no"), "if n is non-negative then nrows(t2) is equal to n"),
  (enforced=("no"), "if n is negative then nrows(t2) is equal to nrows(t1) + n")
] in
let head =
  typfun r ->
    fun (t1 : [r], n : Int) ->
      take(t1, if n >= 0 then n else length(t1) + n) : [r] in
test
  head@<Student>(students, - 2) == [("Bob", 12, "blue")] : [Student] end
