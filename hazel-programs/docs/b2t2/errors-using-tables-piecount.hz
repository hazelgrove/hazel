type Image = ? in
# Using ? for the categorical variables #
let pie_chart
: poly row -> ([row], row -> ?, row -> Int) -> Image =
  ? in

type JellyAnon = (
  get_acne= Bool,
  red= Bool,
  black= Bool,
  white= Bool,
  green= Bool,
  yellow= Bool,
  brown= Bool,
  orange= Bool,
  pink= Bool,
  purple= Bool
) in
let jellyAnon : [JellyAnon] = (
  [
    (true, false, false, false, true, false, false, true, false, false),
    (true, false, true, false, true, true, false, false, false, false),
    (false, false, false, false, true, false, false, false, true, false),
    (false, false, false, false, false, true, false, false, false, false),
    (false, false, false, false, false, true, false, false, true, false),
    (true, false, true, false, false, false, false, true, true, false),
    (false, false, true, false, false, false, false, false, true, false),
    (true, false, false, false, false, false, true, true, false, false),
    (true, false, false, false, false, false, false, true, false, false),
    (false, true, false, false, false, true, true, false, true, false)
  ]
) in
let count =
  typfun row ->
    typfun v ->
      fun (t1 : [row], proj : row -> v) ->
        let go =
          fun (groups : [(value= v, count= Int)], row : row) ->
            case find_opt(groups, fun g -> g.value == proj(row))
            | None => (value= proj(row), count= 1) :: groups
            | Some(value=v,count=c) =>
              (value= proj(row), count= c + 1)
              :: filter(groups, fun g -> g.value != proj(row))
            end in
        fold_left(t1, go, []) : [(value= v, count= Int)] in
let incorrect =
  pie_chart@<(value= Bool, count= Int)>(
    count@<JellyAnon>@<Bool>(jellyAnon, fun r -> r.get_acne),
    fun r -> r.`true`,
    fun r -> r.get_acne
  ) in
let correct =
  pie_chart@<(value= Bool, count= Int)>(
    count@<JellyAnon>@<Bool>(jellyAnon, fun r -> r.get_acne),
    fun r -> r.value,
    fun r -> r.count
  ) in
?
