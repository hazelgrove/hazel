# (benchmark) pivotLonger #
let requires = [
  (enforced=("no"), "length(cs) is positive"),
  (enforced=("no"), "cs has no duplicates"),
  (enforced=("no"), "for all c in cs, c is in header(t1)"),
  (enforced=("no"), "for all c in cs, schema(t1)[c] is equal to schema(t1)[cs[0]]"),
  (enforced=("no"), "concat(removeAll(header(t1), cs), [c1, c2]) has no duplicates")
] in
let ensures = [
  (enforced=("live"), "header(t2) is equal to concat(removeAll(header(t1), cs), [c1, c2])"),
  (enforced=("live"), "for all c in removeAll(header(t1), cs), schema(t2)[c] is equal to schema(t1)[c]"),
  (enforced=("live"), "schema(t2)[c1] is equal to ColName"),
  (enforced=("live"), "schema(t2)[c2] is equal to schema(t1)[cs[0]]")
] in
let pivot_longer =
  fun (t1, cs, c1, c2) ->
    flat_map(
      t1,
      fun row ->
        let entries = to_lvs(row) in
        let pivot_entries, other_entries =
          partition(
            entries,
            fun (label= l, value= v) -> contains(cs, fun c -> l == c)
          ) in
        let rest = from_lvs(other_entries) in
        map(
          pivot_entries,
          fun (label= l, value= v) ->
            rest
            ... (from_lvs([(label=c1, value=l), (label= c2, value= v)]))
        )
    )
    : [?] in
type GradebookEntry = (
  name= String,
  age= Int,
  quiz1= Int,
  quiz2= Int,
  midterm= Int,
  quiz3= Int,
  quiz4= Int,
  final= Int
) in
let gradebook : [GradebookEntry] = (
  [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ]
) in
let expected = (
  [
    (name="Bob", age=12, quiz1=8, quiz2=9, quiz3=7, quiz4=9, exam="midterm", score=77),
    (name="Bob", age=12, quiz1=8, quiz2=9, quiz3=7, quiz4=9, exam="final", score=87),
    (name="Alice", age=17, quiz1=6, quiz2=8, quiz3=8, quiz4=7, exam="midterm", score=88),
    (name="Alice", age=17, quiz1=6, quiz2=8, quiz3=8, quiz4=7, exam="final", score=85),
    (name="Eve", age=13, quiz1=7, quiz2=9, quiz3=8, quiz4=8, exam="midterm", score=84),
    (name="Eve", age=13, quiz1=7, quiz2=9, quiz3=8, quiz4=8, exam="final", score=77)
  ]
) in
test
  pivot_longer(
    gradebook,
    ["midterm", "final"],
    "exam",
    "score"
  )
  == expected end;

# (idiomatic) The idiomatic way to do this with concrete data. Giving good type feedback#
test
  flat_map(
    gradebook,
    fun (entry : GradebookEntry) ->
      map(
        to_lvs(select_labels(entry, `midterm`, `final`)),
        fun (e : (label= String, value= Int)) ->
          omit_labels(entry, `midterm`, `final`)
          ... (exam= e.label, score= e.value)
      )
  )
  == expected end
