type Student = (
  name= String,
  age= Int,
  favorite_color= String
) in
let students : [Student] = (
  [
    ("Bob", 12, "blue"),
    ("Alice", 17, "green"),
    ("Eve", 13, "red")
  ]
) in

# (benchmark) selectRows (by indices) #
let requires = [
  (enforced=("no"), "for all n in ns, n is in range(nrows(t1))")
] in
let ensures = [
  (enforced=("static"), "schema(t2) is equal to schema(t1)"),
  (enforced=("no"), "nrows(t2) is equal to length(ns)")
] in
# We drop rows that are out of bounds #
let select_rows1 =
  typfun r ->
    fun (t1 : [r], ns : [Int]) ->
      map(ns, nth_opt(t1, _)) |> filter_map(_, fun x -> x) in
test
  select_rows1@<Student>(students, [2, 0, 2, 1])
  == [
    ("Eve", 13, "red"),
    ("Bob", 12, "blue"),
    ("Eve", 13, "red"),
    ("Alice", 17, "green")
  ]
  : [Student] end;

# (benchmark) selectRows (by bools) #
let requires = [
  (enforced=("no"), "length(bs) is equal to nrows(t1)")
] in
let ensures = [
  (enforced=("static"), "schema(t2) is equal to schema(t1)"),
  (enforced=("no"), "nrows(t2) is equal to length(ns)")
] in
let select_rows2 =
  typfun r ->
    fun (t1 : [r], bs : [Bool]) ->
      zip(bs, t1)
      |> filter_map(
        _,
        fun (b, r) -> if b then Some(r) else None
      ) in
test
  select_rows2@<Student>(students, [true, false, true])
  == [("Bob", 12, "blue"), ("Eve", 13, "red")]
  : [Student] end
