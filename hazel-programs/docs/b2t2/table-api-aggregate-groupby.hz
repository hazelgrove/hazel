type GradebookEntry = (
  name= String,
  age= Int,
  quiz1= Int,
  quiz2= Int,
  midterm= Int,
  quiz3= Int,
  quiz4= Int,
  final= Int
) in
let gradebook : [GradebookEntry] = (
  [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ]
) in

# (benchmark) groupBy #
let requires = [] in
let ensures = [
  (enforced=("static"), "schema(r1) is equal to schema(t1)"),
  (enforced=("static"), "schema(r2) is equal to schema(t1)"),
  (enforced=("static"), "schema(t2) is equal to schema(r3)"),
  (enforced=("no"), "nrows(t2) is equal to length(removeDuplicates(ks)), where ks is the results of applying key to each row of t1. ks can be defined with select and getColumn.")
] in
# group_by is benchmark-style higher-order: B2T2 itself passes the key, #
# projection, and aggregation as functions, so it needs only projection and #
# tuple construction at the callsite #
let group_by =
  typfun r1 ->
    typfun r3 ->
      typfun K ->
        typfun V ->
          fun (
            t1 : [r1],
            key : (r1 -> K),
            project : (r1 -> V),
            aggregate : ((K, [V]) -> r3)
          ) ->
            let grouped =
              fold_left(
                t1,
                (fun (
                  groups : [(K, [r1])],
                  row : r1
                ) ->
                  let k = key(row) in
                  case find_opt(groups, fun (gk, _) -> k == gk)
                  | None => (k, [row]) :: groups
                  | Some((key, rows)) =>
                    (k, row :: rows) :: filter(groups, fun (gk, _) -> k != gk)
                  end),
                []
              ) in
            map(grouped, fun (k, g) -> aggregate(k, map(g, project)))
            : [r3] in
test
  let average =
    fun ns -> fold_left(ns, int_plus, 0) / length(ns) in
  let abstract_age =
    fun (r : GradebookEntry) ->
      if r.age <= 12
      then "kid"
      else if r.age <= 18 then "teenager" else "adult" in
  group_by@<GradebookEntry>@<?>@<String>@<Int>(
    gradebook,
    abstract_age,
    fun r -> r.final,
    fun (k, vs) -> (key= k, average= average(vs))
  )
  == [
    (key="teenager", average=81),
    (key= "kid", average= 87)
  ] end
