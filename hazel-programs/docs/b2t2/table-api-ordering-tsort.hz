type GradebookEntry = (
  name= String,
  age= Int,
  quiz1= Int,
  quiz2= Int,
  midterm= Int,
  quiz3= Int,
  quiz4= Int,
  final= Int
) in
let gradebook : [GradebookEntry] = (
  [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ]
) in

# (benchmark) tsort #
let requires = [
  (enforced=("no"), "c is in header(t1)"),
  (enforced=("no"), "schema(t1)[c] is Number")
] in
let ensures = [
  (enforced=("no"), "nrows(t2) is equal to nrows(t1)"),
  (enforced=("static"), "schema(t2) is equal to schema(t1)")
] in
# Idiomatically I think we would do this with a implicit comparator on tuples and then project them #
# This could be done in a typesafe way if a function was passed to do the projection #
let get_value =
  fun (r, c : String) ->
    (to_lvs(r) |> find(_, fun (label=l, value=v) -> l == c)).value in
let tsort =
  typfun r ->
    fun (t : [?], c : String, b : Bool) ->
      let sorted =
        sort(
          fun (
            first,
            second
          ) ->
            if get_value(first, c) < get_value(second, c)
            then Lt
            else Gt,
          t
        ) in
      (if b then sorted else reverse(sorted)) : [r] in
test
  tsort@<GradebookEntry>(gradebook, "final", false)
  == [
    ("Bob",   12, 8, 9, 77, 7, 9, 87),
    ("Alice", 17, 6, 8, 88, 8, 7, 85),
    ("Eve", 13, 7, 9, 84, 8, 8, 77)
  ]
  : [GradebookEntry] end
