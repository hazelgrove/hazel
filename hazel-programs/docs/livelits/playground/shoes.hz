let shoe_style = ^^livelit(Drawing.^choice@<Shoe>(
  [("sneakers", Sneakers),
   ("boots", Boots),
   ("clown shoes", ClownShoes),
   ("bare feet", BareFeet),
   ("5 toes", FiveToes),
   ("alien 4 toes", AlienFour),
   ("alien 3 toes", AlienThree),
   ("talons", Talons)])(Sneakers)) in
let shoe_size = ^^livelit(Drawing.^slider("shoe size", 20, 310)(100)) in
let shoe_name =
  case shoe_style
  | Sneakers => "sneakers"
  | Boots => "boots"
  | ClownShoes => "clown shoes"
  | BareFeet => "bare feet"
  | FiveToes => "5 toes"
  | AlienFour => "alien 4 toes"
  | AlienThree => "alien 3 toes"
  | Talons => "talons"
  end in
# The chosen shoe, grown about its ankle by the size. #
let shoe =
  let one = Drawing.named(shoes, shoe_name) in
  case Drawing.anchor(one, "ankle")
  | Found((ax, ay)) =>
    let k = float_of_int(shoe_size) /. 100. in scaled((one, ax, ay, k, k))
  | Missing => one
  end in

# THE PICTURE #

let right_shoe = Drawing.placed(shoe, "ankle", pants, "right foot") in
let left_shoe = Drawing.placed(Drawing.mirrored(shoe), "ankle", pants, "left foot") in
let picture = right_shoe @ left_shoe @ pants in
let ^^probe(drawn) = ^^livelit(Drawing.^picture((picture = (picture)))) in

# Where the shoes' ankles ended up. #
(Drawing.anchor(right_shoe, "ankle"), Drawing.anchor(left_shoe, "ankle"))

# Press a shoe style and both feet change; slide the size and they #
# grow about their ankles. Edit a style's polygons in the shoe editor #
# and that style changes. #
