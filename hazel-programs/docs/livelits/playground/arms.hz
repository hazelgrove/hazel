let hairdo = case style | Short => "short" | Long => "long" | Curly => "curly" end in
let hair =
  Drawing.named(hairdos, hairdo) @ Drawing.named(hairdos, hairdo ++ " top") in

# THE SHOES #

# One shoe, its ankle the anchor; the left is its mirror image. #

let shoe = ^^livelit(Drawing.^polygons((
  shapes = [
    Polygon((
      name = "shoe",
      points = [
        (at = (160.0, 110.0), label = Anchor("ankle")),
        (at = (172.0, 110.0), label = Plain),
        (at = (174.0, 122.0), label = Plain),
        (at = (200.0, 126.0), label = Plain),
        (at = (204.0, 136.0), label = Plain),
        (at = (148.0, 136.0), label = Plain),
        (at = (146.0, 120.0), label = Plain)
      ],
      stroke = (width = 2.0, color = "#222222"),
      fill = "#c0392b"))
  ],
  current = 0, chosen = -1, held = false, moved = false))) in

# THE ARMS #

# Three sliders, as Messed Up Dress Up has them: the arms' angle in #
# degrees (0 is straight out, 90 straight down, -90 straight up), and #
# their length and width. #

let ^angle_dial = Drawing.^slider("arms (up / down)", -180, 180) in
let ^length_dial = Drawing.^slider("arm length", 10, 300) in
let ^width_dial = Drawing.^slider("arm width", 3, 60) in
let arm_angle = ^^livelit(^angle_dial(55)) in
let arm_length = ^^livelit(^length_dial(95)) in
let arm_width = ^^livelit(^width_dial(16)) in

let skin = "#f1c27d" in
let skin_line = (width = 2., color = "#8a5a44") in
let cloth = "#5b8bd0" in
let cloth_line = (width = 3., color = "#2b4a6f") in

# A band w wide from a to b: a rectangle, as a polygon. #
let band = fun (name, (ax, ay), (bx, by), w, stroke, fill)
    : (String, Point, Point, Float, Stroke, String) ->
  let (dx, dy) = (bx -. ax, by -. ay) in
  let d = sqrt(dx *. dx +. dy *. dy) in
  let (nx, ny) =
    if d <. 0.001 then (0., 0.) else (0. -. dy /. d *. w /. 2., dx /. d *. w /. 2.) in
  Polygon((
    name = name,
    points = [
      (at = (ax +. nx, ay +. ny), label = Plain),
      (at = (bx +. nx, by +. ny), label = Plain),
      (at = (bx -. nx, by -. ny), label = Plain),
      (at = (ax -. nx, ay -. ny), label = Plain)],
    stroke = stroke, fill = fill)) in

# A disc of radius r about c: a polygon of 20 sides. #
let ring : (Int, Point, Float) -> [Vertex] =
  fun (i, (cx, cy), r) ->
    if i == 20 then []
    else
      let t = 2. *. pi *. float_of_int(i) /. 20. in
      (at = (cx +. r *. cos(t), cy +. r *. sin(t)), label = Plain)
      :: ring((i + 1, (cx, cy), r)) in
let disc = fun (name, c, r, stroke, fill) : (String, Point, Float, Stroke, String) ->
  Polygon((name = name, points = ring((0, c, r)), stroke = stroke, fill = fill)) in

# One arm, from a shoulder: side is 1 for the right, -1 for the left. #
# It starts a little inside the shoulder, under the torso, and is four #
# layers: the arm; the shirt's sleeve over its first 38%, as Messed Up #
# Dress Up's t-shirt has it; the sleeve again without its outline, over #
# the torso's edge, so sleeve and torso join; and the hand. #
# How much of the arm its sleeve covers, by the shirt's style, as the #
# game has it: a t-shirt's 38%, long sleeves' 95%, a tank top's none. #
let sleeve = case style_worn | TShirt => 0.38 | LongSleeves => 0.95 | TankTop => 0. end in
let arm = fun (side, shoulder) : (Float, Found) ->
  case shoulder
  | Missing => ([], [], [], [])
  | Found((sx, sy)) =>
    let a = float_of_int(arm_angle) *. pi /. 180. in
    let len = float_of_int(arm_length) in
    let w = float_of_int(arm_width) in
    let (rx, ry) = (sx -. side *. 12., sy +. 12.) in
    let along = fun k : Float -> (rx +. side *. k *. len *. cos(a), ry +. k *. len *. sin(a)) in
    ([band(("arm", (rx, ry), along(1.), w, skin_line, skin))],
     (if sleeve >. 0.
      then [band(("sleeve", (rx, ry), along(sleeve), w +. 14., cloth_line, cloth))]
      else []),
     # with no sleeve, the arm's own skin joins it to the bare shoulder #
     (if sleeve >. 0.
      then [band(("sleeve", (rx, ry), along(sleeve), w +. 9., (width = 0., color = cloth), cloth))]
      else [band(("arm", (rx, ry), along(0.2), w -. 1., (width = 0., color = skin), skin))]),
     [disc(("hand", along(1.), 14., skin_line, skin))])
  end in

# THE PICTURE #

# Each piece placed by its anchor, then stacked in drawing order: the #
# neck, behind the shirt so it shows in the collar; the pants; the arms #
# and their sleeves, over the pants but under the shirt where they join #
# it; the shirt; the sleeves' fill over the shirt's edge; the hands; the #
# shoes; the back of the hair; the head; and the top of the hair. #

let neck_at = Drawing.shift(Drawing.placed(neck, "base", body, "neck"), 0., 8.) in
let head_at = Drawing.shift(Drawing.placed(head, "chin", neck_at, "top"), 0., 8.) in
let hair_at = Drawing.placed(hair, "crown", head_at, "crown") in
let right_shoe = Drawing.placed(shoe, "ankle", body, "right foot") in
let left_shoe = Drawing.placed(Drawing.mirrored(shoe), "ankle", body, "left foot") in
let (right_arm, right_sleeve, right_join, right_hand) =
  arm((1., Drawing.anchor(body, "right shoulder"))) in
let (left_arm, left_sleeve, left_join, left_hand) =
  arm((-1., Drawing.anchor(body, "left shoulder"))) in
let outfit =
  neck_at @ pants_at @ right_arm @ left_arm @ right_sleeve @ left_sleeve @ shirt
  @ right_join @ left_join @ right_hand @ left_hand
  @ right_shoe @ left_shoe @ Drawing.named(hair_at, hairdo) @ head_at
  @ Drawing.named(hair_at, hairdo ++ " top") in
let ^^probe(drawn) = ^^livelit(Drawing.^picture((picture = (outfit)))) in

# Where the crown and the shoes' ankles ended up. #
(Drawing.anchor(drawn, "crown"), Drawing.anchor(right_shoe, "ankle"),
 Drawing.anchor(left_shoe, "ankle"))

# Slide the arms' angle and they swing from the shoulders, up over #
# the head or down by the sides; slide their length and width and they #
# grow, sleeves and all. Press a shirt style and the sleeves change; #
# slide the shirt wider or taller and the arms and pants move with it. #
# The hair, neck and shoes work as before. #
