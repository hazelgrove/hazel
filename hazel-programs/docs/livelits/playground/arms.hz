  current = 0, chosen = -1, held = false, moved = false))) in

# Messed Up Dress Up's shirt controls: its style, and its width and #
# height. The style picks the torso; width and height stretch it about #
# the neck, sideways and downward, starting at the size it is drawn. #
let ^shirt_style = Drawing.^choice@<Style>(
  [("t-shirt", TShirt), ("long sleeves", LongSleeves), ("tank top", TankTop)]) in
let style_worn = ^^livelit(^shirt_style(TShirt)) in
let ^shirt_width_dial = Drawing.^slider("shirt width", 10, 120) in
let ^shirt_height_dial = Drawing.^slider("shirt height", 20, 300) in
let shirt_width = ^^livelit(^shirt_width_dial(66)) in
let shirt_height = ^^livelit(^shirt_height_dial(146)) in

# Every point x-scaled about the neck, and those below it y-scaled. #
let stretch_points : ([Vertex], Float, Float, Float, Float) -> [Vertex] =
  fun (vs, cx, cy, sx, sy) ->
    case vs
    | [] => []
    | v :: tl =>
      let (x, y) = v.at in
      (at = (cx +. (x -. cx) *. sx, if y >. cy then cy +. (y -. cy) *. sy else y),
       label = v.label)
      :: stretch_points((tl, cx, cy, sx, sy))
    end in
let stretch : (Picture, Float, Float, Float, Float) -> Picture =
  fun (pic, cx, cy, sx, sy) ->
    case pic
    | [] => []
    | sh :: tl =>
      Drawing.with_points(sh, stretch_points((Drawing.points_of(sh), cx, cy, sx, sy)))
      :: stretch((tl, cx, cy, sx, sy))
    end in

let torso =
  Drawing.named(shirts, case style_worn | TankTop => "tank" | _ => "shirt" end)
  @ Drawing.named(shirts, "stitching") in
# The drawn torso is 66 from the neck to a shoulder, and 146 from the #
# neck to the hips. #
let shirt =
  case Drawing.anchor(torso, "neck")
  | Found((cx, cy)) =>
    stretch((torso, cx, cy, float_of_int(shirt_width) /. 66.,
             float_of_int(shirt_height) /. 146.))
  | Missing => torso
  end in

let pants = ^^livelit(Drawing.^polygons((
  shapes = [
    Polygon((
      name = "pants",
      points = [
        (at = (98., 45.), label = Anchor("left hip")),
        (at = (222., 45.), label = Anchor("right hip")),
        (at = (230., 195.), label = Plain),
        (at = (202., 195.), label = Anchor("right foot")),
