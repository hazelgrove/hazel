        (at = (214., 86.), label = Plain),
        (at = (224., 104.), label = Plain),
        (at = (222., 206.), label = Anchor("right hip")),
        (at = (98., 206.), label = Anchor("left hip")),
        (at = (96., 104.), label = Plain),
        (at = (106., 86.), label = Plain),
        (at = (116., 64.), label = Plain),
        (at = (124., 40.), label = Plain)
      ],
      stroke = (width = 3., color = "#2b4a6f"),
      fill = "#5b8bd0")),
    Path((
      name = "stitching",
      points = [
        (at = (104., 194.), label = Plain),
