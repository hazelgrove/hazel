let shoe_style = ^^livelit(Drawing.^choice@<Shoe>(
  [("sneakers", Sneakers),
   ("boots", Boots),
   ("clown shoes", ClownShoes),
   ("bare feet", BareFeet),
   ("5 toes", FiveToes),
   ("alien 4 toes", AlienFour),
   ("alien 3 toes", AlienThree),
   ("talons", Talons)])(Sneakers)) in
let shoe_size = ^^livelit(Drawing.^slider("shoe size", 20, 310)(100)) in
let shoe_name =
  case shoe_style
  | Sneakers => "sneakers"
  | Boots => "boots"
  | ClownShoes => "clown shoes"
  | BareFeet => "bare feet"
  | FiveToes => "5 toes"
  | AlienFour => "alien 4 toes"
  | AlienThree => "alien 3 toes"
  | Talons => "talons"
  end in
# The chosen shoe, grown about its ankle by the size. #
let shoe =
  let one = Drawing.named(shoes, shoe_name) in
  case Drawing.anchor(one, "ankle")
  | Found((ax, ay)) =>
    let k = float_of_int(shoe_size) /. 100. in scaled((one, ax, ay, k, k))
  | Missing => one
  end in

# THE ARMS #

# Three sliders, as Messed Up Dress Up has them: the arms' angle in #
# degrees (0 is straight out, 90 straight down, -90 straight up), and #
# their length and width. #

let arm_angle = ^^livelit(Drawing.^slider("arms (up / down)", -180, 180)(55)) in
let arm_length = ^^livelit(Drawing.^slider("arm length", 10, 600)(95)) in
let arm_width = ^^livelit(Drawing.^slider("arm width", 3, 60)(16)) in

let skin = "#f1c27d" in
let skin_line = (width = 2., color = "#8a5a44") in
let cloth = "#5b8bd0" in
let cloth_line = (width = 3., color = "#2b4a6f") in

# A band w wide from a to b: a rectangle, as a polygon. #
let band = fun (name, (ax, ay), (bx, by), w, stroke, fill)
    : (String, Point, Point, Float, Stroke, String) ->
  let (dx, dy) = (bx -. ax, by -. ay) in
  let d = sqrt(dx *. dx +. dy *. dy) in
  let (nx, ny) =
    if d <. 0.001 then (0., 0.) else (0. -. dy /. d *. w /. 2., dx /. d *. w /. 2.) in
  Polygon((
    name = name,
    points = [
      (at = (ax +. nx, ay +. ny), label = Plain),
      (at = (bx +. nx, by +. ny), label = Plain),
      (at = (bx -. nx, by -. ny), label = Plain),
      (at = (ax -. nx, ay -. ny), label = Plain)],
    stroke = stroke, fill = fill)) in

# A disc of radius r about c: a polygon of 20 sides. #
let ring : (Int, Point, Float) -> [Vertex] =
  fun (i, (cx, cy), r) ->
    if i == 20 then []
    else
      let t = 2. *. pi *. float_of_int(i) /. 20. in
      (at = (cx +. r *. cos(t), cy +. r *. sin(t)), label = Plain)
      :: ring((i + 1, (cx, cy), r)) in
let disc = fun (name, c, r, stroke, fill) : (String, Point, Float, Stroke, String) ->
  Polygon((name = name, points = ring((0, c, r)), stroke = stroke, fill = fill)) in

# One arm, from a shoulder: side is 1 for the right, -1 for the left. #
# It starts a little inside the shoulder, under the torso, and is four #
# layers: the arm; the shirt's sleeve over its first 38%, as Messed Up #
# Dress Up's t-shirt has it; the sleeve again without its outline, over #
# the torso's edge, so sleeve and torso join; and the hand. #
# THE HANDS #

# Messed Up Dress Up's hand controls: the style, its size, and those #
# only some styles read -- a human hand's fingers (5 is a hand; 1 a #
# thumbs-up, 100 a fringe), an alien hand's, a star's points and how #
# far it turns toward the next one, and the claws' number and their #
# length as a percent of the usual -- and the hand's angle, about the #
# wrist, in degrees (one for every style here, where the game keeps one #
# per style). #

let hand_style = ^^livelit(Drawing.^choice@<Hand>(
  [("round", Round), ("mittens", Mittens), ("stars", Stars),
   ("claws", Claws), ("human", Human), ("alien", Alien)])(Human)) in
let hand_size = ^^livelit(Drawing.^slider("hand size", 2, 80)(14)) in
let fingers = ^^livelit(Drawing.^slider("human fingers", 1, 100)(5)) in
let alien_fingers = ^^livelit(Drawing.^slider("alien fingers", 1, 100)(3)) in
let star_count = ^^livelit(Drawing.^slider("star points", 1, 100)(5)) in
let star_turn = ^^livelit(Drawing.^slider("star turn (% to the next point)", 0, 100)(0)) in
let claw_count = ^^livelit(Drawing.^slider("claws", 1, 100)(4)) in
let claw_length = ^^livelit(Drawing.^slider("claw length", 20, 900)(100)) in
let hand_angle = ^^livelit(Drawing.^slider("hand angle", 0, 360)(0)) in


# Points around an ellipse about (cx, cy), n of them: 20 for a palm, #
# 12 for a finger's small pad. Every point is drawn on each redraw, so #
# a hand is as few as look round. #
let oval : (Float, Float, Float, Float, Int, Int) -> [Point] =
  fun (cx, cy, rx, ry, n, i) ->
    if i == n then []
    else
      let t = 2. *. pi *. float_of_int(i) /. float_of_int(n) in
      (cx +. rx *. cos(t), cy +. ry *. sin(t)) :: oval((cx, cy, rx, ry, n, i + 1)) in
let ellipse = fun (cx, cy, rx, ry) : (Float, Float, Float, Float) ->
  oval((cx, cy, rx, ry, 20, 0)) in
let pad = fun (cx, cy, r) : (Float, Float, Float) -> oval((cx, cy, r, r, 12, 0)) in

# Half a circle of radius h about (cx, cy), from angle a0, 5 points. #
let arc : (Float, Float, Float, Float, Int) -> [Point] =
  fun (cx, cy, h, a0, i) ->
    if i == 5 then []
    else
      let t = a0 +. pi *. float_of_int(i) /. 4. in
      (cx +. h *. cos(t), cy +. h *. sin(t)) :: arc((cx, cy, h, a0, i + 1)) in
# A finger: a stroke from p to q, h either side, with round ends. #
let capsule = fun ((x1, y1), (x2, y2), h) : (Point, Point, Float) ->
  let d = atan2(y2 -. y1, x2 -. x1) in
  arc((x2, y2, h, d -. pi /. 2., 0)) @ arc((x1, y1, h, d +. pi /. 2., 0)) in

# A quadratic curve from a to c, pulled toward b: 6 points on it. #
let quad : (Point, Point, Point, Int) -> [Point] =
  fun ((ax, ay), (bx, by), (cx, cy), i) ->
    if i > 5 then []
    else
      let t = float_of_int(i) /. 5. in
      let u = 1. -. t in
      (u *. u *. ax +. 2. *. u *. t *. bx +. t *. t *. cx,
       u *. u *. ay +. 2. *. u *. t *. by +. t *. t *. cy)
      :: quad(((ax, ay), (bx, by), (cx, cy), i + 1)) in

# A finger, as the game has one: its angle from straight on (degrees), #
# its length and width in units of the hand's size, a round pad at its #
# tip (0 for none), and where it starts along the palm. #
type Finger = (a = Float, len = Float, w = Float, tip = Float, base = Float) in
let finger = fun (a, len, w) : (Float, Float, Float) ->
  (a = a, len = len, w = w, tip = 0., base = 0.6) in

# A human hand of five: four fingers, the middle one longest, and a #
# thumb. #
let five : [Finger] =
  [finger((-36., 1.15, 0.25)), finger((-12., 1.35, 0.26)), finger((12., 1.25, 0.25)),
   finger((35., 1.0, 0.23)), (a = -95., len = 0.85, w = 0.28, tip = 0., base = 0.5)] in

# A human hand of n, thumb included: the n - 1 fingers fan out wider #
# the more there are, and thinner, the middle ones longest, and the #
# thumb just past the first. #
let many_fingers = fun n : Int ->
  let n = if n < 1 then 1 else if n > 100 then 100 else n in
  let k = n - 1 in
  let span =
    if k <= 1 then 0.
    else
      fmin((300., 24. *. float_of_int(if k - 1 < 3 then k - 1 else 3)
                  +. float_of_int(if k > 4 then k - 4 else 0) *. 9.)) in
  let step = if k > 1 then span /. float_of_int(k - 1) else 0. in
  let w = if k > 1 then fmax((0.05, fmin((0.26, 0.75 *. sin(step *. pi /. 360.))))) else 0.26 in
  let fan : Int -> [Finger] =
    fun i ->
      if i == k then []
      else
        let a = if k > 1 then 0. -. span /. 2. +. float_of_int(i) *. step else 0. in
        let t = if span >. 0. then fmax((a, 0. -. a)) /. (span /. 2.) else 0. in
        finger((a, 1.3 -. 0.4 *. t, w)) :: fan(i + 1) in
  fan(0) @ [(a = 0. -. fmin((span /. 2. +. 40., 175.)), len = 0.85, w = fmax((w, 0.12)),
             tip = 0., base = 0.5)] in

# An alien hand of n long, thin fingers, each with a round pad: 3 is a #
# tree frog's, and more spread wider with smaller pads. #
let alien_hand = fun n : Int ->
  let n = if n < 1 then 1 else if n > 100 then 100 else n in
  let span = if n <= 1 then 0. else fmin((330., 90. +. float_of_int(n - 3) *. 14.)) in
  let step = if n > 1 then span /. float_of_int(n - 1) else 90. in
  let half = sin(step *. pi /. 360.) in
  let w = fmax((0.018, fmin((0.2, 0.55 *. half)))) in
  let tip = fmax((0.03, fmin((0.36, 0.95 *. half)))) in
  let fan : Int -> [Finger] =
    fun i ->
      if i == n then []
      else
        let a = if n > 1 then 0. -. span /. 2. +. float_of_int(i) *. step else 0. in
        let t = if span >. 0. then fmax((a, 0. -. a)) /. (span /. 2.) else 0. in
        (a = a, len = 2.15 -. 0.3 *. t, w = w, tip = tip, base = 0.6) :: fan(i + 1) in
  fan(0) in

let skin_ink = "#8a5a44" in
let none = fun c : String -> (width = 0., color = c) in

# A hand with fingers, of size r: a palm and its fingers, each drawn #
# twice, first a little bigger in the outline's color, then in skin, #
# so palm and fingers make one shape with one outline. #
let fingered = fun (r, fs, palm) : (Float, [Finger], Float) ->
  let layer = fun (fill, grow) : (String, Float) ->
    let parts : [Finger] -> [([Point], String, Stroke)] =
      fun fs ->
        case fs
        | [] => []
        | f :: tl =>
          let t = f.a *. pi /. 180. in
          let (dx, dy) = (cos(t), sin(t)) in
          let (b, e) = (r *. f.base, r *. f.base +. r *. f.len) in
          let g = fmin((grow, r *. f.w *. 0.9)) in
          (capsule(((dx *. b, dy *. b), (dx *. e, dy *. e), r *. f.w +. g)), fill, none(fill))
          :: (if f.tip >. 0.
              then [(pad((dx *. e, dy *. e, r *. f.tip +. g)), fill, none(fill))]
              else [])
          @ parts(tl)
        end in
    (ellipse((0., 0., r *. palm *. 1.05 +. grow, r *. palm +. grow)), fill, none(fill))
    :: parts(fs) in
  layer((skin_ink, 2.5)) @ layer((skin, 0.)) in

# n hooked talons fanned out from a paw: each a curve out to a sharp #
# hook and back, wide where it leaves the paw; k is the claws' length #
# as a fraction of the usual. Up to 4 they keep the usual spacing; more #
# fan out wider, nearly all the way round at 100, and get thinner, #
# outline and all, so each still shows. #
let talons = fun (r, k, n) : (Float, Float, Int) ->
  let paw = r *. 0.7 in
  let nf = float_of_int(n) in
  let span = if n <= 4 then 118. *. (nf -. 1.) /. 3. else fmin((330., 118. +. (nf -. 4.) *. 20.)) in
  let step = if n > 1 then span /. (nf -. 1.) else 0. in
  # half a gap between neighbours, where they leave the paw #
  let room = if n > 4 then paw *. 0.8 *. sin(step *. pi /. 360.) else 1000000. in
  let line = if n > 4 then fmax((0.6, fmin((2., room *. 0.5)))) else 2. in
  let one = fun deg : Float ->
    let t = deg *. pi /. 180. in
    let (dx, dy) = (cos(t), sin(t)) in
    let len = r *. 1.4 *. k in
    let w = fmax((r *. 0.03, fmin((r *. 0.25 *. fmin((1., 0.6 +. 0.4 *. k)), room *. 1.1)))) in
    let hook = r *. 0.55 *. fmax((0.5, fmin((k, 2.)))) in
    let p = fun (along, across) : (Float, Float) ->
      (dx *. along -. dy *. across, dy *. along +. dx *. across) in
    (quad((p((paw *. 0.8, 0. -. w)), p((paw +. len *. 0.75, 0. -. w *. 0.9)), p((paw +. len, hook)), 0))
     @ quad((p((paw +. len, hook)), p((paw +. len *. 0.45, w *. 0.6)), p((paw *. 0.8, w)), 0)),
     "#f4ecd6", (width = line, color = "#5c4a2e")) in
  let fan : Int -> [([Point], String, Stroke)] =
    fun i ->
      if i == n then []
      else one(0. -. 3. -. span /. 2. +. float_of_int(i) *. step) :: fan(i + 1) in
  if n == 4 then [one(-62.), one(-22.), one(18.), one(56.)] else fan(0) in

# A star of n points, the first straight up, then turned toward the #
# next by turn (a fraction of the way there), with a dip between each #
# two; a wide gap (1 or 2 points) dips in a rounded curve, so 1 is a #
# teardrop and 2 a lens. Point i, then its dips j = 1 to dips. #
let star_points : (Float, Int, Float, Int, Int) -> [Point] =
  fun (r, n, turn, i, j) ->
    if i == n then []
    else
      let gap = 2. *. pi /. float_of_int(n) in
      let dips = if n >= 3 then 1 else if n == 2 then 2 else 5 in
      let a = 0. -. pi /. 2. +. (turn +. float_of_int(i)) *. gap in
      if j == 0 then (r *. 1.4 *. cos(a), r *. 1.4 *. sin(a)) :: star_points((r, n, turn, i, 1))
      else if j > dips then star_points((r, n, turn, i + 1, 0))
      else
        let b = a +. gap *. float_of_int(j) /. float_of_int(dips + 1) in
        (r *. 0.55 *. cos(b), r *. 0.55 *. sin(b)) :: star_points((r, n, turn, i, j + 1)) in

# A hand of size r in its own frame, as shapes with their fills and #
# outlines, by the style worn. #
let hand_shapes = fun r : Float ->
  case hand_style
  | Round => [(ellipse((0., 0., r, r)), skin, skin_line)]
  | Mittens =>
    [(ellipse((0.4 *. r, 0., 1.2 *. r, 0.85 *. r)), skin, skin_line),
     (ellipse((0.1 *. r, 0. -. 0.9 *. r, 0.35 *. r, 0.5 *. r)), skin, skin_line)]
  | Stars =>
    # many points get a thinner outline, so each still shows #
    let line = if star_count > 5 then fmax((0.6, fmin((2., pi *. r *. 0.55 /. float_of_int(star_count))))) else 2. in
    [(star_points((r, star_count, float_of_int(star_turn) /. 100., 0, 0)), skin, (width = line, color = skin_line.color))]
  | Claws =>
    talons((r, float_of_int(claw_length) /. 100., claw_count))
    @ [(ellipse((0.1 *. r, 0., 0.85 *. r, 0.8 *. r)), skin, skin_line),
       (ellipse((0. -. 0.1 *. r, 0.05 *. r, 0.32 *. r, 0.36 *. r)), "#c9966a", none("#c9966a"))]
  | Human =>
    fingered((r, if fingers == 5 then five else many_fingers(fingers), 0.75))
  | Alien => fingered((r, alien_hand(alien_fingers), 0.55))
  end in

# The hand in its own frame, made once: both arms draw the same hand, #
# turned about the wrist by the hand angle (a star turns its own points; #
# a round hand looks the same however it turns). The two walks are side #
# by side, not one inside the other: statics analyzes a recursive #
# function's body three times, so one nested in another is analyzed #
# nine times. #
let hand_turn = float_of_int(hand_angle) *. pi /. 180. in
let turn_points : [Point] -> [Point] =
  fun ps ->
    case ps
    | [] => []
    | (u, v) :: tl => (u *. cos(hand_turn) -. v *. sin(hand_turn), u *. sin(hand_turn) +. v *. cos(hand_turn)) :: turn_points(tl)
    end in
let turn_shapes : [([Point], String, Stroke)] -> [([Point], String, Stroke)] =
  fun ss ->
    case ss
    | [] => []
    | (ps, fill, stroke) :: tl => (turn_points(ps), fill, stroke) :: turn_shapes(tl)
    end in
let the_hand =
  let hand = hand_shapes(float_of_int(hand_size)) in
  case hand_style
  | Stars => hand
  | Round => hand
  | _ => if hand_angle == 0 then hand else turn_shapes(hand)
  end in

# The hand at h, the end of an arm at angle a: x in the hand's frame #
# runs along the arm, and y across it, mirrored on the left. #
let hand_at = fun (side, a, (hx, hy)) : (Float, Float, Point) ->
  let world : [Point] -> [Vertex] =
    fun ps ->
      case ps
      | [] => []
      | (u, v) :: tl =>
        (at = (hx +. u *. side *. cos(a) -. v *. side *. sin(a),
               hy +. u *. sin(a) +. v *. cos(a)),
         label = Plain)
        :: world(tl)
      end in
  let shapes : [([Point], String, Stroke)] -> Picture =
    fun ss ->
      case ss
      | [] => []
      | (ps, fill, stroke) :: tl =>
        Polygon((name = "hand", points = world(ps), stroke = stroke, fill = fill))
        :: shapes(tl)
      end in
  shapes(the_hand) in

# How much of the arm its sleeve covers, by the shirt's style, as the #
# game has it: a t-shirt's 38%, long sleeves' 95%, a tank top's none. #
let sleeve = case shirt_style | TShirt => 0.38 | LongSleeves => 0.95 | TankTop => 0. end in
let arm = fun (side, shoulder) : (Float, Found) ->
  case shoulder
  | Missing => ([], [], [], [])
  | Found((sx, sy)) =>
    let a = float_of_int(arm_angle) *. pi /. 180. in
    let len = float_of_int(arm_length) in
    let w = float_of_int(arm_width) in
    let (rx, ry) = (sx -. side *. 12., sy +. 12.) in
    let along = fun k : Float -> (rx +. side *. k *. len *. cos(a), ry +. k *. len *. sin(a)) in
    ([band(("arm", (rx, ry), along(1.), w, skin_line, skin))],
     (if sleeve >. 0.
      then [band(("sleeve", (rx, ry), along(sleeve), w +. 14., cloth_line, cloth))]
      else []),
     # with no sleeve, the arm's own skin joins it to the bare shoulder #
     (if sleeve >. 0.
      then [band(("sleeve", (rx, ry), along(sleeve), w +. 9., (width = 0., color = cloth), cloth))]
      else [band(("arm", (rx, ry), along(0.2), w -. 1., (width = 0., color = skin), skin))]),
     hand_at((side, a, along(1.))))
  end in

# The part of a raised arm in front of the face: from where it clears #
# the shirt's top, 14 above the shoulder as the game's collar is, out #
# to the hand. It is drawn again after the head, as the game draws its #
# arms over the face, with a little fill and no outline over where the #
# copy starts, so no seam shows. An arm that never rises past the #
# shirt's top has no such part. #
let arm_front = fun (side, shoulder) : (Float, Found) ->
  case shoulder
  | Missing => []
  | Found((sx, sy)) =>
    let a = float_of_int(arm_angle) *. pi /. 180. in
    let len = float_of_int(arm_length) in
    let w = float_of_int(arm_width) in
    let (rx, ry) = (sx -. side *. 12., sy +. 12.) in
    let along = fun k : Float -> (rx +. side *. k *. len *. cos(a), ry +. k *. len *. sin(a)) in
    let rise = 0. -. sin(a) *. len in
    let clear = 26. +. w /. 2. *. fabs(cos(a)) in
    if rise <=. clear then []
    else
      let k0 = clear /. rise in
      let (k_in, k_out) = (fmax((0., k0 -. 3. /. len)), fmin((1., k0 +. 3. /. len))) in
      [band(("arm", along(k0), along(1.), w, skin_line, skin)),
       band(("arm", along(k_in), along(k_out), w -. 2., (width = 0., color = skin), skin))]
      @ (if sleeve >. k0
         then
           [band(("sleeve", along(k0), along(sleeve), w +. 14., cloth_line, cloth)),
            band(("sleeve", along(k_in), along(sleeve), w +. 11., (width = 0., color = cloth), cloth))]
         else [])
  end in

# THE FACE, IN THE GAME'S UNITS #

# The game's face units on the head drawn here: its head is 160 high #
# about (100, 110.6), and this one runs from its crown to its chin. #
# (Found once: every point of the face goes through to_head.) #
let (crown_x, crown_y, face_scale) =
  case (Drawing.anchor(head, "crown"), Drawing.anchor(head, "chin"))
  | (Found((cx, cy)), Found((_, chin))) => (cx, cy, (chin -. cy) /. 160.)
  | _ => (100., 30.6, 1.)
  end in
let to_head = fun (u, v) : (Float, Float) ->
  (crown_x +. (u -. 100.) *. face_scale, crown_y +. (v -. 30.6) *. face_scale) in

# A shape made in face units, as a polygon on the head. #
let on_head : [Point] -> [Vertex] =
  fun ps ->
    case ps
    | [] => []
    | p :: tl => (at = to_head(p), label = Plain) :: on_head(tl)
    end in
let face_shape = fun (name, ps, width, ink, fill) : (String, [Point], Float, String, String) ->
  Polygon((name = name, points = on_head(ps),
           stroke = (width = width *. face_scale, color = ink), fill = fill)) in

# n points around a circle of radius r about (x, y), squashed by k top #
# to bottom and then turned by t (radians) about its middle. #
let round_eye : (Float, Float, Float, Float, Float, Int, Int) -> [Point] =
  fun (x, y, r, k, t, n, i) ->
    if i == n then []
    else
      let a = 2. *. pi *. float_of_int(i) /. float_of_int(n) in
      let (px, py) = (r *. cos(a), k *. r *. sin(a)) in
      (x +. px *. cos(t) -. py *. sin(t), y +. px *. sin(t) +. py *. cos(t))
      :: round_eye((x, y, r, k, t, n, i + 1)) in
# THE EYES #

# Messed Up Dress Up's eye controls: the style, the iris color, the #
# size, the gap between the eyes, their shape and angle, an iris and #
# eye whites around the pupil, and the shine. #

let eye_style = ^^livelit(Drawing.^choice@<EyeStyle>(
  [("plain", PlainEyes), ("stars", StarEyes), ("hearts", HeartEyes), ("x eyes", XEyes)])(PlainEyes)) in
let iris_color = ^^livelit(Drawing.^choice@<String>(
  [("blue", "#3b82f6"), ("green", "#22c55e"), ("brown", "#8b5a2b"),
   ("gray", "#9ca3af"), ("purple", "#8b5cf6")])("#3b82f6")) in
let eye_size = ^^livelit(Drawing.^slider("eye size", -35, 300)(50)) in
let eye_gap = ^^livelit(Drawing.^slider("eye gap", 0, 200)(38)) in
let eye_shape = ^^livelit(Drawing.^slider("eye shape (round / narrow)", 0, 100)(0)) in
let eye_angle = ^^livelit(Drawing.^slider("eye angle", -60, 60)(0)) in
let iris_size = ^^livelit(Drawing.^slider("iris size", 0, 150)(0)) in
let eye_whites = ^^livelit(Drawing.^slider("eye whites", 0, 150)(0)) in
let shine_size = ^^livelit(Drawing.^slider("shine size", 0, 150)(45)) in

# A star of five points, r to its points, turned by t. #
let star_eye : (Float, Float, Float, Float, Int) -> [Point] =
  fun (x, y, r, t, i) ->
    if i == 10 then []
    else
      let a = t -. pi /. 2. +. float_of_int(i) *. pi /. 5. in
      let rr = if i == 1 || i == 3 || i == 5 || i == 7 || i == 9 then r *. 0.45 else r in
      (x +. rr *. cos(a), y +. rr *. sin(a)) :: star_eye((x, y, r, t, i + 1)) in
# A heart, r across from its middle, turned by t. #
let heart_eye : (Float, Float, Float, Float, Int) -> [Point] =
  fun (x, y, r, t, i) ->
    if i == 24 then []
    else
      let a = 2. *. pi *. float_of_int(i) /. 24. in
      let s3 = sin(a) *. sin(a) *. sin(a) in
      let hx = r *. s3 in
      let hy = 0. -. r /. 16. *. (13. *. cos(a) -. 5. *. cos(2. *. a) -. 2. *. cos(3. *. a) -. cos(4. *. a)) in
      (x +. hx *. cos(t) -. hy *. sin(t), y +. hx *. sin(t) +. hy *. cos(t))
      :: heart_eye((x, y, r, t, i + 1)) in
# A stroke w wide from a to b, as a polygon. #
let stroke_eye = fun ((ax, ay), (bx, by), w) : (Point, Point, Float) ->
  let (dx, dy) = (bx -. ax, by -. ay) in
  let d = sqrt(dx *. dx +. dy *. dy) in
  let (nx, ny) = (0. -. dy /. d *. w /. 2., dx /. d *. w /. 2.) in
  [(ax +. nx, ay +. ny), (bx +. nx, by +. ny), (bx -. nx, by -. ny), (ax -. nx, ay -. ny)] in

# One eye at x, in face units, slanted by deg: the game's eye(). #
let eye = fun (x, deg) : (Float, Float) ->
  let y = 100. in
  let r = float_of_int(6 + eye_size / 7) in
  let t = deg *. pi /. 180. in
  let turn = fun (px, py) : (Float, Float) ->
    (x +. px *. cos(t) -. py *. sin(t), y +. px *. sin(t) +. py *. cos(t)) in
  case eye_style
  | XEyes =>
    [face_shape(("eye", stroke_eye((turn((0. -. r, 0. -. r)), turn((r, r)), 3. +. r /. 6.)), 0., "black", "black")),
     face_shape(("eye", stroke_eye((turn((0. -. r, r)), turn((r, 0. -. r)), 3. +. r /. 6.)), 0., "black", "black"))]
  | StarEyes => [face_shape(("eye", star_eye((x, y, r *. 1.5, t, 0)), 2., "#e0a800", "#ffcc33"))]
  | HeartEyes => [face_shape(("eye", heart_eye((x, y, r *. 1.4, t, 0)), 2., "#a01040", "#e0245e"))]
  | PlainEyes =>
    let k = 1. -. 0.88 *. float_of_int(eye_shape) /. 100. in
    let iris_r = if iris_size > 0 then r +. float_of_int(iris_size) *. 0.25 else 0. in
    let white_r =
      if iris_r >. 0. && eye_whites > 0 then iris_r +. float_of_int(eye_whites) *. 0.25 else 0. in
    let outer = if iris_r >. 0. then iris_r else r in
    # the shine: toward the light, up and to the left, in the picture's #
    # own frame, kept within half the eye #
    let (wx, wy) = (-0.3 *. outer, -0.3 *. outer) in
    let (ux, uy0) = (cos(t) *. wx +. sin(t) *. wy, (0. -. sin(t) *. wx +. cos(t) *. wy) /. k) in
    let len = sqrt(ux *. ux +. uy0 *. uy0) in
    let most = outer *. 0.55 in
    let (ux, uy) = if len >. most then (ux *. most /. len, uy0 *. most /. len) else (ux, uy0) in
    let (dx, dy) = (cos(t) *. ux -. sin(t) *. uy *. k, sin(t) *. ux +. cos(t) *. uy *. k) in
    let shine_r = fmin((r *. float_of_int(shine_size) /. 150., outer *. k *. 0.45)) in
    (if white_r >. 0. then [face_shape(("eye", round_eye((x, y, white_r, k, t, 20, 0)), 2., "black", "#ffffff"))] else [])
    @ (if iris_r >. 0. then [face_shape(("eye", round_eye((x, y, iris_r, k, t, 20, 0)), 0., iris_color, iris_color))] else [])
    @ [face_shape(("eye", round_eye((x, y, r, k, t, 16, 0)), 0., "black", "black"))]
    @ (if shine_r >. 0.3
       then [face_shape(("eye", round_eye((x +. dx, y +. dy, shine_r, 1., 0., 10, 0)), 0., "white", "white"))]
       else [])
  end in

# How far one eye reaches to either side of its middle, as drawn: a #
# plain eye's outermost ring (eye white, iris or pupil), squashed and #
# slanted; a star's or heart's points; an x's two strokes. #
let eye_half_w =
  let r = float_of_int(6 + eye_size / 7) in
  let t = float_of_int(eye_angle) *. pi /. 180. in
  case eye_style
  | XEyes => r *. (fabs(cos(t)) +. fabs(sin(t)))
  | StarEyes => r *. 1.5
  | HeartEyes => r *. 1.4
  | PlainEyes =>
    let k = 1. -. 0.88 *. float_of_int(eye_shape) /. 100. in
    let iris_r = if iris_size > 0 then r +. float_of_int(iris_size) *. 0.25 else 0. in
    let white_r =
      if iris_r >. 0. && eye_whites > 0 then iris_r +. float_of_int(eye_whites) *. 0.25 else 0. in
    let ring = if white_r >. 0. then white_r else if iris_r >. 0. then iris_r else r in
    sqrt(ring *. cos(t) *. ring *. cos(t) +. ring *. k *. sin(t) *. ring *. k *. sin(t))
  end in

# ...and how far above and below it. #
let eye_half_h =
  let r = float_of_int(6 + eye_size / 7) in
  let t = float_of_int(eye_angle) *. pi /. 180. in
  case eye_style
  | XEyes => r *. (fabs(cos(t)) +. fabs(sin(t)))
  | StarEyes => r *. 1.5
  | HeartEyes => r *. 1.4
  | PlainEyes =>
    let k = 1. -. 0.88 *. float_of_int(eye_shape) /. 100. in
    let iris_r = if iris_size > 0 then r +. float_of_int(iris_size) *. 0.25 else 0. in
    let white_r =
      if iris_r >. 0. && eye_whites > 0 then iris_r +. float_of_int(eye_whites) *. 0.25 else 0. in
    let ring = if white_r >. 0. then white_r else if iris_r >. 0. then iris_r else r in
    sqrt(ring *. sin(t) *. ring *. sin(t) +. ring *. k *. cos(t) *. ring *. k *. cos(t))
  end in

# The eyes keep the eye gap between them, edge to edge, however big, #
# narrow or slanted they are: each eye's middle is half the gap and its #
# own half-width out from the face's middle line. The default gap, 38, #
# puts the default eyes where they always were, 32 out. They are mirror #
# images: the left slants by the angle, the right by its opposite, so #
# the outer corners rise together. #
let eye_dx = float_of_int(eye_gap) /. 2. +. eye_half_w in
let eyes =
  eye((100. -. eye_dx, float_of_int(eye_angle)))
  @ eye((100. +. eye_dx, 0. -. float_of_int(eye_angle))) in

# The head, wide enough for its eyes: at the eye line it reaches 8 past #
# each eye's outer edge, or it is stretched sideways about its middle #
# until it does. Where the outline crosses that line is found edge by #
# edge, the last point joined back to the first. #
let reach_at : ([Vertex], Float, Float) -> Float =
  fun (vs, cx, y) ->
    let first = case vs | [] => (cx, y) | v :: _ => v.at end in
    let go : ([Vertex], Float) -> Float =
      fun (ws, best) ->
        case ws
        | [] => best
        | w :: tl =>
          let (x1, y1) = w.at in
          let (x2, y2) = case tl | [] => first | u :: _ => u.at end in
          if (y1 -. y) *. (y2 -. y) <=. 0. && fabs(y2 -. y1) >. 0.0001 then
            let x = x1 +. (x2 -. x1) *. (y -. y1) /. (y2 -. y1) in
            go((tl, fmax((best, fabs(x -. cx)))))
          else go((tl, best))
        end in
    go((vs, 0.)) in
let head_reach =
  case head | [] => 0. | h :: _ => reach_at((Drawing.points_of(h), crown_x, snd(to_head((100., 100.))))) end in
let head_widen =
  if head_reach >. 0. then fmax((1., (eye_dx +. eye_half_w +. 8.) *. face_scale /. head_reach)) else 1. in

# ...and tall enough, as a deep mouth makes it longer (THE MOUTH): once #
# the eyes reach 25% higher above the head's middle than the usual eyes #
# do (23.6), its top half grows with them, so the hair, which grows with #
# it, keeps its fringe above them. And the eyes stay 8 inside the outline #
# all round, which grows the bottom half too: for 24 points around the #
# eye, grown by 8, the half-height an ellipse as wide as the head needs #
# to have the point (px, py) inside it, |py| / sqrt(1 - (px / a)^2), #
# above the middle (s = -1) or below it (s = 1). In face units, of a #
# head 80 from its middle to its crown and its chin. #
let eye_need : (Float, Int) -> Float =
  fun (s, i) ->
    if i == 24 then 0.
    else
      let t = 2. *. pi *. float_of_int(i) /. 24. in
      let px = eye_dx +. (eye_half_w +. 8.) *. cos(t) in
      let py = 0. -. 10.6 +. (eye_half_h +. 8.) *. sin(t) in
      let u = fmin((0.99, fabs(px) /. (80. *. head_widen))) in
      let here = if py *. s >. 0. then fabs(py) /. sqrt(1. -. u *. u) else 0. in
      fmax((here, eye_need((s, i + 1)))) in
let head_lift =
  let forehead = 80. *. (10.6 +. eye_half_h) /. (23.6 *. 1.25) in
  fmax((0., fmax((forehead, eye_need((-1., 0)))) -. 80.)) in
let head_drop = fmax((0., eye_need((1., 0)) -. 80.)) in
let (head_cy, head_ry) = (crown_y +. 80. *. face_scale, 80. *. face_scale) in
let fit_points : [Vertex] -> [Vertex] =
  fun vs ->
    case vs
    | [] => []
    | v :: tl =>
      let (x, y) = v.at in
      let grow = if y <. head_cy then head_lift else head_drop in
      (at = (x, head_cy +. (y -. head_cy) *. (1. +. grow /. 80.)), label = v.label)
      :: fit_points(tl)
    end in
let head =
  case stretch((head, crown_x, 1000000., head_widen, 1.))
  | [] => []
  | h :: tl => Drawing.with_points(h, fit_points(Drawing.points_of(h))) :: tl
  end in

# Where the eyes reach down to, for the mouth to clear them (THE MOUTH): #
# at x, in face units, the lowest point of the right eye's outline right #
# above it -- and so of the left's, its mirror image -- or -1000 where #
# no eye is. The outline is the eye's own polygon: a plain eye's #
# outermost ring, a star's or heart's points, an x's two strokes. #
let below_poly : ([Point], Float) -> Float =
  fun (ps, x) ->
    let first = case ps | [] => (x, 0.) | p :: _ => p end in
    let go : ([Point], Float) -> Float =
      fun (qs, best) ->
        case qs
        | [] => best
        | (x1, y1) :: tl =>
          let (x2, y2) = case tl | [] => first | q :: _ => q end in
          if (x1 -. x) *. (x2 -. x) <=. 0. && fabs(x2 -. x1) >. 0.0001 then
            go((tl, fmax((best, y1 +. (y2 -. y1) *. (x -. x1) /. (x2 -. x1)))))
          else go((tl, best))
        end in
    go((ps, -1000.)) in
let eye_outlines : [[Point]] =
  let (x, y) = (100. +. eye_dx, 100.) in
  let r = float_of_int(6 + eye_size / 7) in
  let t = 0. -. float_of_int(eye_angle) *. pi /. 180. in
  let turn = fun (px, py) : (Float, Float) ->
    (x +. px *. cos(t) -. py *. sin(t), y +. px *. sin(t) +. py *. cos(t)) in
  case eye_style
  | XEyes =>
    [stroke_eye((turn((0. -. r, 0. -. r)), turn((r, r)), 3. +. r /. 6.)),
     stroke_eye((turn((0. -. r, r)), turn((r, 0. -. r)), 3. +. r /. 6.))]
  | StarEyes => [star_eye((x, y, r *. 1.5, t, 0))]
  | HeartEyes => [heart_eye((x, y, r *. 1.4, t, 0))]
  | PlainEyes =>
    let k = 1. -. 0.88 *. float_of_int(eye_shape) /. 100. in
    let iris_r = if iris_size > 0 then r +. float_of_int(iris_size) *. 0.25 else 0. in
    let white_r =
      if iris_r >. 0. && eye_whites > 0 then iris_r +. float_of_int(eye_whites) *. 0.25 else 0. in
    let ring = if white_r >. 0. then white_r else if iris_r >. 0. then iris_r else r in
    [round_eye((x, y, ring, k, t, 20, 0))]
  end in
let eye_below = fun x : Float ->
  let ax = 100. +. fabs(x -. 100.) in
  let go : [[Point]] -> Float =
    fun os -> case os | [] => -1000. | o :: tl => fmax((below_poly((o, ax)), go(tl))) end in
  go(eye_outlines) in

# THE MOUTH #

let smile = ^^livelit(Drawing.^slider("smile", -100, 200)(85)) in
let mouth_open = ^^livelit(Drawing.^slider("mouth open", 0, 300)(0)) in
let teeth = ^^livelit(Drawing.^choice@<Teeth>(
  [("normal teeth", NormalTeeth), ("spiky", SpikyTeeth), ("no teeth", NoTeeth)])(NormalTeeth)) in
let spikes = ^^livelit(Drawing.^slider("spiky teeth", 0, 15)(5)) in
let tongue = ^^livelit(Drawing.^choice@<Tongue>(
  [("tongue in", TongueIn), ("sticking out", TongueOut), ("no tongue", NoTongue)])(TongueIn)) in
let tongue_length = ^^livelit(Drawing.^slider("tongue length", 10, 300)(100)) in
let tongue_width = ^^livelit(Drawing.^slider("tongue width", 30, 250)(100)) in
let tongue_color = ^^livelit(Drawing.^choice@<String>(
  [("pink", "#e75480"), ("rose", "#ff6f91"), ("red", "#d62f4b"), ("magenta", "#c71585"),
   ("purple", "#8e44ad"), ("green", "#2ecc71"), ("blue", "#3b82f6")])("#e75480")) in
# each tongue color darkened, for its outline (the game mixes in 45% #
# black) #
let tongue_line =
  if tongue_color == "#e75480" then "#7f2e46"
  else if tongue_color == "#ff6f91" then "#8c3d50"
  else if tongue_color == "#d62f4b" then "#761a29"
  else if tongue_color == "#c71585" then "#6d0c49"
  else if tongue_color == "#8e44ad" then "#4e255f"
  else if tongue_color == "#2ecc71" then "#19703e"
  else "#204887" in


# The lips. Each is a quadratic curve from the corner (60, 150) to the #
# corner (140, 150), pulled toward a control point (100, c): a smile's #
# control is below the corners, a frown's above. #
let o = float_of_int(mouth_open) in
let q = 110. +. 0.8 *. float_of_int(smile) in
# Open, a smile's top lip flattens to a line and stops there while its #
# bottom drops; a frown's bottom flattens and its top rises. #
let (upper, lower) =
  let gap = o *. 0.4 in
  let t = fmin((1., o /. 100.)) in
  let (u, l) = if q >=. 150. then (q +. (150. -. q) *. t, q +. gap) else (q -. gap, q +. (150. -. q) *. t) in
  (fmin((u, l)), fmax((u, l))) in
# A curve's highest point is halfway between the corners and control. #
let lip_top = fun c : Float -> fmin((150., 75. +. c /. 2.)) -. 2.5 in
# An opening frown would rise into the nose's place: the mouth moves #
# down instead, by as much as its top rose. #
let rise0 = if mouth_open == 0 then 0. else fmax((0., lip_top(q) -. lip_top(upper))) in
# And big eyes close together reach down past its corners: it moves #
# down until, all along its top curve as drawn (a smile's corners, a #
# frown's middle, an open mouth's upper lip), it is 8 below the eyes #
# right above it (THE EYES), as the game does. The usual eyes never #
# move it. #
let clear_of_eyes : Int -> Float =
  fun i ->
    if i > 40 then 0.
    else
      let x = 60. +. 2. *. float_of_int(i) in
      let t = (x -. 60.) /. 80. in
      let c = if mouth_open == 0 then q else upper in
      let lip = 150. +. rise0 +. 2. *. t *. (1. -. t) *. (c -. 150.) -. 2.5 in
      fmax((eye_below(x) +. 8. -. lip, clear_of_eyes(i + 1))) in
let rise = rise0 +. clear_of_eyes(0) in
# The lip with control c, at x. #
let lip_y = fun (c, x) : (Float, Float) ->
  let t = (x -. 60.) /. 80. in
  150. +. rise +. 2. *. t *. (1. -. t) *. (c -. 150.) in
# Points along a lip from x0 to x1, n + 1 of them, each with dy added #
# and kept between the lips. #
let along_lip : (Float, Float, Float, Float, Int, Int) -> [Point] =
  fun (c, x0, x1, dy, n, i) ->
    if i > n then []
    else
      let x = x0 +. (x1 -. x0) *. float_of_int(i) /. float_of_int(n) in
      let y = lip_y((c, x)) +. dy in
      let y = if mouth_open == 0 then y else fmax((lip_y((upper, x)), fmin((lip_y((lower, x)), y)))) in
      (x, y) :: along_lip((c, x0, x1, dy, n, i + 1)) in
let reverse : [Point] -> [Point] =
  fun ps -> case ps | [] => [] | p :: tl => reverse(tl) @ [p] end in
# the lips' middles, and the mouth's depth between them #
let top = if mouth_open == 0 then 75. +. q /. 2. +. rise else 75. +. upper /. 2. +. rise in
let bottom = if mouth_open == 0 then top else 75. +. lower /. 2. +. rise in
let depth = bottom -. top in

# A tongue sticking out: a band with a round end, hanging over the #
# lower lip, and a line down its middle. #
let tongue_out =
  let w = 26. *. float_of_int(tongue_width) /. 100. in
  let len = 30. *. float_of_int(tongue_length) /. 100. in
  let r = w /. 2. in
  let y0 = if mouth_open == 0 then top -. 2. else fmax((top +. 2., bottom -. depth *. 0.4)) in
  let y1 = bottom +. len in
  let tip : Int -> [Point] =
    fun i ->
      if i > 8 then []
      else
        let a = pi *. float_of_int(i) /. 8. in
        (100. -. r *. cos(a), y1 +. r *. sin(a)) :: tip(i + 1) in
  [face_shape(("mouth", [(100. -. r, y0)] @ tip(0) @ [(100. +. r, y0)], 2., tongue_line, tongue_color)),
   Path((name = "mouth",
         points = on_head([(100., y0 +. 4.), (100., y0 +. (y1 +. r -. y0) *. 0.7)]),
         stroke = (width = 2. *. face_scale, color = tongue_line)))] in

# Spiky teeth: n triangles, along the lower lip pointing up and the #
# upper pointing down, by turns. #
let spiky : Int -> Picture =
  fun j ->
    if j > spikes then []
    else
      let d = float_of_int(spikes + 1) in
      let x = 60. +. 80. *. float_of_int(j) /. d in
      let up = j == 1 || j == 3 || j == 5 || j == 7 || j == 9 || j == 11 || j == 13 || j == 15 in
      let y = lip_y((if up then lower else upper, x)) in
      let tip = if up then y -. 10. else y +. 10. in
      face_shape(("mouth", [(x -. 6., y), (x +. 6., y), (x, tip)], 2., "black", "white"))
      :: spiky(j + 1) in

let mouth =
  let outline = along_lip((lower, 60., 140., 0., 12, 0)) @ reverse(along_lip((upper, 60., 140., 0., 12, 0))) in
  let line = fun ps : [Point] ->
    Path((name = "mouth", points = on_head(ps), stroke = (width = 5. *. face_scale, color = "black"))) in
  if mouth_open == 0 then
    (case tongue | TongueOut => tongue_out | _ => [] end)
    @ [line(along_lip((q, 60., 140., 0., 12, 0)))]
  else
    let t = fmax((3., fmin((10., depth *. 0.2)))) in
    [face_shape(("mouth", outline, 0., "#5c1a1a", "#5c1a1a"))]
    @ (if depth >. 4.
       then [face_shape(("mouth", round_eye((100., top +. depth *. 0.42, 22., depth *. 0.3 /. 22., 0., 16, 0)),
                         0., "#160606", "#160606"))]
       else [])
    @ (case tongue
       | NoTongue => []
       | _ =>
         let cy = bottom -. depth *. 0.06 in
         let ry = fmax((3., depth *. 0.34)) in
         let arc : Int -> [Point] =
           fun i ->
             if i > 10 then []
             else
               let a = pi *. float_of_int(i) /. 10. in
               let x = 100. +. 27. *. cos(a) in
               (x, fmax((lip_y((upper, x)), fmin((lip_y((lower, x)), cy -. ry *. sin(a)))))) :: arc(i + 1) in
         [face_shape(("mouth", along_lip((lower, 73., 127., 0., 8, 0)) @ arc(0), 1.5, tongue_line, tongue_color))]
       end)
    @ (case teeth
       | NormalTeeth =>
         [face_shape(("mouth", along_lip((upper, 60., 140., 0., 12, 0))
                               @ reverse(along_lip((upper, 60., 140., t, 12, 0))), 0., "white", "white")),
          face_shape(("mouth", along_lip((lower, 60., 140., 0. -. t *. 0.85, 12, 0))
                               @ reverse(along_lip((lower, 60., 140., 0., 12, 0))), 0., "white", "white"))]
       | _ => []
       end)
    @ [line(outline @ [(60., 150. +. rise)])]
    @ (case teeth | SpikyTeeth => spiky(1) | _ => [] end)
    @ (case tongue | TongueOut => tongue_out | _ => [] end) in

# A deep mouth stretches the head's lower half, as in the game: every #
# point below the head's middle moves down, more the lower it is, by as #
# much as the mouth needs below it (12 under the lower lip) or rose -- #
# less what big eyes already stretched it (THE EYES): the head takes the #
# larger of the two. #
let stretch_by =
  fmax((0., fmax((rise, bottom +. 2.5 +. 12. -. 190.6)) -. head_drop)) *. face_scale in
let (head_cy, head_ry) = (crown_y +. 80. *. face_scale, 80. *. face_scale) in
let stretch_head : [Vertex] -> [Vertex] =
  fun vs ->
    case vs
    | [] => []
    | v :: tl =>
      let (x, y) = v.at in
      (at = (x, if y >. head_cy then y +. stretch_by *. (y -. head_cy) /. head_ry else y),
       label = v.label)
      :: stretch_head(tl)
    end in
let head_shaped : Picture =
  case head
  | [] => []
  | h :: tl => Drawing.with_points(h, stretch_head(Drawing.points_of(h))) :: tl
  end in

# THE PICTURE #

# Each piece placed by its anchor, then stacked in drawing order: the #
# neck, behind the shirt so it shows in the collar; the shoes, under #
# the pants' legs; the pants; the arms and their sleeves, under the #
# shirt where they join it; the shirt; the sleeves' fill over the #
# shirt's edge; the back of the hair; the head, its eyes and mouth; the #
# top of the hair, grown with the head; then raised arms again, over #
# the face; and the hands, last, as the game draws them. #

let neck_at = Drawing.shift(Drawing.placed(neck, "base", body, "neck"), 0., 8.) in
let face_at = Drawing.shift(Drawing.placed(head_shaped @ eyes @ mouth, "chin", neck_at, "top"), 0., 8.) in
# The hair grows with the head, about the head's middle, 80 face units #
# below its crown. #
let hair_fit =
  case Drawing.anchor(hair, "crown")
  | Found((hx, hy)) =>
    scaled((hair, hx, hy +. 80. *. face_scale, head_widen, 1. +. head_lift /. 80.))
  | Missing => hair
  end in
let hair_at = Drawing.placed(hair_fit, "crown", face_at, "crown") in
let right_shoe = Drawing.placed(shoe, "ankle", body, "right foot") in
let left_shoe = Drawing.placed(Drawing.mirrored(shoe), "ankle", body, "left foot") in
let (right_arm, right_sleeve, right_join, right_hand) =
  arm((1., Drawing.anchor(body, "right shoulder"))) in
let (left_arm, left_sleeve, left_join, left_hand) =
  arm((-1., Drawing.anchor(body, "left shoulder"))) in
# The picture's box, which ^picture shows and cuts off at: tall enough #
# for the hair as the slide opens. #
let outfit =
  Drawing.frame((0., -58., 320., 400.))
  @ neck_at @ right_shoe @ left_shoe @ pants_at @ right_arm @ left_arm @ right_sleeve
  @ left_sleeve @ shirt @ right_join @ left_join
  @ Drawing.named(hair_at, hairdo_name) @ face_at
  @ Drawing.named(hair_at, hairdo_name ++ " top")
  @ arm_front((1., Drawing.anchor(body, "right shoulder")))
  @ arm_front((-1., Drawing.anchor(body, "left shoulder"))) @ right_hand @ left_hand in
let ^^probe(drawn) = ^^livelit(Drawing.^picture((picture = (skinned(outfit))))) in

# Where the crown and the shoes' ankles ended up. #
(Drawing.anchor(drawn, "crown"), Drawing.anchor(right_shoe, "ankle"),
 Drawing.anchor(left_shoe, "ankle"))

# Change anything on any slide's livelits here and the whole figure #
# follows: press a hairdo, a shirt, a hand, a shoe, an eye style; #
# slide the arms, the neck, the eyes, the smile; or move a point in #
# the shirt's, the head's, the hair's or the shoes' editor. #
