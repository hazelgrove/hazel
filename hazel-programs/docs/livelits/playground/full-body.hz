  ],
  current = 0, chosen = -1, held = false, moved = false))) in

# Messed Up Dress Up's shirt controls: its style, and its width and #
# height. The style picks the torso; width and height stretch it about #
# the neck, sideways and downward, starting at the size it is drawn. #
let shirt_style = ^^livelit(Drawing.^choice@<Style>(
  [("t-shirt", TShirt), ("long sleeves", LongSleeves), ("tank top", TankTop)])(TShirt)) in
let shirt_width = ^^livelit(Drawing.^slider("shirt width", 10, 120)(66)) in
let shirt_height = ^^livelit(Drawing.^slider("shirt height", 20, 300)(146)) in

let torso =
  Drawing.named(shirts, case shirt_style | TankTop => "tank" | _ => "shirt" end)
  @ Drawing.named(shirts, "stitching") in
# The drawn torso is 66 from the neck to a shoulder, and 146 from the #
# neck to the hips. #
let shirt =
  case Drawing.anchor(torso, "neck")
  | Found((cx, cy)) =>
    stretch((torso, cx, cy, float_of_int(shirt_width) /. 66.,
             float_of_int(shirt_height) /. 146.))
  | Missing => torso
  end in

# THE PANTS #

# They hang from the shirt's hips, and are as wide. #

let pants = ^^livelit(Drawing.^polygons((
  shapes = [
    Polygon((
      name = "pants",
      points = [
        (at = (98., 45.), label = Anchor("left hip")),
        (at = (222., 45.), label = Anchor("right hip")),
        (at = (230., 195.), label = Plain),
        (at = (202., 195.), label = Anchor("right foot")),
        (at = (174., 195.), label = Plain),
        (at = (160., 87.), label = Plain),
        (at = (146., 195.), label = Plain),
        (at = (118., 195.), label = Anchor("left foot")),
        (at = (90., 195.), label = Plain)
      ],
      stroke = (width = 3., color = "#1f2a36"),
      fill = "#34495e"))
  ],
  current = 0, chosen = -1, held = false, moved = false))) in

# The pants' hips are as wide as the shirt's, so they take its width #
# too: stretched sideways about their left hip, then hung from it, so #
# both hips meet the shirt's. #
let pants_at =
  case Drawing.anchor(pants, "left hip")
  | Found((lx, _)) =>
    Drawing.placed(
      stretch((pants, lx, 1000000., float_of_int(shirt_width) /. 66., 1.)),
      "left hip", shirt, "left hip")
  | Missing => Drawing.placed(pants, "left hip", shirt, "left hip")
  end in
let body = pants_at @ shirt in

# THE NECK #

# A rectangle as long as the slider says. Its base is the anchor that #
# goes on the shirt's neck, and its top the one the chin goes on; each #
# is in the middle of an edge. It is 16 longer than what shows: placed, #
# it moves 8 down, under the collar, and the head 8 down over its top. #

let neck_length = ^^livelit(Drawing.^slider("neck", 0, 60)(28)) in
let neck : Picture =
  let top = 0. -. float_of_int(neck_length) -. 16. in
  [Polygon((
    name = "neck",
    points = [
      (at = (-12., 0.), label = Plain),
      (at = (0., 0.), label = Anchor("base")),
      (at = (12., 0.), label = Plain),
      (at = (12., top), label = Plain),
      (at = (0., top), label = Anchor("top")),
      (at = (-12., top), label = Plain)
    ],
    stroke = (width = 2., color = "#8a5a44"),
    fill = "#f1c27d"))] in

