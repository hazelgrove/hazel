# THE SHOES #

# Messed Up Dress Up's eight feet, each drawn in the shoe editor and #
# named for its button: sneakers, boots, clown shoes, bare feet, and #
# feet with five toes, an alien's four or three, or a bird's talons. #
# Each has an ankle, an invisible point, and that is where it goes on #
# a foot. The left is the right one's mirror image. #

let shoes = ^^livelit(Drawing.^polygons((
  shapes = [
    Path((
      name = "sneakers",
      points = [(at = (34.0, 60.0), label = Anchor("ankle"))],
      stroke = (width = 0., color = "none"))),
    Polygon((
      name = "sneakers",
      points = [
        (at = (32.0, 60.0), label = Plain),
        (at = (46.0, 60.0), label = Plain),
