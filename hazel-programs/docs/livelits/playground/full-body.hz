        (at = (226., 50.), label = Anchor("right shoulder")),
        (at = (224., 104.), label = Plain),
        (at = (96., 104.), label = Plain),
        (at = (94., 50.), label = Anchor("left shoulder"))
      ],
      stroke = (width = 2., color = "#8a5a44"),
      fill = "#f1c27d")),
    Polygon((
      name = "tank",
      points = [
        (at = (140., 40.), label = Plain),
        (at = (160., 60.), label = Anchor("neck")),
        (at = (180., 40.), label = Plain),
        (at = (196., 40.), label = Plain),
