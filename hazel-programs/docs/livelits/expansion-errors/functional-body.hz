# Expansion Type Errors, Functional 2: Inside the Body #

# The body of a Functional expand is checked like any other code, #
# with m at the type Model. Here Expansion = Int and expand returns #
# string_length(m), which is an Int -- but m is an Int, and #
# string_length takes a String. The error is on m, in the #
# definition: Expecting type String but got inconsistent type Model #
# (Model, the alias m is annotated with, is Int). #

let ^count = {
  type Model = Int;
  type Action = Int;
  type Expansion = Int;
  let init = Pure(0);
  let update = fun m : Model -> fun a : Action -> Pure(m + a);
  let view = fun m : Model -> Pure(Html.text(string_of_int(m)));
  let expand = Functional(fun m : Model -> string_length(m));
  let shape = Inline(4)
} in
^^livelit(^count(3))
