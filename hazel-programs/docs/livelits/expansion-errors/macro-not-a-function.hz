# Expansion Type Errors, Macro 3: Not a Function of the Splices #

# expand lists one splice, m.a, so its code must be a function of #
# one argument. Here the code is quote 0 end, an Int, which takes #
# no argument. The error is on the use: #
#   The expansion's code has type Int, but must be a function of #
#   its splice, to Expansion = Int #

let ^zero = {
  type Model = (a = SpliceRef);
  type Action = Int;
  type Expansion = Int;
  let init =
    do a <- new_splice((IntT, Some(IntLit(1)))) in
    Pure((a = a));
  let update = fun m : Model -> fun _a : Action -> Pure(m);
  let view = fun m : Model ->
    do e <- editor((m.a, FixedWidth(6))) in
    Pure(Html.div([], [Html.text("a = "), e]));
  let expand = Macro(fun m : Model -> (quote 0 end, [m.a]));
  let shape = Inline(12)
} in
^^livelit(^zero((a = (1))))
