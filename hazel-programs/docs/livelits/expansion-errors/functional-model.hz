# Expansion Type Errors, Functional 3: The Model #

# expand's parameter is the model, so it has type Model. Here the #
# author annotated it String, where Model = Int. The error is on the #
# annotation, in the definition: Expecting type Int but got #
# inconsistent type String. #

let ^count = {
  type Model = Int;
  type Action = Int;
  type Expansion = Int;
  let init = Pure(0);
  let update = fun m : Model -> fun a : Action -> Pure(m + a);
  let view = fun m : Model -> Pure(Html.text(string_of_int(m)));
  let expand = Functional(fun m : String -> 0);
  let shape = Inline(4)
} in
^^livelit(^count(3))
