# The Expansion #

# Every livelit has a member called expand, and a type member called #
# Expansion, the type the paper has a livelit declare (Sec. 3.1). #
# Together they answer one question: what does a use of this livelit #
# MEAN to the program around it? (Sec. 2.2) #

#   let expand : + Functional(Model -> Expansion) + Macro(...) #

# It is a boundary. On one side is the MODEL: the state of the #
# widget's GUI, written into the program text so it survives #
# (Sec. 3.2.1). The paper requires a model type that serializes, so #
# no functions. This implementation does not check that: a #
# function-typed Model typechecks and runs here. #

# On the other side is the EXPANSION: what a use means. It is never #
# saved; expand rebuilds it from the model whenever it is needed #
# (Sec. 3.2.5). In the paper, expand returns it as quoted code over #
# the splices -- the Macro arm, in WHAT SPLICES CHANGE below. The #
# examples first use Functional, an addition here, which computes #
# the expansion as a value directly. #

# THE DULL CASE: EXPANSION = MODEL #

# A slider stores an Int and means that Int. expand is the identity, #
# and the livelit is a nicer way to type a number. #

#   type Model = Int;  type Expansion = Int; #
#   let expand = Functional(fun m : Model -> m) #

# BETTER: THE EXPANSION IS NOT THE MODEL #

# The Color Picker slide in this deck stores (hue, whiteness, #
# blackness) and expands to a CSS string. Client code gets the #
# string, never the triple, and never has to know the hwb geometry #
# the widget uses to read a click: #

#   type Model = (Int, Int, Int);  type Expansion = String; #
#   let expand = Functional(fun m : Model -> css(m)) #

# The GUI absorbs the domain knowledge. That is already the point of #
# the Expansion type (Sec. 2.3): a use that expands at all has that #
# type, so a client can reason about it without reading the #
# expansion or the widget (Sec. 1.2, Sec. 2.2). #

# INTERESTING: AN EXPANSION THAT IS A FUNCTION #

# Pick one color, and mean a whole RAMP of them. This livelit's #
# Expansion is a FUNCTION, Int -> Color: give it k and it adds k to #
# the whiteness of the color you picked, kept within 0 to 100. #

# The two sides do different jobs (Sec. 3.2.5). The model is the #
# GUI's state, the part the program keeps (Sec. 3.2.1): here, one #
# hwb triple the slider moves, committed back as text. The expansion #
# is what that state means to the client, and expand may compute #
# anything from it, a function included. That is where a picked #
# color becomes a family of colors. #

# And a Color is not a string. It gives one color in three #
# coordinate systems, each still numeric, so a client can compute #
# with it -- compare channels, sort by lightness, interpolate. Two #
# edge cases where the systems disagree are marked in the code. #
# Turning one into text is a separate step, further down. #

type Rgb = (r=Int, g=Int, b=Int) in
type Hsl = (h=Int, s=Int, l=Int) in
type Hwb = (h=Int, w=Int, b=Int) in
type Color = (rgb=Rgb, hsl=Hsl, hwb=Hwb) in

let ^ramp = {
  type Model = Hwb;
  type Action = Hwb;
  type Expansion = Int -> Color;

  let clamp = fun n : Int -> if n < 0 then 0 else if n > 100 then 100 else n;

  # the hue at full strength, walked around the six sectors #
  # KNOWN BUG: h = 360, the slider's top, is not wrapped to 0, so it #
  # lands in the last branch and comes out magenta, not red. The #
  # swatches paint from css, so only the expansion's rgb shows it #
  let hue_rgb = fun h : Int ->
    let sector = h / 60 in
    let up = (h - sector * 60) * 255 / 60 in
    let down = 255 - up in
    if sector == 0 then (r=255, g=up, b=0)
    else if sector == 1 then (r=down, g=255, b=0)
    else if sector == 2 then (r=0, g=255, b=up)
    else if sector == 3 then (r=0, g=down, b=255)
    else if sector == 4 then (r=up, g=0, b=255)
    else (r=255, g=0, b=down);

  # whiteness and blackness shrink the pure hue toward grey #
  let to_rgb = fun c : Hwb ->
    if c.w + c.b >= 100 then
      let grey = c.w * 255 / (c.w + c.b) in (r=grey, g=grey, b=grey)
    else
      let pure = hue_rgb(c.h) in
      let span = 100 - c.w - c.b in
      let mix = fun v : Int -> v * span / 100 + c.w * 255 / 100 in
      (r=mix(pure.r), g=mix(pure.g), b=mix(pure.b));

  # KNOWN BUG: unlike to_rgb, this misses the grey case w + b >= 100. #
  # At this slide's model, shade(k) for k of 73 or more gets a #
  # negative saturation (shade(80) has s = -66) though its rgb is grey #
  let to_hsl = fun c : Hwb ->
    let value = 100 - c.b in
    if value == 0 then (h=c.h, s=0, l=0)
    else
      let sat_v = 100 - c.w * 100 / value in
      let l = value * (200 - sat_v) / 200 in
      let edge = if l < 100 - l then l else 100 - l in
      (h=c.h, s=if edge == 0 then 0 else (value - l) * 100 / edge, l=l);

  let color = fun c : Hwb -> (rgb=to_rgb(c), hsl=to_hsl(c), hwb=c);

  # the view needs text, so it makes its own; the EXPANSION does not #
  let css = fun c : Hwb ->
    "hwb(" ++ string_of_int(c.h) ++ " "
    ++ string_of_int(c.w) ++ "% " ++ string_of_int(c.b) ++ "%)";

  let init = Pure((h=200, w=20, b=10));

  let update = fun _m : Model -> fun a : Action -> Pure(a);

  let swatch = fun c : Hwb ->
    Html.div([Attr.style([("width", "18px"), ("height", "18px"),
                          ("border", "1px solid black"),
                          ("background", css(c))])], []);

  let view = fun m : Model -> Pure(
    Html.div(
      [Attr.style([("display", "flex"), ("gap", "0.4em"),
                   ("align-items", "center")])],
      [Html.input([Attr.type_("range"), Attr.min("0"), Attr.max("360"),
                   Attr.value(string_of_int(m.h)),
                   Attr.on_input(fun s -> (h=int_of_string(s), w=m.w, b=m.b))]),
       swatch(m),
       swatch((h=m.h, w=clamp(m.w + 35), b=m.b))]));

  # not a color, and not text: a function FROM a whiteness offset #
  # TO structure #
  let expand = Functional(fun m : Model ->
    fun k : Int -> color((h=m.h, w=clamp(m.w + k), b=m.b)));

  let shape = Inline(14)
} in

# TEXT COMES LAST #

# Each coordinate system gets its own to_string, out here, where the #
# client can choose one -- or none. The expansion handed over #
# structure; these are what you reach for only once you want to LOOK #
# at it. #

let rgb_string = fun c : Rgb ->
  "rgb(" ++ string_of_int(c.r) ++ " " ++ string_of_int(c.g)
  ++ " " ++ string_of_int(c.b) ++ ")" in

let hsl_string = fun c : Hsl ->
  "hsl(" ++ string_of_int(c.h) ++ " " ++ string_of_int(c.s)
  ++ "% " ++ string_of_int(c.l) ++ "%)" in

let hwb_string = fun c : Hwb ->
  "hwb(" ++ string_of_int(c.h) ++ " " ++ string_of_int(c.w)
  ++ "% " ++ string_of_int(c.b) ++ "%)" in

# WHERE A WRONG EXPAND IS CAUGHT #

# The paper checks an expansion only at each USE (Sec. 3.2.5). This #
# implementation also checks expand at the DEFINITION, and for a #
# Functional livelit that is where every expansion error now shows #
# up -- see USE below. #

# At the DEFINITION, the module is checked against the builtin #
# `Livelit` signature with Model, Action and Expansion realized by #
# the definition's own types. So this is an error where it is #
# written, before any use exists: #

#   type Model = Bool;  type Expansion = String;        #
#   let expand = Functional(fun m : Model -> m)          #
#                                                        #
#   Expecting type String                                #
#   but got inconsistent type Model                      #

# The error marks the body, m. The expected side reads String, not #
# Expansion: the check substitutes the definition's own types into #
# the signature before comparing. Without that, Expansion would mean #
# nothing outside the module, become ?, and ? is consistent with #
# anything. The body's side keeps its own name, Model, the module's #
# alias for Bool. #

# At each USE, this implementation also checks the expansion against #
# the declared Expansion, as the paper does. For a Functional #
# livelit that check is vacuous: Functional(f) was already checked #
# against Model -> Expansion, so f(model) has type Expansion at every #
# use. The use-site check is for Macro, whose quoted expansion has a #
# type that depends on the splice list -- how many splices there are #
# and what their types are -- which the definition cannot see #
# (Sec. 3.2.5). It waits on Exp. A definition with a bad member is #
# still bound, so its uses keep resolving: each synthesizes the #
# declared Expansion. #

# Try it: the ^good livelit below type-checks. Change its Expansion #
# to String and the error appears on the DEFINITION immediately. The #
# use fails too, but for a client's reason: ^good(3) now synthesizes #
# the declared String, and + 1 wants an Int. The use-site check #
# itself stays silent. #

let ^good = {
  type Model = Int;
  type Action = Int;
  type Expansion = Int;
  let init = Pure(3);
  let update = fun _m : Model -> fun a : Action -> Pure(a);
  let view = fun m : Model ->
    Pure(Html.text(string_of_int(m)));
  let expand = Functional(fun m : Model -> m);
  let shape = Inline(3)
} in

# The use below IS a function. Drag the hue and every shade moves, #
# because they all come from the one expansion. #

# Note what the client gets to do: read a channel as a number, and #
# pick which coordinate system to render -- decisions the livelit #
# never made for it. #

let shade = ^^livelit(^ramp((h=200, w=20, b=10))) in
let mid = shade(25) in
(mid.rgb.r,
 mid.hsl.l,
 rgb_string(mid.rgb),
 hsl_string(mid.hsl),
 hwb_string(shade(50).hwb),
 ^^livelit(^good(3)) + 1)

# WHAT SPLICES CHANGE #

# THE PAPER'S DESIGN, in the types but not yet running. Everything #
# ABOVE this line works today. Its core exists on this branch as #
# TYPES -- expand's Macro arm, SpliceRef, the five splice commands -- #
# so a livelit that uses them typechecks. Little of it RUNS yet: #
# with no splice store, every splice command but editor reports "not #
# implemented", and #
# with no inhabitants of Exp, a Macro can be written but cannot #
# return. The Color (Figure 3) slide writes out the paper's own #
# example in full. #

# A splice is a region of the widget that holds the CLIENT's code #
# (Sec. 2.4.2). Not a value the widget computed: an expression the #
# client wrote, edited in place inside the GUI, and typed in the #
# client's scope. #

# The paper opens with a color livelit whose four channels are #
# splices (Sec. 1, Fig. 1b). The client binds a variable, baseline, #
# offsets green past it, and nests a slider livelit in the alpha #
# splice. In outline, with what the text does not give elided: #

#   let baseline = ... in                                   #
#   $color [r: baseline] [g: baseline + ...] [b: baseline]  #
#          [a: $percent ...]                                #

# `baseline` is the CLIENT's variable. The widget shows a color, but #
# the green channel is an expression mentioning something the widget #
# has never heard of, and alpha is another livelit. That is what #
# splices buy. #

# THE TWO KINDS OF LIVELIT #

# There is ONE signature, and `expand` is a sum. A definition picks a #
# kind by which arm it inhabits. #

#   let expand :                                            #
#     + Functional( Model -> Expansion )        (a VALUE)   #
#     + Macro( Model -> (Exp, List(SpliceRef)) )            #

# The Macro arm is the paper's (Fig. 3 l.55, Sec. 3.2.5). #

# Two things set the paper's arm apart from Functional, and the #
# second is the interesting one. #

# FIRST, the expansion becomes SYNTAX. `Exp` is quoted code, not a #
# value -- so Macro writes a program rather than computing an #
# answer. In the paper, $color's expand returns a quoted function #
# (Fig. 3 l.55-57): #

#   fun model -> (`fun r g b a -> (r, g, b, a)`,          #
#                 [model.r, model.g, model.b, model.a])   #

# SECOND, the splices come back as a LIST beside it, and the quoted #
# expression is a curried FUNCTION of them -- the paper's #
# parameterized expansion (Sec. 3.2.5). The client's four #
# expressions become the four arguments, and the result is checked #
# at each use. #

# That shape is not decoration. It is how the paper gets CAPTURE #
# AVOIDANCE (Sec. 2.4.3): a splice cannot be caught by a binding #
# inside the expansion, because it is scoped where the livelit is #
# used, not inside the expansion. It arrives as an argument, and #
# beta reduction substitutes it without capturing variables #
# (Sec. 4.2.2). Put client code that mentions `len` in a #
# splice of a livelit whose expansion happens to bind `len`, and #
# nothing goes wrong. #

# WHAT ELSE MOVES #

# The MODEL stops holding the data. Fig. 3 l.3-4 (Sec. 3.2.1): #

#   type Model = (.r SpliceRef, .g SpliceRef, #
#                 .b SpliceRef, .a SpliceRef) #

# Four references, no colors. The content lives in the splices, as #
# program text; the model only says where. Compare the Tree Care #
# slide, whose model IS the tree. #

# In the paper, init is a COMMAND, because making a splice is an #
# effect on the program: an UpdateCmd(Model) that makes its splices #
# with new_splice (Sec. 3.2.1): #

#   new_splice : (Typ, Maybe(Exp)) -> UpdateCmd(SpliceRef) #

# Here init stays a plain Model. It is pasted as text at the caret #
# when you type the name, with no evaluator to run a command, so #
# once a splice store exists a livelit's first splices will have to #
# come from a click, in update -- which does return an UpdateCmd. #
# Today neither path runs. update is also where the paper WRITES a #
# splice, as Fig. 3 does on a click (Sec. 3.2.4): #

#   set_splice : (SpliceRef, Exp) -> UpdateCmd(()) #

# Typ is a stopgap here: a closed list of base types, IntT, FloatT, #
# BoolT and StringT, in place of the paper's quoted types. A #
# SpliceRef carries no type index: the splice has a type, the handle #
# does not. And, as in the paper, no command deletes a splice: a #
# splice the model no longer refers to is garbage. #

# view already returns a COMMAND, a ViewCmd, and that is what lets it #
# RUN a splice and show a live preview of code the client wrote #
# (Sec. 3.2.3): #

#   eval_splice : SpliceRef -> ViewCmd(Maybe(Result)) #
#   type Result = Val(Exp) | Indet(Exp) #

# That Result is the paper's. With no Exp here, Val carries the value #
# itself and Indet carries nothing. view also places each splice's #
# editor, and its rendered result, with editor and result_view, both #
# taking (SpliceRef, Dim). UpdateCmd has no eval_splice, on purpose: #
# the model must not depend DIRECTLY on which closure the user has #
# selected, though the view may still emit actions that depend on a #
# result (Sec. 3.2.4). #

# Indet is the honest case: the client's expression may not reduce #
# to a value, and a widget that demands one would be lying #
# (Sec. 2.5.2). Fig. 3 disables the color preview unless all four #
# channels are values (Sec. 3.2.3). #

# And a paper livelit lists the definition-site bindings its #
# expansion may use (Sec. 3.2, Fig. 3 l.6). They are bound where the #
# livelit is defined, so its expansion is valid in any client #
# context and a client never has to supply a hidden dependency -- #
# context independence (Sec. 2.4.3). The list is explicit so that #
# private bindings do not leak to clients (Sec. 3.2.1): #

#   context { } #

# There is no context clause here. A livelit is a module and sees #
# its ordinary lexical scope, builtins included. A Functional expand #
# is a closure over that scope, so what it uses is bound at the #
# definition already. Quoted code has no closure, so the clause will #
# matter once Macro can return -- and once new_splice and set_splice #
# carry code, which the paper checks against the same context #
# (Sec. 3.2.1, Sec. 3.2.4). #

# WHERE THIS BRANCH IS #

# Matt Keenan's splices work, PR 2415, supplies the editor half: a #
# Splice form in the grammar, sub-editors that share the host's #
# zipper and statics, and a projector API for rendering them. #

# That work is merged here. SpliceRef -- the TYPE above, what the #
# Macro arm hands back -- is a builtin, and the five commands are #
# typed around it. Four parts of the paper's design are still #
# missing: a splice store, so the commands other than editor RUN #
# rather than report "not implemented"; an inhabited Exp, so Macro #
# can return and #
# set_splice has code to write; an init that runs as an UpdateCmd #
# when a use is inserted, so it can call new_splice (Sec. 3.2.1); #
# and the context clause above. Until the store exists, the #
# SpliceRef, MVP slide runs a stopgap. #
