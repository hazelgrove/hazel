# Higher-order, Functional Expansion #

# Every livelit has a member called expand, and a type member called #
# Expansion, the type the paper has a livelit declare (Sec. 3.1). #
# Together they answer one question: what does a use of this livelit #
# MEAN to the program around it? (Sec. 2.2) #

#   let expand : + Functional(Model -> Expansion) + Macro(...) #

# It is a boundary. On one side is the MODEL: the state of the #
# widget's GUI, written into the program text so it survives #
# (Sec. 3.2.1). The paper requires a model type that serializes, so #
# no functions. This implementation does not check that: a #
# function-typed Model typechecks and runs here. #

# On the other side is the EXPANSION: what a use means. It is never #
# saved; expand rebuilds it from the model whenever it is needed #
# (Sec. 3.2.5). This slide is about the Functional arm, which #
# computes the expansion as a value (Overview). The paper's Macro arm #
# returns quoted code instead: Color (Figure 3), Dynamic Row or #
# Column, and the Hygiene folder. #

# THE DULL CASE: EXPANSION = MODEL #

# A slider stores an Int and means that Int. expand is the identity, #
# and the livelit is a nicer way to type a number. #

#   type Model = Int;  type Expansion = Int; #
#   let expand = Functional(fun m : Model -> m) #

# BETTER: THE EXPANSION IS NOT THE MODEL #

# The Color Picker slide in this deck stores (hue, whiteness, #
# blackness) and expands to a CSS string. Client code gets the #
# string, never the triple, and never has to know the hwb geometry #
# the widget uses to read a click: #

#   type Model = (Int, Int, Int);  type Expansion = String; #
#   let expand = Functional(fun m : Model -> css(m)) #

# The GUI absorbs the domain knowledge, and the client reasons from #
# the Expansion type alone (Overview). #

# INTERESTING: A HIGHER-ORDER EXPANSION #

# Pick one color, and mean a whole family of them, written out in #
# whichever notation the client asks for. This livelit's Expansion is #
# a CURRIED function, #

#   Format -> Int -> String #

# Give it a format, Rgb, Hsl or Hwb, and get back a function; give #
# that an offset k, and get the color you picked with k added to its #
# whiteness (kept within 0 to 100), as text in that format: #

#   shade(Hsl)(25)  is  "hsl(200 69% 67%)" #

# A function that returns a function is higher-order, and expand #
# computes it from the model like any other expansion (Sec. 3.2.5). #
# The model is the GUI's state, the part the program keeps #
# (Sec. 3.2.1): here, one hwb triple the slider moves, committed back #
# as text. The expansion is what that state means to the client: #
# not one color but every shade of it, in every notation. #

# The format is the client's choice, made at the use, not the #
# livelit's. It is a sum type, so it is declared ABOVE the livelit: #
# a constructor is in scope only where its type is, and the client #
# names Hsl at the use. #

type Format = + Rgb + Hsl + Hwb in

type Rgb = (r=Int, g=Int, b=Int) in
type Hsl = (h=Int, s=Int, l=Int) in
type Hwb = (h=Int, w=Int, b=Int) in
type Color = (rgb=Rgb, hsl=Hsl, hwb=Hwb) in

let ^ramp = {
  type Model = Hwb;
  type Action = Hwb;
  type Expansion = Format -> Int -> String;

  let clamp = fun n : Int -> if n < 0 then 0 else if n > 100 then 100 else n;

  # the hue at full strength, walked around the six sectors #
  # KNOWN BUG: h = 360, the slider's top, is not wrapped to 0, so it #
  # lands in the last branch and comes out magenta, not red. The #
  # swatches paint from css, so only the expansion's rgb shows it #
  let hue_rgb = fun h : Int ->
    let sector = h / 60 in
    let up = (h - sector * 60) * 255 / 60 in
    let down = 255 - up in
    if sector == 0 then (r=255, g=up, b=0)
    else if sector == 1 then (r=down, g=255, b=0)
    else if sector == 2 then (r=0, g=255, b=up)
    else if sector == 3 then (r=0, g=down, b=255)
    else if sector == 4 then (r=up, g=0, b=255)
    else (r=255, g=0, b=down);

  # whiteness and blackness shrink the pure hue toward grey #
  let to_rgb = fun c : Hwb ->
    if c.w + c.b >= 100 then
      let grey = c.w * 255 / (c.w + c.b) in (r=grey, g=grey, b=grey)
    else
      let pure = hue_rgb(c.h) in
      let span = 100 - c.w - c.b in
      let mix = fun v : Int -> v * span / 100 + c.w * 255 / 100 in
      (r=mix(pure.r), g=mix(pure.g), b=mix(pure.b));

  # KNOWN BUG: unlike to_rgb, this misses the grey case w + b >= 100. #
  # At this slide's model, shade(k) for k of 73 or more gets a #
  # negative saturation (shade(80) has s = -66) though its rgb is grey #
  let to_hsl = fun c : Hwb ->
    let value = 100 - c.b in
    if value == 0 then (h=c.h, s=0, l=0)
    else
      let sat_v = 100 - c.w * 100 / value in
      let l = value * (200 - sat_v) / 200 in
      let edge = if l < 100 - l then l else 100 - l in
      (h=c.h, s=if edge == 0 then 0 else (value - l) * 100 / edge, l=l);

  let color = fun c : Hwb -> (rgb=to_rgb(c), hsl=to_hsl(c), hwb=c);

  # the view needs text, so it makes its own; the EXPANSION does not #
  let css = fun c : Hwb ->
    "hwb(" ++ string_of_int(c.h) ++ " "
    ++ string_of_int(c.w) ++ "% " ++ string_of_int(c.b) ++ "%)";

  let init = Pure((h=200, w=20, b=10));

  let update = fun _m : Model -> fun a : Action -> Pure(a);

  let swatch = fun c : Hwb ->
    Html.div([Attr.style([("width", "18px"), ("height", "18px"),
                          ("border", "1px solid black"),
                          ("background", css(c))])], []);

  let view = fun m : Model -> Pure(
    Html.div(
      [Attr.style([("display", "flex"), ("gap", "0.4em"),
                   ("align-items", "center")])],
      [Html.input([Attr.type_("range"), Attr.min("0"), Attr.max("360"),
                   Attr.value(string_of_int(m.h)),
                   Attr.on_input(fun s -> (h=int_of_string(s), w=m.w, b=m.b))]),
       swatch(m),
       swatch((h=m.h, w=clamp(m.w + 35), b=m.b))]));

  # A color in each notation. Members, not bindings outside: the #
  # definition runs in the builtin environment, so it must be closed. #
  let rgb_string = fun c : Rgb ->
    "rgb(" ++ string_of_int(c.r) ++ " " ++ string_of_int(c.g)
    ++ " " ++ string_of_int(c.b) ++ ")";
  let hsl_string = fun c : Hsl ->
    "hsl(" ++ string_of_int(c.h) ++ " " ++ string_of_int(c.s)
    ++ "% " ++ string_of_int(c.l) ++ "%)";
  let render = fun (fmt, c) : (Format, Color) ->
    case fmt
    | Rgb => rgb_string(c.rgb)
    | Hsl => hsl_string(c.hsl)
    | Hwb => css(c.hwb)
    end;

  # Curried: a format, then an offset, then text. #
  let expand = Functional(fun m : Model ->
    fun fmt : Format -> fun k : Int ->
      render((fmt, color((h=m.h, w=clamp(m.w + k), b=m.b)))));

  let shape = Inline(14)
} in

# WHERE A WRONG EXPAND IS CAUGHT #

# A Functional expand is checked at the definition, so a wrong one is #
# an ordinary type error there. Its expected side reads the #
# definition's own type, String, not Expansion, which outside the #
# module would mean nothing. Expansion Type Errors shows each kind. #

# Try it: the ^good livelit below type-checks. Change its Expansion #
# to String and the error appears on the DEFINITION immediately. The #
# use fails too, but for a client's reason: ^good(3) now synthesizes #
# the declared String, and + 1 wants an Int. The use-site check #
# itself stays silent. #

let ^good = {
  type Model = Int;
  type Action = Int;
  type Expansion = Int;
  let init = Pure(3);
  let update = fun _m : Model -> fun a : Action -> Pure(a);
  let view = fun m : Model ->
    Pure(Html.text(string_of_int(m)));
  let expand = Functional(fun m : Model -> m);
  let shape = Inline(3)
} in

# The use below IS a function, of two arguments, one at a time. Drag #
# the hue and every shade moves, in every notation, because they all #
# come from the one expansion. shade(Hsl) is itself a function, a #
# palette in one notation, which can be passed around before any #
# offset is given. #

let shade = ^^livelit(^ramp((h=200, w=20, b=10))) in
let in_hsl = shade(Hsl) in
(in_hsl(25),
 in_hsl(50),
 shade(Rgb)(25),
 shade(Hwb)(0),
 ^^livelit(^good(3)) + 1)
