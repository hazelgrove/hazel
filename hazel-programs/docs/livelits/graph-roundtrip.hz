# Graph round trip: a user-defined graph livelit edits the input, and    #
# because the livelit has a `wrap` member, every probed Graph -- the     #
# wells in the constellation panel, a probe's drawer, a type node shown  #
# as a value -- renders through the same view. Drag a node in `input`   #
# and watch `output` follow.                                             #

type Graph = ([(Int, Int)], [(Int, Int)]) in

let ^graph = {
  # (nodes, edges, selected, dragging, moved since press) #
  type Model = ([(Int, Int)], [(Int, Int)], Int, Int, Bool);
  type Action = + Down(Int, Int) + MoveTo(Int, Int) + Up + Clear;

  let init : Model =
    ([(40, 40), (150, 40), (95, 115)], [(0, 1), (1, 2)], -1, -1, false);

  let len(xs: [(Int, Int)]): Int =
    case xs
    | [] => 0
    | _ :: tl => 1 + len(tl)
    end;

  # index of the node within 16px of (x, y), or -1 #
  let near(nodes: [(Int, Int)], x: Int, y: Int, i: Int): Int =
    case nodes
    | [] => -1
    | (nx, ny) :: tl =>
      let dx = nx - x in
      let dy = ny - y in
      if dx * dx + dy * dy <= 256 then i else near(tl, x, y, i + 1)
    end;

  let pick(xs: [(Int, Int)], i: Int): (Int, Int) =
    case xs
    | [] => (0, 0)
    | hd :: tl => if i <= 0 then hd else pick(tl, i - 1)
    end;

  let set_at(xs: [(Int, Int)], i: Int, p: (Int, Int)): [(Int, Int)] =
    case xs
    | [] => []
    | hd :: tl => if i <= 0 then p :: tl else hd :: set_at(tl, i - 1, p)
    end;

  let has_edge(edges: [(Int, Int)], e: (Int, Int)): Bool =
    case edges
    | [] => false
    | hd :: tl => hd == e || has_edge(tl, e)
    end;

  let update(m: Model, a: Action): Model =
    let (nodes, edges, sel, drag, moved) = m in
    case a
    | Clear => ([], [], -1, -1, false)
    | Down(x, y) =>
      let hit = near(nodes, x, y, 0) in
      if hit == -1 then (nodes @ [(x, y)], edges, sel, len(nodes), true)
      else (nodes, edges, sel, hit, false)
    | MoveTo(x, y) =>
      if drag == -1 then m
      else if moved then (set_at(nodes, drag, (x, y)), edges, sel, drag, true)
      else
        let (nx, ny) = pick(nodes, drag) in
        let dx = nx - x in
        let dy = ny - y in
        if dx * dx + dy * dy > 16
        then (set_at(nodes, drag, (x, y)), edges, sel, drag, true)
        else m
    | Up =>
      if drag == -1 then m
      else if moved then (nodes, edges, sel, -1, false)
      else if sel == -1 then (nodes, edges, drag, -1, false)
      else if sel == drag then (nodes, edges, -1, -1, false)
      else
        let e = if sel < drag then (sel, drag) else (drag, sel) in
        if has_edge(edges, e) then (nodes, edges, -1, -1, false)
        else (nodes, edges @ [e], -1, -1, false)
    end;

  let dot((x, y): (Int, Int), i: Int, sel: Int): HTML =
    Node("circle",
      [Create("cx", string_of_int(x)), Create("cy", string_of_int(y)),
       Create("r", "10"), Create("fill", if i == sel then "coral" else "teal")],
      []);

  let line_of(nodes: [(Int, Int)], (a, b): (Int, Int)): HTML =
    let (x1, y1) = pick(nodes, a) in
    let (x2, y2) = pick(nodes, b) in
    Node("line",
      [Create("x1", string_of_int(x1)), Create("y1", string_of_int(y1)),
       Create("x2", string_of_int(x2)), Create("y2", string_of_int(y2)),
       Create("stroke", "#888"), Create("stroke-width", "2")],
      []);

  let dots(nodes: [(Int, Int)], sel: Int): HTML =
    Node("g", [], mapi(nodes, fun (i: Int, p: (Int, Int)) -> dot(p, i, sel)));

  let lines(nodes: [(Int, Int)], edges: [(Int, Int)]): HTML =
    Node("g", [], map(edges, fun (e: (Int, Int)) -> line_of(nodes, e)));

  let view(m: Model): HTML =
    let (nodes, edges, sel, _, _) = m in
    Div([], [
      Node("svg",
        [Create("viewBox", "0 0 200 150"), Width("200"), Height("150"),
         Style([("border", "1px solid #ccc"), ("background", "#fafafa")]),
         OnMouseDownAt(fun (x: Int, y: Int) -> Down(x, y)),
         OnMouseMoveAt(fun (x: Int, y: Int) -> MoveTo(x, y)),
         OnMouseUpAt(fun _ -> Up)],
        [lines(nodes, edges), dots(nodes, sel)]),
      Div([], [
        Button([OnClick(Clear)], [Text("clear")]),
        Text(string_of_int(len(nodes)) ++ " nodes, "
             ++ string_of_int(len(edges)) ++ " edges")])
    ]);

  # a display model for any Graph value (nothing selected or dragged) #
  let wrap(g: Graph): Model =
    let (nodes, edges) = g in
    (nodes, edges, -1, -1, false);

  let expand(m: Model): Graph =
    let (nodes, edges, _, _, _) = m in
    (nodes, edges);

  let shape : LivelitShape = Block(32, 8)
} in

# Mirror every node across the vertical midline of the 200x150 canvas #
let mirror(g: Graph): Graph =
  let (nodes, edges) = g in
  (map(nodes, fun (x: Int, y: Int) -> (200 - x, y)), edges)
in

# Connect every node to the next one, making a chain #
let chain(g: Graph): Graph =
  let (nodes, _) = g in
  let seq(i: Int): [(Int, Int)] =
    if i + 1 >= length(nodes) then [] else (i, i + 1) :: seq(i + 1)
  in
  (nodes, seq(0))
in

let input : Graph =
  ^^livelit(^graph(([(30, 30), (100, 90), (170, 30)], [(0, 1), (1, 2)], -1, -1, false)))
in
let output : Graph = ^^probe(mirror(chain(input))) in

test mirror(([(30, 30)], [])) == ([(170, 30)], []) end;
test chain(([(0, 0), (1, 1), (2, 2)], []))
     == ([(0, 0), (1, 1), (2, 2)], [(0, 1), (1, 2)]) end;
test output != input end;

output
