# Define a Slider #

# A number you drag, expanding to that number: ^pct, a module #
# checked against the Livelit signature from the Overview. This #
# slide goes through it one member at a time, the paper's type for #
# each beside the type here, and ends by adding two uses as Ints. #

# Three types declare the interface; Expansion is the one clients #
# see (Overview). #

# Model:     the state a use carries, persisted in the program #
#            (Sec. 3.2.1), written as the use's argument, ^pct(25). #
#            A parameter is given differently: see Parameters #
# Action:    what the GUI emits (Sec. 3.2.2) #
# Expansion: what a use MEANS to the program (Sec. 3.1) #

# init:   UpdateCmd(Model), the command that answers the model a #
#         fresh use starts with; the same in the paper (Sec. 3.2.1). #
#         It runs when you type ^pct then a space, and the new use's #
#         text is the model it answers #
# update: Model -> Action -> UpdateCmd(Model), curried, run when #
#         the GUI acts; the same in the paper (Sec. 3.2.4) #
# view:   the paper's is Model -> ViewCmd(Html(Action)) (Sec. 3.2.3); #
#         here it is Model -> ViewCmd(Html.T), and its handlers #
#         still emit Actions #
# expand: Functional, Model -> Expansion, checked at the #
#         definition. A number needs no program written for it; the #
#         paper's Macro arm returns one (Overview, Color (Figure 3)) #

# init is a COMMAND, and update and view return commands. Pure(x) is #
# the command that answers x and does nothing else; a slider makes no #
# splices, so all three answer with Pure. None is annotated with its #
# command type: Hazel cannot write an applied type like #
# UpdateCmd(Model), so the member's expected type supplies it. The #
# Overview slide says more. #

let ^pct = {
  type Model = Int;
  type Action = Int;
  type Expansion = Int;

  let init = Pure(50);

  let update = fun _m : Model -> fun a : Action -> Pure(a);

  let view = fun m : Model -> Pure(
    Html.div(
      [Attr.style([("display", "flex"), ("gap", "0.5em"),
              ("align-items", "center"),
              ("font-family", "var(--code-font)"),
              ("font-size", "0.8em")])],
      [
        Html.input([
          Attr.type_("range"), Attr.min("0"), Attr.max("100"),
          Attr.value(string_of_int(m)),
          Attr.on_input(fun s -> int_of_string(s))
        ]),
        Html.text(string_of_int(m) ++ "%")
      ]
    ));

  let expand = Functional(fun m : Model -> m);

  let shape = Inline(20)
} in

# Each use below carries its own model, stored right here in the #
# text. Drag a slider: each `input` event on the way only re-renders #
# the widget, so its label moves but nothing is written to the text. #
# Let go, and the `change` event commits: the argument in the text #
# becomes the new value, and the sum changes with it -- the program #
# means what each model expands to (Sec. 2.2). #

^^livelit(^pct(25)) + ^^livelit(^pct(75))
