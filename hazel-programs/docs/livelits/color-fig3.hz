# Color: the Paper's Figure 3, Rebuilt #

# Figure 3 of the paper -- Omar et al., Filling Typed Holes with Live #
# GUIs, PLDI 2021 -- defines $color, and Sec. 3.1 through 3.2.5 walk #
# through it member by member. This slide is that same definition in #
# this implementation, written to follow the figure as closely as the #
# language allows. Each piece is tagged "Fig. 3 l.N" with the line of #
# the figure it corresponds to, so the paper can sit open beside it. #

# All of it runs, expand included: each use means the quoted function #
# of Fig. 3 l.56 applied to that use's four splices, so the value at #
# the bottom of this program is the color the sliders make. #

# THE EXPANSION #

# Figure 3's expand (l.55-57) is a MACRO: it returns a quoted #
# function together with the four splices to apply it to. That is #
# the paper's expand member (Sec. 3.2.5, formalized in Sec. 4.2.2): #
# the use's meaning is that function applied to the client's #
# splices. It never sees them as Exp -- it treats them #
# parametrically -- and applying it to them is what keeps them #
# capture-avoiding (Sec. 2.4.3). The paper writes the quotation in #
# backticks; here it is quote ... end, and the function is curried #
# by hand, since fun r g b a is not a curried function here. #

# init makes the four splices (l.8-13), the view reads and places #
# them (l.18-44), and a click writes them (l.46-53). The #
# paper's starting code is the quoted `0`; here it is IntLit(0), an #
# Exp constructor, which needs no quotation. #

# Fig. 3 l.1 -- the expansion type. The paper spells labeled fields #
# .r Int; here they are r = Int. #
type Color = (r = Int, g = Int, b = Int, a = Int) in

# Fig. 3 l.2 -- the declaration, livelit $color at Color, which gives #
# the name and the expansion type (Sec. 3.1). There is no separate #
# declaration form here: the name is the caret binding, and "at Color" #
# is the Expansion member. #
let ^color = {
  type Expansion = Color;

  # Fig. 3 l.3-4 -- the model is four SpliceRefs, one per channel. The #
  # model holds HANDLES to the client's code. Here a ref also carries #
  # the value its code had in the last run: that is what eval_splice #
  # reads. update could take the value out too, which Sec. 3.2.4 means #
  # to prevent; making SpliceRef abstract is later work. #
  type Model = (r = SpliceRef, g = SpliceRef, b = SpliceRef, a = SpliceRef);

  # Fig. 3 l.6 -- context { }, the definition-site context (Sec. 3.2). #
  # There is no context clause here, and nothing checks what a #
  # definition refers to. By convention a definition is closed: its #
  # helpers are its own members, and builtins like Html and #
  # string_of_int are in scope. That matters because init and update #
  # run in the editor -- init when a use is made, update at each #
  # event -- where only the builtins are in scope. #

  # Fig. 3 l.15-16 -- the one action: the reader clicked a color. #
  type Action = + ClickOn(Color);

  # Fig. 3 l.8-13 -- init, a COMMAND: an UpdateCmd(Model) that makes #
  # four splices with new_splice and answers their refs (Sec. 3.2.1). #
  # r, g and b start at 0, a at 100. It runs when a use is created: #
  # type ^color and a space. The paper's starting code is the quoted #
  # `0`; here it is IntLit(0), an Exp constructor, which needs no #
  # quotation. `Int` is IntT, which new_splice takes and does not keep #
  # yet: a splice is typed only by where it sits. return is Pure. #
  let init =
    do r <- new_splice(IntT, Some(IntLit(0))) in
    do g <- new_splice(IntT, Some(IntLit(0))) in
    do b <- new_splice(IntT, Some(IntLit(0))) in
    do a <- new_splice(IntT, Some(IntLit(100))) in
    Pure((r, g, b, a));

  # Fig. 3 l.18-44 -- view, a function that returns a ViewCmd #
  # (Sec. 3.2.3). This part follows the figure closely: the do block #
  # is the paper's own notation (Sec. 3). #
  let view = fun model : Model ->
    # Fig. 3 l.20-24 -- determine a color to display, by evaluating #
    # each channel's splice (Sec. 3.2.3). #
    do r_res <- eval_splice(model.r) in
    do g_res <- eval_splice(model.g) in
    do b_res <- eval_splice(model.b) in
    do a_res <- eval_splice(model.a) in
    # Fig. 3 l.25-35 -- all four must be values to make a color. The #
    # paper matches Some(Val(IntLit(r))): its results are values AS #
    # SYNTAX, an Exp. Here Val carries the value itself, not syntax, #
    # so the pattern is Some(Val(r)). Anything else -- a splice that is #
    # still a hole, say -- gives no color (Sec. 2.5.2). #
    let cur_color =
      case (r_res, g_res, b_res, a_res)
      | (Some(Val(r)), Some(Val(g)), Some(Val(b)), Some(Val(a))) =>
        Some((r, g, b, a))
      | _ => None
      end
    in
    # Fig. 3 l.37-42 -- one editor per splice, each FixedWidth(20), the #
    # constructor the figure uses (Sec. 3.2.3). #
    let size = FixedWidth(20) in
    do r_editor <- editor((model.r, size)) in
    do g_editor <- editor((model.g, size)) in
    do b_editor <- editor((model.b, size)) in
    do a_editor <- editor((model.a, size)) in
    # Fig. 3 l.44 -- the paper elides the rendering. Here: a swatch of #
    # the current color, shown as X when it is indeterminate (l.33), #
    # the four editors, and a few colors to click. #
    let swatch =
      case cur_color
      | Some((r, g, b, a)) =>
        Html.div(
          [Attr.style([
             ("width", "28px"), ("height", "28px"),
             ("border", "1px solid #888"),
             ("background",
              "rgb(" ++ string_of_int(r) ++ " " ++ string_of_int(g) ++ " "
              ++ string_of_int(b) ++ " / " ++ string_of_int(a) ++ "%)")])],
          [])
      | _ =>
        Html.div(
          [Attr.style([("width", "28px"), ("height", "28px"),
                       ("border", "1px solid #888"),
                       ("text-align", "center")])],
          [Html.text("X")])
      end
    in
    let channel = fun (label, ed) ->
      Html.div([Attr.style([("display", "flex"), ("gap", "4px")])],
        [Html.text(label), ed])
    in
    let pick = fun (label, c) ->
      Html.button([Attr.on_click(ClickOn(c))], [Html.text(label)])
    in
    Pure(
      Html.div([Attr.style([("display", "flex"), ("gap", "8px")])],
        [swatch,
         Html.div([],
           [channel(("r", r_editor)), channel(("g", g_editor)),
            channel(("b", b_editor)), channel(("a", a_editor))]),
         Html.div([],
           [pick(("red", (r = 255, g = 0, b = 0, a = 100))),
            pick(("teal", (r = 0, g = 128, b = 128, a = 100))),
            pick(("clear", (r = 0, g = 0, b = 0, a = 0)))])]));

  # Fig. 3 l.46-53 -- update, a function that returns an UpdateCmd #
  # (Sec. 3.2.4). A click OVERWRITES the four splices with the clicked #
  # color: the livelit writes into the client's code, which is exactly #
  # what set_splice is for. The paper's pattern fun model (ClickOn c) #
  # is a case here, and each set_splice binds its () answer to _. #
  let update = fun model : Model -> fun a : Action ->
    case a
    | ClickOn(c) =>
      # Fig. 3 l.49-52 -- IntLit(c.r) is a number as SYNTAX, an Exp. #
      do _ <- set_splice((model.r, IntLit(c.r))) in
      do _ <- set_splice((model.g, IntLit(c.g))) in
      do _ <- set_splice((model.b, IntLit(c.b))) in
      do _ <- set_splice((model.a, IntLit(c.a))) in
      # Fig. 3 l.53 -- return model. In the paper the model is the same #
      # four refs, and what changes is the code they point at. #
      Pure(model)
    end;

  # Fig. 3 l.55-57 -- expand, the MACRO. The paper hands back a quoted #
  # curried function and the splice list to apply it to: #
  #   (`fun r g b a -> (r, g, b, a)`, #
  #    [model.r, model.g, model.b, model.a]) #
  # The quotation is closed: it names only its own parameters. Each use #
  # means it applied to that use's four splices, in the list's order, #
  # and is checked there against Int -> Int -> Int -> Int -> Color. #
  let expand =
    Macro(fun model : Model ->
      (quote fun r -> fun g -> fun b -> fun a -> (r, g, b, a) end,
       [model.r, model.g, model.b, model.a]));

  let shape = Block(40, 5)
} in

# COMPOSITION #

# A splice is the client's own code, in the client's scope #
# (Sec. 2.4.2-2.4.3), so it can name the client's variables, and those #
# can come from livelits of their own. ^byte is a slider from 0 to #
# 255, defined here; alpha, a percentage, uses the builtin slider. #
# Drag one and let go: the program runs again, and ^color's view #
# reads the new value of the splice that names it (eval_splice). #
# Clicking a color still overwrites all four splices (l.46-53), and #
# they then hold numbers, not these variables: set_splice rewrites #
# the client's code. #

let ^byte = {
  type Model = Int;
  type Action = Int;
  type Expansion = Int;
  let init = Pure(0);
  let update = fun _m : Model -> fun a : Action -> Pure(a);
  let view = fun m : Model -> Pure(
    Html.div(
      [Attr.style([("display", "flex"), ("gap", "0.5em"),
                   ("align-items", "center"),
                   ("font-family", "var(--code-font)"),
                   ("font-size", "0.8em")])],
      [Html.input([
         Attr.type_("range"), Attr.min("0"), Attr.max("255"),
         Attr.value(string_of_int(m)),
         Attr.on_input(fun s -> int_of_string(s))]),
       Html.text(string_of_int(m))]));
  let expand = Functional(fun m : Model -> m);
  let shape = Inline(20)
} in

let red = ^^livelit(^byte(255)) in
let green = ^^livelit(^byte(140)) in
let blue = ^^livelit(^byte(0)) in
let alpha = ^^slider(100) in

# A use, as saved. Its model is four splices, each in parens where #
# its ref sits: that is how the program text keeps what new_splice #
# made. Here each one holds a variable, bound by a slider above. #
^^livelit(^color((r = (red), g = (green), b = (blue), a = (alpha))))
