# A Color Picker Livelit #

# Click the gradient square to pick; the slider sets the hue. The #
# model (Sec. 3.2.1) is (hue, whiteness, blackness), and the #
# expansion (Sec. 2.2) is a CSS hwb() string. The square IS the hwb #
# space: a white-to-hue wash under a black veil, so the pixel under #
# the pointer is the color the click math computes, give or take a #
# percent: it works in whole pixels and whole percents. Clicking the #
# dot itself can move the color by a percent. #

# The paper's own color livelit -- rebuilt on the Color (Figure 3) #
# slide -- keeps each channel as a splice, a region of the client's #
# code inside the widget (Sec. 2.4.2), and its expand returns quoted #
# code over them (Sec. 3.2.5). This one keeps three plain numbers and #
# expands with Functional, straight to the String. It uses no splice #
# commands, so all of it runs today; view and update answer with Pure. #

# The helpers -- css, pick, dot_x, dot_y -- are ordinary members of #
# the module; view and expand call them like any other function. #

let ^hwb = {
  type Model = (Int, Int, Int);
  type Action = Model;
  type Expansion = String;

  let css = fun (h, w, b) : Model ->
    "hwb(" ++ string_of_int(h) ++ " "
    ++ string_of_int(w) ++ "% "
    ++ string_of_int(b) ++ "%)";

  # field geometry: 150 x 92 px; y scales to blackness #
  let pick = fun (h, x, y) ->
    let b = y * 100 / 92 in
    (h, (150 - x) * (100 - b) / 150, b);

  let dot_x = fun (w, b) ->
    if b == 100 then 0 else 150 - 150 * w / (100 - b);

  let dot_y = fun b -> b * 92 / 100;

  let init = Pure((160, 25, 10));

  let update = fun _m : Model -> fun a : Action -> Pure(a);

  let view = fun (h, w, b) : Model -> Pure(
    Html.div(
      [Attr.style([("display", "flex"), ("flex-direction", "column"),
              ("gap", "0.35em"),
              ("font-family", "var(--code-font)"),
              ("font-size", "0.75em"), ("padding", "2px")])],
      [
        Html.div(
          [Attr.style([("width", "150px"), ("height", "92px"),
                  ("position", "relative"),
                  ("cursor", "crosshair"),
                  ("border-radius", "3px"),
                  ("background",
                   "linear-gradient(to top, #000, transparent), "
                   ++ "linear-gradient(to right, #fff, hsl("
                   ++ string_of_int(h) ++ " 100% 50%))")]),
           Attr.on_click_at(fun (x, y) -> pick((h, x, y)))],
          [
            Html.div(
              [Attr.style([("position", "absolute"),
                      ("left",
                       string_of_int(dot_x((w, b)) - 4) ++ "px"),
                      ("top", string_of_int(dot_y(b) - 4) ++ "px"),
                      ("width", "8px"), ("height", "8px"),
                      ("border-radius", "50%"),
                      ("border", "2px solid #fff"),
                      ("box-shadow", "0 0 2px #000"),
                      ("pointer-events", "none")])],
              []
            )
          ]
        ),
        Html.div(
          [Attr.style([("display", "flex"), ("gap", "0.5em"),
                  ("align-items", "center")])],
          [
            Html.div(
              [Attr.style([("width", "26px"), ("height", "14px"),
                      ("border-radius", "7px"),
                      ("border", "1px solid var(--BR1)"),
                      ("background", css((h, w, b)))])],
              []
            ),
            Html.input([
              Attr.type_("range"), Attr.min("0"), Attr.max("359"),
              Attr.value(string_of_int(h)),
              Attr.on_input(fun s -> (int_of_string(s), w, b)),
              Attr.style([("width", "118px"), ("margin", "0"),
                     ("background",
                      "linear-gradient(to right, #f00, #ff0, #0f0, "
                      ++ "#0ff, #00f, #f0f, #f00)")])
            ])
          ]
        )
      ]
    ));

  let expand = Functional(fun m : Model -> css(m));

  let shape = Tab(16, 5)
} in

# Two uses, each keeping its own color in its argument: the model #
# lives in the program text (Sec. 3.2.1). A pick commits the new #
# model value there, and so does letting go of the hue slider; while #
# it moves, the widget only previews. #

(^^livelit(^hwb(160, 25, 10)), ^^livelit(^hwb(280, 5, 40)))
