# A Color Picker Livelit #

# Click the gradient square to pick; the slider sets the hue. The #
# model is (hue, whiteness, blackness) and the expansion is a CSS #
# hwb() string. The square IS the hwb space: a white-to-hue wash #
# under a black veil, so the click math reads the color exactly. #

let ^hwb = {
  type Model = (Int, Int, Int);
  type Action = Model;

  let css((h, w, b): Model): String =
    "hwb(" ++ string_of_int(h) ++ " "
    ++ string_of_int(w) ++ "% "
    ++ string_of_int(b) ++ "%)";

  # field geometry: 150 x 92 px; y scales to blackness #
  let pick(h: Int, x: Int, y: Int): Model =
    let b = y * 100 / 92 in
    (h, (150 - x) * (100 - b) / 150, b);

  let min(a: Int, b: Int): Int = if a < b then a else b;
  let max(a: Int, b: Int): Int = if a > b then a else b;

  let dot_x(w: Int, b: Int): Int =
    if b == 100 then 0 else 150 - 150 * w / (100 - b);

  let dot_y(b: Int): Int = b * 92 / 100;

  let init : Model = (160, 25, 10);

  let update(_m: Model, a: Action): Model = a;

  let view((h, w, b): Model): HTML =
    Div([Class("color-picker-view livelit-bleed"), Create("title", css((h, w, b))), Style([("display", "flex"), ("flex-direction", "column"),
          ("width", "150px"), ("background", "#555"),
          ("font-family", "ui-monospace, Menlo, monospace"), ("font-size", "10px")])],
      [Div([Style([("width", "150px"), ("height", "92px"), ("position", "relative"), ("cursor", "crosshair"),
                    ("background", "linear-gradient(to top, #000, transparent), linear-gradient(to right, #fff, hsl(" ++ string_of_int(h) ++ " 100% 50%))")]),
             OnClickAt(fun (x: Int, y: Int) -> pick(h, x, y))],
        [Div([Style([("position", "absolute"), ("left", string_of_int(max(0, min(136, dot_x(w, b) - 7))) ++ "px"),
                      ("top", string_of_int(max(0, min(80, dot_y(b) - 6))) ++ "px"), ("width", "14px"), ("height", "12px"), ("background", css((h, w, b))),
                      ("box-sizing", "border-box"), ("border-radius", "2px"), ("border", "1px solid #fff"),
                      ("box-shadow", "0 0 0 1px #0008"), ("pointer-events", "none")])], [])]),
       Input([Class("livelit-hue"), Type("range"), Min("0"), Max("359"), Value(string_of_int(h)),
              Create("aria-label", "Hue"), OnInput(fun (s: String) -> (int_of_string(s), w, b)),
              Style([("width", "150px"), ("height", "16px"), ("margin", "1px 0 0"),
                     ("background", "linear-gradient(to right, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00)")])])]);

  let expand(m: Model): String = css(m);

  let shape : LivelitShape = Tab(16, 5)
} in

# Two picks, each with its own color stored in its argument: #

(^^livelit(^hwb(160, 25, 10)), ^^livelit(^hwb(280, 5, 40)))
