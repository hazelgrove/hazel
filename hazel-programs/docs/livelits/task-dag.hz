# Task Plan: tasks with durations, arrows for "must finish first".    #
# Drag a task to move it. Click a task to select it (orange); then    #
# click another task to add or remove the arrow between them, or      #
# click the selected task again to bump its days (1..5). Click empty  #
# space to deselect; "+ task" adds one. A use expands to              #
# Plan(tasks, deps); `schedule` finds the earliest start of each task  #
# and which ones are critical, and `gantt` draws that as a chart.     #

type Plan = + Plan([(String, Int)], [(Int, Int)]) in
type Schedule = + Schedule([(String, Int, Int, Bool)]) in

let ^plan = {
  # (tasks as (name, days, x, y), deps as (before, after), selected, dragging, moved) #
  type Model = ([(String, Int, Int, Int)], [(Int, Int)], Int, Int, Bool);
  type Action = + Down(Int, Int) + MoveTo(Int, Int) + Up + Add;
  let init : Model =
    ([("A", 2, 40, 40), ("B", 3, 120, 30), ("C", 1, 120, 110), ("D", 2, 210, 70)],
     [(0, 1), (0, 2), (1, 3), (2, 3)], -1, -1, false);

  let s = string_of_int;
  let hit : ([(String, Int, Int, Int)], Int, Int, Int) -> Int =
    fun ts, x, y, i ->
      case ts
      | [] => -1
      | (_, _, tx, ty) :: tl =>
        if (tx - x) * (tx - x) + (ty - y) * (ty - y) <= 324 then i else hit(tl, x, y, i + 1)
      end;
  let at = fun (ts, i) -> let (_, _, x, y) = nth(ts, i) in (x, y);

  let update = fun ((ts, deps, sel, drag, moved), a) : (Model, Action) ->
    case a
    | Add =>
      let n = length(ts) in
      (ts @ [("T" ++ s(n + 1), 2, 40 + 60 * int_mod(n, 4), 40 + 45 * (n / 4))], deps, sel, drag, moved)
    | Down(x, y) =>
      let h = hit(ts, x, y, 0) in
      (ts, deps, if h == -1 then -1 else sel, h, false)
    | MoveTo(x, y) =>
      if drag == -1 then (ts, deps, sel, drag, moved)
      else
        let (tx, ty) = at(ts, drag) in
        if !moved && (tx - x) * (tx - x) + (ty - y) * (ty - y) < 16 then (ts, deps, sel, drag, moved)
        else (mapi(ts, fun (i, t) -> let (n, d, _, _) = t in if i == drag then (n, d, x, y) else t), deps, sel, drag, true)
    | Up =>
      if drag == -1 || moved then (ts, deps, sel, -1, false)
      else if sel == -1 then (ts, deps, drag, -1, false)
      else if sel == drag then
        (mapi(ts, fun (i, t) -> let (n, d, x, y) = t in if i == sel then (n, int_mod(d, 5) + 1, x, y) else t),
         deps, sel, -1, false)
      else
        let e = (sel, drag) in
        let rest = filter(deps, fun d -> d != e) in
        (ts, if length(rest) < length(deps) then rest else deps @ [e], -1, -1, false)
    end;

  let arrow = fun (ts, (a, b)) ->
    let (x1, y1) = at(ts, a) in let (x2, y2) = at(ts, b) in
    Node("line", [Create("x1", s(x1)), Create("y1", s(y1)), Create("x2", s(x2)), Create("y2", s(y2)),
                  Create("stroke", "#888"), Create("stroke-width", "2"), Create("marker-end", "url(#tip)")], []);
  let task = fun (i, (name, days, x, y), sel) ->
    Node("g", [], [
      Node("circle", [Create("cx", s(x)), Create("cy", s(y)), Create("r", "17"),
                      Create("fill", if i == sel then "orange" else "#5ab"), Create("stroke", "#333")], []),
      Node("text", [Create("x", s(x)), Create("y", s(y + 4)), Create("text-anchor", "middle"),
                    Create("font-size", "12"), Create("pointer-events", "none")], [Text(name)]),
      Node("text", [Create("x", s(x + 18)), Create("y", s(y - 12)), Create("font-size", "10"),
                    Create("fill", "#555"), Create("pointer-events", "none")], [Text(s(days) ++ "d")])]);

  let view = fun (ts, deps, sel, _, _) : Model ->
    Div([Create("data-hint", "drag a task; click: select, then link or bump days"),
         Style([("display", "flex"), ("flex-direction", "column")])], [
      Node("svg",
        [Create("viewBox", "0 0 260 150"), Width("260"), Height("150"),
         Style([("border", "1px solid #ccc"), ("background", "#fafafa"), ("font-family", "sans-serif")]),
         OnMouseDownAt(fun (x, y) -> Down(x, y)), OnMouseMoveAt(fun (x, y) -> MoveTo(x, y)),
         OnMouseUpAt(fun _ -> Up)],
        Node("defs", [], [Node("marker", [Create("id", "tip"), Create("viewBox", "0 0 10 10"), Create("refX", "27"),
                                          Create("refY", "5"), Create("markerWidth", "8"), Create("markerHeight", "8"),
                                          Create("orient", "auto")],
                              [Node("path", [Create("d", "M0 0 L10 5 L0 10 z"), Create("fill", "#888")], [])])])
        :: map(deps, fun d -> arrow(ts, d)) @ mapi(ts, fun (i, t) -> task(i, t, sel))),
      Div([Style([("display", "flex"), ("gap", "0.6em"), ("align-items", "center"), ("font-size", "0.7em"),
                  ("line-height", "20px"), ("color", "#888")])],
          [Button([OnClick(Add), Style([("font-size", "1em"), ("padding", "0 4px")])], [Text("+ task")]),
           Text(s(length(ts)) ++ " tasks, " ++ s(length(deps)) ++ " links")])
    ]);

  let expand = fun (ts, deps, _, _, _) : Model -> Plan(map(ts, fun (n, d, _, _) -> (n, d)), deps);

  let wrap : Plan -> Model =
    fun v -> case v | Plan(tasks, deps) =>
      (mapi(tasks, fun (i, (n, d)) -> (n, d, 40 + 60 * int_mod(i, 4), 40 + 45 * (i / 4))), deps, -1, -1, false) end;

  let shape = Block(26, 7)
} in

let show : Plan -> HTML = fun v -> ^plan.view(^plan.wrap(v)) in

let max = fun (a, b) -> if a > b then a else b in let min = fun (a, b) -> if a < b then a else b in

# Earliest start of each task, then latest finish; a task is critical when it has no slack #
let schedule : Plan -> Schedule =
  fun p -> case p | Plan(tasks, deps) =>
    let days = fun i -> snd(nth(tasks, i)) in
    let ids = mapi(tasks, fun (i, _) -> i) in
    let relax = fun (f, start) -> fold_left(ids, fun (acc, _) -> map(ids, fun i -> f(acc, i)), start) in
    let est = relax(fun (e, i) -> fold_left(deps, fun (m, (a, b)) -> if b == i then max(m, nth(e, a) + days(a)) else m, nth(e, i)),
                    map(ids, fun _ -> 0)) in
    let total = fold_left(ids, fun (m, i) -> max(m, nth(est, i) + days(i)), 0) in
    let lft = relax(fun (l, i) -> fold_left(deps, fun (m, (a, b)) -> if a == i then min(m, nth(l, b) - days(b)) else m, nth(l, i)),
                    map(ids, fun _ -> total)) in
    let rows = mapi(tasks, fun (i, (n, d)) -> (n, nth(est, i), nth(est, i) + d, nth(est, i) + d == nth(lft, i))) in
    Schedule(sort(fun ((_, a, _, _), (_, b, _, _)) -> int_compare(a, b), rows)) end in

let critical_path : Plan -> [String] =
  fun p -> case schedule(p) | Schedule(rows) => map(filter(rows, fun (_, _, _, c) -> c), fun (n, _, _, _) -> n) end in

let makespan : Plan -> Int =
  fun p -> case schedule(p) | Schedule(rows) => fold_left(rows, fun (m, (_, _, f, _)) -> max(m, f), 0) end in

# One row per task; critical tasks in coral #
let gantt : Schedule -> HTML =
  fun sc -> case sc | Schedule(rows) =>
    let s = string_of_int in
    let h = 22 * length(rows) + 6 in
    Node("svg", [Create("viewBox", "0 0 260 " ++ s(h)), Width("260"), Height(s(h)),
                 Style([("background", "#fafafa"), ("font-family", "sans-serif")])],
      concat(mapi(rows, fun (i, (n, a, b, c)) ->
        [Node("text", [Create("x", "4"), Create("y", s(22 * i + 19)), Create("font-size", "12")], [Text(n)]),
         Node("rect", [Create("x", s(40 + 14 * a)), Create("y", s(22 * i + 6)), Create("width", s(14 * (b - a))),
                       Create("height", "16"), Create("rx", "3"), Create("fill", if c then "coral" else "#5ab")], [])]))) end in

let input : Plan = ^^livelit(^plan(([("A", 2, 40, 40), ("B", 3, 120, 30), ("C", 1, 120, 110), ("D", 2, 210, 70)],
                                    [(0, 1), (0, 2), (1, 3), (2, 3)], -1, -1, false))) in
let chart : HTML = gantt(schedule(input)) in

test schedule(Plan([("A", 2), ("B", 3)], [(0, 1)])) == Schedule([("A", 0, 2, true), ("B", 2, 5, true)]) end;
test critical_path(Plan([("A", 2), ("B", 3), ("C", 1)], [(0, 1), (0, 2)])) == ["A", "B"] end;
test makespan(Plan([("A", 2), ("B", 3), ("C", 1)], [(0, 1), (0, 2)])) == 5 end;

(days=makespan(input), critical=critical_path(input), chart=chart)
