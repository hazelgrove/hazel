# Range Picker: an interval on a 0..100 bar with two handles.          #
# Press anywhere on the bar and drag: the nearer handle follows. A use  #
# expands to Range(low, high); `overlap` and `within` compare ranges,   #
# and `show` draws any Range on the same bar.                           #

type Range = + Range(Int, Int) in

let ^range = {
  # (low, high, dragging: 0 the low handle, 1 the high handle, -1 none) #
  type Model = (Int, Int, Int);
  type Action = + Down(Int) + MoveTo(Int) + Up;
  let init : Model = (25, 75, -1);

  # the bar runs from x = 8 to x = 178 #
  let s = string_of_int;
  let x_of = fun v -> 8 + 17 * v / 10;
  let v_of = fun x -> let v = (x - 8) * 10 / 17 in if v < 0 then 0 else if v > 100 then 100 else v;

  let update = fun ((lo, hi, drag), a) : (Model, Action) ->
    case a
    | Down(x) => (lo, hi, if abs(x - x_of(lo)) <= abs(x - x_of(hi)) then 0 else 1)
    | MoveTo(x) =>
      let v = v_of(x) in
      if drag == 0 then (if v < hi then v else hi, hi, drag)
      else if drag == 1 then (lo, if v > lo then v else lo, drag)
      else (lo, hi, drag)
    | Up => (lo, hi, -1)
    end;

  let handle = fun (v, held) ->
    Node("circle", [Create("cx", s(x_of(v))), Create("cy", "11"), Create("r", "6"),
                    Create("fill", if held then "orange" else "#fff"), Create("stroke", "teal"), Create("stroke-width", "2")], []);

  let view = fun (lo, hi, drag) : Model ->
    Div([Style([("display", "flex"), ("align-items", "center"), ("gap", "4px"),
                ("font-family", "var(--code-font)"), ("font-size", "0.75em")])], [
      Node("svg",
        [Create("viewBox", "0 0 186 22"), Width("186"), Height("22"), Style([("cursor", "ew-resize")]),
         OnMouseDownAt(fun (x, _) -> Down(x)), OnMouseMoveAt(fun (x, _) -> MoveTo(x)), OnMouseUpAt(fun _ -> Up)],
        [Node("rect", [Create("x", "8"), Create("y", "8"), Create("width", "170"), Create("height", "6"),
                       Create("rx", "3"), Create("fill", "#ddd")], []),
         Node("rect", [Create("x", s(x_of(lo))), Create("y", "8"), Create("width", s(x_of(hi) - x_of(lo))),
                       Create("height", "6"), Create("fill", "teal")], []),
         handle(lo, drag == 0), handle(hi, drag == 1)]),
      Span([Style([("min-width", "44px"), ("text-align", "right")])], [Text(s(lo) ++ "-" ++ s(hi))])
    ]);

  let expand = fun (lo, hi, _) : Model -> Range(lo, hi);

  let wrap : Range -> Model = fun v -> case v | Range(lo, hi) => (lo, hi, -1) end;

  let shape = Inline(24)
} in

let show : Range -> HTML = fun v -> ^range.view(^range.wrap(v)) in

let width : Range -> Int = fun r -> case r | Range(lo, hi) => hi - lo end in

# The part two ranges share; Range(0, 0) when they don't touch #
let overlap : (Range, Range) -> Range =
  fun (a, b) -> case (a, b) | (Range(l1, h1), Range(l2, h2)) =>
    let lo = if l1 > l2 then l1 else l2 in
    let hi = if h1 < h2 then h1 else h2 in
    if lo <= hi then Range(lo, hi) else Range(0, 0) end in

let within : (Range, Range) -> Bool =
  fun (inner, outer) -> case (inner, outer) | (Range(l1, h1), Range(l2, h2)) => l1 >= l2 && h1 <= h2 end in

# The pressure a valve is rated for, and what a test run observed (bar) #
let rated : Range = ^^livelit(^range((20, 80, -1))) in
let observed : Range = ^^livelit(^range((35, 90, -1))) in

test width(Range(20, 80)) == 60 end;
test overlap(Range(20, 80), Range(35, 90)) == Range(35, 80) end;
test overlap(Range(0, 10), Range(20, 30)) == Range(0, 0) end;
test within(Range(30, 40), Range(20, 80)) && !within(Range(10, 40), Range(20, 80)) end;

(safe=within(observed, rated), shared=show(overlap(observed, rated)))
