# Editable Parameters #

# The Parameters slide gives a slider its bounds as PARAMETERS, the #
# paper's $slider 0 100 (Sec. 2.4.1): once, in an abbreviation, #

#   let ^percent = ^slider(0, 100) in #

# and from then on they are FIXED, for the lifetime of the livelit: #
# every use of ^percent runs from 0 to 100, the bounds are closed #
# (no client variable in them), and changing them means changing the #
# abbreviation. #

# This slider takes its bounds another way: as SPLICES, regions of #
# the CLIENT's program inside the widget (Sec. 2.4.2, 2.4.3). So they #
# are EDITABLE parameters: #

#                    Parameters            Editable Parameters #
#   given            once, abbreviation    per use, in the widget #
#   may name         builtins only         the client's variables #
#   changes          never                 whenever you edit a bound #
#   the livelit      reads their values    reads their values, and #
#                                          could rewrite them #

# Both are the paper's: parameters for what a livelit is configured #
# with, splices for what the client keeps writing. This one is the #
# smallest livelit that needs splices -- a slider whose two ends are #
# the client's code. #

# It is written the way Figure 3 is (Sec. 3.2): init MAKES the two #
# bounds with new_splice, the model holds only their refs, the view #
# READS them with eval_splice and places their editors, and expand #
# is a Macro, returning code for a function of the two bounds, which #
# a use applies to them. #

# Drag the handle. #

let ^between = {
  # pct is where the handle sits, 0 to 100. lo and hi are the ends of #
  # the range: handles, SpliceRefs, as a spliced field is in Figure 3 #
  # (l.3-4). The model never holds the bounds' values. #
  type Model = (pct=Int, lo=SpliceRef, hi=SpliceRef);

  # Only the handle moves: there is no SetLo or SetHi. The bounds are #
  # the client's code, and this slider leaves them alone -- though the #
  # paper does let update rewrite a splice, with set_splice; Color #
  # (Figure 3) does. #
  type Action = + Slide(Int);

  type Expansion = Int;

  # init is a command, an UpdateCmd(Model) (Sec. 3.2.1). It is #
  # performed when a use is created -- type ^between, then a space -- #
  # and it MAKES the two bounds with new_splice, starting them at 0 #
  # and 100. The new use's text is that model, each ref written as its #
  # splice, in parens: lo=(0) is the splice new_splice made, as saved. #
  # The uses below are written the same way. #
  let init =
    do lo <- new_splice((IntT, Some(IntLit(0)))) in
    do hi <- new_splice((IntT, Some(IntLit(100)))) in
    Pure((pct=50, lo=lo, hi=hi));

  let update = fun m : Model -> fun a : Action -> Pure(
    case a
    | Slide(p) => (pct=p, lo=m.lo, hi=m.hi)
    end);

  # The view reads each bound with eval_splice, a ViewCmd (Sec. #
  # 3.2.3), under the closure the reader has selected. It answers #
  # Maybe(Result): Some(Val(n)) for a number, and otherwise nothing #
  # to show -- a hole in a bound is Indet (Sec. 2.5.2) -- so the #
  # widget shows ? until both bounds have values. Each editor is #
  # placed by its ref, with Html.splice: the same splice node as the #
  # ViewCmd editor((ref, dim)), without editor's fixed-width box. #
  # They are real editors: click in and type. What you type is code #
  # in YOUR scope, not in the livelit's (Sec. 2.4.3). #
  let view = fun m : Model ->
    do lo <- eval_splice(m.lo) in
    do hi <- eval_splice(m.hi) in
    let result =
      case (lo, hi)
      | (Some(Val(l)), Some(Val(h))) =>
        string_of_int(l + (h - l) * m.pct / 100)
      | _ => "?"
      end
    in
    Pure(
      Html.div(
        [Attr.style([("display", "flex"), ("gap", "0.4em"),
                     ("align-items", "center"),
                     ("font-family", "var(--code-font)"),
                     ("font-size", "0.8em")])],
        [Html.splice(m.lo),
         Html.input(
           [Attr.type_("range"), Attr.min("0"), Attr.max("100"),
            Attr.value(string_of_int(m.pct)),
            Attr.on_input(fun s -> Slide(int_of_string(s)))]),
         Html.splice(m.hi),
         Html.text(" = " ++ result)]));

  # What a use MEANS, as the paper writes it (Sec. 3.2.5): CODE, a #
  # quoted function of the bounds, with the list of refs whose code #
  # fills its parameters, in order. The handle's position, a number #
  # in the model, is written into the code with unquote IntLit(...) #
  # end: an antiquote, whose code is spliced in where it stands. A #
  # use means that function applied to its two bounds, so a bound's #
  # code is passed in as an argument and no binder in the expansion #
  # can capture it (Sec. 2.4.3; the Hygiene folder). expand never #
  # sees a bound's value: it treats the splices parametrically. #
  let expand = Macro(fun m : Model ->
    (quote fun lo -> fun hi ->
       lo + (hi - lo) * unquote IntLit(m.pct) end / 100
     end,
     [m.lo, m.hi]));

  # Width of the widget's OWN chrome only -- the slider and the #
  # " = N". The splices add their own width on top, because only the #
  # editor knows how long the client's code is. #
  let shape = Inline(26)
} in

# WHY THE BOUNDS ARE SPLICES #

# In the paper a model is plain data: it is what gets saved, so it can #
# hold no functions (Sec. 3.2.1). The client's code reaches a widget #
# only through its parameters and splices (Sec. 2.4). #

# Here a use's model argument happens to be an ordinary expression in #
# the client's scope, so a plain Int field could say `baseline * 2` #
# and it would evaluate -- until the first drag. An interaction #
# commits the model VALUE back into the text, and the field would #
# then read 20. Without splices a livelit could COMPUTE with the #
# client's code; it could not HOLD any. #

# A splice holds it. On commit a spliced field keeps the client's #
# term, not its value, and the widget shows that term where the author #
# chose, as a real editor, beside whatever the author puts next to it. #
# The code inside stays the client's, in the client's scope #
# (Sec. 2.4.3). #

# A livelit may still REWRITE a splice. That is set_splice, and #
# Figure 3's update uses it to overwrite all four channels on a click #
# (Sec. 3.2.4). This slider has no reason to, though it could: #
# set_splice runs, and Color (Figure 3) does just that. #

let baseline = 10 in

# baseline * 2 is 20, and the handle is halfway: the use means 15. #
let shown = ^^livelit(^between((pct=50, lo=(baseline), hi=(baseline * 2)))) in

# SPLICES COMPOSE #

# A splice holds an EXPRESSION, and a use of a livelit is an #
# expression, so one of these can be the bound of another #
# (Sec. 2.4.2). Three ways, and the difference between them is only #
# where you write it. #

# 1. BY NAME. The inner slider's value is the outer slider's maximum. #

let cap = ^^livelit(^between((pct=50, lo=(0), hi=(200)))) in
let by_name = ^^livelit(^between((pct=50, lo=(0), hi=(cap)))) in

# 2. NESTED IN PLACE. The same relationship, with the inner slider #
# living INSIDE the outer one's max splice. Drag the inner handle and #
# let go, and the outer slider's range changes under you. (While you #
# drag, only the inner widget redraws; the release commits.) #

let nested =
  ^^livelit(^between((pct=50, lo=(0),
    hi=(^^livelit(^between((pct=50, lo=(0), hi=(200)))))))) in

# 3. COMPUTED. A splice is not a slot for a widget, it is a region of #
# your program -- so the maximum can be arithmetic over one. #

let computed =
  ^^livelit(^between((pct=50, lo=(0),
    hi=((^^livelit(^between((pct=50, lo=(0), hi=(200))))) * 2 + 10)))) in

# Watch where the parens close in 3. Parens are how a splice is #
# written in text, and a field's parens are read as a splice only #
# when they hold its WHOLE value, spaces aside. Written #
# `hi=(slider) * 2 + 10`, the parens hold only part of the value, so #
# they are not read as a splice at all: the field has no ref, and it #
# does not typecheck. A livelit makes each new splice with new_splice #
# (Sec. 3.2.1), but writing one by hand is legal too, whole-value #
# parens and all: see Splices in Text. #

(shown, by_name, nested, computed)

# Try: change baseline to 20 and watch both bounds follow. Or type #
# `baseline * 3` into the right-hand splice. Or empty a bound and see #
# what the widget does with a hole. #
