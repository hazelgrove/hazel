# MVU Counter #

# The smallest complete app: (init, update, view, subs). #

type Model = Int in
type Action = Int in

let init: Model = 0 in

let update(model: Model, action: Action): Model =
  model + action
in

let stepButton(label: String, action: Action): Html.T =
  Html.button(
    [Attr.on_click(action),
     Attr.style([("padding", "0.35em 0.6em"), ("background", "var(--surface-default)"),
            ("border", "1px solid var(--border-soft)"), ("border-radius", "3px"),
            ("cursor", "pointer"), ("font-family", "inherit"), ("font-size", "1em"),
            ("color", "var(--text-default)")])],
    [Html.text(label)]
  )
in

let view(model: Model): Html.T =
  Html.div(
    [Attr.class("counter"),
     Attr.style([("max-width", "280px"), ("margin", "0 auto"),
            ("font-family", "var(--code-font)"), ("font-size", "0.85em"),
            ("background", "var(--surface-code)"), ("color", "var(--text-default)"),
            ("border", "1px solid var(--border-soft)"), ("border-radius", "0.4em"),
            ("overflow", "hidden")])],
    [
      Html.div(
        [Attr.style([("padding", "0.9em 1em 0.8em"), ("text-align", "center"),
                ("font-size", "1.2em"), ("font-weight", "bold"), ("color", "var(--text-strong)")])],
        [Html.text("Counter")]
      ),
      Html.div(
        [Attr.style([("padding", "0.7em 1em"), ("text-align", "center"),
                ("background", "var(--surface-raised)"), ("font-size", "1.5em"),
                ("font-weight", "bold"), ("color", "var(--text-strong)"),
                ("border-top", "1px solid var(--border-soft)"),
                ("border-bottom", "1px solid var(--border-soft)")])],
        [Html.int(model)]
      ),
      Html.div(
        [Attr.style([("padding", "0.7em 1em"), ("display", "grid"),
                ("grid-template-columns", "1fr 1fr"), ("gap", "0.4em")])],
        [stepButton("-", -1), stepButton("+", 1)]
      ),
      Html.div(
        [Attr.style([("padding", "0.6em 1em"), ("text-align", "center"),
                ("font-size", "0.75em"), ("color", "var(--text-muted)"),
                ("border-top", "1px solid var(--border-soft)")])],
        [Html.text("Use + and - to change the count")]
      )
    ]
  )
in

let subs(_model: Model): Sub.T = Sub.none in

# Tests #

hint "increment adds one"
test update(0, 1) == 1 end;

hint "decrement subtracts one"
test update(5, -1) == 4 end;

# Nothing here issues a command, so `update` returns a bare Model and is #
# lifted into the (Model, Cmd.T) shape the app tuple expects. #

let noCmd(f: (Model, Action) -> Model): (Model, Action) -> (Model, Cmd.T) =
  fun (model, action) -> (f(model, action), Cmd.none)
in

^^html_sidebar((init, noCmd(update), view, subs))
