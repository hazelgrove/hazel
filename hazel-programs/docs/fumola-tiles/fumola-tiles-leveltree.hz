# A LEVEL TREE, BUILT IN THE STORE #

# This is the shape of levelTree.fromList from the Fumola repo, cut down to #
# what the tiles can build today.  The real one takes a generic List<X>, #
# destructures a record, and carries type annotations -- none of which #
# these tiles have.  What survives the cut is the part that makes it #
# incremental: every node is a cell, so re-running touches only what #
# changed. #

# Declaring the Hazel type is what makes the result typecheck.  A Fumola #
# variant crosses as a Hazel constructor of the same name, capitalised, so #
# the leaf tag arrives as Leaf(1).  Without a type in scope that names it, #
# Hazel has every right to call it unbound -- and did.  With one, the #
# expected type also tells the bridge which sum to build. #

# (Note for anyone editing this slide: a Hazel comment is delimited by the #
# hash, so a Fumola tag cannot be written inside one.) #

type Tree = + Leaf(Int) + Bin((Tree, Tree)) in

# Two leaves and a binary node above them.  Reading a cell with `@` is what #
# records the edge from this node to the ones it read: #

let shape: Tree = fumola $graphical as trees in
  { let a = 1 := $leaf(1);
    let b = 2 := $leaf(2);
    let n = 3 := $bin((@ a, @ b));
    @ n }
end in

# A thunk instead.  Forcing it is the traversal the event list shows as a #
# Begin and an End, with an edge to each cell the thunk read: #

let total: Int = fumola $graphical as trees in
  { let a = 1 := 10;
    let b = 2 := 20;
    let t = 3 := thunk { (@ a) + (@ b) };
    force t }
end in

# Open the Fumola panel -- the tab below Problems -- with the cursor inside #
# either program to see what `trees` recorded. #

(shape, total)
