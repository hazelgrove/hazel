# THE INSTANCE, AND ITS MODE #

# The instance is named in the program text rather than derived from the #
# expression, and that is the whole point: the adapton store it holds #
# survives every edit that leaves the name alone. #

let a = fumola store as $graphical in 0 := 41 end in
let b = fumola store as $graphical in @ 0 end in

# Two programs naming `store` share one store.  A different name is a #
# different instance, with nothing in it: #

let elsewhere = fumola other as $graphical in @ 0 end in

# The mode is $graphical or $simple.  Only a $graphical instance records the #
# events that the Fumola panel shows; a $simple one keeps no graph. #

# Changing a mode RESETS the instance, which discards the store.  That is #
# why the mode is written beside the name, and why leaving the slot as a #
# hole means "leave this instance alone" rather than "use the default". #

(a, b, elsewhere)
