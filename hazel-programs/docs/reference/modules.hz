# MODULES #

# Modules use curly-brace syntax with semicolon-separated items. #
# The `module` keyword supports capitalized module names. #
# Modules are first-class values; their types are signatures. #


# A. MODULE CONSTRUCTION AND ACCESS #

# 1. Defining and accessing a module #
module Geometry = {
  type Point = (Int, Int);
  type Distance = Int;
  let origin : Point = (0, 0);
  let manhattan =
    fun (x, y) : Point -> x + y
} in

let pt : Geometry.Point = (3, 4) in
let dist : Geometry.Distance = Geometry.manhattan(pt) in

# 2. Empty module #
module Empty = {} in

# 3. Lowercase `let` works too #
let colors = {
  let red = 1;
  let green = 2;
  let blue = 3
} in
let r = colors.red in

# 4. Later bindings can reference earlier ones #
module Counter = {
  let start = 0;
  let next = start + 1;
  let after = next + 1
} in

# 5. Shadowing: last binding wins #
module M = {
  let x = 1;
  let x = "hello"
} in

# 6. Test assertion inside a module #
module M = {
  test 1 + 1 == 2 end;
  let result = 99
} in


# B. QUALIFIED TYPE ACCESS #

# 7. Type aliases are accessible via dot notation in types #
module Units = {
  type Meters = Int;
  type Seconds = Int
} in
let height : Units.Meters = 170 in
let duration : Units.Seconds = 60 in

# 8. Nested modules and nested type access #
module Outer = {
  module Inner = {
    type T = Bool;
    let value = true
  }
} in
let b : Outer.Inner.T = Outer.Inner.value in

# 9. Module aliasing propagates type exports #
module Base = {
  type Id = Int
} in
module App = {
  module Db = Base;
  type UserId = Db.Id
} in
let uid : App.Db.Id = 42 in
let uid2 : App.UserId = uid in

# 10. Variable aliasing propagates type exports too #
module M = {
  type T = Int
} in
let n = M in
let x : n.T = 5 in

# 11. Error: nonexistent type member #
module M = {
  type Real = Int
} in
let bad : M.Fake = 1 in

# 11a. Error: a type member is not a value #
let bad2 = M.Real in

# 11b. Error: this module has no type members #
let bad3 : Empty.T = 1 in

# 11c. Error: only modules and tuples have members #
let n = 1 in
let bad4 = n.x in

# 11d. Error: a value that is not a module cannot start a type path #
let bad5 : n.T = 1 in


# C. MODULE SIGNATURES #

# Signatures use curly-brace syntax in type position: #
# { let name : Type; type T = Type; module Name : Signature } #

# 12. Module matching its signature #
module M : {let x : Int} = {let x = 42} in

# 13. Empty signature #
module M : {} = {} in

# 14. Type members in a signature are checked #
module M : {
  type T = Int;
  let x : T
} = {
  type T = Int;
  let x = 4
} in

# 15. Nested module declared in a signature #
module Outer : {
  module Inner : {let x : Int};
  let y : Int
} = {
  module Inner = {let x = 1};
  let y = 2
} in
let v = Outer.Inner.x + Outer.y in

# 16. Lowercase nested module in a signature #
let outer : {let inner : {let x : Int}} = {let inner = {let x = 1}} in

# 17. Signature bound to a type alias #
type MT = {let x : Int} in
let m : MT = {let x = 4} in


# D. SIGNATURE ERRORS #

# 18. Error: member type doesn't match signature #
module M : {let x : Int} = {let x = true} in

# 19. Error: one matching, one non-matching member #
module M : {
  let x : Int;
  let y : Bool
} = {
  let x = 1;
  let y = 2
} in

# 20. Error: module is missing a required member #
module M : {
  let x : Int;
  let y : Bool;
  let z : String
} = {
  let x = 1;
  let y = true
} in

# 21. Error: empty module missing all members #
module M : {
  let x : Int;
  let y : Bool
} = {} in

# 22. Error: type member differs from the signature's #
module M : {
  type T = Int;
  let x : T
} = {
  type T = Bool;
  let x = true
} in

# 23. Error: a hole-typed member is still required #
let m : {let x : ?} = {let y = 1} in


# E. WIDTH SUBTYPING #

# Where a module is checked against a signature, it may have #
# more members than the signature declares; the extra members #
# are sealed away. Consistency elsewhere stays exact. #

# 24. Extra members are sealed away by the signature #
module M : {let x : Int} = {
  let x = 1;
  let y = 2
} in
let ok = M.x in

# 25. Error: a sealed-away member is not accessible #
let bad = M.y in

# 26. A function over any module with the members it needs #
let greet = fun (m : {let name : String}) -> "hello " ++ m.name in
module Alice = {let name = "Alice"; let age = 30} in
module Bob = {let name = "Bob"; let email = "bob@example.com"} in
let g1 = greet(Alice) in
let g2 = greet(Bob) in

# 27. Hiding helpers: only the signature's members are exported #
module Stack : {
  let empty : [Int];
  let push : Int -> [Int] -> [Int];
  let top : [Int] -> Int
} = {
  let default = 0;
  let empty = [];
  let push = fun x -> fun s -> x :: s;
  let top = fun s -> case s | h :: _ => h | [] => default end
} in
let t = Stack.top(Stack.push(1)(Stack.empty)) in

# 28. Error: the helper is not part of the signature #
let hidden = Stack.default in

# 29. Nested members may be wider than declared too #
module Config : {module Db : {let host : String}} = {
  module Db = {let host = "localhost"; let port = 5432}
} in
let h = Config.Db.host in

# 30. A function on fewer members serves where more are provided #
let get_x : {let x : Int; let y : Int} -> Int =
  fun (m : {let x : Int}) -> m.x in

# 31. Error: branches are joined exactly, so they must agree... #
let pick = fun b -> if b then {let x = 1} else {let x = 1; let y = 2} in

# 32. ...unless the wider branch is sealed by an ascription #
let pick = fun b ->
  if b then {let x = 1} else ({let x = 1; let y = 2} : {let x : Int}) in
¿
