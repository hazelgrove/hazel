# MODULE SIGNATURES #

# Continues the Modules slide: width subtyping and abstract type #
# members. #

# E. WIDTH SUBTYPING #

# Where a module is checked against a signature, it may have #
# more members than the signature declares; the extra members #
# are sealed away. Consistency elsewhere stays exact. #

# 24. Extra members are sealed away by the signature #
module M : {let x : Int} = {
  let x = 1;
  let y = 2
} in
let ok = M.x in

# 25. Error: a sealed-away member is not accessible #
let bad = M.y in

# 26. A function over any module with the members it needs #
let greet = fun (m : {let name : String}) -> "hello " ++ m.name in
module Alice = {let name = "Alice"; let age = 30} in
module Bob = {let name = "Bob"; let email = "bob@example.com"} in
let g1 = greet(Alice) in
let g2 = greet(Bob) in

# 27. Hiding helpers: only the signature's members are exported #
module Stack : {
  let empty : [Int];
  let push : Int -> [Int] -> [Int];
  let top : [Int] -> Int
} = {
  let default = 0;
  let empty = [];
  let push = fun x -> fun s -> x :: s;
  let top = fun s -> case s | h :: _ => h | [] => default end
} in
let t = Stack.top(Stack.push(1)(Stack.empty)) in

# 28. Error: the helper is not part of the signature #
let hidden = Stack.default in

# 29. Nested members may be wider than declared too #
module Config : {module Db : {let host : String}} = {
  module Db = {let host = "localhost"; let port = 5432}
} in
let h = Config.Db.host in

# 30. A function on fewer members serves where more are provided #
let get_x : {let x : Int; let y : Int} -> Int =
  fun (m : {let x : Int}) -> m.x in

# 31. Error: branches are joined exactly, so they must agree... #
let pick = fun b -> if b then {let x = 1} else {let x = 1; let y = 2} in

# 32. ...unless the wider branch is sealed by an ascription #
let pick = fun b ->
  if b then {let x = 1} else ({let x = 1; let y = 2} : {let x : Int}) in


# F. ABSTRACT TYPE MEMBERS #

# A signature may declare `type T` without a definition. A module #
# sealed by it must define T, but outside the module T is known #
# only as the path M.T: its representation is hidden. #

# 33. Sealing hides the representation #
module Counter : {
  type T;
  let zero : T;
  let incr : T -> T;
  let get : T -> Int
} = {
  type T = Int;
  let zero = 0;
  let incr = fun c -> c + 1;
  let get = fun c -> c
} in
let two = Counter.get(Counter.incr(Counter.incr(Counter.zero))) in

# 34. Error: Counter.zero is a Counter.T, not an Int #
let leak = Counter.zero + 1 in

# 35. The path type names the abstract type #
let c : Counter.T = Counter.incr(Counter.zero) in

# 36. Aliasing a module keeps its abstract type #
module C2 = Counter in
let c2 : C2.T = c in

# 37. Error: separately sealed modules have distinct types #
module Other : {type T; let zero : T} = {type T = Int; let zero = 0} in
let mixed : Counter.T = Other.zero in

# 38. A manifest member stays transparent #
module Open : {type T = Int; let x : T} = {type T = Int; let x = 1} in
let visible = Open.x + 1 in

# 39. Error: the module must define the abstract type #
module Missing : {type T; let x : T} = {let x = 1} in
¿
