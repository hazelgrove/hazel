# PLAYING CARD LITERALS #

type Suit =
  + Hearts + Diamonds + Clubs + Spades in

type Rank =
  + Ace + Jack + Queen + King
  + Two + Three + Four + Five 
  + Six + Seven + Eight + Nine + Ten in

type Card = (Suit, Rank) in
type Hand = [Card] in

# Use Alt/Option-L to individual toggle card display #
let _card = ^^card((Spades,Jack)) in

# Hands (list of cards) can also be displayed as cards #
let _deck: [Card] = ^^card([(Hearts, King), (Clubs, Queen), (Clubs, Four), (Clubs, Ace), (Diamonds, Four), (Hearts, Nine), (Clubs, Ace), (Diamonds, Ten), (Diamonds, Nine),((Hearts, King)), (Spades, Two), (Spades, Ace), (Clubs, Ace)]) in

# Clicking on a card flips it over (just for fun) #
# Shift-clicking on a card lets you pick a different card #

# You can use the card display in patterns too #
# A wildcard pattern can be used for the rank or suit #
let flush = fun hand ->
  case hand
  | ^^card([(Hearts, _), (Hearts, _), (Hearts, _), (Hearts, _), (Hearts, _)]) => true
  | ^^card([(Clubs,_),(Clubs,_),(Clubs,_),(Clubs,_),(Clubs,_)]) => true
  | ^^card([(Diamonds,_),(Diamonds,_),(Diamonds,_),(Diamonds,_),(Diamonds,_)]) => true
  | ^^card([(Spades,_),(Spades,_),(Spades,_),(Spades,_),(Spades,_)]) => true
  | _ => false  
  end in

test flush([^^card((Hearts, King)),^^card((Hearts, Queen)),^^card((Hearts, Jack)),^^card((Hearts, Ten)),^^card((Hearts, Ace))]) end;

let value((_, rank) : Card) : Int =
  case rank
  | Ace => 14 | King => 13 | Queen => 12 | Jack => 11 
  | Ten => 10 | Nine => 9 | Eight => 8 | Seven => 7 | Six => 6
  | Five => 5 | Four => 4 | Three => 3 | Two => 2
  end in

# The probes below show intermediate hands as actual cards #
# This is controlled by the rich views toggle in the probes sidebar #
# Double-click any sample to flip it back to text #

# Insertion Sort #

let insert(card : Card, hand : Hand) : Hand =
  case ^^probe(hand)
  | [] => ^^probe([card])
  | hd :: tl =>
    case ^^probe(value(card) <= value(hd))
    | true => ^^probe(card :: hand)
    | false => ^^probe(hd :: insert((card, tl)))
    end end in

let sort(hand : Hand) : Hand =
  case hand
  | [] => []
  | hd :: tl => ^^probe(insert(hd, sort(tl)))
  end in

# Quicksort #

let filter_le(pivot : Card, hand : Hand) : Hand =
  case hand
  | [] => []
  | hd :: tl =>
    case value(hd) <= value(pivot)
    | true => ^^probe(hd :: filter_le(pivot, tl))
    | false => ^^probe(filter_le(pivot, tl))
    end end in

let filter_gt(pivot : Card, hand : Hand) : Hand  =
  case hand
  | [] => []
  | hd :: tl =>
    case value(hd) <= value(pivot)
    | true => ^^probe(filter_gt(pivot, tl))
    | false => ^^probe(hd :: filter_gt(pivot, tl))
    end end in

let quicksort(hand : Hand) : Hand =
  case ^^probe(hand)
  | [] => []
  | p :: rest =>
    ^^probe(quicksort(filter_le((p, rest)))
    @ [p] @ quicksort(filter_gt((p, rest))))
  end in

let five : Hand =
  ^^card([(Clubs, Jack), (Hearts, Ace), (Spades, Three), (Diamonds, King), (Hearts, Seven)]) in

quicksort(^^probe(five));

test sort(five) == quicksort(five) end
