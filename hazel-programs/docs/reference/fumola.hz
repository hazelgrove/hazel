# FUMOLA #
# Fumola is a language whose execution model uses Adapton: editing a program #
# repairs prior computation rather than redoing it. A ^fumola_thunk livelit  #
# runs a Fumola program and expands to its result, translated into a Hazel   #
# value.                                                                     #
#                                                                            #
# This card is a tour of Fumola syntax and of what each kind of value        #
# becomes on the Hazel side. Every livelit below is annotated, and the       #
# annotation is what the translation produces -- change one and Hazel will   #
# tell you.                                                                  #
#                                                                            #
# A ^fumola_thunk takes three things:                                        #
#   an instance id      which Fumola runtime to run in                       #
#   a thunk name        Fumola source for a symbol, naming this thunk        #
#   the program         Fumola source                                        #
#                                                                            #
# Every livelit here shares instance 0, so they share one runtime; each has  #
# its own thunk name, so they do not overwrite each other.                   #

# Numbers and arithmetic look as you would expect. #
let myInt : Int =
  ^fumola_thunk(0, "`myInt", "1 + 2") in

# Booleans too. #
let myBool : Bool =
  ^fumola_thunk(0, "`myBool", "true") in

# A symbol is Fumola's notion of a name, written with a leading backtick.   #
# It arrives in Hazel as its text, which is also the only way to produce a  #
# String here: a Hazel string literal cannot contain a quote, so neither    #
# can the program above.                                                    #
let myString : String =
  ^fumola_thunk(0, "`myString", "`hello") in

# Fumola's unit is Hazel's empty tuple. #
let myUnit : () =
  ^fumola_thunk(0, "`myUnit", "()") in

# Tuples cross as tuples, so the parts keep their own types. #
let myPair : (Int, Bool) =
  ^fumola_thunk(0, "`myPair", "(1, true)") in

# A Fumola record is written with semicolons, and becomes a Hazel labeled   #
# tuple. Fields come back in name order.                                    #
let myRecord : (x=Int, y=Bool) =
  ^fumola_thunk(0, "`myRecord", "{x = 1; y = true}") in

# Variants are written with a leading hash, as in the program below.        #
# A Fumola variant names no type of its own, so the expected type is        #
# what decides which constructor is meant -- which is why these             #
# livelits need an annotation.                                              #
type Shape = + Circle(Int) + Square(Int) in
let myVariant : Shape =
  ^fumola_thunk(0, "`myVariant", "#Circle(3)") in

# Fumola's option is Hazel's: ?(x) is Some(x) and null is None. #
let mySome : Option =
  ^fumola_thunk(0, "`mySome", "?(3)") in

let myNone : Option =
  ^fumola_thunk(0, "`myNone", "null") in

# These compose, so a structure of structures translates as one. #
let myNested : (Int, (a=Int, b=String)) =
  ^fumola_thunk(0, "`myNested", "(1, {a = 2; b = `word})") in

# SYMBOLS #
# A symbol is Fumola's notion of a name, and they are first-order data: a   #
# number is a symbol, an identifier is a symbol, and they compose.          #
#                                                                          #
#   `hello                 an identifier                                   #
#   7                      a number is a symbol too                        #
#   `adapton(`settings)    application, and it nests                       #
#                                                                          #
# Symbols cross into Hazel as their text, with the backticks dropped at     #
# every depth, so one convention holds throughout.                          #
let mySymbol : String =
  ^fumola_thunk(0, "`mySymbol", "`hello") in

let myAppliedSymbol : String =
  ^fumola_thunk(0, "`myApplied", "`adapton(`settings)") in

let myNestedSymbol : String =
  ^fumola_thunk(0, "`myNestedSym", "`a(`b(`c))") in

# They travel inside structures like any other value. #
let mySymbolPair : (String, String) =
  ^fumola_thunk(0, "`mySymPair", "(`x, `y)") in

# Text is not the only form. Hazel has a Symbol type of the same shape       #
# Fumola gives them, and which form you get is decided by the type you ask   #
# for -- these two livelits run the same program.                            #
#                                                                           #
#   type Symbol = + Num(Int) + Name(String)                                  #
#                 + Call((Symbol, Symbol)) + Dot((Symbol, Symbol))           #
#                                                                           #
# The text form stays useful because it is the only way to produce a String  #
# from a livelit at all: a Hazel string cannot contain a quote, so neither   #
# can the program that would otherwise build one.                            #
let symbolAsText : String =
  ^fumola_thunk(0, "`asText", "`hello") in

let symbolAsData : Symbol =
  ^fumola_thunk(0, "`asData", "`hello") in

# A number is a symbol, so it has a structured form too. #
let numberAsSymbol : Symbol =
  ^fumola_thunk(0, "`numSym", "7") in

# Application nests, each side a symbol in its own right. #
let appliedAsSymbol : Symbol =
  ^fumola_thunk(0, "`applSym", "`adapton(`settings)") in

# SYMBOLS, THE OTHER WAY #
# Symbols also travel from Hazel into Fumola, in one specific place: the    #
# thunk name, the second argument of every livelit on this card. It is not  #
# an identifier this side invents a syntax for -- it is Fumola source,      #
# which Fumola parses in a runtime kept only for that purpose. So any form  #
# the language spells as a symbol works as a name.                          #
#                                                                          #
# An ordinary name, a number, and an applied symbol, each naming its own    #
# thunk in the same runtime.                                                #
let namedPlainly : Int =
  ^fumola_thunk(0, "`plainName", "1") in

let namedByNumber : Int =
  ^fumola_thunk(0, "1234", "2") in

let namedByApplication : Int =
  ^fumola_thunk(0, "`group(`member)", "3") in

# SPACES AND TIMES #
# Adapton names places and moments, and each is mostly just a symbol. Both  #
# have a type in the Hazel prelude of the shape Fumola gives them, so the   #
# cases can be told apart.                                                  #
#                                                                          #
#   type Space = + Symbol(String) + Here                                    #
#   type Time  = + Symbol(String) + Now                                     #
#                                                                          #
# A named space carries the symbol as its text.                             #
let mySpace : Space =
  ^fumola_thunk(0, "`mySpace", "Adapton.space(`region)") in

# `here` and `now` are relative to where evaluation is, and name nothing,   #
# so they come across as their own cases rather than as symbols.            #
let myHere : Space =
  ^fumola_editor(0, "Adapton.here()") in

let myNow : Time =
  ^fumola_editor(0, "Adapton.now()") in

# CELLS AND POINTERS #
# Cells are what make editing incremental. `:=` writes one, and get(s)      #
# reads it back. State written in one edit is still there in the next, so   #
# try editing the program below to just `get(1)`.                           #
let myCell : Int =
  ^fumola_thunk(0, "`myCell", "1 := 2; get(1)") in

# A name for a cell is a symbol, and a number is a symbol too, so cells can #
# be named either way.                                                      #
let myNamedCell : Int =
  ^fumola_thunk(0, "`myNamedCell", "`count := 41; get(`count) + 1") in

# peek(s) reads without recording a dependency, and answers an option: the  #
# cell may never have been written.                                         #
let myPeek : Option =
  ^fumola_thunk(0, "`myPeek", "`count := 41; peek(`count)") in

let myMissing : Option =
  ^fumola_thunk(0, "`myMissing", "peek(`neverWritten)") in

# POINTERS #
# pointer(s) is the pointer that symbol s names, and `:=` evaluates to the  #
# pointer it just wrote -- so these two produce the same thing.             #
#                                                                          #
# A pointer is not read here as a number or a handle. It arrives as a       #
# reference that carries the value it points at, so it has the type of what #
# it points to -- a pointer to a cell holding an Int is usable as an Int -- #
# while still showing which cell the value came from.                       #
let myPointer : Int =
  ^fumola_thunk(0, "`myPointer", "`x := 41; pointer(`x)") in

# `:=` evaluates to a pointer, so this is the same reference by a shorter   #
# route.                                                                    #
let myWrite : Int =
  ^fumola_thunk(0, "`myWrite", "`y := 7") in

# The type comes from what the cell holds, so a pointer to a tuple is a     #
# reference of that tuple's type.                                           #
let myTuplePointer : (Int, Bool) =
  ^fumola_thunk(0, "`myTuplePointer", "`t := (1, true); pointer(`t)") in

# Numbers name cells as readily as backticked names do.                     #
let myNumberedPointer : Int =
  ^fumola_thunk(0, "`myNumberedPointer", "7 := 5; pointer(7)") in

# FORCING A THUNK #
# Every thunk livelit here runs its program inside a thunk named by its     #
# second argument, so each of those names is a cell of the shared runtime:  #
# `myInt names the thunk that computed 1 + 2, and pointer(`myInt) is a      #
# pointer to that thunk.                                                    #
#                                                                          #
# A thunk is not a value, and it is values that have a Hazel translation -- #
# ask a livelit for the thunk itself and there is nothing to bring across.  #
# force is what closes the gap: force(p) runs the thunk p points at, or     #
# reuses what it already computed, and answers with its value, which does   #
# translate. So an editor livelit can reach back for the result of any      #
# thunk defined above, with the type that thunk's program produced.         #
let forcedInt : Int =
  ^fumola_editor(0, "force(pointer(`myInt))") in

# Structure survives the trip, as it did from the thunk itself. #
let forcedPair : (Int, Bool) =
  ^fumola_editor(0, "force(pointer(`myPair))") in

# A forced variant still takes its home type from the annotation. #
let forcedVariant : Shape =
  ^fumola_editor(0, "force(pointer(`myVariant))") in

# And a record arrives as the labeled tuple its fields describe. #
let forcedRecord : (x=Int, y=Bool) =
  ^fumola_editor(0, "force(pointer(`myRecord))") in

(
  myInt,
  myBool,
  myString,
  myPair,
  myRecord,
  mySome,
  myNested,
  mySymbol,
  myAppliedSymbol,
  mySymbolPair,
  symbolAsText,
  symbolAsData,
  appliedAsSymbol,
  mySpace,
  myCell,
  myPointer,
  myTuplePointer,
  forcedInt,
  forcedPair,
  forcedVariant,
  forcedRecord
)
