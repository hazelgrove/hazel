#HazelHtml Timer Example#
#Elm-style architecture with subscriptions#
#msg = (String, Int), model = (Int, Bool)#

let update : ((String, Int), (Int, Bool)) -> (Int, Bool) = fun (msg, model) ->
  let seconds = fst(model) in
  let running = snd(model) in
  if fst(msg) == "toggle" then
    (seconds, not running)
  else if fst(msg) == "reset" then
    (0, false)
  else if fst(msg) == "tick" then
    if running then (seconds + 1, running)
    else model
  else
    model
in

let view : (Int, Bool) -> HTML = fun model ->
  let seconds = fst(model) in
  let running = snd(model) in
  let minutes = seconds / 60 in
  let secs = seconds % 60 in
  let time_str =
    (if minutes < 10 then "0" else "") ++ string_of_int(minutes) ++ ":" ++
    (if secs < 10 then "0" else "") ++ string_of_int(secs)
  in
  Div(
    [
      Id("timer"),
      Class("timer-app"),
      Style([("text-align", "center"), ("padding", "40px"), ("font-family", "monospace")])
    ],
    [
      H1([Style([("font-size", "72px"), ("margin", "20px")])], [Text(time_str)]),
      Div(
        [],
        [
          Button(
            [
              OnClick(("toggle", 0)),
              Style([("font-size", "24px"), ("padding", "15px 30px"), ("margin", "10px"), ("cursor", "pointer")])
            ],
            [Text(if running then "Pause" else "Start")]
          ),
          Button(
            [
              OnClick(("reset", 0)),
              Style([("font-size", "24px"), ("padding", "15px 30px"), ("margin", "10px"), ("cursor", "pointer")])
            ],
            [Text("Reset")]
          )
        ]
      )
    ]
  )
in

let subs : (Int, Bool) -> Sub = fun model ->
  let running = snd(model) in
  if running then
    Every(1000.0, fun _timestamp -> ("tick", 0))
  else
    SubNone
in

((0, false), update, view, subs)
