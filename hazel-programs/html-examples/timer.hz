# HazelHtml Timer Example #
# A timer that uses the Every subscription to update each second #
# This example uses the App type: ((HTML, Cmd), HTML -> Sub) #

# Timer state is stored as (seconds_elapsed, is_running) #
# We encode this in the HTML structure #

let timer_view = (seconds, running) ->
  let minutes = seconds / 60 in
  let secs = seconds % 60 in
  let time_str =
    (if minutes < 10 then "0" else "") ++ string_of_int(minutes) ++ ":" ++
    (if secs < 10 then "0" else "") ++ string_of_int(secs)
  in
  Div(
    [
      Id("timer"),
      Class("timer-app"),
      Data("seconds", string_of_int(seconds)),
      Data("running", if running then "true" else "false"),
      Style([("text-align", "center"), ("padding", "40px"), ("font-family", "monospace")])
    ],
    [
      H1([Style([("font-size", "72px"), ("margin", "20px")])], [Text(time_str)]),
      Div(
        [],
        [
          Button(
            [
              OnClick(fun html ->
                let new_running = not running in
                timer_view(seconds, new_running)
              ),
              Style([("font-size", "24px"), ("padding", "15px 30px"), ("margin", "10px"), ("cursor", "pointer")])
            ],
            [Text(if running then "Pause" else "Start")]
          ),
          Button(
            [
              OnClick(fun html -> timer_view(0, false)),
              Style([("font-size", "24px"), ("padding", "15px 30px"), ("margin", "10px"), ("cursor", "pointer")])
            ],
            [Text("Reset")]
          )
        ]
      )
    ]
  )
in

# Helper to extract state from HTML #
let get_seconds = html ->
  # In real implementation, we'd parse the data attribute #
  # For now, assume we can access it somehow #
  0
in

let get_running = html ->
  # Would parse data-running attribute #
  false
in

# The subscriptions function - tick every 1000ms when running #
let subscriptions = html ->
  # Extract running state from HTML #
  # When running, subscribe to tick every second #
  Every(1000.0, fun (h, timestamp) ->
    # Would need to extract current seconds and increment #
    # This is a simplified example #
    timer_view(1, true)
  )
in

# Initial state and app tuple #
let init_html = timer_view(0, false) in
let init_cmd = CmdNone in

# App: ((HTML, Cmd), HTML -> Sub) #
((init_html, init_cmd), subscriptions)
