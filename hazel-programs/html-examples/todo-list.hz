#HazelHtml Todo List Example#
#A todo list with add/remove functionality#
#msg = Msg sum type, model = (todos=[String], input_value=String)#

type Msg =
  + AddTodo
  + RemoveTodo(Int)
  + UpdateInput(String)
in

let init = (todos=["Learn Hazel", "Build an app"], input_value="") in

let remove_at : ([String], Int) -> [String] =
  fun (xs, idx) ->
    let indexed = mapi(xs, fun (i, x) -> (i, x)) in
    let filtered = filter(indexed, fun pair -> fst(pair) != idx) in
    map(filtered, fun pair -> snd(pair))
in

let update = fun (msg, model) ->
  case msg
  | AddTodo =>
      if model.input_value == "" then (model, CmdNone)
      else ((todos=model.todos @ [model.input_value], input_value=""), CmdNone)
  | RemoveTodo(idx) =>
      ((todos=remove_at(model.todos, idx), input_value=model.input_value), CmdNone)
  | UpdateInput(value) =>
      ((todos=model.todos, input_value=value), CmdNone)
  end
in

let view = fun model ->
  Div(
    [Class("todo-app"), Style([("max-width", "400px"), ("margin", "20px auto"), ("font-family", "sans-serif")])],
    [
      H2([Style([("text-align", "center")])], [Text("Todo List")]),
      #Input form#
      Div(
        [Style([("display", "flex"), ("margin-bottom", "20px")])],
        [
          Input([
            Type("text"),
            Value(model.input_value),
            Placeholder("Add a todo..."),
            OnInput(fun value -> UpdateInput(value)),
            Style([("flex", "1"), ("padding", "8px"), ("font-size", "16px")])
          ]),
          Button(
            [
              OnClick(AddTodo),
              Style([("padding", "8px 16px"), ("background", "#4CAF50"), ("color", "white"), ("border", "none"), ("cursor", "pointer")])
            ],
            [Text("Add")]
          )
        ]
      ),
      #Todo items#
      Ul(
        [Style([("list-style", "none"), ("padding", "0"), ("margin", "0")])],
        mapi(model.todos, fun (index, item) ->
          Li(
            [Style([("padding", "8px"), ("border-bottom", "1px solid #eee"), ("display", "flex"), ("justify-content", "space-between")])],
            [
              Span([], [Text(item)]),
              Button(
                [
                  OnClick(RemoveTodo(index)),
                  Style([("background", "#ff4444"), ("color", "white"), ("border", "none"), ("padding", "4px 8px"), ("cursor", "pointer")])
                ],
                [Text("X")]
              )
            ]
          )
        )
      ),
      #Item count#
      Div(
        [Style([("text-align", "center"), ("color", "#666"), ("margin-top", "10px")])],
        [Text(string_of_int(length(model.todos)) ++ " items")]
      )
    ]
  )
in

let subs = fun _model -> SubNone in

# Tests #

hint "add todo appends to list"
test
  let (m, _cmd) = update(AddTodo, (todos=["A"], input_value="B")) in
  m.todos == ["A", "B"] && m.input_value == ""
end;

hint "add empty todo does nothing"
test
  let (m, _cmd) = update(AddTodo, (todos=["A"], input_value="")) in
  m.todos == ["A"]
end;

hint "remove first todo"
test
  let (m, _cmd) = update(RemoveTodo(0), (todos=["A", "B", "C"], input_value="")) in
  m.todos == ["B", "C"]
end;

hint "remove last todo"
test
  let (m, _cmd) = update(RemoveTodo(2), (todos=["A", "B", "C"], input_value="")) in
  m.todos == ["A", "B"]
end;

hint "remove middle todo"
test
  let (m, _cmd) = update(RemoveTodo(1), (todos=["A", "B", "C"], input_value="")) in
  m.todos == ["A", "C"]
end;

hint "update input"
test
  let (m, _cmd) = update(UpdateInput("hello"), init) in
  m.input_value == "hello"
end;

(init, update, view, subs)
