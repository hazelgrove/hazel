# NIGHT GROVE CROP PLOTTER #
# Plant a 3x3 grove: pick a seed, then plant cells, rows, or columns #

type Plant = String in
type Grove = [[Plant]] in
type Row = Int in
type Col = Int in

type Model = (
  grove = Grove,
  currentSeed = Plant,
  seedInventory = [Plant]
) in

type Action =
  + SelectSeed(Int)
  + PlantSeed(Row, Col)
  + Uproot(Row, Col)
  + ClearGrove
  + PlantRow(Row)
  + PlantCol(Col)
in

let init: Model = (
  grove = [
    ["", "", ""],
    ["", "", ""],
    ["", "", ""]
  ],
  currentSeed = "🌱",
  seedInventory = ["🌱", "🌿", "🍄", "☘️", "🌸"]
) in

let setCell(grove: Grove, row: Row, col: Col, plant: Plant): Grove =
  mapi(grove, fun (i, r) ->
    if i == row
    then mapi(r, fun (j, c) -> if j == col then plant else c)
    else r)
in

let setRow(grove: Grove, targetRow: Row, plant: Plant): Grove =
  mapi(grove, fun (i, row) ->
    if i == targetRow
    then map(row, fun _ -> plant)
    else row)
in

let setCol(grove: Grove, col: Col, plant: Plant): Grove =
  map(grove, fun row ->
    mapi(row, fun (j, c) -> if j == col then plant else c))
in

let setAll(grove: Grove, plant: Plant): Grove =
  map(grove, fun row -> map(row, fun _ -> plant))
in

let updateGrove(m: Model, f: Grove -> Grove): Model =
  (
    grove = f(m.grove),
    currentSeed = m.currentSeed,
    seedInventory = m.seedInventory
  )
in

let update(action: Action, m: Model): (Model, Cmd) =
  case action
  | SelectSeed(idx) =>
      (
        (
          grove = m.grove,
          currentSeed = nth(m.seedInventory, idx),
          seedInventory = m.seedInventory
        ),
        CmdNone
      )
  | PlantSeed(row, col) =>
      (updateGrove(m, fun g -> setCell(g, row, col, m.currentSeed)), CmdNone)
  | Uproot(row, col) =>
      (updateGrove(m, fun g -> setCell(g, row, col, "")), CmdNone)
  | ClearGrove =>
      (updateGrove(m, fun g -> setAll(g, "")), CmdNone)
  | PlantRow(row) =>
      (updateGrove(m, fun g -> setRow(g, row, m.currentSeed)), CmdNone)
  | PlantCol(col) =>
      (updateGrove(m, fun g -> setCol(g, col, m.currentSeed)), CmdNone)
  end
in

# ===== VIEW ===== #

let view(model: Model): HTML =
  let stripBtn(label: String, action: Action): HTML =
    Button(
      [
        OnClick(action),
        Style([
          ("width", "60px"), ("height", "22px"), ("font-size", "12px"),
          ("background", "#161b22"), ("color", "#8b949e"),
          ("border", "1px solid #30363d"), ("cursor", "pointer")
        ])
      ],
      [Text(label)]
    )
  in
  Div(
    [Style([
      ("max-width", "420px"), ("margin", "20px auto"), ("padding", "20px"),
      ("font-family", "monospace"), ("text-align", "center"),
      ("background", "#0d1117"), ("color", "#c9d1d9"),
      ("border", "1px solid #30363d"), ("border-radius", "12px")
    ])],
    [
      H2([Style([("color", "#3fb950"), ("margin-bottom", "2px")])], [Text("🌙 Crop Plotter")]),
      P(
        [Style([("color", "#8b949e"), ("font-size", "12px"), ("margin-top", "0")])],
        [Text("Click to plant, double-click to uproot")]
      ),
      # Seed inventory #
      Div(
        [Style([("margin-bottom", "12px"), ("display", "flex"), ("justify-content", "center"), ("gap", "5px")])],
        mapi(model.seedInventory, fun (idx, seed) ->
          Button(
            [
              OnClick(SelectSeed(idx)),
              Style([
                ("font-size", "22px"), ("padding", "6px 10px"), ("cursor", "pointer"),
                ("background", "#161b22"),
                ("border", if seed == model.currentSeed then "2px solid #3fb950" else "1px solid #30363d"),
                ("border-radius", "6px")
              ])
            ],
            [Text(seed)]
          )
        )
      ),
      # Column planting strip #
      Div(
        [Style([("display", "flex"), ("justify-content", "center"), ("gap", "2px"), ("margin-left", "62px")])],
        mapi(nth(model.grove, 0), fun (col_idx, _cell) ->
          stripBtn("↓ col", PlantCol(col_idx))
        )
      ),
      # Grove grid, each row prefixed by its row-planting button #
      Div(
        [Style([("display", "inline-block"), ("margin-top", "2px")])],
        mapi(model.grove, fun (row_idx, row) ->
          Div(
            [Style([("display", "flex"), ("justify-content", "center"), ("gap", "2px"), ("margin-bottom", "2px")])],
            [stripBtn("→ row", PlantRow(row_idx))] @
            mapi(row, fun (col_idx, cell) ->
              Button(
                [
                  OnClick(PlantSeed(row_idx, col_idx)),
                  OnDoubleClick(Uproot(row_idx, col_idx)),
                  Style([
                    ("width", "60px"), ("height", "60px"), ("font-size", "26px"),
                    ("background", "#161b22"), ("border", "1px solid #30363d"),
                    ("border-radius", "4px"), ("cursor", "pointer")
                  ])
                ],
                [Text(if cell == "" then " " else cell)]
              )
            )
          )
        )
      ),
      # Controls #
      Div(
        [Style([("margin-top", "12px")])],
        [
          Button(
            [
              OnClick(ClearGrove),
              Style([("padding", "8px 16px"), ("background", "#8b2252"), ("color", "white"),
                     ("border", "none"), ("border-radius", "6px"), ("cursor", "pointer"),
                     ("font-family", "monospace")])
            ],
            [Text("🌾 Clear Grove")]
          )
        ]
      ),
      Div(
        [Style([("margin-top", "10px"), ("color", "#8b949e"), ("font-size", "13px")])],
        [Text("Holding: " ++ model.currentSeed)]
      )
    ]
  )
in

let subs(_model: Model): Sub = SubNone in

# ===== TESTS ===== #

let step(acc: Model, a: Action): Model = let (m, _cmd) = update(a, acc) in m in
let run(m: Model, actions: [Action]): Model = fold_left(actions, step, m) in

hint "planting a row fills that row"
test
  let (m, _cmd) = update(PlantRow(1), init) in
  m.grove == [["", "", ""], ["🌱", "🌱", "🌱"], ["", "", ""]]
end;

hint "planting column 0 fills the left edge"
test
  let (m, _cmd) = update(PlantCol(0), init) in
  m.grove == [["🌱", "", ""], ["🌱", "", ""], ["🌱", "", ""]]
end;

hint "planting column 2 fills the right edge"
test
  let (m, _cmd) = update(PlantCol(2), init) in
  m.grove == [["", "", "🌱"], ["", "", "🌱"], ["", "", "🌱"]]
end;

hint "row and column planting cross"
test
  let m = run(init, [PlantRow(0), PlantCol(1)]) in
  m.grove == [["🌱", "🌱", "🌱"], ["", "🌱", ""], ["", "🌱", ""]]
end;

hint "column planting uses the selected seed"
test
  let m = run(init, [SelectSeed(2), PlantCol(1)]) in
  m.grove == [["", "🍄", ""], ["", "🍄", ""], ["", "🍄", ""]]
  && m.currentSeed == "🍄"
end;

hint "planting a single cell"
test
  let (m, _cmd) = update(PlantSeed(0, 0), init) in
  m.grove == [["🌱", "", ""], ["", "", ""], ["", "", ""]]
end;

hint "uprooting clears one cell of a row"
test
  let m = run(init, [PlantRow(0), Uproot(0, 1)]) in
  m.grove == [["🌱", "", "🌱"], ["", "", ""], ["", "", ""]]
end;

hint "clearing the grove empties every cell"
test
  let m = run(init, [PlantCol(1), ClearGrove]) in
  m.grove == [["", "", ""], ["", "", ""], ["", "", ""]]
end;

(init, update, view, subs)
