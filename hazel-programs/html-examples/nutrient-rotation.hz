# SPECTRAL SOIL LAB - Night Garden Nutrient Tracker #
# A mystical soil management system for sustainable moon farming #
# Adapted from the headless nutrient-rotation program into a full MVU app #

# Soil nutrients are measured 0-100 #
# N = Nitrogen, P = Phosphorus, K = Potassium #
type Soil = (
  n = Int,
  p = Int,
  k = Int
) in

# Crops of the night garden #
type Crop =
  + Nightbeans      # Nitrogen fixer - restores N when harvested #
  + Mooncorn        # Heavy feeder - depletes N significantly #
  + Startomatoes    # Balanced - moderate use of all nutrients #
  + TwilightClover  # Cover crop - restores N when turned under #
in

# A garden plot tracks soil, current crop (if any), and season #
type Model = (
  soil = Soil,
  crop = +None +Some(Crop),
  season = Int
) in

# Actions that can be performed on a plot #
type Action =
  + Plant(Crop)
  + Harvest
  + Compost         # Add organic matter, boosts all nutrients #
  + SeasonChange    # Time passes, nutrients settle #
in

# Utility: clamp value between 0 and 100 #
let clamp : Int -> Int =
  fun x ->
    if x < 0 then 0
    else if x > 100 then 100
    else x
in

# Initial balanced soil - good starting conditions #
let balancedSoil : Soil = (n = 60, p = 60, k = 60) in

# Create a fresh plot with balanced soil #
let init : Model = (
  soil = balancedSoil,
  crop = None,
  season = 1
) in

# Calculate how a crop affects soil when planted #
# Planting takes a small amount of nutrients to establish #
let plantingCost : (Soil, Crop) -> Soil =
  fun (s, crop) ->
    case crop
    | Nightbeans => (n = s.n, p = clamp(s.p - 5), k = clamp(s.k - 5))
    | Mooncorn => (n = clamp(s.n - 5), p = clamp(s.p - 5), k = clamp(s.k - 5))
    | Startomatoes => (n = clamp(s.n - 5), p = clamp(s.p - 5), k = clamp(s.k - 5))
    | TwilightClover => (n = s.n, p = clamp(s.p - 3), k = clamp(s.k - 3))
    end
in

# Calculate how a crop affects soil when harvested #
# This is the main nutrient exchange - crops deplete or restore #
let harvestEffect : (Soil, Crop) -> Soil =
  fun (s, crop) ->
    case crop
    | Nightbeans =>
        # Nitrogen fixer: restores N, uses some P and K #
        (n = clamp(s.n + 15), p = clamp(s.p - 10), k = clamp(s.k - 10))
    | Mooncorn =>
        # Heavy N feeder: depletes N significantly #
        (n = clamp(s.n - 30), p = clamp(s.p - 10), k = clamp(s.k - 15))
    | Startomatoes =>
        # Balanced consumer: moderate depletion across all #
        (n = clamp(s.n - 15), p = clamp(s.p - 15), k = clamp(s.k - 15))
    | TwilightClover =>
        # Cover crop: major N restoration when turned under #
        (n = clamp(s.n + 20), p = clamp(s.p - 5), k = clamp(s.k - 5))
    end
in

# Apply compost - boosts all nutrients #
let applyCompost : Soil -> Soil =
  fun s ->
    (n = clamp(s.n + 10), p = clamp(s.p + 10), k = clamp(s.k + 10))
in

# Season change - minor settling/leaching #
let seasonSettle : Soil -> Soil =
  fun s ->
    (n = clamp(s.n - 3), p = clamp(s.p - 2), k = clamp(s.k - 2))
in

# Main update function: (Action, Model) -> (Model, Cmd) #
let update : (Action, Model) -> (Model, Cmd) =
  fun (action, model) ->
    case action
    | Plant(c) =>
        case model.crop
        | Some(_) => (model, CmdNone)  # Can't plant if crop already growing #
        | None =>
            (
              (
                soil = plantingCost(model.soil, c),
                crop = Some(c),
                season = model.season
              ),
              CmdNone
            )
        end
    | Harvest =>
        case model.crop
        | None => (model, CmdNone)  # Nothing to harvest #
        | Some(c) =>
            (
              (
                soil = harvestEffect(model.soil, c),
                crop = None,
                season = model.season
              ),
              CmdNone
            )
        end
    | Compost =>
        (
          (
            soil = applyCompost(model.soil),
            crop = model.crop,
            season = model.season
          ),
          CmdNone
        )
    | SeasonChange =>
        (
          (
            soil = seasonSettle(model.soil),
            crop = model.crop,
            season = model.season + 1
          ),
          CmdNone
        )
    end
in

# ===== HELPER FUNCTIONS FOR VIEW ===== #

# Season name from season counter (cycles through 4 seasons) #
let seasonName : Int -> String =
  fun s ->
    let phase = int_mod(s - 1, 4) in
    if phase == 0 then "Spring"
    else if phase == 1 then "Summer"
    else if phase == 2 then "Autumn"
    else "Winter"
in

# Season emoji #
let seasonEmoji : Int -> String =
  fun s ->
    let phase = int_mod(s - 1, 4) in
    if phase == 0 then "🌱"
    else if phase == 1 then "☀️"
    else if phase == 2 then "🍂"
    else "❄️"
in

# Crop name as string #
let cropName : Crop -> String =
  fun c ->
    case c
    | Nightbeans => "Nightbeans"
    | Mooncorn => "Mooncorn"
    | Startomatoes => "Startomatoes"
    | TwilightClover => "Twilight Clover"
    end
in

# Crop emoji #
let cropEmoji : Crop -> String =
  fun c ->
    case c
    | Nightbeans => "🫘"
    | Mooncorn => "🌽"
    | Startomatoes => "🍅"
    | TwilightClover => "🍀"
    end
in

# ===== VIEW ===== #

let view : Model -> HTML = fun model ->

  # Shared style values #
  let darkBg = ("background", "#0d1117") in
  let cardBg = ("background", "#161b22") in
  let textColor = ("color", "#c9d1d9") in
  let fontFamily = ("font-family", "monospace, sans-serif") in
  let borderStyle = ("border", "1px solid #30363d") in

  # Nutrient bar: label, value 0-100, color #
  let nutrientBar = fun (label, value, color) ->
    let widthPct = string_of_int(value) ++ "%" in
    Div(
      [Style([("margin-bottom", "12px")])],
      [
        # Label and value row #
        Div(
          [Style([("display", "flex"), ("justify-content", "space-between"), ("margin-bottom", "4px")])],
          [
            Span([Style([("color", "#8b949e"), ("font-size", "13px")])], [Text(label)]),
            Span([Style([("color", color), ("font-size", "13px"), ("font-weight", "bold")])], [Text(string_of_int(value) ++ "/100")])
          ]
        ),
        # Bar background #
        Div(
          [Style([("width", "100%"), ("height", "18px"), ("background", "#21262d"),
                  ("border-radius", "9px"), ("overflow", "hidden"), ("border", "1px solid #30363d")])],
          [
            # Bar fill #
            Div(
              [Style([("width", widthPct), ("height", "18px"), ("background", color),
                      ("border-radius", "9px"), ("transition", "width 0.3s")])],
              []
            )
          ]
        )
      ]
    )
  in

  # Action button helper #
  let actionButton = fun (label, action, bg) ->
    Button(
      [
        OnClick(action),
        Style([
          ("padding", "10px 18px"), ("margin", "5px"),
          ("background", bg), ("color", "#e0e0e0"),
          ("border", "1px solid #30363d"), ("border-radius", "6px"),
          ("cursor", "pointer"), ("font-size", "14px"),
          ("font-weight", "bold"), fontFamily
        ])
      ],
      [Text(label)]
    )
  in

  # Crop display #
  let cropDisplay =
    case model.crop
    | None =>
        Div(
          [Style([("text-align", "center"), ("padding", "16px"), cardBg,
                  ("border-radius", "8px"), borderStyle, ("margin-bottom", "16px")])],
          [
            Div([Style([("font-size", "36px"), ("margin-bottom", "4px")])], [Text("🌫️")]),
            Div([Style([("color", "#8b949e"), ("font-size", "14px")])], [Text("Fallow - No crop planted")])
          ]
        )
    | Some(c) =>
        Div(
          [Style([("text-align", "center"), ("padding", "16px"), cardBg,
                  ("border-radius", "8px"), borderStyle, ("margin-bottom", "16px")])],
          [
            Div([Style([("font-size", "36px"), ("margin-bottom", "4px")])], [Text(cropEmoji(c))]),
            Div([Style([("color", "#c9d1d9"), ("font-size", "16px"), ("font-weight", "bold")])], [Text(cropName(c))]),
            Div([Style([("color", "#8b949e"), ("font-size", "12px"), ("margin-top", "4px")])], [Text("Currently growing")])
          ]
        )
    end
  in

  # Plant crop buttons #
  let plantButtons =
    case model.crop
    | Some(_) =>
        # Can't plant when crop is growing #
        [
          Div(
            [Style([("text-align", "center"), ("color", "#484f58"), ("font-size", "12px"), ("padding", "8px")])],
            [Text("Clear the field first (harvest) to plant")]
          )
        ]
    | None =>
        [
          actionButton("🫘 Nightbeans", Plant(Nightbeans), "#1a3a1a"),
          actionButton("🌽 Mooncorn", Plant(Mooncorn), "#3a3a1a"),
          actionButton("🍅 Startomatoes", Plant(Startomatoes), "#3a1a1a"),
          actionButton("🍀 Clover", Plant(TwilightClover), "#1a3a2a")
        ]
    end
  in

  # Main layout #
  Div(
    [Style([
      darkBg, textColor, fontFamily,
      ("max-width", "480px"), ("margin", "20px auto"),
      ("padding", "24px"), ("border-radius", "12px"),
      ("border", "2px solid #30363d"),
      ("box-shadow", "0 0 40px rgba(80, 200, 120, 0.15)")
    ])],
    [
      # Title #
      H1(
        [Style([("text-align", "center"), ("color", "#3fb950"), ("margin-bottom", "4px"), ("font-size", "22px")])],
        [Text("👻 Spectral Soil Lab 👻")]
      ),
      P(
        [Style([("text-align", "center"), ("color", "#8b949e"), ("margin-top", "0"), ("margin-bottom", "16px"), ("font-size", "12px")])],
        [Text("Mystical nutrient management for moon farming")]
      ),

      # Season indicator #
      Div(
        [Style([("text-align", "center"), ("padding", "12px"), cardBg,
                ("border-radius", "8px"), borderStyle, ("margin-bottom", "16px")])],
        [
          Span([Style([("font-size", "28px")])], [Text(seasonEmoji(model.season))]),
          Span(
            [Style([("font-size", "18px"), ("color", "#58a6ff"), ("margin-left", "12px"), ("font-weight", "bold")])],
            [Text(seasonName(model.season))]
          ),
          Span(
            [Style([("font-size", "13px"), ("color", "#8b949e"), ("margin-left", "8px")])],
            [Text("(Season " ++ string_of_int(model.season) ++ ")")]
          )
        ]
      ),

      # Soil nutrients section #
      H3(
        [Style([("color", "#3fb950"), ("margin-bottom", "8px"), ("font-size", "14px")])],
        [Text("🧪 Soil Nutrients")]
      ),
      Div(
        [Style([("padding", "14px"), cardBg, ("border-radius", "8px"),
                borderStyle, ("margin-bottom", "16px")])],
        [
          nutrientBar("N  Nitrogen", model.soil.n, "#3fb950"),
          nutrientBar("P  Phosphorus", model.soil.p, "#bc8cff"),
          nutrientBar("K  Potassium", model.soil.k, "#f0883e")
        ]
      ),

      # Current crop section #
      H3(
        [Style([("color", "#3fb950"), ("margin-bottom", "8px"), ("font-size", "14px")])],
        [Text("🌾 Current Crop")]
      ),
      cropDisplay,

      # Plant buttons #
      H3(
        [Style([("color", "#3fb950"), ("margin-bottom", "8px"), ("font-size", "14px")])],
        [Text("🌱 Plant")]
      ),
      Div(
        [Style([("display", "flex"), ("flex-wrap", "wrap"), ("justify-content", "center"), ("margin-bottom", "16px")])],
        plantButtons
      ),

      # Action buttons #
      H3(
        [Style([("color", "#3fb950"), ("margin-bottom", "8px"), ("font-size", "14px")])],
        [Text("⚗️ Actions")]
      ),
      Div(
        [Style([("display", "flex"), ("flex-wrap", "wrap"), ("justify-content", "center"), ("margin-bottom", "16px")])],
        [
          actionButton("🌿 Harvest", Harvest, "#238636"),
          actionButton("🧑‍🌾 Compost", Compost, "#6e4000"),
          actionButton("🔄 Season Change", SeasonChange, "#1f6feb")
        ]
      ),

      # Footer #
      Div(
        [Style([("text-align", "center"), ("color", "#484f58"), ("font-size", "11px"),
                ("margin-top", "12px"), ("padding-top", "12px"), ("border-top", "1px solid #21262d")])],
        [Text("👻 Ghost Garden | N:" ++ string_of_int(model.soil.n)
              ++ " P:" ++ string_of_int(model.soil.p)
              ++ " K:" ++ string_of_int(model.soil.k))]
      )
    ]
  )
in

let subs : Model -> Sub = fun _model -> SubNone in

# ===== TEST HELPERS ===== #
let do_step = fun (acc, a) -> let (m, _) = update(a, acc) in m in
let do_actions = fun (m, actions) -> fold_left(actions, do_step, m) in

# ===== TESTS ===== #

# Basic planting tests #
hint "planting sets the current crop"
test
  let (p, _) = update(Plant(Mooncorn), init) in
  p.crop == Some(Mooncorn)
end;

hint "cannot plant when crop already growing"
test
  let p = do_actions(init, [Plant(Mooncorn), Plant(Startomatoes)]) in
  p.crop == Some(Mooncorn)
end;

hint "planting has small nutrient cost"
test
  let (p, _) = update(Plant(Startomatoes), init) in
  p.soil.n < init.soil.n
end;

# Harvest tests #
hint "harvesting clears the crop"
test
  let p = do_actions(init, [Plant(Mooncorn), Harvest]) in
  p.crop == None
end;

hint "harvesting nothing changes nothing"
test
  let (p, _) = update(Harvest, init) in
  p == init
end;

# Crop-specific effects #
hint "mooncorn depletes nitrogen heavily"
test
  let p = do_actions(init, [Plant(Mooncorn), Harvest]) in
  p.soil.n < init.soil.n - 20
end;

hint "nightbeans restore nitrogen"
test
  let depleted : Model = (
    soil = (n = 30, p = 50, k = 50),
    crop = None,
    season = 1
  ) in
  let p = do_actions(depleted, [Plant(Nightbeans), Harvest]) in
  p.soil.n > depleted.soil.n
end;

hint "twilight clover restores nitrogen significantly"
test
  let depleted : Model = (
    soil = (n = 30, p = 60, k = 60),
    crop = None,
    season = 1
  ) in
  let p = do_actions(depleted, [Plant(TwilightClover), Harvest]) in
  p.soil.n >= 45
end;

hint "startomatoes deplete all nutrients moderately"
test
  let p = do_actions(init, [Plant(Startomatoes), Harvest]) in
  p.soil.n < init.soil.n &&
  p.soil.p < init.soil.p &&
  p.soil.k < init.soil.k
end;

# Compost tests #
hint "compost boosts all nutrients"
test
  let (p, _) = update(Compost, init) in
  p.soil.n > init.soil.n &&
  p.soil.p > init.soil.p &&
  p.soil.k > init.soil.k
end;

hint "compost respects maximum (100)"
test
  let rich : Model = (soil = (n = 95, p = 95, k = 95), crop = None, season = 1) in
  let (p, _) = update(Compost, rich) in
  p.soil.n == 100 && p.soil.p == 100 && p.soil.k == 100
end;

# Season change tests #
hint "season advances counter"
test
  let (p, _) = update(SeasonChange, init) in
  p.season == 2
end;

hint "season change causes minor nutrient loss"
test
  let (p, _) = update(SeasonChange, init) in
  p.soil.n < init.soil.n
end;

# Crop rotation scenario #
hint "mooncorn then clover rotation restores nitrogen"
test
  let start : Model = (soil = (n = 60, p = 60, k = 60), crop = None, season = 1) in
  let afterMooncorn = do_actions(start, [Plant(Mooncorn), Harvest]) in
  let afterClover = do_actions(afterMooncorn, [Plant(TwilightClover), Harvest]) in
  afterClover.soil.n > afterMooncorn.soil.n &&
  afterClover.soil.n >= 40
end;

# Nutrients stay in valid range #
hint "nutrients cannot go below 0"
test
  let poor : Model = (soil = (n = 10, p = 10, k = 10), crop = None, season = 1) in
  let p = do_actions(poor, [Plant(Mooncorn), Harvest]) in
  p.soil.n >= 0 && p.soil.p >= 0 && p.soil.k >= 0
end;

hint "nutrients cannot exceed 100"
test
  let rich : Model = (soil = (n = 90, p = 90, k = 90), crop = None, season = 1) in
  let p = do_actions(rich, [Compost, Compost, Compost]) in
  p.soil.n <= 100 && p.soil.p <= 100 && p.soil.k <= 100
end;

(init, update, view, subs)
