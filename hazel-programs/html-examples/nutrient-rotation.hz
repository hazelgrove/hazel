# NIGHT GARDEN NUTRIENT TRACKER #
# Soil management for sustainable moonlight farming #

# Soil nutrients are measured 0-100 #
# N = Nitrogen (leafy growth), P = Phosphorus (roots), K = Potassium (health) #
type Soil = (
  n = Int,
  p = Int,
  k = Int
) in

# The mystical crops of the night garden #
type Crop =
  + Duskwheat    # Nitrogen fixer - restores N when harvested #
  + Moonmelon    # Heavy feeder - depletes N significantly #
  + Starfruit    # Balanced - moderate use of all nutrients #
  + Nightshade   # Cover crop - restores N when turned under #
in

# A garden plot has soil state, optionally a growing crop, and a season #
type Model = (
  soil = Soil,
  crop = +None +Some(Crop),
  season = Int
) in

type Action =
  + Plant(Crop)     # Plant a new crop (fails if plot occupied) #
  + Harvest         # Harvest current crop, apply nutrient effects #
  + Compost         # Add organic matter, boosts all nutrients #
  + SeasonChange    # Time passes, nutrients settle #
in

let clamp(x: Int): Int =
  if x < 0 then 0
  else if x > 100 then 100
  else x
in

let balancedSoil: Soil = (n = 60, p = 60, k = 60) in

let init: Model = (
  soil = balancedSoil,
  crop = None,
  season = 1
) in

# Establishing a crop costs a little of what it needs most #
let plantingCost(s: Soil, crop: Crop): Soil =
  case crop
  | Duskwheat => (n = s.n, p = clamp(s.p - 5), k = clamp(s.k - 5))
  | Moonmelon => (n = clamp(s.n - 5), p = clamp(s.p - 5), k = clamp(s.k - 5))
  | Starfruit => (n = clamp(s.n - 5), p = clamp(s.p - 5), k = clamp(s.k - 5))
  | Nightshade => (n = s.n, p = clamp(s.p - 3), k = clamp(s.k - 3))
  end
in

# Harvesting is the main nutrient exchange: crops deplete or restore #
let harvestEffect(s: Soil, crop: Crop): Soil =
  case crop
  | Duskwheat =>
      # Nitrogen fixer: restores N, uses some P and K #
      (n = clamp(s.n + 15), p = clamp(s.p - 10), k = clamp(s.k - 10))
  | Moonmelon =>
      # Heavy N feeder: depletes nitrogen significantly #
      (n = clamp(s.n - 30), p = clamp(s.p - 10), k = clamp(s.k - 15))
  | Starfruit =>
      # Balanced consumer: moderate depletion across all #
      (n = clamp(s.n - 15), p = clamp(s.p - 15), k = clamp(s.k - 15))
  | Nightshade =>
      # Cover crop turned under: major N restoration #
      (n = clamp(s.n + 20), p = clamp(s.p - 5), k = clamp(s.k - 5))
  end
in

let applyCompost(s: Soil): Soil =
  (n = clamp(s.n + 10), p = clamp(s.p + 10), k = clamp(s.k + 10))
in

let seasonSettle(s: Soil): Soil =
  (n = clamp(s.n - 3), p = clamp(s.p - 2), k = clamp(s.k - 2))
in

let update(action: Action, plot: Model): (Model, Cmd) =
  case action
  | Plant(crop) =>
      # Only plant if the plot is empty #
      case plot.crop
      | Some(_) => (plot, CmdNone)
      | None =>
          (
            (
              soil = plantingCost(plot.soil, crop),
              crop = Some(crop),
              season = plot.season
            ),
            CmdNone
          )
      end
  | Harvest =>
      case plot.crop
      | None => (plot, CmdNone)
      | Some(crop) =>
          (
            (
              soil = harvestEffect(plot.soil, crop),
              crop = None,
              season = plot.season
            ),
            CmdNone
          )
      end
  | Compost =>
      (
        (soil = applyCompost(plot.soil), crop = plot.crop, season = plot.season),
        CmdNone
      )
  | SeasonChange =>
      (
        (soil = seasonSettle(plot.soil), crop = plot.crop, season = plot.season + 1),
        CmdNone
      )
  end
in

# ===== VIEW HELPERS ===== #

let seasonName(s: Int): String =
  let phase = int_mod(s - 1, 4) in
  if phase == 0 then "Spring"
  else if phase == 1 then "Summer"
  else if phase == 2 then "Autumn"
  else "Winter"
in

let seasonEmoji(s: Int): String =
  let phase = int_mod(s - 1, 4) in
  if phase == 0 then "🌱"
  else if phase == 1 then "🌙"
  else if phase == 2 then "🍂"
  else "❄️"
in

let cropName(c: Crop): String =
  case c
  | Duskwheat => "Duskwheat"
  | Moonmelon => "Moonmelon"
  | Starfruit => "Starfruit"
  | Nightshade => "Nightshade"
  end
in

let cropEmoji(c: Crop): String =
  case c
  | Duskwheat => "🌾"
  | Moonmelon => "🍈"
  | Starfruit => "🌟"
  | Nightshade => "🍇"
  end
in

# ===== VIEW ===== #

let view(model: Model): HTML =

  # Shared style values #
  let darkBg = ("background", "#0d1117") in
  let cardBg = ("background", "#161b22") in
  let textColor = ("color", "#c9d1d9") in
  let fontFamily = ("font-family", "monospace, sans-serif") in
  let borderStyle = ("border", "1px solid #30363d") in

  # Nutrient bar: label, value 0-100, color #
  let nutrientBar(label: String, value: Int, color: String): HTML =
    let widthPct = string_of_int(value) ++ "%" in
    Div(
      [Style([("margin-bottom", "12px")])],
      [
        Div(
          [Style([("display", "flex"), ("justify-content", "space-between"), ("margin-bottom", "4px")])],
          [
            Span([Style([("color", "#8b949e"), ("font-size", "13px")])], [Text(label)]),
            Span([Style([("color", color), ("font-size", "13px"), ("font-weight", "bold")])],
                 [Text(string_of_int(value) ++ "/100")])
          ]
        ),
        Div(
          [Style([("width", "100%"), ("height", "18px"), ("background", "#21262d"),
                  ("border-radius", "9px"), ("overflow", "hidden"), ("border", "1px solid #30363d")])],
          [
            Div(
              [Style([("width", widthPct), ("height", "18px"), ("background", color),
                      ("border-radius", "9px"), ("transition", "width 0.3s")])],
              []
            )
          ]
        )
      ]
    )
  in

  let actionButton(label: String, action: Action, bg: String): HTML =
    Button(
      [
        OnClick(action),
        Style([
          ("padding", "10px 18px"), ("margin", "5px"),
          ("background", bg), ("color", "#e0e0e0"),
          ("border", "1px solid #30363d"), ("border-radius", "6px"),
          ("cursor", "pointer"), ("font-size", "14px"),
          ("font-weight", "bold"), fontFamily
        ])
      ],
      [Text(label)]
    )
  in

  let cropDisplay =
    case model.crop
    | None =>
        Div(
          [Style([("text-align", "center"), ("padding", "16px"), cardBg,
                  ("border-radius", "8px"), borderStyle, ("margin-bottom", "16px")])],
          [
            Div([Style([("font-size", "36px"), ("margin-bottom", "4px")])], [Text("🌫️")]),
            Div([Style([("color", "#8b949e"), ("font-size", "14px")])], [Text("Fallow - No crop planted")])
          ]
        )
    | Some(c) =>
        Div(
          [Style([("text-align", "center"), ("padding", "16px"), cardBg,
                  ("border-radius", "8px"), borderStyle, ("margin-bottom", "16px")])],
          [
            Div([Style([("font-size", "36px"), ("margin-bottom", "4px")])], [Text(cropEmoji(c))]),
            Div([Style([("color", "#c9d1d9"), ("font-size", "16px"), ("font-weight", "bold")])], [Text(cropName(c))]),
            Div([Style([("color", "#8b949e"), ("font-size", "12px"), ("margin-top", "4px")])], [Text("Currently growing")])
          ]
        )
    end
  in

  let plantButtons =
    case model.crop
    | Some(_) =>
        [
          Div(
            [Style([("text-align", "center"), ("color", "#484f58"), ("font-size", "12px"), ("padding", "8px")])],
            [Text("Clear the field first (harvest) to plant")]
          )
        ]
    | None =>
        [
          actionButton("🌾 Duskwheat", Plant(Duskwheat), "#3a3a1a"),
          actionButton("🍈 Moonmelon", Plant(Moonmelon), "#1a3a2a"),
          actionButton("🌟 Starfruit", Plant(Starfruit), "#3a3320"),
          actionButton("🍇 Nightshade", Plant(Nightshade), "#2a1a3a")
        ]
    end
  in

  Div(
    [Style([
      darkBg, textColor, fontFamily,
      ("max-width", "480px"), ("margin", "20px auto"),
      ("padding", "24px"), ("border-radius", "12px"),
      ("border", "2px solid #30363d"),
      ("box-shadow", "0 0 40px rgba(80, 200, 120, 0.15)")
    ])],
    [
      H1(
        [Style([("text-align", "center"), ("color", "#3fb950"), ("margin-bottom", "4px"), ("font-size", "22px")])],
        [Text("🌙 Moonlit Soil Lab 🌙")]
      ),
      P(
        [Style([("text-align", "center"), ("color", "#8b949e"), ("margin-top", "0"), ("margin-bottom", "16px"), ("font-size", "12px")])],
        [Text("Nutrient management for the night garden")]
      ),

      # Season indicator #
      Div(
        [Style([("text-align", "center"), ("padding", "12px"), cardBg,
                ("border-radius", "8px"), borderStyle, ("margin-bottom", "16px")])],
        [
          Span([Style([("font-size", "28px")])], [Text(seasonEmoji(model.season))]),
          Span(
            [Style([("font-size", "18px"), ("color", "#58a6ff"), ("margin-left", "12px"), ("font-weight", "bold")])],
            [Text(seasonName(model.season))]
          ),
          Span(
            [Style([("font-size", "13px"), ("color", "#8b949e"), ("margin-left", "8px")])],
            [Text("(Season " ++ string_of_int(model.season) ++ ")")]
          )
        ]
      ),

      # Soil nutrients #
      H3(
        [Style([("color", "#3fb950"), ("margin-bottom", "8px"), ("font-size", "14px")])],
        [Text("🧪 Soil Nutrients")]
      ),
      Div(
        [Style([("padding", "14px"), cardBg, ("border-radius", "8px"),
                borderStyle, ("margin-bottom", "16px")])],
        [
          nutrientBar("N  Nitrogen", model.soil.n, "#3fb950"),
          nutrientBar("P  Phosphorus", model.soil.p, "#bc8cff"),
          nutrientBar("K  Potassium", model.soil.k, "#f0883e")
        ]
      ),

      # Current crop #
      H3(
        [Style([("color", "#3fb950"), ("margin-bottom", "8px"), ("font-size", "14px")])],
        [Text("🌾 Current Crop")]
      ),
      cropDisplay,

      # Plant buttons #
      H3(
        [Style([("color", "#3fb950"), ("margin-bottom", "8px"), ("font-size", "14px")])],
        [Text("🌱 Plant")]
      ),
      Div(
        [Style([("display", "flex"), ("flex-wrap", "wrap"), ("justify-content", "center"), ("margin-bottom", "16px")])],
        plantButtons
      ),

      # Actions #
      H3(
        [Style([("color", "#3fb950"), ("margin-bottom", "8px"), ("font-size", "14px")])],
        [Text("⚗️ Actions")]
      ),
      Div(
        [Style([("display", "flex"), ("flex-wrap", "wrap"), ("justify-content", "center"), ("margin-bottom", "16px")])],
        [
          actionButton("🌿 Harvest", Harvest, "#238636"),
          actionButton("🧑‍🌾 Compost", Compost, "#6e4000"),
          actionButton("🔄 Season Change", SeasonChange, "#1f6feb")
        ]
      ),

      Div(
        [Style([("text-align", "center"), ("color", "#484f58"), ("font-size", "11px"),
                ("margin-top", "12px"), ("padding-top", "12px"), ("border-top", "1px solid #21262d")])],
        [Text("🌙 Night Garden | N:" ++ string_of_int(model.soil.n)
              ++ " P:" ++ string_of_int(model.soil.p)
              ++ " K:" ++ string_of_int(model.soil.k))]
      )
    ]
  )
in

let subs(_model: Model): Sub = SubNone in

# ===== TESTS ===== #

let step(acc: Model, a: Action): Model = let (m, _cmd) = update(a, acc) in m in
let run(plot: Model, actions: [Action]): Model = fold_left(actions, step, plot) in

hint "planting sets the current crop"
test
  let (p, _cmd) = update(Plant(Moonmelon), init) in
  p.crop == Some(Moonmelon)
end;

hint "cannot plant when crop already growing"
test
  let p = run(init, [Plant(Moonmelon), Plant(Starfruit)]) in
  p.crop == Some(Moonmelon)
end;

hint "planting has small nutrient cost"
test
  let (p, _cmd) = update(Plant(Starfruit), init) in
  p.soil.n < init.soil.n
end;

hint "harvesting clears the crop"
test
  let p = run(init, [Plant(Moonmelon), Harvest]) in
  p.crop == None
end;

hint "harvesting nothing changes nothing"
test
  let (p, _cmd) = update(Harvest, init) in
  p == init
end;

hint "moonmelon depletes nitrogen heavily"
test
  let p = run(init, [Plant(Moonmelon), Harvest]) in
  p.soil.n < init.soil.n - 20
end;

hint "duskwheat restores nitrogen"
test
  let depleted: Model = (
    soil = (n = 30, p = 50, k = 50),
    crop = None,
    season = 1
  ) in
  let p = run(depleted, [Plant(Duskwheat), Harvest]) in
  p.soil.n > depleted.soil.n
end;

hint "nightshade restores nitrogen significantly"
test
  let depleted: Model = (
    soil = (n = 30, p = 60, k = 60),
    crop = None,
    season = 1
  ) in
  let p = run(depleted, [Plant(Nightshade), Harvest]) in
  p.soil.n >= 45
end;

hint "starfruit depletes all nutrients moderately"
test
  let p = run(init, [Plant(Starfruit), Harvest]) in
  p.soil.n < init.soil.n &&
  p.soil.p < init.soil.p &&
  p.soil.k < init.soil.k
end;

hint "compost boosts all nutrients"
test
  let (p, _cmd) = update(Compost, init) in
  p.soil.n > init.soil.n &&
  p.soil.p > init.soil.p &&
  p.soil.k > init.soil.k
end;

hint "compost respects maximum (100)"
test
  let rich: Model = (soil = (n = 95, p = 95, k = 95), crop = None, season = 1) in
  let (p, _cmd) = update(Compost, rich) in
  p.soil.n == 100 && p.soil.p == 100 && p.soil.k == 100
end;

hint "season advances counter"
test
  let (p, _cmd) = update(SeasonChange, init) in
  p.season == 2
end;

hint "season change causes minor nutrient loss"
test
  let (p, _cmd) = update(SeasonChange, init) in
  p.soil.n < init.soil.n
end;

hint "moonmelon then nightshade rotation restores nitrogen"
test
  let afterMoonmelon = run(init, [Plant(Moonmelon), Harvest]) in
  let afterNightshade = run(afterMoonmelon, [Plant(Nightshade), Harvest]) in
  afterNightshade.soil.n > afterMoonmelon.soil.n &&
  afterNightshade.soil.n >= 40
end;

hint "nutrients cannot go below 0"
test
  let poor: Model = (soil = (n = 10, p = 10, k = 10), crop = None, season = 1) in
  let p = run(poor, [Plant(Moonmelon), Harvest]) in
  p.soil.n >= 0 && p.soil.p >= 0 && p.soil.k >= 0
end;

hint "nutrients cannot exceed 100"
test
  let rich: Model = (soil = (n = 90, p = 90, k = 90), crop = None, season = 1) in
  let p = run(rich, [Compost, Compost, Compost]) in
  p.soil.n <= 100 && p.soil.p <= 100 && p.soil.k <= 100
end;

(init, update, view, subs)
