#MVU Counter Example#
#Elm-style architecture: (init_model, update, view, subs)#
#Handlers produce messages routed through update#

#update: (msg, model) -> model#
#Messages are integers representing the delta#
let update = fun (msg, model) -> model + msg in

#view: model -> HTML#
#OnClick takes a bare message value, not a function#
let view = fun model ->
  Div(
    [Class("counter"), Style([("text-align", "center"), ("padding", "20px")])],
    [
      H2([], [Text("MVU Counter")]),
      Div(
        [Style([("font-size", "48px"), ("margin", "20px")])],
        [Int(model)]
      ),
      Div(
        [],
        [
          Button(
            [
              OnClick(-1),
              Style([("font-size", "24px"), ("margin", "10px"), ("padding", "10px 20px")])
            ],
            [Text("-")]
          ),
          Button(
            [
              OnClick(1),
              Style([("font-size", "24px"), ("margin", "10px"), ("padding", "10px 20px")])
            ],
            [Text("+")]
          )
        ]
      ),
      P(
        [Style([("color", "#666"), ("font-size", "12px")])],
        [Text("Click buttons to change count")]
      )
    ]
  )
in

#subs: model -> Sub#
let subs = fun _model -> SubNone in

#App 4-tuple: (init_model, update, view, subs)#
(0, update, view, subs)
