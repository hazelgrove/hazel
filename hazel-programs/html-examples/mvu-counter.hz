#MVU Counter Example: moonflowers in bloom#
#Elm-style architecture: (init_model, update, view, subs)#
#msg = Int, model = Int#

let update(msg, model) = (model + msg, CmdNone) in

let view(model: Int) : HTML = Div(
  [Class("counter"), Style([("text-align", "center"), ("padding", "20px")])],
  [
    H2([], [Text("Moonflowers in Bloom")]),
    Div(
      [Style([("font-size", "48px"), ("margin", "20px")])],
      [Int(model)]
    ),
    Div(
      [],
      [
        Button([
          OnClick(-1),
          Style([("font-size", "24px"), ("margin", "10px"), ("padding", "10px 20px")])
          ],
          [Text("-")]
          ),
        Button([
              OnClick(1),
              Style([("font-size", "24px"), ("margin", "10px"), ("padding", "10px 20px")])
            ],
            [Text("+")]
          )
        ]
      ),
      P(
        [Style([("color", "#666"), ("font-size", "12px")])],
        [Text("Plant a moonflower, or pick one")]
      )
    ]
  )
in

let subs(_model: Int) : Sub = SubNone in

# Tests #

hint "planting adds a moonflower"
test let (m, _cmd) = update(1, 0) in m == 1 end;

hint "picking removes one"
test let (m, _cmd) = update(-1, 5) in m == 4 end;

(0, update, view, subs)
