#HazelHtml Full App Example#
#Elm-style architecture with tabs, forms, commands, and subscriptions#
#msg = Msg sum type, model = (active_tab=String, form_name=String, form_message=String, saved_message=String)#

type Msg =
  + Tab(String)
  + Name(String)
  + Message(String)
  + Submit
in

let init = (active_tab="Home", form_name="", form_message="", saved_message="") in

let update = fun (msg, model) ->
  case msg
  | Tab(tab) =>
      ((active_tab=tab, form_name=model.form_name, form_message=model.form_message, saved_message=model.saved_message),
       CmdNone)
  | Name(name) =>
      ((active_tab=model.active_tab, form_name=name, form_message=model.form_message, saved_message=model.saved_message),
       CmdNone)
  | Message(text) =>
      ((active_tab=model.active_tab, form_name=model.form_name, form_message=text, saved_message=model.saved_message),
       CmdNone)
  | Submit =>
      let new_saved = model.form_name ++ ": " ++ model.form_message in
      ((active_tab=model.active_tab, form_name="", form_message="", saved_message=new_saved),
       CmdBatch([Log("Form submitted: " ++ new_saved), Focus("name-input")]))
  end
in

let view = fun model ->
  let tabs : [String] = ["Home", "Form", "About"] in
  Div(
    [
      Id("app"),
      Style([
        ("max-width", "500px"),
        ("margin", "20px auto"),
        ("font-family", "Arial, sans-serif"),
        ("border", "1px solid #ddd"),
        ("border-radius", "8px"),
        ("overflow", "hidden")
      ])
    ],
    [
      #Header with tabs#
      Div(
        [Style([("display", "flex"), ("background", "#333")])],
        map(tabs, fun tab ->
          Button(
            [
              OnClick(Tab(tab)),
              Style([
                ("flex", "1"),
                ("padding", "15px"),
                ("border", "none"),
                ("background", if tab == model.active_tab then "#4CAF50" else "#333"),
                ("color", "white"),
                ("cursor", "pointer"),
                ("font-size", "14px")
              ])
            ],
            [Text(tab)]
          )
        )
      ),
      #Content area#
      Div(
        [Style([("padding", "20px"), ("min-height", "200px")])],
        [
          if model.active_tab == "Home" then
            Div([], [
              H2([], [Text("Welcome to HazelHtml!")]),
              P([], [Text("This is a demo app showing various features:")]),
              Ul([], [
                Li([], [Text("Tab navigation")]),
                Li([], [Text("Form handling with OnInput")]),
                Li([], [Text("Commands (Focus, Log)")]),
                Li([], [Text("Responsive styling")])
              ]),
              if model.saved_message != "" then
                Div(
                  [Style([("background", "#e8f5e9"), ("padding", "10px"), ("margin-top", "20px"), ("border-radius", "4px")])],
                  [Text("Last saved: " ++ model.saved_message)]
                )
              else
                Div([], [])
            ])
          else if model.active_tab == "Form" then
            Div([], [
              H2([], [Text("Contact Form")]),
              Div(
                [Style([("margin-bottom", "15px")])],
                [
                  Label([Style([("display", "block"), ("margin-bottom", "5px")])], [Text("Name:")]),
                  Input([
                    Id("name-input"),
                    Type("text"),
                    Value(model.form_name),
                    Placeholder("Enter your name"),
                    OnInput(fun value -> Name(value)),
                    Style([("width", "100%"), ("padding", "8px"), ("box-sizing", "border-box")])
                  ])
                ]
              ),
              Div(
                [Style([("margin-bottom", "15px")])],
                [
                  Label([Style([("display", "block"), ("margin-bottom", "5px")])], [Text("Message:")]),
                  TextArea(
                    [
                      Value(model.form_message),
                      Placeholder("Enter your message"),
                      OnInput(fun value -> Message(value)),
                      Style([("width", "100%"), ("padding", "8px"), ("height", "100px"), ("box-sizing", "border-box")])
                    ],
                    model.form_message
                  )
                ]
              ),
              Button(
                [
                  OnClick(Submit),
                  Style([
                    ("background", "#4CAF50"),
                    ("color", "white"),
                    ("padding", "10px 20px"),
                    ("border", "none"),
                    ("cursor", "pointer"),
                    ("border-radius", "4px")
                  ])
                ],
                [Text("Submit")]
              )
            ])
          else
            Div([], [
              H2([], [Text("About HazelHtml")]),
              P([], [Text("HazelHtml is a web app library for Hazel.")]),
              Ul([], [
                Li([], [Text("HTML element types (Div, Button, Input, etc.)")]),
                Li([], [Text("Attribute types (Class, Style, OnClick, etc.)")]),
                Li([], [Text("Command types (Focus, Delay, Log, etc.)")]),
                Li([], [Text("Subscription types (OnResize, Every, etc.)")])
              ])
            ])
        ]
      ),
      #Footer#
      Div(
        [Style([("background", "#f5f5f5"), ("padding", "10px"), ("text-align", "center"), ("color", "#666"), ("font-size", "12px")])],
        [Text("Built with HazelHtml")]
      )
    ]
  )
in

let subs = fun _model -> SubNone in

# Tests #

hint "tab switch"
test
  let (m, _cmd) = update(Tab("Form"), init) in
  m.active_tab == "Form"
end;

hint "name input"
test
  let (m, _cmd) = update(Name("Alice"), init) in
  m.form_name == "Alice"
end;

hint "message input"
test
  let (m, _cmd) = update(Message("Hello"), init) in
  m.form_message == "Hello"
end;

hint "submit clears form and saves"
test
  let filled = (active_tab="Form", form_name="Bob", form_message="Hi", saved_message="") in
  let (m, _cmd) = update(Submit, filled) in
  m.form_name == "" && m.form_message == "" && m.saved_message == "Bob: Hi"
end;

hint "tab preserves form data"
test
  let (filled, _) = update(Name("Alice"), init) in
  let (m, _cmd) = update(Tab("About"), filled) in
  m.form_name == "Alice"
end;

(init, update, view, subs)
