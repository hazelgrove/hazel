# HazelHtml Keyboard Example #
# A simple game where you move a box with arrow keys #
# Uses OnDocumentKeyDown subscription for global key events #

# Position state encoded in the HTML #
let game_view = (x, y) =>
  Div(
    [
      Id("game"),
      Data("x", string_of_int(x)),
      Data("y", string_of_int(y)),
      Style([
        ("width", "400px"),
        ("height", "400px"),
        ("position", "relative"),
        ("background", "#f0f0f0"),
        ("border", "2px solid #333"),
        ("margin", "20px auto")
      ])
    ],
    [
      # Instructions #
      Div(
        [Style([("text-align", "center"), ("padding", "10px"), ("color", "#666")])],
        [Text("Use arrow keys to move the box")]
      ),
      # The movable box #
      Div(
        [Style([
          ("width", "40px"),
          ("height", "40px"),
          ("background", "#4CAF50"),
          ("position", "absolute"),
          ("left", string_of_int(x) ++ "px"),
          ("top", string_of_int(y) ++ "px"),
          ("border-radius", "4px"),
          ("transition", "all 0.1s ease")
        ])],
        []
      ),
      # Position display #
      Div(
        [Style([("position", "absolute"), ("bottom", "10px"), ("left", "10px"), ("color", "#333")])],
        [Text("Position: (" ++ string_of_int(x) ++ ", " ++ string_of_int(y) ++ ")")]
      )
    ]
  )
in

# Handle keyboard events #
# KeyEvent = (key, code, ctrl, shift, alt, meta) #
let handle_key = (html, key_event) =>
  let (key, code, ctrl, shift, alt, meta) = key_event in
  let step = 20 in
  # Would need to extract x, y from html in real implementation #
  let x = 180 in  # Center position for demo #
  let y = 180 in
  if key == "ArrowUp" then
    game_view(x, max(0, y - step))
  else if key == "ArrowDown" then
    game_view(x, min(360, y + step))
  else if key == "ArrowLeft" then
    game_view(max(0, x - step), y)
  else if key == "ArrowRight" then
    game_view(min(360, x + step), y)
  else
    game_view(x, y)
in

# Subscriptions - listen for keyboard events #
let subscriptions = html =>
  OnDocumentKeyDown(handle_key)
in

# Initial state at center #
let init_html = game_view(180, 180) in

# App tuple #
((init_html, CmdNone), subscriptions)
