#HazelHtml Keyboard Game#
#Move a box with arrow keys using OnDocumentKeyDown subscription#
#msg = Msg sum type, model = (x=Int, y=Int)#

type Msg =
  + MoveUp
  + MoveDown
  + MoveLeft
  + MoveRight
  + NoOp
in

let max : (Int, Int) -> Int = fun (a, b) -> if a > b then a else b in
let min : (Int, Int) -> Int = fun (a, b) -> if a < b then a else b in

let step : Int = 20 in

let init = (x=180, y=180) in

let update = fun (msg, model) ->
  case msg
  | MoveUp => (x=model.x, y=max(0, model.y - step))
  | MoveDown => (x=model.x, y=min(360, model.y + step))
  | MoveLeft => (x=max(0, model.x - step), y=model.y)
  | MoveRight => (x=min(360, model.x + step), y=model.y)
  | NoOp => model
  end
in

let view = fun model ->
  Div(
    [
      Id("game"),
      Style([
        ("width", "400px"),
        ("height", "400px"),
        ("position", "relative"),
        ("background", "#f0f0f0"),
        ("border", "2px solid #333"),
        ("margin", "20px auto")
      ])
    ],
    [
      Div(
        [Style([("text-align", "center"), ("padding", "10px"), ("color", "#666")])],
        [Text("Use arrow keys to move the box")]
      ),
      Div(
        [Style([
          ("width", "40px"),
          ("height", "40px"),
          ("background", "#4CAF50"),
          ("position", "absolute"),
          ("left", string_of_int(model.x) ++ "px"),
          ("top", string_of_int(model.y) ++ "px"),
          ("border-radius", "4px"),
          ("transition", "all 0.1s ease")
        ])],
        []
      ),
      Div(
        [Style([("position", "absolute"), ("bottom", "10px"), ("left", "10px"), ("color", "#333")])],
        [Text("Position: (" ++ string_of_int(model.x) ++ ", " ++ string_of_int(model.y) ++ ")")]
      )
    ]
  )
in

let subs = fun _model ->
  OnDocumentKeyDown(fun (key, _code, _ctrl, _shift, _alt, _meta) ->
    if key == "ArrowUp" then MoveUp
    else if key == "ArrowDown" then MoveDown
    else if key == "ArrowLeft" then MoveLeft
    else if key == "ArrowRight" then MoveRight
    else NoOp
  )
in

# Tests #

hint "move up decreases y"
test
  let m = update(MoveUp, (x=100, y=100)) in
  m.y == 80
end;

hint "move down increases y"
test
  let m = update(MoveDown, (x=100, y=100)) in
  m.y == 120
end;

hint "move left decreases x"
test
  let m = update(MoveLeft, (x=100, y=100)) in
  m.x == 80
end;

hint "move right increases x"
test
  let m = update(MoveRight, (x=100, y=100)) in
  m.x == 120
end;

hint "clamp at top boundary"
test
  let m = update(MoveUp, (x=100, y=0)) in
  m.y == 0
end;

hint "clamp at bottom boundary"
test
  let m = update(MoveDown, (x=100, y=360)) in
  m.y == 360
end;

hint "clamp at left boundary"
test
  let m = update(MoveLeft, (x=0, y=100)) in
  m.x == 0
end;

hint "clamp at right boundary"
test
  let m = update(MoveRight, (x=360, y=100)) in
  m.x == 360
end;

hint "noop does nothing"
test
  let m = update(NoOp, (x=100, y=100)) in
  m.x == 100 && m.y == 100
end;

(init, update, view, subs)
