#HazelHtml Keyboard Game#
#Steer a firefly around the grove with arrow keys, via OnDocumentKeyDown#
#msg = Msg sum type, model = (x=Int, y=Int)#

type Msg =
  + MoveUp
  + MoveDown
  + MoveLeft
  + MoveRight
  + NoOp
in

let max(a: Int, b: Int) : Int = if a > b then a else b in
let min(a: Int, b: Int) : Int = if a < b then a else b in

let step : Int = 20 in

let init = (x=180, y=180) in

let update(msg, model) =
  case msg
  | MoveUp => ((x=model.x, y=max(0, model.y - step)), CmdNone)
  | MoveDown => ((x=model.x, y=min(360, model.y + step)), CmdNone)
  | MoveLeft => ((x=max(0, model.x - step), y=model.y), CmdNone)
  | MoveRight => ((x=min(360, model.x + step), y=model.y), CmdNone)
  | NoOp => (model, CmdNone)
  end
in

let view(model) =
  Div(
    [
      Id("grove"),
      Style([
        ("width", "400px"),
        ("height", "400px"),
        ("position", "relative"),
        ("background", "#0d1117"),
        ("border", "2px solid #30363d"),
        ("margin", "20px auto")
      ])
    ],
    [
      Div(
        [Style([("text-align", "center"), ("padding", "10px"), ("color", "#8b949e")])],
        [Text("Steer the firefly with the arrow keys")]
      ),
      Div(
        [Style([
          ("width", "40px"),
          ("height", "40px"),
          ("background", "#f7e26b"),
          ("position", "absolute"),
          ("left", string_of_int(model.x) ++ "px"),
          ("top", string_of_int(model.y) ++ "px"),
          ("border-radius", "50%"),
          ("box-shadow", "0 0 18px #f7e26b"),
          ("transition", "all 0.1s ease")
        ])],
        []
      ),
      Div(
        [Style([("position", "absolute"), ("bottom", "10px"), ("left", "10px"), ("color", "#8b949e")])],
        [Text("Position: (" ++ string_of_int(model.x) ++ ", " ++ string_of_int(model.y) ++ ")")]
      )
    ]
  )
in

let subs(_model) =
  OnDocumentKeyDown(fun e ->
    if e.key == "ArrowUp" then MoveUp
    else if e.key == "ArrowDown" then MoveDown
    else if e.key == "ArrowLeft" then MoveLeft
    else if e.key == "ArrowRight" then MoveRight
    else NoOp
  )
in

# Tests #

hint "move up decreases y"
test
  let (m, _cmd) = update(MoveUp, (x=100, y=100)) in
  m.y == 80
end;

hint "move down increases y"
test
  let (m, _cmd) = update(MoveDown, (x=100, y=100)) in
  m.y == 120
end;

hint "move left decreases x"
test
  let (m, _cmd) = update(MoveLeft, (x=100, y=100)) in
  m.x == 80
end;

hint "move right increases x"
test
  let (m, _cmd) = update(MoveRight, (x=100, y=100)) in
  m.x == 120
end;

hint "clamp at top boundary"
test
  let (m, _cmd) = update(MoveUp, (x=100, y=0)) in
  m.y == 0
end;

hint "clamp at bottom boundary"
test
  let (m, _cmd) = update(MoveDown, (x=100, y=360)) in
  m.y == 360
end;

hint "clamp at left boundary"
test
  let (m, _cmd) = update(MoveLeft, (x=0, y=100)) in
  m.x == 0
end;

hint "clamp at right boundary"
test
  let (m, _cmd) = update(MoveRight, (x=360, y=100)) in
  m.x == 360
end;

hint "noop does nothing"
test
  let (m, _cmd) = update(NoOp, (x=100, y=100)) in
  m.x == 100 && m.y == 100
end;

(init, update, view, subs)
