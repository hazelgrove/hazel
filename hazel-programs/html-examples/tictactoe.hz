# SPROUTS AND SHROOMS #
# Tic-tac-toe in the night garden: sprouts race shrooms for three in a row #

type Cell = + Empty + Sprout + Shroom in

type Board = [Cell] in  # 9 cells, row-major: [0,1,2,3,4,5,6,7,8] #

type Player = + PlayerSprout + PlayerShroom in

type GameStatus =
  + InProgress
  + Won(Player)
  + Draw
in

type Model = (
  board = Board,
  turn = Player,
  status = GameStatus
) in

type Msg = + ClickCell(Int) + NewGame in

let emptyBoard: Board =
  [Empty, Empty, Empty,
   Empty, Empty, Empty,
   Empty, Empty, Empty]
in

let init: Model = (
  board = emptyBoard,
  turn = PlayerSprout,
  status = InProgress
) in

let getCell(board: Board, pos: Int): Cell = nth(board, pos) in

let setCell(board: Board, pos: Int, cell: Cell): Board =
  mapi(board, fun (i, c) -> if i == pos then cell else c)
in

let playerCell(p: Player): Cell =
  case p
  | PlayerSprout => Sprout
  | PlayerShroom => Shroom
  end
in

let cellStr(c: Cell): String =
  case c
  | Empty => " "
  | Sprout => "🌱"
  | Shroom => "🍄"
  end
in

# Three matching non-empty cells win a line #
let threeInRow(a: Cell, b: Cell, c: Cell): Option =
  case (a, b, c)
  | (Sprout, Sprout, Sprout) => Some(Sprout)
  | (Shroom, Shroom, Shroom) => Some(Shroom)
  | _ => None
  end
in

let getCells3(board: Board, i: Int, j: Int, k: Int): (Cell, Cell, Cell) =
  (getCell(board, i), getCell(board, j), getCell(board, k))
in

let checkWinner(board: Board): Option =
  # Rows #
  let row0 = threeInRow(getCells3(board, 0, 1, 2)) in
  let row1 = threeInRow(getCells3(board, 3, 4, 5)) in
  let row2 = threeInRow(getCells3(board, 6, 7, 8)) in
  # Columns #
  let col0 = threeInRow(getCells3(board, 0, 3, 6)) in
  let col1 = threeInRow(getCells3(board, 1, 4, 7)) in
  let col2 = threeInRow(getCells3(board, 2, 5, 8)) in
  # Diagonals #
  let diag1 = threeInRow(getCells3(board, 0, 4, 8)) in
  let diag2 = threeInRow(getCells3(board, 2, 4, 6)) in
  # First winning line found #
  case row0 | Some(c) => Some(c) | None =>
  case row1 | Some(c) => Some(c) | None =>
  case row2 | Some(c) => Some(c) | None =>
  case col0 | Some(c) => Some(c) | None =>
  case col1 | Some(c) => Some(c) | None =>
  case col2 | Some(c) => Some(c) | None =>
  case diag1 | Some(c) => Some(c) | None =>
  diag2
  end end end end end end end
in

let isFull(board: Board): Bool = for_all(board, fun c -> c != Empty) in

let cellToPlayer(c: Cell): Player =
  case c
  | Sprout => PlayerSprout
  | Shroom => PlayerShroom
  | Empty => PlayerSprout  # shouldn't happen #
  end
in

let calcStatus(board: Board): GameStatus =
  case checkWinner(board)
  | Some(c) => Won(cellToPlayer(c))
  | None => if isFull(board) then Draw else InProgress
  end
in

let nextPlayer(p: Player): Player =
  case p
  | PlayerSprout => PlayerShroom
  | PlayerShroom => PlayerSprout
  end
in

let isValidMove(m: Model, pos: Int): Bool =
  pos >= 0 && pos < 9 &&
  getCell(m.board, pos) == Empty &&
  m.status == InProgress
in

let move(m: Model, pos: Int): Model =
  if isValidMove(m, pos) then
    let newBoard = setCell(m.board, pos, playerCell(m.turn)) in
    (
      board = newBoard,
      turn = nextPlayer(m.turn),
      status = calcStatus(newBoard)
    )
  else m  # Invalid move, no change #
in

let update(msg: Msg, m: Model): (Model, Cmd) =
  case msg
  | ClickCell(pos) => (move(m, pos), CmdNone)
  | NewGame => (init, CmdNone)
  end
in

# ===== VIEW ===== #

let view(model: Model): HTML =
  let playerName(p: Player): String =
    case p
    | PlayerSprout => "Sprout"
    | PlayerShroom => "Shroom"
    end
  in
  let statusText =
    case model.status
    | InProgress => playerName(model.turn) ++ "'s turn"
    | Won(p) => playerName(p) ++ " wins!"
    | Draw => "The plot is full - a draw!"
    end
  in
  let boardRow(positions: [Int]): HTML =
    Div([Style([("display", "flex")])],
      map(positions, fun pos ->
        Button(
          [
            OnClick(ClickCell(pos)),
            Style([
              ("width", "80px"), ("height", "80px"), ("font-size", "36px"),
              ("border", "1px solid #30363d"), ("cursor", "pointer"),
              ("background", "#161b22")
            ])
          ],
          [Text(cellStr(getCell(model.board, pos)))]
        )
      )
    )
  in
  Div(
    [Style([("max-width", "300px"), ("margin", "20px auto"), ("text-align", "center"),
            ("font-family", "monospace"), ("background", "#0d1117"), ("color", "#c9d1d9"),
            ("padding", "20px"), ("border-radius", "12px"), ("border", "1px solid #30363d")])],
    [
      H2([Style([("color", "#3fb950"), ("margin-bottom", "4px")])], [Text("🌱 Sprouts and Shrooms 🍄")]),
      P([Style([("font-size", "16px"), ("margin-bottom", "15px"), ("color", "#8b949e")])], [Text(statusText)]),
      Div(
        [Style([("display", "inline-block")])],
        [boardRow([0, 1, 2]), boardRow([3, 4, 5]), boardRow([6, 7, 8])]
      ),
      Div(
        [Style([("margin-top", "15px")])],
        [
          Button(
            [
              OnClick(NewGame),
              Style([("padding", "10px 20px"), ("font-size", "14px"), ("background", "#238636"),
                     ("color", "white"), ("border", "none"), ("cursor", "pointer"),
                     ("border-radius", "6px"), ("font-family", "monospace")])
            ],
            [Text("New Plot")]
          )
        ]
      )
    ]
  )
in

let subs(_model: Model): Sub = SubNone in

# ===== TESTS ===== #

let play(m: Model, moves: [Int]): Model = fold_left(moves, move, m) in

hint "initial board is empty"
test for_all(init.board, fun c -> c == Empty) end;

hint "sprout plays first"
test init.turn == PlayerSprout end;

hint "game starts in progress"
test init.status == InProgress end;

hint "move places correct marker"
test
  let m = move(init, 0) in
  getCell(m.board, 0) == Sprout
end;

hint "turn alternates after move"
test
  let m = move(init, 0) in
  m.turn == PlayerShroom
end;

hint "second move places a shroom"
test
  let m = play(init, [0, 4]) in
  getCell(m.board, 4) == Shroom
end;

hint "invalid move on occupied cell"
test
  let m = play(init, [0, 0]) in  # Sprout plays 0, Shroom tries 0 #
  getCell(m.board, 0) == Sprout &&
  m.turn == PlayerShroom
end;

hint "sprout wins with top row"
test
  let m = play(init, [0, 3, 1, 4, 2]) in
  m.status == Won(PlayerSprout)
end;

hint "shroom wins with middle column"
test
  let m = play(init, [0, 1, 2, 4, 6, 7]) in
  m.status == Won(PlayerShroom)
end;

hint "shroom wins with bottom row"
test
  let m = play(init, [0, 6, 1, 7, 4, 8]) in
  m.status == Won(PlayerShroom)
end;

hint "sprout wins with main diagonal"
test
  let m = play(init, [0, 1, 4, 2, 8]) in
  m.status == Won(PlayerSprout)
end;

hint "sprout wins with anti-diagonal"
test
  let m = play(init, [2, 0, 4, 1, 6]) in
  m.status == Won(PlayerSprout)
end;

hint "sprout wins with left column"
test
  let m = play(init, [0, 1, 3, 4, 6]) in
  m.status == Won(PlayerSprout)
end;

hint "sprout wins with right column"
test
  let m = play(init, [2, 0, 5, 1, 8]) in
  m.status == Won(PlayerSprout)
end;

hint "draw when board full with no winner"
test
  let m = play(init, [0, 1, 2, 5, 3, 6, 4, 8, 7]) in
  case m.status | Draw => true | _ => false end
end;

hint "no moves after win"
test
  let m = play(init, [0, 3, 1, 4, 2, 5]) in
  case m.status | Won(PlayerSprout) => getCell(m.board, 5) == Empty | _ => false end
end;

hint "can't move to position 9 or higher"
test
  let m = move(init, 9) in
  for_all(m.board, fun c -> c == Empty)
end;

hint "can't move to negative position"
test
  let m = move(init, -1) in
  for_all(m.board, fun c -> c == Empty)
end;

hint "new game resets"
test
  let m = play(init, [0, 1, 4]) in
  let (m2, _cmd) = update(NewGame, m) in
  for_all(m2.board, fun c -> c == Empty) && m2.turn == PlayerSprout
end;

(init, update, view, subs)
