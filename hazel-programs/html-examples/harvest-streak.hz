# NIGHT GARDEN HARVEST LEDGER #
# Track your harvest under the stars! #
# Consecutive harvests of the same quality build streak bonuses #

# Quality tiers from the moonlit fields #
type Quality =
  + Bronze      # Common harvest, basic value #
  + Silver      # Good quality, moderate bonus #
  + Gold        # Excellent harvest, high value #
  + Starlight   # Legendary, blessed by the moon #
in

# Crops that grow under the night sky #
type Crop =
  + Moonmelon
  + Starfruit
  + Nightshade
  + Glowpumpkin
  + Duskwheat
in

# A single harvest from the garden #
type Harvest = (
  crop = Crop,
  quality = Quality,
  quantity = Int
) in

# The harvest ledger tracks all harvests and bonuses #
type Model = (
  harvests = [Harvest],
  totalValue = Int,
  streakBonus = Int,
  lastQuality = Quality
) in

# Actions the farmer can take #
type Action =
  + RecordHarvest(Harvest)  # Log a new harvest #
  + ClaimBonus              # Collect accumulated streak bonus #
  + CloseDay                # End the harvest day, reset streaks #
in

let cropValue(c: Crop): Int =
  case c
  | Moonmelon => 15
  | Starfruit => 20
  | Nightshade => 20
  | Glowpumpkin => 12
  | Duskwheat => 10
  end
in

let qualityMultiplier(q: Quality): Int =
  case q
  | Bronze => 1
  | Silver => 2
  | Gold => 3
  | Starlight => 5
  end
in

let harvestValue(h: Harvest): Int =
  cropValue(h.crop) * qualityMultiplier(h.quality) * h.quantity
in

let init: Model = (
  harvests = [],
  totalValue = 0,
  streakBonus = 0,
  lastQuality = Bronze
) in

# A streak continues when consecutive harvests share a quality tier #
let processHarvest(ledger: Model, h: Harvest): Model =
  let value = harvestValue(h) in
  let isFirst = length(ledger.harvests) == 0 in
  let continues = !isFirst && h.quality == ledger.lastQuality in
  let newStreak = if continues then ledger.streakBonus + 5 else 0 in
  (
    harvests = h :: ledger.harvests,
    totalValue = ledger.totalValue + value + newStreak,
    streakBonus = newStreak,
    lastQuality = h.quality
  )
in

let claimBonus(ledger: Model): Model =
  (
    harvests = ledger.harvests,
    totalValue = ledger.totalValue + ledger.streakBonus,
    streakBonus = 0,
    lastQuality = ledger.lastQuality
  )
in

# Close the harvest day: keep the ledger, reset streak tracking #
let closeDay(ledger: Model): Model =
  (
    harvests = ledger.harvests,
    totalValue = ledger.totalValue,
    streakBonus = 0,
    lastQuality = Bronze
  )
in

let update(action: Action, ledger: Model): (Model, Cmd) =
  case action
  | RecordHarvest(h) => (processHarvest(ledger, h), CmdNone)
  | ClaimBonus => (claimBonus(ledger), CmdNone)
  | CloseDay => (closeDay(ledger), CmdNone)
  end
in

# ===== VIEW HELPERS ===== #

let cropName(c: Crop): String =
  case c
  | Moonmelon => "Moonmelon"
  | Starfruit => "Starfruit"
  | Nightshade => "Nightshade"
  | Glowpumpkin => "Glowpumpkin"
  | Duskwheat => "Duskwheat"
  end
in

let qualityLabel(q: Quality): String =
  case q
  | Bronze => "Bronze"
  | Silver => "Silver"
  | Gold => "Gold"
  | Starlight => "Starlight"
  end
in

let qualityEmoji(q: Quality): String =
  case q
  | Bronze => "🥉"
  | Silver => "🥈"
  | Gold => "🥇"
  | Starlight => "⭐"
  end
in

let qualityColor(q: Quality): String =
  case q
  | Bronze => "#cd7f32"
  | Silver => "#c0c0c0"
  | Gold => "#ffd700"
  | Starlight => "#e0b0ff"
  end
in

# ===== VIEW ===== #

let view(model: Model): HTML =
  let harvestRows =
    let ordered = reverse(model.harvests) in
    mapi(ordered, fun (i, h) ->
      Tr(
        [Style([("border-bottom", "1px solid #21262d")])],
        [
          Td(
            [Style([("padding", "8px 12px"), ("color", "#8b949e")])],
            [Text(string_of_int(i + 1))]
          ),
          Td(
            [Style([("padding", "8px 12px"), ("color", "#c9d1d9")])],
            [Text(cropName(h.crop))]
          ),
          Td(
            [Style([("padding", "8px 12px"), ("color", qualityColor(h.quality))])],
            [Text(qualityEmoji(h.quality) ++ " " ++ qualityLabel(h.quality))]
          ),
          Td(
            [Style([("padding", "8px 12px"), ("color", "#c9d1d9"), ("text-align", "right")])],
            [Text(string_of_int(h.quantity))]
          ),
          Td(
            [Style([("padding", "8px 12px"), ("color", "#58a6ff"), ("text-align", "right"), ("font-weight", "bold")])],
            [Text(string_of_int(harvestValue(h)))]
          )
        ]
      )
    )
  in
  let harvestButton(h: Harvest): HTML =
    Button(
      [OnClick(RecordHarvest(h)),
       Style([("padding", "8px 14px"), ("background", "#21262d"), ("color", qualityColor(h.quality)),
              ("border", "1px solid #30363d"), ("border-radius", "6px"),
              ("cursor", "pointer"), ("font-family", "monospace"), ("font-size", "12px")])],
      [Text(qualityEmoji(h.quality) ++ " " ++ cropName(h.crop) ++ " x" ++ string_of_int(h.quantity))]
    )
  in
  let headerCell(label: String, align: String): HTML =
    Th([Style([("padding", "8px 12px"), ("text-align", align), ("color", "#8b949e"),
               ("font-size", "11px"), ("text-transform", "uppercase")])],
       [Text(label)])
  in
  let statBlock(label: String, color: String, value: String): HTML =
    Div(
      [Style([("text-align", "center")])],
      [
        Div([Style([("font-size", "11px"), ("color", "#8b949e"), ("margin-bottom", "4px")])],
            [Text(label)]),
        Div([Style([("font-size", "24px"), ("color", color), ("font-weight", "bold")])],
            [Text(value)])
      ]
    )
  in
  Div(
    [Style([
      ("max-width", "600px"), ("margin", "20px auto"), ("font-family", "monospace"),
      ("background", "#0d1117"), ("padding", "24px"), ("border-radius", "12px"),
      ("color", "#c9d1d9"), ("border", "1px solid #30363d")
    ])],
    [
      H1(
        [Style([("text-align", "center"), ("color", "#e0b0ff"), ("margin-bottom", "4px"), ("font-size", "24px")])],
        [Text("🌙 Harvest Ledger 🌙")]
      ),
      P(
        [Style([("text-align", "center"), ("color", "#8b949e"), ("margin-top", "0"), ("font-size", "12px")])],
        [Text("Track your night garden harvests")]
      ),
      Hr([Style([("border", "none"), ("border-top", "1px solid #21262d"), ("margin", "16px 0")])]),

      # Summary stats #
      Div(
        [Style([("display", "flex"), ("justify-content", "space-around"), ("margin-bottom", "20px"),
                ("padding", "12px"), ("background", "#161b22"), ("border-radius", "8px"),
                ("border", "1px solid #21262d")])],
        [
          statBlock("TOTAL VALUE", "#58a6ff", string_of_int(model.totalValue)),
          statBlock("STREAK BONUS",
                    if model.streakBonus > 0 then "#3fb950" else "#484f58",
                    "+" ++ string_of_int(model.streakBonus)),
          statBlock("LAST QUALITY", qualityColor(model.lastQuality), qualityEmoji(model.lastQuality))
        ]
      ),

      # Harvest table #
      Table(
        [Style([("width", "100%"), ("border-collapse", "collapse"), ("margin-bottom", "20px")])],
        [
          Thead(
            [Style([("border-bottom", "2px solid #30363d")])],
            [
              Tr(
                [],
                [
                  headerCell("#", "left"),
                  headerCell("Crop", "left"),
                  headerCell("Quality", "left"),
                  headerCell("Qty", "right"),
                  headerCell("Value", "right")
                ]
              )
            ]
          ),
          Tbody(
            [],
            if length(model.harvests) == 0
            then [
              Tr([], [
                Td(
                  [Style([("padding", "20px"), ("text-align", "center"), ("color", "#484f58"), ("font-style", "italic")])],
                  [Text("No harvests yet... the garden awaits")]
                )
              ])
            ]
            else harvestRows
          )
        ]
      ),

      # Record-harvest buttons #
      Div(
        [Style([("display", "flex"), ("flex-wrap", "wrap"), ("gap", "8px"), ("margin-bottom", "12px")])],
        [
          H3([Style([("width", "100%"), ("color", "#e0b0ff"), ("font-size", "14px"), ("margin", "4px 0")])],
             [Text("🌙 Record Harvest")]),
          harvestButton((crop = Moonmelon, quality = Bronze, quantity = 2)),
          harvestButton((crop = Starfruit, quality = Silver, quantity = 1)),
          harvestButton((crop = Nightshade, quality = Gold, quantity = 1)),
          harvestButton((crop = Glowpumpkin, quality = Gold, quantity = 3)),
          harvestButton((crop = Duskwheat, quality = Bronze, quantity = 4)),
          harvestButton((crop = Moonmelon, quality = Starlight, quantity = 1))
        ]
      ),

      # Ledger actions #
      Div(
        [Style([("display", "flex"), ("gap", "8px"), ("margin-top", "8px")])],
        [
          Button(
            [OnClick(ClaimBonus),
             Style([("padding", "8px 16px"), ("background", "#238636"), ("color", "white"),
                    ("border", "none"), ("border-radius", "6px"),
                    ("cursor", "pointer"), ("font-family", "monospace"), ("font-size", "13px")])],
            [Text("💰 Claim Bonus")]
          ),
          Button(
            [OnClick(CloseDay),
             Style([("padding", "8px 16px"), ("background", "#8b2252"), ("color", "white"),
                    ("border", "none"), ("border-radius", "6px"),
                    ("cursor", "pointer"), ("font-family", "monospace"), ("font-size", "13px")])],
            [Text("🌅 Close Day")]
          )
        ]
      ),

      Div(
        [Style([("text-align", "center"), ("color", "#484f58"), ("font-size", "11px"),
                ("margin-top", "16px"), ("padding-top", "12px"), ("border-top", "1px solid #21262d")])],
        [Text("🌱 Harvests: " ++ string_of_int(length(model.harvests)) ++ " | Night Garden Ledger")]
      )
    ]
  )
in

let subs(_model: Model): Sub = SubNone in

# ===== TESTS ===== #

let step(acc: Model, a: Action): Model = let (m, _cmd) = update(a, acc) in m in
let run(ledger: Model, actions: [Action]): Model = fold_left(actions, step, ledger) in

hint "recording harvest adds to total value"
test
  let h: Harvest = (crop = Moonmelon, quality = Bronze, quantity = 2) in
  let (ledger, _cmd) = update(RecordHarvest(h), init) in
  # Moonmelon(15) * Bronze(1) * 2 = 30, no streak bonus on the first #
  ledger.totalValue == 30
end;

hint "harvest is added to harvests list"
test
  let h: Harvest = (crop = Starfruit, quality = Silver, quantity = 1) in
  let (ledger, _cmd) = update(RecordHarvest(h), init) in
  length(ledger.harvests) == 1
end;

hint "silver quality doubles value"
test
  let h: Harvest = (crop = Duskwheat, quality = Silver, quantity = 1) in
  let (ledger, _cmd) = update(RecordHarvest(h), init) in
  ledger.totalValue == 20
end;

hint "gold quality triples value"
test
  let h: Harvest = (crop = Duskwheat, quality = Gold, quantity = 1) in
  let (ledger, _cmd) = update(RecordHarvest(h), init) in
  ledger.totalValue == 30
end;

hint "starlight quality gives 5x value"
test
  let h: Harvest = (crop = Nightshade, quality = Starlight, quantity = 1) in
  let (ledger, _cmd) = update(RecordHarvest(h), init) in
  ledger.totalValue == 100
end;

hint "same quality builds streak"
test
  let h1: Harvest = (crop = Moonmelon, quality = Gold, quantity = 1) in
  let h2: Harvest = (crop = Starfruit, quality = Gold, quantity = 1) in
  let ledger = run(init, [RecordHarvest(h1), RecordHarvest(h2)]) in
  ledger.streakBonus == 5
end;

hint "streak bonus accumulates with consecutive same-quality harvests"
test
  let h1: Harvest = (crop = Moonmelon, quality = Silver, quantity = 1) in
  let h2: Harvest = (crop = Starfruit, quality = Silver, quantity = 1) in
  let h3: Harvest = (crop = Nightshade, quality = Silver, quantity = 1) in
  let ledger = run(init, [
    RecordHarvest(h1),
    RecordHarvest(h2),
    RecordHarvest(h3)
  ]) in
  ledger.streakBonus == 10
end;

hint "different quality resets streak"
test
  let h1: Harvest = (crop = Moonmelon, quality = Bronze, quantity = 1) in
  let h2: Harvest = (crop = Starfruit, quality = Gold, quantity = 1) in
  let ledger = run(init, [RecordHarvest(h1), RecordHarvest(h2)]) in
  ledger.streakBonus == 0
end;

hint "streak resets then can build again"
test
  let h1: Harvest = (crop = Moonmelon, quality = Bronze, quantity = 1) in
  let h2: Harvest = (crop = Starfruit, quality = Gold, quantity = 1) in
  let h3: Harvest = (crop = Nightshade, quality = Gold, quantity = 1) in
  let ledger = run(init, [
    RecordHarvest(h1),
    RecordHarvest(h2),
    RecordHarvest(h3)
  ]) in
  ledger.streakBonus == 5
end;

hint "claiming bonus banks it and resets the streak"
test
  let h1: Harvest = (crop = Moonmelon, quality = Gold, quantity = 1) in
  let h2: Harvest = (crop = Starfruit, quality = Gold, quantity = 1) in
  let earned = run(init, [RecordHarvest(h1), RecordHarvest(h2)]) in
  let ledger = run(earned, [ClaimBonus]) in
  ledger.streakBonus == 0 && ledger.totalValue == earned.totalValue + 5
end;

hint "closing day resets streak tracking"
test
  let h1: Harvest = (crop = Moonmelon, quality = Gold, quantity = 1) in
  let h2: Harvest = (crop = Starfruit, quality = Gold, quantity = 1) in
  let ledger = run(init, [
    RecordHarvest(h1),
    RecordHarvest(h2),
    CloseDay
  ]) in
  ledger.streakBonus == 0 && ledger.lastQuality == Bronze
end;

hint "lastQuality tracks most recent harvest quality"
test
  let h: Harvest = (crop = Moonmelon, quality = Starlight, quantity = 1) in
  let (ledger, _cmd) = update(RecordHarvest(h), init) in
  ledger.lastQuality == Starlight
end;

hint "starfruit and nightshade have the highest base value"
test
  let h1: Harvest = (crop = Nightshade, quality = Bronze, quantity = 1) in
  let h2: Harvest = (crop = Moonmelon, quality = Bronze, quantity = 1) in
  let (ledger1, _c1) = update(RecordHarvest(h1), init) in
  let (ledger2, _c2) = update(RecordHarvest(h2), init) in
  ledger1.totalValue > ledger2.totalValue &&
  cropValue(Starfruit) == cropValue(Nightshade)
end;

hint "duskwheat has the lowest base value"
test
  let h1: Harvest = (crop = Duskwheat, quality = Bronze, quantity = 1) in
  let h2: Harvest = (crop = Glowpumpkin, quality = Bronze, quantity = 1) in
  let (ledger1, _c1) = update(RecordHarvest(h1), init) in
  let (ledger2, _c2) = update(RecordHarvest(h2), init) in
  ledger1.totalValue < ledger2.totalValue
end;

hint "quantity multiplies value"
test
  let h: Harvest = (crop = Moonmelon, quality = Bronze, quantity = 5) in
  let (ledger, _cmd) = update(RecordHarvest(h), init) in
  ledger.totalValue == 75
end;

hint "full harvest day scenario"
test
  let ledger = run(init, [
    # Dusk: Bronze harvests build a streak #
    RecordHarvest((crop = Duskwheat, quality = Bronze, quantity = 3)),
    RecordHarvest((crop = Moonmelon, quality = Bronze, quantity = 2)),
    # Midnight: switch to Gold, streak resets #
    RecordHarvest((crop = Starfruit, quality = Gold, quantity = 1)),
    RecordHarvest((crop = Nightshade, quality = Gold, quantity = 1)),
    # Dawn: claim and close #
    ClaimBonus,
    CloseDay
  ]) in
  ledger.streakBonus == 0 &&
  length(ledger.harvests) == 4
end;

(init, update, view, subs)
