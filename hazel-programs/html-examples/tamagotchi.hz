# HAUNTED TOASTER - A Tamagotchi-style Virtual Pet #
# Your pet is a possessed kitchen appliance with feelings #
# Late night ghost gardener / haunted theme #

type Stat = Int in  # 0-100 range #

type Stats = (
  hunger = Stat,     # 0 = starving, 100 = stuffed #
  happiness = Stat,  # 0 = miserable, 100 = ecstatic #
  energy = Stat,     # 0 = exhausted, 100 = hyperactive #
  health = Stat      # 0 = broken, 100 = pristine #
) in

type Evolution =
  + BabyToaster      # Just possessed, learning the ropes #
  + TeenToaster      # Moody, unpredictable #
  + AdultToaster     # Mature, stable #
  + GoldenToaster    # Legendary, well-cared-for #
  + RustyToaster     # Neglected, cranky #
in

type Personality =
  + Cheerful
  + Grumpy
  + Anxious
  + Balanced
in

type Memory = (
  timesFed = Int,
  timesPlayed = Int,
  timesSlept = Int,
  timesNeglected = Int
) in

type Model = (
  stats = Stats,
  evolution = Evolution,
  personality = Personality,
  memory = Memory,
  age = Int           # Time ticks elapsed #
) in

type Action =
  + Feed              # Reduces hunger, slight energy boost #
  + Play              # Increases happiness, costs energy #
  + Sleep             # Restores energy, slight health boost #
  + Repair            # Fixes health issues #
  + TimeTick          # Time passes, stats decay #
in

# Utility: clamp value between 0 and 100 #
let clamp : Int -> Int =
  fun x ->
    if x < 0 then 0
    else if x > 100 then 100
    else x
in

# Initial state: a fresh baby toaster #
let init: Model = (
  stats = (
    hunger = 50,
    happiness = 50,
    energy = 50,
    health = 100
  ),
  evolution = BabyToaster,
  personality = Balanced,
  memory = (
    timesFed = 0,
    timesPlayed = 0,
    timesSlept = 0,
    timesNeglected = 0
  ),
  age = 0
) in

# Calculate stat decay based on current stats #
let decayStats : Stats -> Stats =
  fun s ->
    let hungerDecay = 5 in
    let happinessDecay =
      if s.hunger < 30 then 8  # Hungry makes mood worse #
      else 3
    in
    let energyDecay = 2 in
    let healthDecay =
      if s.energy < 20 then 5   # Exhaustion hurts health #
      else if s.hunger < 20 then 3  # Starvation hurts health #
      else 0
    in
    (
      hunger = clamp(s.hunger - hungerDecay),
      happiness = clamp(s.happiness - happinessDecay),
      energy = clamp(s.energy - energyDecay),
      health = clamp(s.health - healthDecay)
    )
in

# Determine personality based on memory #
let calcPersonality : Memory -> Personality =
  fun m ->
    let careScore = m.timesFed + m.timesPlayed + m.timesSlept in
    let neglectScore = m.timesNeglected in
    if neglectScore > careScore then Grumpy
    else if m.timesPlayed > m.timesFed + m.timesSlept then Cheerful
    else if m.timesNeglected > 5 then Anxious
    else Balanced
in

# Determine evolution based on age and care quality #
let calcEvolution : (Int, Memory) -> Evolution =
  fun (age, m) ->
    let careScore = m.timesFed + m.timesPlayed + m.timesSlept in
    let neglectScore = m.timesNeglected in
    if age < 10 then BabyToaster
    else if age < 25 then TeenToaster
    else if careScore > neglectScore * 3 then GoldenToaster
    else if neglectScore > careScore then RustyToaster
    else AdultToaster
in

# Check if stats indicate neglect (any stat critically low) #
let isNeglected : Stats -> Bool =
  fun s ->
    s.hunger < 15 || s.happiness < 15 || s.energy < 10 || s.health < 20
in

# Update memory based on action #
let updateMemory : (Memory, Action, Stats) -> Memory =
  fun (m, action, stats) ->
    case action
    | Feed => (timesFed = m.timesFed + 1, timesPlayed = m.timesPlayed, timesSlept = m.timesSlept, timesNeglected = m.timesNeglected)
    | Play => (timesFed = m.timesFed, timesPlayed = m.timesPlayed + 1, timesSlept = m.timesSlept, timesNeglected = m.timesNeglected)
    | Sleep => (timesFed = m.timesFed, timesPlayed = m.timesPlayed, timesSlept = m.timesSlept + 1, timesNeglected = m.timesNeglected)
    | Repair => m
    | TimeTick =>
        if isNeglected(stats)
        then (timesFed = m.timesFed, timesPlayed = m.timesPlayed, timesSlept = m.timesSlept, timesNeglected = m.timesNeglected + 1)
        else m
    end
in

# Apply an action to stats #
let applyAction : (Stats, Action, Personality) -> Stats =
  fun (s, action, personality) ->
    # Personality affects action effectiveness #
    let bonus = case personality
      | Cheerful => 5
      | Grumpy => -5
      | Anxious => -2
      | Balanced => 0
      end
    in
    case action
    | Feed =>
        (
          hunger = clamp(s.hunger + 30 + bonus),
          happiness = clamp(s.happiness + 5),
          energy = clamp(s.energy + 10),
          health = s.health
        )
    | Play =>
        if s.energy < 20
        then # Too tired to play effectively #
          (
            hunger = s.hunger,
            happiness = clamp(s.happiness + 5),
            energy = clamp(s.energy - 5),
            health = s.health
          )
        else
          (
            hunger = clamp(s.hunger - 10),
            happiness = clamp(s.happiness + 25 + bonus),
            energy = clamp(s.energy - 15),
            health = s.health
          )
    | Sleep =>
        (
          hunger = clamp(s.hunger - 5),
          happiness = s.happiness,
          energy = clamp(s.energy + 40 + bonus),
          health = clamp(s.health + 5)
        )
    | Repair =>
        (
          hunger = s.hunger,
          happiness = clamp(s.happiness - 10),  # Repairs are uncomfortable #
          energy = s.energy,
          health = clamp(s.health + 35 + bonus)
        )
    | TimeTick => decayStats(s)
    end
in

# Main update function: (Action, Model) -> (Model, Cmd) #
let update =
  fun (action, model) ->
    let newStats = applyAction(model.stats, action, model.personality) in
    let newMemory = updateMemory(model.memory, action, model.stats) in
    let newAge = case action
      | TimeTick => model.age + 1
      | _ => model.age
      end
    in
    let newModel = (
      stats = newStats,
      evolution = calcEvolution(newAge, newMemory),
      personality = calcPersonality(newMemory),
      memory = newMemory,
      age = newAge
    ) in
    (newModel, CmdNone)
in

# Generate n TimeTicks #
let timePasses : Int -> [Action] =
  fun n ->
    if n <= 0 then []
    else map(range(1, n), fun _ -> TimeTick)
in

# Test helpers #
let do_step = fun (acc, a) -> let (m, _) = update(a, acc) in m in
let do_actions = fun (m, actions) -> fold_left(actions, do_step, m) in

# ===== VIEW ===== #

let evolutionEmoji = fun evo ->
  case evo
  | BabyToaster => "🍞"
  | TeenToaster => "🔥"
  | AdultToaster => "⚡"
  | GoldenToaster => "✨"
  | RustyToaster => "🪦"
  end
in

let evolutionName = fun evo ->
  case evo
  | BabyToaster => "Baby Toaster"
  | TeenToaster => "Teen Toaster"
  | AdultToaster => "Adult Toaster"
  | GoldenToaster => "Golden Toaster"
  | RustyToaster => "Rusty Toaster"
  end
in

let personalityStr = fun p ->
  case p
  | Cheerful => "😊 Cheerful"
  | Grumpy => "😠 Grumpy"
  | Anxious => "😰 Anxious"
  | Balanced => "😐 Balanced"
  end
in

let statBar = fun (label, value, color) ->
  let widthPx = string_of_int(value * 2) ++ "px" in
  Div(
    [Style([("margin-bottom", "10px")])],
    [
      Div(
        [Style([("display", "flex"), ("justify-content", "space-between"), ("margin-bottom", "3px")])],
        [
          Span([Style([("color", "#b0b0b0"), ("font-size", "13px")])], [Text(label)]),
          Span([Style([("color", "#e0e0e0"), ("font-size", "13px"), ("font-weight", "bold")])], [Text(string_of_int(value))])
        ]
      ),
      Div(
        [Style([("width", "200px"), ("height", "16px"), ("background", "#2a2a3e"),
                ("border-radius", "8px"), ("overflow", "hidden"), ("border", "1px solid #3a3a5e")])],
        [
          Div(
            [Style([("width", widthPx), ("height", "16px"), ("background", color),
                    ("border-radius", "8px"), ("transition", "width 0.3s")])],
            []
          )
        ]
      )
    ]
  )
in

let actionButton = fun (label, action, bg) ->
  Button(
    [
      OnClick(action),
      Style([
        ("padding", "10px 18px"), ("margin", "5px"),
        ("background", bg), ("color", "white"),
        ("border", "none"), ("border-radius", "6px"),
        ("cursor", "pointer"), ("font-size", "15px"),
        ("font-weight", "bold")
      ])
    ],
    [Text(label)]
  )
in

let view = fun model ->
  let emoji = evolutionEmoji(model.evolution) in
  let name = evolutionName(model.evolution) in
  Div(
    [Style([
      ("background", "#1a1a2e"), ("color", "#e0e0e0"),
      ("font-family", "'Courier New', monospace"),
      ("max-width", "420px"), ("margin", "20px auto"),
      ("padding", "24px"), ("border-radius", "12px"),
      ("border", "2px solid #3a3a5e"),
      ("box-shadow", "0 0 30px rgba(100, 60, 180, 0.3)")
    ])],
    [
      # Title #
      H2(
        [Style([("text-align", "center"), ("color", "#9b59b6"), ("margin-bottom", "5px")])],
        [Text("👻 Haunted Toaster 👻")]
      ),
      # Evolution display #
      Div(
        [Style([("text-align", "center"), ("margin-bottom", "15px")])],
        [
          Div(
            [Style([("font-size", "64px"), ("margin-bottom", "5px")])],
            [Text(emoji)]
          ),
          Div(
            [Style([("font-size", "18px"), ("color", "#c39bd3"), ("font-weight", "bold")])],
            [Text(name)]
          )
        ]
      ),
      # Personality and Age #
      Div(
        [Style([("display", "flex"), ("justify-content", "space-between"),
                ("margin-bottom", "15px"), ("padding", "8px 12px"),
                ("background", "#16213e"), ("border-radius", "8px")])],
        [
          Span([Style([("color", "#d5a6e6")])], [Text(personalityStr(model.personality))]),
          Span([Style([("color", "#7f8c8d")])], [Text("Age: " ++ string_of_int(model.age))])
        ]
      ),
      # Stat bars #
      Div(
        [Style([("padding", "10px"), ("background", "#16213e"), ("border-radius", "8px"),
                ("margin-bottom", "15px")])],
        [
          statBar("Hunger", model.stats.hunger, "#e67e22"),
          statBar("Happiness", model.stats.happiness, "#e84393"),
          statBar("Energy", model.stats.energy, "#f1c40f"),
          statBar("Health", model.stats.health, "#2ecc71")
        ]
      ),
      # Memory display #
      Div(
        [Style([("text-align", "center"), ("margin-bottom", "12px"),
                ("font-size", "11px"), ("color", "#7f8c8d")])],
        [Text("Fed:" ++ string_of_int(model.memory.timesFed)
              ++ " Played:" ++ string_of_int(model.memory.timesPlayed)
              ++ " Slept:" ++ string_of_int(model.memory.timesSlept)
              ++ " Neglect:" ++ string_of_int(model.memory.timesNeglected))]
      ),
      # Action buttons #
      Div(
        [Style([("display", "flex"), ("flex-wrap", "wrap"), ("justify-content", "center"),
                ("margin-bottom", "10px")])],
        [
          actionButton("🍕 Feed", Feed, "#e67e22"),
          actionButton("🎮 Play", Play, "#e84393"),
          actionButton("💤 Sleep", Sleep, "#2980b9"),
          actionButton("🔧 Repair", Repair, "#2ecc71")
        ]
      ),
      # Time Passes button #
      Div(
        [Style([("text-align", "center")])],
        [
          Button(
            [
              OnClick(TimeTick),
              Style([
                ("padding", "8px 24px"), ("background", "#6c3483"),
                ("color", "#e0e0e0"), ("border", "1px solid #9b59b6"),
                ("border-radius", "6px"), ("cursor", "pointer"),
                ("font-size", "14px"), ("font-family", "'Courier New', monospace")
              ])
            ],
            [Text("⏳ Time Passes")]
          )
        ]
      )
    ]
  )
in

let subs = fun _model -> SubNone in

# ===== TESTS ===== #

# Basic feeding test #
hint "feeding increases hunger stat"
test
  let (m, _) = update(Feed, init) in
  m.stats.hunger > init.stats.hunger
end;

hint "feeding also gives small happiness boost"
test
  let (m, _) = update(Feed, init) in
  m.stats.happiness > init.stats.happiness
end;

# Playing tests #
hint "playing increases happiness when has energy"
test
  let (m, _) = update(Play, init) in
  m.stats.happiness > init.stats.happiness
end;

hint "playing costs energy"
test
  let (m, _) = update(Play, init) in
  m.stats.energy < init.stats.energy
end;

hint "playing when exhausted is less effective"
test
  let exhausted = (
    stats = (hunger = 50, happiness = 30, energy = 10, health = 80),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let (m, _) = update(Play, exhausted) in
  # Only +5 happiness instead of +25 #
  m.stats.happiness == 35
end;

# Sleeping tests #
hint "sleeping restores energy"
test
  let tired = (
    stats = (hunger = 50, happiness = 50, energy = 30, health = 80),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let (m, _) = update(Sleep, tired) in
  m.stats.energy == 70
end;

# Repair tests #
hint "repair increases health"
test
  let damaged = (
    stats = (hunger = 50, happiness = 50, energy = 50, health = 40),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let (m, _) = update(Repair, damaged) in
  m.stats.health == 75
end;

hint "repair is uncomfortable (decreases happiness)"
test
  let (m, _) = update(Repair, init) in
  m.stats.happiness < init.stats.happiness
end;

# Time decay tests #
hint "time tick reduces hunger"
test
  let (m, _) = update(TimeTick, init) in
  m.stats.hunger < init.stats.hunger
end;

hint "time tick reduces energy"
test
  let (m, _) = update(TimeTick, init) in
  m.stats.energy < init.stats.energy
end;

hint "hunger affects happiness decay rate"
test
  let hungry = (
    stats = (hunger = 20, happiness = 50, energy = 50, health = 80),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let full = (
    stats = (hunger = 80, happiness = 50, energy = 50, health = 80),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let (hungryAfter, _) = update(TimeTick, hungry) in
  let (fullAfter, _) = update(TimeTick, full) in
  # Hungry toaster loses more happiness #
  hungryAfter.stats.happiness < fullAfter.stats.happiness
end;

hint "exhaustion hurts health"
test
  let exhausted = (
    stats = (hunger = 50, happiness = 50, energy = 15, health = 50),
    evolution = BabyToaster,
    personality = Balanced,
    memory = init.memory,
    age = 0
  ) in
  let (m, _) = update(TimeTick, exhausted) in
  m.stats.health < exhausted.stats.health
end;

# Evolution tests #
hint "starts as baby toaster"
test
  init.evolution == BabyToaster
end;

hint "evolves to teen after age 10"
test
  let m = do_actions(init, timePasses(10)) in
  m.evolution == TeenToaster
end;

hint "well-cared-for toaster becomes golden"
test
  let wellCared = do_actions(init, [
    Feed, Play, Sleep, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick, TimeTick,
    Feed, Sleep, TimeTick, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick, TimeTick,
    Feed, Sleep, TimeTick, TimeTick, TimeTick,
    Feed, Play, Sleep, TimeTick, TimeTick, TimeTick
  ]) in
  wellCared.evolution == GoldenToaster
end;

# Memory tests #
hint "feeding increments timesFed"
test
  let m = do_actions(init, [Feed, Feed, Feed]) in
  m.memory.timesFed == 3
end;

hint "playing increments timesPlayed"
test
  let m = do_actions(init, [Play, Play]) in
  m.memory.timesPlayed == 2
end;

# Personality tests #
hint "lots of play creates cheerful personality"
test
  let playful = do_actions(init, [
    Play, Play, Play, Play, Play,
    Feed, Sleep
  ]) in
  playful.personality == Cheerful
end;

# Stat clamping tests #
hint "stats cannot go below 0"
test
  let dying = (
    stats = (hunger = 5, happiness = 5, energy = 5, health = 5),
    evolution = RustyToaster,
    personality = Grumpy,
    memory = init.memory,
    age = 30
  ) in
  let m = do_actions(dying, timePasses(5)) in
  m.stats.hunger >= 0 && m.stats.happiness >= 0 &&
  m.stats.energy >= 0 && m.stats.health >= 0
end;

hint "stats cannot exceed 100"
test
  let healthy = (
    stats = (hunger = 90, happiness = 90, energy = 90, health = 95),
    evolution = GoldenToaster,
    personality = Cheerful,
    memory = (timesFed = 10, timesPlayed = 10, timesSlept = 10, timesNeglected = 0),
    age = 30
  ) in
  let m = do_actions(healthy, [Feed, Sleep]) in
  m.stats.hunger <= 100 && m.stats.energy <= 100 && m.stats.health <= 100
end;

# Personality affects stats #
hint "cheerful personality gives bonus to actions"
test
  let cheerfulModel = (
    stats = (hunger = 50, happiness = 50, energy = 50, health = 50),
    evolution = AdultToaster,
    personality = Cheerful,
    memory = init.memory,
    age = 25
  ) in
  let grumpyModel = (
    stats = (hunger = 50, happiness = 50, energy = 50, health = 50),
    evolution = AdultToaster,
    personality = Grumpy,
    memory = init.memory,
    age = 25
  ) in
  let (cheerfulFed, _) = update(Feed, cheerfulModel) in
  let (grumpyFed, _) = update(Feed, grumpyModel) in
  cheerfulFed.stats.hunger > grumpyFed.stats.hunger
end;

# Complex scenario tests #
hint "daily routine maintains health"
test
  let dailyRoutine = [Feed, Play, Sleep, TimeTick, TimeTick] in
  let m = do_actions(init, dailyRoutine) in
  m.stats.health >= init.stats.health - 5
end;

hint "neglect leads to rusty evolution"
test
  let neglected = do_actions(init, timePasses(30)) in
  neglected.evolution == RustyToaster
end;

hint "age increases with time ticks"
test
  let m = do_actions(init, timePasses(5)) in
  m.age == 5
end;

hint "age does not increase with other actions"
test
  let m = do_actions(init, [Feed, Play, Sleep, Repair]) in
  m.age == 0
end;

(init, update, view, subs)