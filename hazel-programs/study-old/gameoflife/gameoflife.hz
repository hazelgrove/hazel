# CONWAY'S GAME OF LIFE #
# Cellular automaton with birth/death rules #

type Cell = + Dead + Alive in

# Grid is a flat list with width/height metadata #
type Grid = (
  cells = [Cell],
  width = Int,
  height = Int
) in

# Create empty grid #
let makeGrid : (Int, Int) -> Grid =
  fun (w, h) ->
    (
      cells = map(range(0, w * h - 1), fun _ -> Dead),
      width = w,
      height = h
    )
in

# Convert (x, y) to index #
let toIndex : (Grid, Int, Int) -> Int =
  fun (g, x, y) ->
    y * g.width + x
in

# Check if coords are in bounds #
let inBounds : (Grid, Int, Int) -> Bool =
  fun (g, x, y) ->
    x >= 0 && x < g.width && y >= 0 && y < g.height
in

# Get cell at (x, y), returns Dead if out of bounds #
let getCell : (Grid, Int, Int) -> Cell =
  fun (g, x, y) ->
    if inBounds(g, x, y)
    then nth(g.cells, toIndex(g, x, y))
    else Dead
in

# Set cell at (x, y) #
let setCell : (Grid, Int, Int, Cell) -> Grid =
  fun (g, x, y, cell) ->
    let idx = toIndex(g, x, y) in
    (
      cells = mapi(g.cells, fun (i, c) -> if i == idx then cell else c),
      width = g.width,
      height = g.height
    )
in

# Count alive neighbors for cell at (x, y) #
let countNeighbors : (Grid, Int, Int) -> Int =
  fun (g, x, y) ->
    let neighbors = [
      getCell(g, x - 1, y - 1),
      getCell(g, x,     y - 1),
      getCell(g, x + 1, y - 1),
      getCell(g, x - 1, y),
      getCell(g, x + 1, y),
      getCell(g, x - 1, y + 1),
      getCell(g, x,     y + 1),
      getCell(g, x + 1, y + 1)
    ] in
    length(filter(neighbors, fun c -> c == Alive))
in

# Apply Game of Life rules to a single cell #
let nextCellState : (Cell, Int) -> Cell =
  fun (current, neighbors) ->
    case current
    | Alive =>
        if neighbors == 2 || neighbors == 3
        then Alive
        else Dead
    | Dead =>
        if neighbors == 3
        then Alive
        else Dead
    end
in

# Step the entire grid (simultaneous update) #
let step : Grid -> Grid =
  fun g ->
    let newCells = mapi(g.cells, fun (idx, _) ->
      let x = idx - (idx / g.width) * g.width in
      let y = idx / g.width in
      let current = getCell(g, x, y) in
      let neighbors = countNeighbors(g, x, y) in
      nextCellState(current, neighbors)
    ) in
    (cells = newCells, width = g.width, height = g.height)
in

# Run n steps #
let run : (Grid, Int) -> Grid =
  fun (g, n) ->
    if n <= 0 then g
    else fold_left(range(1, n), fun (grid, _) -> step(grid), g)
in

# Helper: set multiple cells alive #
let setAlive : (Grid, [(Int, Int)]) -> Grid =
  fun (g, coords) ->
    fold_left(coords, fun (grid, xy) ->
      let (x, y) = xy in
      setCell(grid, x, y, Alive)
    , g)
in

# Count total alive cells #
let countAlive : Grid -> Int =
  fun g ->
    length(filter(g.cells, fun c -> c == Alive))
in

# ===== TESTS ===== #

# Basic grid operations #
hint "empty grid has all dead cells"
test
  let g = makeGrid(3, 3) in
  countAlive(g) == 0
end;

hint "can set and get cell"
test
  let g = setCell(makeGrid(3, 3), 1, 1, Alive) in
  getCell(g, 1, 1) == Alive
end;

hint "out of bounds returns Dead"
test
  let g = makeGrid(3, 3) in
  getCell(g, -1, 0) == Dead && getCell(g, 5, 5) == Dead
end;

# Neighbor counting #
hint "isolated cell has 0 neighbors"
test
  let g = setAlive(makeGrid(5, 5), [(2, 2)]) in
  countNeighbors(g, 2, 2) == 0
end;

hint "cell with one neighbor counts correctly"
test
  let g = setAlive(makeGrid(5, 5), [(2, 2), (2, 3)]) in
  countNeighbors(g, 2, 2) == 1
end;

hint "corner cell counts neighbors correctly"
test
  let g = setAlive(makeGrid(3, 3), [(0, 0), (1, 0), (0, 1)]) in
  countNeighbors(g, 0, 0) == 2
end;

hint "cell with 8 neighbors"
test
  let g = setAlive(makeGrid(3, 3), [
    (0, 0), (1, 0), (2, 0),
    (0, 1),         (2, 1),
    (0, 2), (1, 2), (2, 2)
  ]) in
  countNeighbors(g, 1, 1) == 8
end;

# Cell state rules #
hint "alive cell with 2 neighbors survives"
test
  let g = setAlive(makeGrid(3, 3), [(0, 1), (1, 1), (2, 1)]) in
  let g2 = step(g) in
  getCell(g2, 1, 1) == Alive
end;

hint "alive cell with 3 neighbors survives"
test
  let g = setAlive(makeGrid(3, 3), [
    (1, 0),
    (0, 1), (1, 1), (2, 1)
  ]) in
  let g2 = step(g) in
  getCell(g2, 1, 1) == Alive
end;

hint "alive cell with 1 neighbor dies (underpopulation)"
test
  let g = setAlive(makeGrid(3, 3), [(1, 1), (1, 0)]) in
  let g2 = step(g) in
  getCell(g2, 1, 1) == Dead
end;

hint "alive cell with 4 neighbors dies (overpopulation)"
test
  let g = setAlive(makeGrid(3, 3), [
    (1, 0),
    (0, 1), (1, 1), (2, 1),
    (1, 2)
  ]) in
  let g2 = step(g) in
  getCell(g2, 1, 1) == Dead
end;

hint "dead cell with 3 neighbors becomes alive (birth)"
test
  let g = setAlive(makeGrid(3, 3), [(0, 0), (1, 0), (0, 1)]) in
  let g2 = step(g) in
  getCell(g2, 1, 1) == Alive
end;

hint "dead cell with 2 neighbors stays dead"
test
  let g = setAlive(makeGrid(3, 3), [(0, 0), (1, 0)]) in
  let g2 = step(g) in
  getCell(g2, 1, 1) == Dead
end;

# Classic patterns #

# Blinker: oscillates between horizontal and vertical #
hint "blinker oscillates (horizontal to vertical)"
test
  let g = setAlive(makeGrid(5, 5), [(1, 2), (2, 2), (3, 2)]) in
  let g2 = step(g) in
  getCell(g2, 2, 1) == Alive &&
  getCell(g2, 2, 2) == Alive &&
  getCell(g2, 2, 3) == Alive
end;

hint "blinker returns to original after 2 steps"
test
  let g = setAlive(makeGrid(5, 5), [(1, 2), (2, 2), (3, 2)]) in
  let g2 = run(g, 2) in
  getCell(g2, 1, 2) == Alive &&
  getCell(g2, 2, 2) == Alive &&
  getCell(g2, 3, 2) == Alive
end;

# Block: stable 2x2 square #
hint "block is stable (still life)"
test
  let g = setAlive(makeGrid(4, 4), [(1, 1), (2, 1), (1, 2), (2, 2)]) in
  let g2 = step(g) in
  countAlive(g2) == 4 &&
  getCell(g2, 1, 1) == Alive &&
  getCell(g2, 2, 2) == Alive
end;

hint "block remains stable after 5 steps"
test
  let g = setAlive(makeGrid(4, 4), [(1, 1), (2, 1), (1, 2), (2, 2)]) in
  let g2 = run(g, 5) in
  countAlive(g2) == 4
end;

# Single cell dies #
hint "lone cell dies"
test
  let g = setAlive(makeGrid(3, 3), [(1, 1)]) in
  let g2 = step(g) in
  countAlive(g2) == 0
end;

# Two adjacent cells die #
hint "two adjacent cells die"
test
  let g = setAlive(makeGrid(3, 3), [(1, 1), (2, 1)]) in
  let g2 = step(g) in
  countAlive(g2) == 0
end;

# Simultaneous update test #
hint "updates are simultaneous not sequential"
test
  let g = setAlive(makeGrid(5, 5), [(1, 2), (2, 2), (3, 2)]) in
  let g2 = step(g) in
  getCell(g2, 1, 2) == Dead &&
  getCell(g2, 3, 2) == Dead
end;

# Edge behavior #
hint "edge cells count neighbors correctly"
test
  let g = setAlive(makeGrid(3, 3), [(0, 0), (1, 0), (2, 0)]) in
  let g2 = step(g) in
  getCell(g2, 1, 0) == Alive &&
  getCell(g2, 1, 1) == Alive
end;

# Demo: Blinker evolution #
let blinker = setAlive(makeGrid(5, 5), [(1, 2), (2, 2), (3, 2)]) in
(blinker, step(blinker), run(blinker, 2))
