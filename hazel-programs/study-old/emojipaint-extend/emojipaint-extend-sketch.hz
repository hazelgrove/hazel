# EMOJIPAINT EXTENSION TASK                     #
#                                               #
# The emojipaint app lets you paint emojis on   #
# a grid. It already supports painting rows.    #
#                                               #
# YOUR TASK: Add a PaintCol action that fills   #
# an entire column with the current brush.      #
#                                               #
# You need to:                                  #
#   1. Add PaintCol(Col) to the Action type     #
#   2. Add a setCol helper function             #
#   3. Handle PaintCol in the update function   #
#                                               #
# Look at how PaintRow is implemented for       #
# guidance - PaintCol is similar but vertical.  #
#                                               #
# Tip: Use auto-probe to see how the canvas     #
# changes after each action.                    #

type Emoji = String in
type Canvas = [[Emoji]] in
type Row = Int in
type Col = Int in

type Model = (
  canvas = Canvas,
  brush = Emoji,
  palette = [Emoji]
) in

type Action =
  + SetBrush(Int)
  + PaintCell(Row, Col)
  + ClearCell(Row, Col)
  + ClearGrid
  + PaintRow(Row)
  # TODO: Add PaintCol(Col) here #
in

let init: Model = (
  canvas = [
    ["", "", ""],
    ["", "", ""],
    ["", "", ""]
  ],
  brush = "🎨",
  palette = ["🎨", "🌟", "💜", "🔥", "🌊"]
) in

let setCell: (Canvas, Row, Col, Emoji) -> Canvas =
  fun canvas, row, col, emoji ->
    mapi(canvas, fun (i, r) ->
      if i == row
      then mapi(r, fun (j, c) -> if j == col then emoji else c)
      else r)
in

let setRow: (Canvas, Row, Emoji) -> Canvas =
  fun canvas, targetRow, emoji ->
    mapi(canvas, fun (i, row) ->
      if i == targetRow
      then map(row, fun _ -> emoji)
      else row)
in

# TODO: Add setCol helper here #
# Hint: You need to modify each row, changing #
# only the cell at the target column.         #

let setAll: (Canvas, Emoji) -> Canvas =
  fun (canvas, emoji) ->
    map(canvas, fun row -> map(row, fun _ -> emoji))
in

let updateGrid: (Model, Canvas -> Canvas) -> Model =
  fun (m, f) -> (f(m.canvas), m.brush, m.palette)
in

let update: (Model, Action) -> Model =
  fun m, action ->
    case action
    | SetBrush(idx) =>
        (m.canvas, nth(m.palette, idx), m.palette)
    | PaintCell(row, col) =>
        updateGrid(m, fun c -> setCell(c, row, col, m.brush))
    | ClearCell(row, col) =>
        updateGrid(m, fun c -> setCell(c, row, col, ""))
    | ClearGrid =>
        updateGrid(m, fun c -> setAll(c, ""))
    | PaintRow(row) =>
        updateGrid(m, fun c -> setRow(c, row, m.brush))
    # TODO: Add PaintCol case here #
    end
in

let do: (Model, [Action]) -> Model =
  fun (init: Model, actions: [Action]) ->
    fold_left(actions, update, init)
in

# Existing tests #
test
  let m = update(init, PaintRow(1)) in
  m.canvas == [["", "", ""], ["🎨", "🎨", "🎨"], ["", "", ""]]
end;

# New tests for PaintCol #
test
  let m = update(init, PaintCol(0)) in
  m.canvas == [["🎨", "", ""], ["🎨", "", ""], ["🎨", "", ""]]
end;

test
  let m = update(init, PaintCol(2)) in
  m.canvas == [["", "", "🎨"], ["", "", "🎨"], ["", "", "🎨"]]
end;

test
  let m = do(init, [PaintRow(0), PaintCol(1)]) in
  m.canvas == [["🎨", "🎨", "🎨"], ["", "🎨", ""], ["", "🎨", ""]]
end;

test
  let m = do(init, [SetBrush(2), PaintCol(1)]) in
  m.canvas == [["", "💜", ""], ["", "💜", ""], ["", "💜", ""]]
  && m.brush == "💜"
end
