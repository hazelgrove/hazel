module EchoCipherII = {
  # Shift cipher variant: modulus 15, key 6 #
  let modulus : Int = 15;

  let wrap = fun (n: Int) ->
    int_mod(int_mod(n, modulus) + modulus, modulus);

  let encode = fun (k: Int, rs: [Int]) ->
    map(rs, fun r -> wrap(r + k));

  let decode = fun (k: Int, rs: [Int]) ->
    map(rs, fun r -> wrap(r - k));

  let checksum = fun (rs: [Int]) ->
    fold_left(rs, fun (acc, r) -> int_mod(acc * 31 + r, 9973), 7);

  let selfcheck : () -> Bool = fun _ ->
    let msg = [2, 13, 7, 7, 3, 10, 11] in
    let hidden = encode(6, msg) in
    decode(6, hidden) == msg
    && checksum(msg) == 8816
    && checksum(hidden) == 8307
} in

module SmithWorksII = {
  # Crafting variant: recipe costs (3, 1) and 7 #
  type Model = (wood = Int, resin = Int, ones = Int, twos = Int);
  type Action =
    + Gather(Int, Int)
    + CraftOne
    + CraftTwo;

  let init : Model = (wood = 0, resin = 0, ones = 0, twos = 0);

  let update = fun (m: Model, a: Action) ->
    case a
    | Gather(w, r) => (
        wood = m.wood + w, resin = m.resin + r,
        ones = m.ones, twos = m.twos
      )
    | CraftOne =>
        if m.wood >= 3 && m.resin >= 1
        then (
          wood = m.wood - 3, resin = m.resin - 1,
          ones = m.ones + 1, twos = m.twos
        )
        else m
    | CraftTwo =>
        if m.wood >= 7
        then (
          wood = m.wood - 7, resin = m.resin,
          ones = m.ones, twos = m.twos + 1
        )
        else m
    end;

  let run = fun (m: Model, actions: [Action]) ->
    fold_left(actions, fun (acc, a) -> update(acc, a), m);

  let selfcheck : () -> Bool = fun _ ->
    let m1 = run(init, [Gather(18, 6), CraftOne, CraftOne, CraftOne, CraftTwo]) in
    m1.ones == 3 && m1.twos == 1
    && m1.wood == 2 && m1.resin == 3
} in

module HeathTallyII = {
  # Streak tally variant: bonus step 2, cap 6 #
  type Model = (total = Int, streak = Int, last = Int, seen = Bool);
  type Action =
    + Score(Int)
    + Clear;

  let init : Model = (total = 0, streak = 0, last = 0, seen = false);

  let update = fun (m: Model, a: Action) ->
    case a
    | Score(v) =>
        let bump =
          if m.seen && v == m.last
          then (if m.streak + 2 > 6 then 6 else m.streak + 2)
          else 0 in
        (total = m.total + v + bump, streak = bump, last = v, seen = true)
    | Clear => init
    end;

  let run = fun (m: Model, actions: [Action]) ->
    fold_left(actions, fun (acc, a) -> update(acc, a), m);

  let selfcheck : () -> Bool = fun _ ->
    let m1 = run(init, [Score(9), Score(9), Score(9), Score(9), Score(9), Score(2)]) in
    m1.total == 65
    && m1.streak == 0
    && run(m1, [Clear]) == init
} in

module QuarryMarketII = {
  # Market variant: distinct stock table and sale ledger #
  type Item = (label = String, price = Int, stock = Int);
  type Model = (items = [Item], coins = Int);
  type Action =
    + Sell(String, Int)
    + Restock(String, Int);

  let init : Model = (
    items = [
      (label = "slate", price = 6, stock = 17),
      (label = "chisel", price = 10, stock = 5),
      (label = "dust", price = 2, stock = 41)
    ],
    coins = 0
  );

  let stock_of = fun (m: Model, which: String) ->
    fold_left(m.items, fun (acc, it) ->
      if it.label == which then it.stock else acc
    , 0);

  let earn = fun (m: Model, which: String, n: Int) ->
    fold_left(m.items, fun (acc, it) ->
      if it.label == which then acc + n * it.price else acc
    , 0);

  let update = fun (m: Model, a: Action) ->
    case a
    | Sell(which, n) =>
        if stock_of(m, which) < n
        then m
        else (
          items =
            map(m.items, fun it ->
              if it.label == which
              then (label = it.label, price = it.price, stock = it.stock - n)
              else it),
          coins = m.coins + earn(m, which, n)
        )
    | Restock(which, n) => (
        items =
          map(m.items, fun it ->
            if it.label == which
            then (label = it.label, price = it.price, stock = it.stock + n)
            else it),
        coins = m.coins
      )
    end;

  let run = fun (m: Model, actions: [Action]) ->
    fold_left(actions, fun (acc, a) -> update(acc, a), m);

  let selfcheck : () -> Bool = fun _ ->
    let done_ = run(init, [Sell("slate", 10), Sell("dust", 25), Sell("chisel", 4), Sell("chisel", 1)]) in
    done_.coins == 160
    && stock_of(done_, "slate") == 7
} in

module FrostCipherII = {
  # Shift cipher variant: modulus 39, key 21 #
  let modulus : Int = 39;

  let wrap = fun (n: Int) ->
    int_mod(int_mod(n, modulus) + modulus, modulus);

  let encode = fun (k: Int, rs: [Int]) ->
    map(rs, fun r -> wrap(r + k));

  let decode = fun (k: Int, rs: [Int]) ->
    map(rs, fun r -> wrap(r - k));

  let checksum = fun (rs: [Int]) ->
    fold_left(rs, fun (acc, r) -> int_mod(acc * 31 + r, 9973), 7);

  let selfcheck : () -> Bool = fun _ ->
    let msg = [37, 1, 20, 25, 9, 16] in
    let hidden = encode(21, msg) in
    decode(21, hidden) == msg
    && checksum(msg) == 9196
    && checksum(hidden) == 1441
} in

module WheelWorksII = {
  # Crafting variant: recipe costs (1, 1) and 5 #
  type Model = (wood = Int, resin = Int, ones = Int, twos = Int);
  type Action =
    + Gather(Int, Int)
    + CraftOne
    + CraftTwo;

  let init : Model = (wood = 0, resin = 0, ones = 0, twos = 0);

  let update = fun (m: Model, a: Action) ->
    case a
    | Gather(w, r) => (
        wood = m.wood + w, resin = m.resin + r,
        ones = m.ones, twos = m.twos
      )
    | CraftOne =>
        if m.wood >= 1 && m.resin >= 1
        then (
          wood = m.wood - 1, resin = m.resin - 1,
          ones = m.ones + 1, twos = m.twos
        )
        else m
    | CraftTwo =>
        if m.wood >= 5
        then (
          wood = m.wood - 5, resin = m.resin,
          ones = m.ones, twos = m.twos + 1
        )
        else m
    end;

  let run = fun (m: Model, actions: [Action]) ->
    fold_left(actions, fun (acc, a) -> update(acc, a), m);

  let selfcheck : () -> Bool = fun _ ->
    let m1 = run(init, [Gather(10, 8), CraftOne, CraftOne, CraftOne, CraftOne, CraftOne, CraftTwo]) in
    m1.ones == 5 && m1.twos == 1
    && m1.wood == 0 && m1.resin == 3
} in

module MireTallyII = {
  # Streak tally variant: bonus step 7, cap 20 #
  type Model = (total = Int, streak = Int, last = Int, seen = Bool);
  type Action =
    + Score(Int)
    + Clear;

  let init : Model = (total = 0, streak = 0, last = 0, seen = false);

  let update = fun (m: Model, a: Action) ->
    case a
    | Score(v) =>
        let bump =
          if m.seen && v == m.last
          then (if m.streak + 7 > 20 then 20 else m.streak + 7)
          else 0 in
        (total = m.total + v + bump, streak = bump, last = v, seen = true)
    | Clear => init
    end;

  let run = fun (m: Model, actions: [Action]) ->
    fold_left(actions, fun (acc, a) -> update(acc, a), m);

  let selfcheck : () -> Bool = fun _ ->
    let m1 = run(init, [Score(8), Score(8), Score(2), Score(8), Score(8), Score(8)]) in
    m1.total == 70
    && m1.streak == 14
    && run(m1, [Clear]) == init
} in

module MetaRunner = {
  # The linking layer: an MVU program whose actions run the sub-apps #
  type Report = (label = String, passed = Bool);
  type Model = (ran = Int, ok = Int);
  type Action =
    + RunAll
    + Reset;

  let init : Model = (ran = 0, ok = 0);

  let all_reports : () -> [Report] = fun _ ->
    [
