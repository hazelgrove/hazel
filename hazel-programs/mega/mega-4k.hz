      (label = "HarborMarket", passed = HarborMarket.selfcheck(())),
      (label = "DuneCipher", passed = DuneCipher.selfcheck(())),
      (label = "PressWorks", passed = PressWorks.selfcheck(())),
      (label = "GladeTally", passed = GladeTally.selfcheck(())),
      (label = "MeadowMarket", passed = MeadowMarket.selfcheck(())),
      (label = "EchoCipher", passed = EchoCipher.selfcheck(())),
      (label = "SmithWorks", passed = SmithWorks.selfcheck(())),
      (label = "HeathTally", passed = HeathTally.selfcheck(())),
      (label = "QuarryMarket", passed = QuarryMarket.selfcheck(())),
      (label = "FrostCipher", passed = FrostCipher.selfcheck(())),
      (label = "WheelWorks", passed = WheelWorks.selfcheck(())),
      (label = "MireTally", passed = MireTally.selfcheck(())),
      (label = "ReefMarket", passed = ReefMarket.selfcheck(())),
      (label = "GaleCipher", passed = GaleCipher.selfcheck(())),
