# A Color Picker Livelit #

# Click the gradient square to pick; the slider sets the hue. The #
# model is (hue, whiteness, blackness) and the expansion is a CSS #
# hwb() string. The square IS the hwb space: a white-to-hue wash #
# under a black veil, so the click math reads the color exactly. #

let ^hwb = {
  type Model = (Int, Int, Int);
  type Action = Model;

  let css = fun (h, w, b) : Model ->
    "hwb(" ++ string_of_int(h) ++ " "
    ++ string_of_int(w) ++ "% "
    ++ string_of_int(b) ++ "%)";

  # square geometry: 150 x 100 px, so y is blackness directly #
  let pick = fun (h, x, y) ->
    (h, (150 - x) * (100 - y) / 150, y);

  let dot_x = fun (w, b) ->
    if b == 100 then 0 else 150 - 150 * w / (100 - b);

  let init : Model = (160, 25, 10);

  let update = fun (m, a) : (Model, Action) -> a;

  let view = fun (h, w, b) : Model ->
    Div(
      [Style([("display", "flex"), ("gap", "0.8em"),
              ("align-items", "flex-start"),
              ("font-family", "var(--code-font)"),
              ("font-size", "0.75em"), ("padding", "2px")])],
      [
        Div(
          [Style([("width", "2.6em"), ("height", "2.6em"),
                  ("border-radius", "0.4em"),
                  ("border", "1px solid var(--BR1)"),
                  ("background", css((h, w, b)))])],
          []
        ),
        Div(
          [Style([("display", "flex"), ("flex-direction", "column"),
                  ("gap", "0.4em")])],
          [
            Div(
              [Style([("width", "150px"), ("height", "100px"),
                      ("position", "relative"),
                      ("cursor", "crosshair"),
                      ("border-radius", "3px"),
                      ("background",
                       "linear-gradient(to top, #000, transparent), "
                       ++ "linear-gradient(to right, #fff, hsl("
                       ++ string_of_int(h) ++ " 100% 50%))")]),
               OnClickAt(fun (x, y) -> pick((h, x, y)))],
              [
                Div(
                  [Style([("position", "absolute"),
                          ("left",
                           string_of_int(dot_x((w, b)) - 4) ++ "px"),
                          ("top", string_of_int(b - 4) ++ "px"),
                          ("width", "8px"), ("height", "8px"),
                          ("border-radius", "50%"),
                          ("border", "2px solid #fff"),
                          ("box-shadow", "0 0 2px #000"),
                          ("pointer-events", "none")])],
                  []
                )
              ]
            ),
            Input([
              Type("range"), Min("0"), Max("359"),
              Value(string_of_int(h)),
              OnInput(fun s -> (int_of_string(s), w, b)),
              Style([("width", "150px"), ("margin", "0"),
                     ("background",
                      "linear-gradient(to right, #f00, #ff0, #0f0, "
                      ++ "#0ff, #00f, #f0f, #f00)")])
            ])
          ]
        )
      ]
    );

  let expand = fun m : Model -> css(m);

  let size = (28, 7)
} in

# Two picks, each with its own color stored in its argument: #

(^^livelit(^hwb(160, 25, 10)), ^^livelit(^hwb(280, 5, 40)))
